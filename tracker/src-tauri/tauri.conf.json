{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sputnik",
  "version": "0.3.0",
  "identifier": "com.siponik.sputnik",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Спутник",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Спутник — задачи и календарь",
    "longDescription": "Трекер задач поверх Google Tasks и Google Calendar.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRjVGMDBCOTRGMkI2NkUKUldSdXR2S1VDL0QxLzlxYzdlUlVYNUNIakExdHdDY0N6UnNzaDdTK2xOcnp4aEp3NzFiSlNMV2MK",
      "endpoints": [
        "https://github.com/Siponik/sputnik/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
