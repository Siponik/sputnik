msgstr "KB/s"

msgid "МБ/с"
msgstr "MB/s"

msgid "ещё ~{} с"
msgstr "~{} s left"

msgid "ещё ~{} мин"
msgstr "~{} min left"

msgid "{} из {}"
msgstr "{} of {}"

msgid "Файл скачался, но подпись не сошлась — ставить его нельзя."
msgstr "The file downloaded but its signature does not match — it cannot be installed."

msgid "Нажми «Повторить»: файл скачается заново."
msgstr "Press “Retry”: the file will download again."

msgid "Windows не дала заменить файл Спутника."
msgstr "Windows did not allow replacing the Sputnik file."

msgid "Закрой другие окна Спутника или перенеси sputnik.exe в свою папку (например, Документы) и повтори."
msgstr "Close other Sputnik windows or move sputnik.exe to your own folder (for example, Documents) and retry."

msgid "На диске не хватило места для новой версии."
msgstr "Not enough disk space for the new version."

msgid "Освободи около 100 МБ и повтори."
msgstr "Free up about 100 MB and retry."

msgid "Нет связи с GitHub — адрес не находится."
msgstr "No connection to GitHub — the address cannot be found."

msgid "Проверь интернет и повтори."
msgstr "Check your internet and retry."

msgid "GitHub отвечает слишком медленно — скачивание остановилось."
msgstr "GitHub is responding too slowly — the download stopped."

msgid "Нажми «Повторить»: продолжу с того же места. Не помогает несколько раз — включи VPN на время обновления."
msgstr "Press “Retry”: it will continue from the same place. If it keeps failing, turn on a VPN during the update."

msgid "Связь с GitHub оборвалась посреди скачивания."
msgstr "The connection to GitHub dropped mid-download."

msgid "Файл новой версии не нашёлся на GitHub."
msgstr "The new version file was not found on GitHub."

msgid "Подожди несколько минут — сборка, возможно, ещё выкладывается."
msgstr "Wait a few minutes — the build may still be uploading."

msgid "GitHub временно не отдаёт файл."
msgstr "GitHub is temporarily not serving the file."

msgid "Повтори через несколько минут."
msgstr "Retry in a few minutes."

msgid "У GitHub сбой."
msgstr "GitHub has an outage."

msgid "Обновление не скачалось."
msgstr "The update did not download."

msgid "Нажми «Повторить»."
msgstr "Press “Retry”."
