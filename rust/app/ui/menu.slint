// Меню по правому клику: у курсора, не выходит за окно. Пункты и подменю строит Rust.
import { G } from "theme.slint";
import { Icon, ScrollView, Pop } from "kit.slint";
import { S } from "store.slint";

export component CtxMenu inherits Rectangle {
    TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.menu-close(); } }
    }
    pad := Pop {
        x: max(8px, min(S.menu-x, root.width - self.width - 8px));
        y: max(8px, min(S.menu-y, root.height - self.height - 8px));
        width: 260px;
        // своя ScrollView без preferred-height — высота по пунктам
        height: min(mvl.preferred-height, root.height - 16px);
        border-radius: 10px;
        background: G.node;
        border-width: 1px; border-color: G.line;
        drop-shadow-blur: 18px; drop-shadow-color: #000a;
        clip: true;
        TouchArea { }
        mv := ScrollView {
            viewport-height: mvl.preferred-height;
            mvl := VerticalLayout {
            padding: 4px; padding-top: 6px;
            if S.menu-title != "" && S.menu-head.alpha == 0: HorizontalLayout { padding-left: 10px; padding-right: 10px; Text {
                text: S.menu-title.to-uppercase(); height: 28px;
                font-family: G.mono; font-size: 9.5px; letter-spacing: 1.3px; color: #8A8C96; vertical-alignment: center; overflow: elide;
            } }
            // шапка цвета сферы (G_Spheres): во всю ширину, над пунктами
            if S.menu-head.alpha > 0: Rectangle { height: 32px;
                Rectangle { x: -4px; y: -6px; width: parent.width + 8px; height: 32px; background: S.menu-head;
                    Text { x: 12px; text: S.menu-title.to-uppercase(); font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; overflow: elide; width: parent.width - 40px; }
                    Text { x: parent.width - 24px; text: "···"; font-size: 13px; color: #ffffffd0; vertical-alignment: center; height: parent.height; }
                } }
            for m in S.menu-items: VerticalLayout {
                if m.sep: Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; background: G.line; } }
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: ia.has-hover && !m.off ? G.node-hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; spacing: 10px;
                        // пункт выбора цвета — сам цвет кружком, а не значок
                        if m.hue.alpha == 0: Icon { name: m.icon; width: 16px; y: (parent.height - 16px) / 2; c: m.red ? G.red : m.off ? G.dim : #A3A5AE; }
                        if m.hue.alpha > 0: Rectangle { width: 16px; Rectangle {
                            width: 14px; height: 14px; border-radius: 7px; background: m.hue;
                            border-width: m.on ? 2px : 0; border-color: #ffffffd0;
                        } }
                        Text { text: m.label; font-size: 13px; color: m.red ? G.red : m.off ? G.dim : G.ink; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if m.on: Icon { name: "check"; width: 14px; y: (parent.height - 14px) / 2; c: G.accent; }
                        if m.key != "": Text { text: m.key; font-family: G.mono; font-size: 10px; color: #7A7C86; vertical-alignment: center; }
                        if m.sub: Icon { name: "next"; width: 12px; y: (parent.height - 12px) / 2; c: #8A8C96; }
                    }
                    ia := TouchArea { enabled: !m.off; mouse-cursor: pointer; clicked => { S.menu-pick(m.id); } }
                }
            }
            }
        }
    }
}
