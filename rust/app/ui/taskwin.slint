// Окно задачи (G_TaskFull, п.34, 36, 38): большое окно по центру, одно для всех видов доски.
// Шапка цвета сферы, название, полоса колонок, слева подзадачи и заметка, справа «Когда», «Свойства», «История».
import { G } from "theme.slint";
import { Field, Overlay, Brackets, Icon, Chev, ScrollInput, ScrollView, Pop, LabelHint } from "kit.slint";
import { S, Opt, Sub } from "store.slint";
import { MdNote } from "mdnote.slint";
import { TimeBox } from "dialogs.slint";
import { DueDrop } from "datetime.slint";

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 26px;
    width: ct.preferred-width + 20px;
    border-radius: 7px;
    border-width: 1px;
    border-color: on ? G.accent : G.line;
    background: on ? G.accent-wash : (ca.has-hover ? G.node-hover : transparent);
    ct := Text { x: 10px; text: root.text; font-size: 12px; color: on ? G.ink : G.ink2; vertical-alignment: center; height: parent.height; }
    ca := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component Cap inherits Text {
    font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px; color: G.grey;
}

// карточка-рамка из макета: radius 10, тонкая линия, фон темнее окна
component Card inherits Rectangle {
    border-radius: 10px; border-width: 1px; border-color: G.line; background: G.bg; clip: true;
}

// заголовок карточки: «ПОДЗАДАЧИ» слева, счётчик справа
component CardHead inherits Rectangle {
    in property <string> text;
    in property <string> right;
    height: 30px;
    Text { x: 10px; text: root.text; font-family: G.mono; font-size: 10px; font-weight: 500; letter-spacing: 1.4px; color: G.muted; vertical-alignment: center; height: parent.height; }
    Text { x: parent.width - 10px - self.preferred-width; text: root.right; font-family: G.mono; font-size: 11px; color: G.muted; vertical-alignment: center; height: parent.height; }
}

// строка свойства: значок, название, значение и стрелка (как в макете)
component PRow inherits Rectangle {
    in property <string> icon;
    in property <string> key;
    in property <string> val;
    in property <color> c: G.ink;
    in property <bool> arrow: true;
    callback clicked;
    height: 32px;
    background: pa.has-hover && arrow ? G.node-hover : transparent;
    Rectangle { y: 0; height: 1px; background: G.line-soft; }
    Icon { x: 10px; y: 8px; width: 15px; height: 15px; name: root.icon; c: G.muted; }
    Text { x: 33px; width: 92px; text: root.key; font-size: 12.5px; color: G.muted; vertical-alignment: center; height: parent.height; }
    Text { x: 133px; width: parent.width - 133px - 28px; text: root.val == "" ? "—" : root.val; font-size: 12.5px; font-weight: root.val == "" ? 400 : 600; color: root.val == "" ? G.ghost : root.c; vertical-alignment: center; height: parent.height; overflow: elide; }
    if arrow && val != "": Chev { x: parent.width - 20px; y: 13px; c: G.muted; }
    pa := TouchArea { enabled: root.arrow; clicked => { root.clicked(); } mouse-cursor: root.arrow ? pointer : default; }
}

// полоса колонок: пройденные зелёные с «✓», текущая оранжевая «N ДН · ИДЁТ», впереди серые; клик переносит.
// Прокрутка появляется, только когда колонок больше, чем влезает (больше 6).
component StageBar inherits Rectangle {
    property <int> cur: -1;
    property <int> n: S.t-cols.length;
    property <length> gap: 6px;
    property <length> cw: max(110px, (self.width - (n - 1) * gap) / max(1, n));
    property <bool> over: n * cw + (n - 1) * gap > self.width + 1px;
    height: over ? 54px : 42px;
    sv := ScrollView {
        content-width: root.n * root.cw + (root.n - 1) * root.gap;
        content-height: root.height;
        for c[i] in S.t-cols: Rectangle {
            property <int> st: c.on ? 1 : (i < root.cur ? 0 : 2);
            init => { if (c.on) { root.cur = i; } }
            x: i * (root.cw + root.gap); y: 0; width: root.cw; height: 42px;
            border-radius: 8px;
            background: st == 1 ? G.accent : st == 0 ? #E3F1E5.mix(#232A25, G.lt) : (ca.has-hover ? G.node-hover : transparent);
            border-width: st == 1 ? 0 : 1px;
            border-color: st == 0 ? #9CCBA5.mix(#2F4A35, G.lt) : G.line-hi;
            Text { x: 8px; y: 6px; width: parent.width - 16px; horizontal-alignment: center; text: (st == 0 ? "✓ " : "") + c.label; font-size: 13px; font-weight: st == 1 ? 600 : 400; color: st == 1 ? G.bg : st == 0 ? G.green : G.faint; overflow: elide; }
            Text { x: 8px; y: 24px; width: parent.width - 16px; horizontal-alignment: center; text: c.hint == "" ? "—" : c.hint; font-family: G.mono; font-size: 9.5px; letter-spacing: 1px; color: st == 1 ? G.bg : st == 0 ? G.green : G.ghost; opacity: 0.85; overflow: elide; }
            ca := TouchArea { clicked => { S.t-col(c.id); } mouse-cursor: pointer; }
        }
    }
}

export component TaskDialog inherits Overlay {
    property <bool> big;          // ⤢ — почти на весь экран
    property <bool> note-full;    // ⤢ у заметки — заметка на всё окно
    property <bool> menu;
    property <bool> lists-open;
    property <int> pop;           // 1 напоминания, 2 приоритет, 3 повтор
    property <string> repeat-label: S.t-repeats.length == 0 ? "" : S.t-repeats[0].on ? "" : S.t-repeats[1].on ? S.t-repeats[1].label : S.t-repeats.length > 2 && S.t-repeats[2].on ? S.t-repeats[2].label : S.t-repeats.length > 3 && S.t-repeats[3].on ? S.t-repeats[3].label : S.t-repeats.length > 4 && S.t-repeats[4].on ? S.t-repeats[4].label : S.t-repeats.length > 5 && S.t-repeats[5].on ? S.t-repeats[5].label : "";
    property <[Opt]> pop-items: pop == 1 ? S.t-reminds : pop == 3 ? S.t-repeats : [
        { id: "1", label: "!!! Высокий", on: S.t-prio == 1 }, { id: "2", label: "!! Средний", on: S.t-prio == 2 },
        { id: "3", label: "! Низкий", on: S.t-prio == 3 }, { id: "0", label: "Нет", on: S.t-prio == 0 }];
    property <bool> done-open;
    property <int> drag-i: -1;
    property <int> drag-to: -1;
    property <bool> narrow: self.width < 1000px;
    property <length> W: big ? self.width - 48px : max(min(840px, self.width - 16px), min(1200px, self.width * 0.82));
    property <length> H: big ? self.height - 48px : max(min(560px, self.height - 16px), min(860px, self.height * 0.86));
    property <length> RW: 340px;
    property <length> top: S.t-cols.length > 1 ? 176px : 118px;
    property <length> mid-h: root.H - root.top - 56px;
    property <length> lw: root.narrow || root.note-full ? root.W - 48px : root.W - 48px - root.RW - 24px;
    close => { S.t-close(); }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (root.note-full) { root.note-full = false; return accept; }
                S.t-close(); return accept;
            }
            reject
        }
        win := Rectangle {
            x: (parent.width - root.W) / 2;
            y: (parent.height - root.H) / 2;
            width: root.W; height: root.H;
            border-radius: 12px;
            background: G.node;
            border-width: 1px;
            border-color: G.accent-line;
            drop-shadow-blur: 30px; drop-shadow-color: #000c.transparentize(1 - G.shade);
            TouchArea { }
            // шапка цвета сферы
            Rectangle {
                y: 0; height: 36px;
                border-top-left-radius: 12px; border-top-right-radius: 12px;
                background: S.t-hue.mix(G.bg, 0.55);
                Text { x: 16px; width: parent.width - 140px; text: S.t-path; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; overflow: elide; }
                HorizontalLayout {
                    x: parent.width - 108px; width: 96px; height: parent.height; spacing: 6px; alignment: end;
                    for b[i] in ["more", "expand", "close"]: Rectangle {
                        width: 28px;
                        Icon { x: 6px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; name: b; c: ba.has-hover ? #fff : #ffffffb0; }
                        ba := TouchArea { clicked => { if (i == 0) { root.menu = !root.menu; } else if (i == 1) { root.big = !root.big; } else { S.t-close(); } } mouse-cursor: pointer; }
                    }
                }
            }
            // заголовок и значок приоритета сразу за ним
            Rectangle {
                x: 24px; y: 52px; width: parent.width - 48px; height: 34px;
                ti := TextInput {
                    x: 0; width: min(self.preferred-width + 4px, parent.width - 60px); height: parent.height;
                    text: S.t-title; font-size: 24px; font-weight: 600; color: G.ink;
                    single-line: true; vertical-alignment: center;
                    selection-background-color: G.accent-line;
                    edited => { S.t-title-set(self.text); }
                }
                if S.t-prio > 0: Rectangle {
                    x: ti.width + 14px; y: 6px; height: 22px; width: pt.preferred-width + 16px;
                    border-radius: 6px; background: G.accent-wash;
                    pt := Text { text: S.t-prio == 1 ? "!!!" : S.t-prio == 2 ? "!!" : "!"; font-family: G.mono; font-size: 13px; font-weight: 600; color: G.accent; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Text { x: 24px; y: 88px; width: parent.width - 48px; text: S.t-meta; font-size: 12.5px; color: G.muted; overflow: elide; }
            // полоса колонок
            if S.t-cols.length > 1: StageBar { x: 24px; y: 118px; width: parent.width - 48px; }
            // середина
            mid := ScrollView {
                x: 0; y: root.top; width: parent.width; height: root.mid-h;
                content-height: root.narrow && !root.note-full ? 320px + 10px + 560px : root.mid-h;
                // левая колонка: подзадачи (не больше 40 %) и заметка до подвала
                property <length> lh: root.narrow && !root.note-full ? 320px : root.mid-h - 12px;
                property <length> sub-h: root.note-full ? 0px : min(lh * 0.4, 30px + (S.t-subs.length > 0 ? 11px : 0px) + S.t-subs-open.length * 32px + 32px + (S.t-subs-done > 0 ? 32px : 0px) + (root.done-open ? S.t-subs-donelist.length * 32px : 0px) + 2px);
                if !root.note-full: Card {
                    x: 24px; y: 0; width: root.lw; height: sub-h;
                    CardHead { y: 0; text: "ПОДЗАДАЧИ"; right: S.t-subs.length > 0 ? S.t-subs-done + " / " + S.t-subs.length : ""; }
                    if S.t-subs.length > 0: Rectangle {
                        x: 10px; y: 30px; width: parent.width - 20px; height: 3px; border-radius: 1.5px; background: G.line-mid;
                        Rectangle { x: 0; width: parent.width * S.t-subs-done / max(1, S.t-subs.length); border-radius: 1.5px; background: G.violet; }
                    }
                    property <length> sy: S.t-subs.length > 0 ? 41px : 30px;
                    ScrollView {
                        x: 0; y: sy; width: parent.width; height: parent.height - sy - 1px;
                        content-height: sl.preferred-height;
                        sl := VerticalLayout {
                            spacing: 0; alignment: start;
                            for sb[si] in S.t-subs-open: Rectangle {
                                height: 32px;
                                background: root.drag-i >= 0 && root.drag-to == si && root.drag-to != root.drag-i ? G.accent-wash : transparent;
                                Rectangle { y: 0; height: 1px; background: G.line-soft; }
                                // ручка: потянуть вверх или вниз — подзадача встанет на новое место
                                Rectangle {
                                    x: 4px; width: 22px;
                                    Icon { x: 6px; y: 10px; width: 12px; height: 12px; name: "drag"; c: hda.has-hover || root.drag-i == si ? G.ink : G.dim; }
                                    hda := TouchArea {
                                        mouse-cursor: move;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down) { root.drag-i = si; root.drag-to = si; }
                                            if (e.kind == PointerEventKind.up && root.drag-i >= 0) {
                                                if (root.drag-to != root.drag-i) {
                                                    S.sub-move(S.t-list, S.t-id, sb.id, root.drag-to > root.drag-i
                                                        ? (root.drag-to + 1 < S.t-subs-open.length ? S.t-subs-open[root.drag-to + 1].id : "")
                                                        : S.t-subs-open[root.drag-to].id);
                                                }
                                                root.drag-i = -1; root.drag-to = -1;
                                            }
                                        }
                                        moved => { if (root.drag-i >= 0) { root.drag-to = max(0, min(S.t-subs-open.length - 1, si + round((self.mouse-y - self.pressed-y) / 32px))); } }
                                    }
                                }
                                Rectangle {
                                    x: 32px; y: 9px; width: 14px; height: 14px; border-radius: 3px;
                                    border-width: 1px; border-color: G.sub;
                                    TouchArea { clicked => { S.t-sub-toggle(sb.id); } mouse-cursor: pointer; }
                                }
                                Text { x: 56px; width: parent.width - 66px; text: sb.title; color: G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; overflow: elide; }
                            }
                            Rectangle {
                                height: 32px;
                                Rectangle { y: 0; height: 1px; background: G.line-soft; }
                                Field { x: 4px; width: parent.width - 8px; height: 32px; bare: true; font-size: 12.5px; placeholder: "＋ подзадача · Enter"; accepted(t) => { if (t != "") { S.t-sub-add(t); self.clear(); } } }
                            }
                            if S.t-subs-done > 0: Rectangle {
                                height: 32px;
                                Rectangle { y: 0; height: 1px; background: G.line-soft; }
                                HorizontalLayout {
                                    padding-left: 10px; spacing: 6px; alignment: start;
                                    Icon { y: 9px; width: 14px; height: 14px; name: "check"; c: G.green; }
                                    Text { text: "сделано " + S.t-subs-done; font-size: 12.5px; color: G.muted; vertical-alignment: center; }
                                    Chev { y: 11px; up: root.done-open; c: G.muted; }
                                }
                                TouchArea { clicked => { root.done-open = !root.done-open; } mouse-cursor: pointer; }
                            }
                            if root.done-open: VerticalLayout {
                                for sb in S.t-subs-donelist: Rectangle {
                                    height: 32px;
                                    Rectangle { y: 0; height: 1px; background: G.line-soft; }
                                    Rectangle {
                                        x: 32px; y: 9px; width: 14px; height: 14px; border-radius: 3px; background: G.green;
                                        Icon { name: "check"; width: 9px; x: 2.5px; y: 2.5px; c: G.bg; }
                                        TouchArea { clicked => { S.t-sub-toggle(sb.id); } mouse-cursor: pointer; }
                                    }
                                    dn := Text { x: 56px; width: parent.width - 66px; text: sb.title; color: G.muted; font-size: 13px; vertical-alignment: center; height: parent.height; overflow: elide; }
                                    Rectangle { x: 56px; y: 16px; height: 1px; width: min(dn.preferred-width, parent.width - 66px); background: G.muted; }
                                }
                            }
                        }
                    }
                }
                // заметка
                Card {
                    x: 24px; y: sub-h + (root.note-full ? 0 : 10px); width: root.lw; height: lh - sub-h - (root.note-full ? 0 : 10px);
                    border-color: nb.focused ? G.accent-line : G.line;
                    animate border-color { duration: G.fast; }
                    Text { x: 10px; y: 0; height: 30px; text: "ЗАМЕТКА"; font-family: G.mono; font-size: 10px; font-weight: 500; letter-spacing: 1.4px; color: G.muted; vertical-alignment: center; }
                    Text { x: 84px; y: 0; height: 30px; text: "MARKDOWN"; font-family: G.mono; font-size: 10px; color: G.muted; vertical-alignment: center; }
                    Rectangle {
                        x: parent.width - 28px; y: 4px; width: 22px; height: 22px;
                        border-radius: 6px; border-width: 1px; border-color: G.line;
                        Icon { x: 4px; y: 4px; width: 14px; height: 14px; name: root.note-full ? "minimize" : "expand"; c: na.has-hover ? G.ink : G.ink2; }
                        na := TouchArea { clicked => { root.note-full = !root.note-full; } mouse-cursor: pointer; }
                    }
                    nb := MdNote {
                        x: 12px; y: 34px; width: parent.width - 24px; height: parent.height - 44px;
                        text: S.t-notes; lines: S.t-note-lines; links: S.t-note-links-at; key: S.t-list + "|" + S.t-id;
                        edited(t) => { S.t-notes-set(t); }
                        opened => { S.t-close(); }
                    }
                }
                // правая колонка (в узком окне — под левой)
                if !root.note-full: VerticalLayout {
                    x: root.narrow ? 24px : root.W - 24px - root.RW;
                    y: root.narrow ? 330px : 0;
                    width: root.narrow ? root.W - 48px : root.RW;
                    height: root.narrow ? 540px : root.mid-h - 12px;
                    spacing: 10px;
                    // Когда: срок и напоминания чипами
                    Card {
                        height: 108px;
                        // выпадашки времени и даты выходят за карточку — не обрезать и держать над «Свойствами»
                        clip: !(tbx.open || S.dp-drop == "task");
                        z: tbx.open || S.dp-drop == "task" ? 20 : 0;
                        CardHead { y: 0; text: "КОГДА"; }
                        // время и дата в один ряд, как в макете G_TaskFull: время 140 px, дата — остальное
                        tbx := TimeBox { x: 10px; y: 30px; width: 140px; height: 34px; z: self.open ? 20 : 0; border-radius: 8px;
                            val: S.t-time; label: S.t-time-label; empty: "Весь день"; clearable: true; picked(t) => { S.t-time-set(t); } }
                        Rectangle {
                            x: 156px; y: 30px; width: parent.width - 166px; height: 34px;
                            border-radius: 8px; border-width: 1px; border-color: da.has-hover ? G.accent : G.accent-line; background: G.bg;
                            Icon { x: 10px; y: 10px; width: 14px; height: 14px; name: "calendar"; c: G.muted; }
                            Text { x: 32px; width: parent.width - 60px; text: S.t-due-label == "" ? "Без срока" : S.t-due-label; font-size: 13px; color: S.t-due-label == "" ? G.muted : G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                            Chev { x: parent.width - 20px; y: 14px; c: G.muted; }
                            da := TouchArea { clicked => { if (S.dp-drop == "task") { S.dp-cancel(); } else { S.drop = 0; S.dp-open-task(); } } mouse-cursor: pointer; }
                            if S.dp-open && S.dp-drop == "task": DueDrop { x: parent.width - self.width; y: parent.height + 4px; }
                        }
                        HorizontalLayout {
                            x: 10px; y: 72px; height: 26px; width: parent.width - 20px; spacing: 0; alignment: start;
                            Rectangle { width: 22px; Icon { x: 0; y: 6px; width: 14px; height: 14px; name: "bell"; c: G.muted; } }
                            // первые два чипа, остальные прячутся в «+N» — ряд не вылезает за край
                            for r in S.t-reminds: Rectangle {
                                property <bool> show: r.on && r.hint.to-float() < 2;
                                visible: show; width: show ? rc.width + 6px : 0px;
                                rc := Chip { x: 0; text: r.label + " ×"; on: true; clicked => { S.t-remind(r.id); } }
                            }
                            Chip { text: S.t-remind-n > 2 ? "+" + (S.t-remind-n - 2) : "＋"; on: root.pop == 1; clicked => { root.pop = root.pop == 1 ? 0 : 1; } }
                        }
                    }
                    // Свойства: строки с выпадающими списками
                    Card {
                        height: 30px + 4 * 32px + 2px;
                        VerticalLayout {
                            CardHead { text: "СВОЙСТВА"; }
                            PRow { icon: "board"; key: "Список"; val: "● " + S.t-list-name; c: S.t-hue; clicked => { root.pop = 0; root.lists-open = !root.lists-open; } }
                            PRow { icon: "priority"; key: "Приоритет"; val: ["", "!!! Высокий", "!! Средний", "! Низкий"][S.t-prio]; clicked => { root.pop = root.pop == 2 ? 0 : 2; } }
                            PRow { icon: "repeat"; key: "Повтор"; val: root.repeat-label; clicked => { root.pop = root.pop == 3 ? 0 : 3; } }
                            PRow { icon: "share"; key: "Исполнитель"; val: "Я"; arrow: false; }
                        }
                    }
                    // Заметки «Знаний» про эту задачу: по ссылкам [[…]] и по названию
                    Card {
                        height: 30px + max(1, S.t-note-links.length) * 32px + 4px;
                        CardHead { y: 0; text: "ЗАМЕТКИ"; }
                        Rectangle {
                            x: parent.width - lt.preferred-width - 22px; y: 0; width: lt.preferred-width + 12px; height: 30px;
                            lt := Text { text: "＋ Связать"; font-size: 12.5px; color: la.has-hover ? G.accent-ink : G.accent; horizontal-alignment: center; vertical-alignment: center; }
                            la := TouchArea { mouse-cursor: pointer; clicked => { S.t-notes-set(S.t-notes + (S.t-notes == "" ? "[[" : "\n[[")); nb.grab(); } }
                        }
                        VerticalLayout {
                            y: 30px; padding-left: 6px; padding-right: 6px; alignment: start;
                            if S.t-note-links.length == 0: Text { x: 10px; height: 32px; text: "Нет — напиши [[название]] в заметке"; font-size: 12px; color: G.faint; vertical-alignment: center; }
                            for n in S.t-note-links: Rectangle {
                                height: 32px; border-radius: 6px; background: nla.has-hover ? G.node-hover : transparent;
                                Rectangle { x: 8px; y: 13px; width: 6px; height: 6px; border-radius: 3px; background: n.hue; }
                                LabelHint { x: 22px; width: parent.width - 30px; height: parent.height; label: n.label; hint: n.hint; label-size: 13px; mono: true; hint-size: 9.5px; hint-spacing: 1px; hint-color: G.muted; }
                                nla := TouchArea { mouse-cursor: pointer; clicked => { S.t-close(); S.note-open(n.id); } }
                            }
                        }
                    }
                    // История
                    Card {
                        vertical-stretch: 1;
                        min-height: 80px;
                        CardHead { y: 0; text: "ИСТОРИЯ"; }
                        ScrollView {
                            y: 30px; height: parent.height - 36px;
                            content-height: hl.preferred-height;
                            hl := VerticalLayout {
                                alignment: start; spacing: 0;
                                for h in S.t-hist: Rectangle {
                                    height: 26px;
                                    Rectangle { x: 10px; y: 10px; width: 6px; height: 6px; border-radius: 3px; background: h.hue; }
                                    LabelHint { x: 24px; width: parent.width - 34px; height: parent.height; label: h.label; hint: h.hint; label-size: 12px; label-color: G.ink2; mono: true; hint-size: 10px; hint-color: G.muted; }
                                }
                                if S.t-hist.length == 0: Text { x: 10px; height: 26px; text: "Пока пусто"; font-size: 12px; color: G.faint; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
            // подвал
            Rectangle {
                y: root.H - 56px; height: 56px;
                Rectangle { y: 0; height: 1px; background: G.line; }
                Rectangle { x: 24px; y: 25px; width: 6px; height: 6px; border-radius: 3px; background: G.green; }
                Text { x: 38px; width: parent.width - 360px; text: S.t-saved.to-uppercase(); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.3px; color: G.grey; vertical-alignment: center; height: parent.height; overflow: elide; }
                HorizontalLayout {
                    x: parent.width - 24px - self.preferred-width; y: 11px; height: 34px; spacing: 10px;
                    Rectangle {
                        width: dt.preferred-width + 28px; border-radius: 8px; border-width: 1px; border-color: dla.has-hover ? G.red : G.line;
                        dt := Text { text: "Удалить"; font-size: 13px; color: dla.has-hover ? G.red : G.grey; horizontal-alignment: center; vertical-alignment: center; }
                        dla := TouchArea { clicked => { S.t-delete(); } mouse-cursor: pointer; }
                    }
                    if S.t-next-id != "": Rectangle {
                        width: nt.preferred-width + 48px; border-radius: 8px; background: nxa.has-hover ? G.accent-ink : G.accent;
                        nt := Text { x: 14px; text: S.t-next-name; font-size: 13px; font-weight: 600; color: G.bg; vertical-alignment: center; height: parent.height; }
                        Icon { x: parent.width - 26px; y: 11px; width: 12px; height: 12px; name: "next"; c: G.bg; }
                        nxa := TouchArea { clicked => { S.t-col(S.t-next-id); } mouse-cursor: pointer; }
                    }
                }
            }
            // меню ⋯
            // клик мимо закрывает выпадающий список
            if root.menu || root.pop > 0 || root.lists-open: TouchArea { x: -4000px; y: -4000px; width: 8000px; height: 8000px; z: 19; clicked => { root.menu = false; root.pop = 0; root.lists-open = false; } }
            if root.menu: Pop {
                from-right: true;
                x: root.W - 200px; y: 34px; width: 176px; height: 84px;
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009.transparentize(1 - G.shade);
                VerticalLayout {
                    padding: 5px;
                    for it[i] in ["Дублировать", "Удалить"]: Rectangle {
                        height: 36px; border-radius: 5px;
                        background: ia.has-hover ? G.node-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { name: i == 0 ? "copy" : "trash"; c: i == 1 ? G.red : G.muted; width: 14px; y: (parent.height - 14px) / 2; }
                            Text { text: it; font-size: 13px; color: i == 1 ? G.red : G.ink; vertical-alignment: center; }
                        }
                        ia := TouchArea { clicked => { root.menu = false; if (i == 0) { S.t-dup(); } else { S.t-delete(); } } mouse-cursor: pointer; }
                    }
                }
            }
            // выпадающий список: напоминания, приоритет или повтор — под своей строкой
            if root.pop > 0: Pop {
                property <length> base: root.top + (root.narrow ? 330px - mid.viewport-y * -1 : 0px);
                x: root.narrow ? 24px + 133px : root.W - 24px - root.RW + 133px;
                y: base + (root.pop == 1 ? 102px : root.pop == 2 ? 118px + 30px + 64px : 118px + 30px + 96px);
                width: min(200px, root.W - self.x - 16px);
                height: root.pop-items.length * 30px + 10px;
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009.transparentize(1 - G.shade);
                VerticalLayout {
                    padding: 5px;
                    for o in root.pop-items: Rectangle {
                        height: 30px; border-radius: 5px;
                        background: poa.has-hover ? G.node-hover : transparent;
                        Text { x: 10px; width: parent.width - 36px; text: o.label; font-size: 13px; color: o.on ? G.accent-ink : G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                        if o.on: Icon { x: parent.width - 24px; y: 8px; width: 14px; height: 14px; name: "check"; c: G.accent; }
                        poa := TouchArea {
                            clicked => {
                                if (root.pop == 1) { S.t-remind(o.id); }
                                else if (root.pop == 2) { S.t-prio-set(o.id.to-float()); root.pop = 0; }
                                else { S.t-repeat(o.id); root.pop = 0; }
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
            // выбор списка — под полем «Список», прижат к окну
            if root.lists-open: Pop {
                x: max(8px, root.W - 24px - root.RW + 100px - max(0px, 100px + 300px - root.RW));
                y: root.top + 118px + 30px + 32px;
                width: min(300px, root.W - 16px);
                height: min(260px, S.t-lists.length * 30px + 10px);
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009.transparentize(1 - G.shade);
                ScrollView {
                    content-height: lv.preferred-height;
                    lv := VerticalLayout {
                        padding: 5px;
                        for l in S.t-lists: Rectangle {
                            height: 30px; border-radius: 5px;
                            background: lia.has-hover ? G.node-hover : transparent;
                            Rectangle { x: 10px; y: 12px; width: 7px; height: 7px; border-radius: 1.5px; background: l.hue; }
                            LabelHint { x: 26px; width: parent.width - 36px; height: parent.height; label: l.label; hint: l.hint; label-color: l.on ? G.accent-ink : G.ink; label-size: 13px; }
                            lia := TouchArea { clicked => { root.lists-open = false; S.t-move(l.id); } }
                        }
                    }
                }
            }
        }
        Brackets { x: win.x; y: win.y; width: win.width; height: win.height; }
    }
    init => { fs.focus(); }
}
