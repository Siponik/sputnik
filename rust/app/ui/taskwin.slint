// Окно задачи (G_TaskFull, п.34, 36, 38): большое окно по центру, одно для всех видов доски.
// Шапка цвета сферы, название, полоса колонок, слева подзадачи и заметка, справа «Когда», «Свойства», «История».
import { G } from "theme.slint";
import { Field, Overlay, Brackets, Icon, Chev, ScrollInput, ScrollView } from "kit.slint";
import { S, Opt, Sub } from "store.slint";

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    height: 28px;
    width: ct.preferred-width + 22px;
    border-radius: 4px;
    border-width: 1px;
    border-color: on ? G.accent : G.line;
    background: on ? G.accent-wash : (ca.has-hover ? G.node-hover : transparent);
    ct := Text { x: 11px; text: root.text; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.2px; color: on ? G.accent-ink : #A3A5AE; vertical-alignment: center; height: parent.height; }
    ca := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component Cap inherits Text {
    font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px; color: #A3A5AE;
}

// полоса колонок: пройденные зелёные с днями, текущая оранжевая «N ДН · ИДЁТ», впереди серые; клик переносит
component StageBar inherits Rectangle {
    property <int> cur: -1;
    property <int> n: S.t-cols.length;
    property <length> cw: n > 6 ? max(130px, (self.width - (n - 1) * 4px) / max(1, n)) : (self.width - (n - 1) * 4px) / max(1, n);
    height: n * (cw + 4px) > self.width + 4px ? 54px : 42px;
    sv := ScrollView {
        content-width: n * (root.cw + 4px);
        content-height: root.height;
        for c[i] in S.t-cols: Rectangle {
            property <int> st: c.on ? 1 : (i < root.cur ? 0 : 2);
            init => { if (c.on) { root.cur = i; } }
            x: i * (root.cw + 4px); y: 0; width: root.cw; height: 40px;
            border-radius: 6px;
            background: st == 1 ? G.accent : st == 0 ? #2C3A2F : (ca.has-hover ? G.node-hover : transparent);
            border-width: st == 1 ? 0 : 1px;
            border-color: st == 0 ? #3F6B47 : #4A4B52;
            Text { x: 10px; y: 5px; width: parent.width - 20px; text: c.label; font-size: 13px; font-weight: st == 1 ? 600 : 400; color: st == 1 ? #1C1D21 : st == 0 ? G.green : #8A8C96; overflow: elide; }
            Text { x: 10px; y: 23px; width: parent.width - 20px; text: c.hint; font-family: G.mono; font-size: 9px; letter-spacing: 1.1px; color: st == 1 ? #1C1D21 : st == 0 ? G.green.transparentize(0.3) : #62646E; overflow: elide; }
            ca := TouchArea { clicked => { S.t-col(c.id); } mouse-cursor: pointer; }
        }
    }
}

export component TaskDialog inherits Overlay {
    property <bool> big;          // ⤢ — почти на весь экран
    property <bool> note-full;    // ⤢ у заметки — заметка на всё окно
    property <bool> menu;
    property <bool> lists-open;
    property <bool> done-open;
    property <bool> narrow: self.width < 1000px;
    property <length> W: big ? self.width - 48px : max(min(840px, self.width - 16px), min(1200px, self.width * 0.82));
    property <length> H: big ? self.height - 48px : max(min(560px, self.height - 16px), min(860px, self.height * 0.86));
    property <length> RW: 340px;
    property <length> top: S.t-cols.length > 1 ? 172px : 116px;
    property <length> mid-h: root.H - root.top - 56px;
    property <length> lw: root.narrow || root.note-full ? root.W - 48px : root.W - 48px - root.RW - 24px;
    close => { S.t-close(); }
    function pick-link(title: string) {
        nb.text = S.link-insert(nb.text, title);
        S.t-notes-set(nb.text);
        S.link-search(nb.text);
        nb.grab();
        nb.to-end();
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (root.note-full) { root.note-full = false; return accept; }
                S.t-close(); return accept;
            }
            reject
        }
        win := Rectangle {
            x: (parent.width - root.W) / 2;
            y: (parent.height - root.H) / 2;
            width: root.W; height: root.H;
            border-radius: 12px;
            background: G.node;
            border-width: 1px;
            border-color: G.accent-line;
            drop-shadow-blur: 30px; drop-shadow-color: #000c;
            TouchArea { }
            // шапка цвета сферы
            Rectangle {
                y: 0; height: 36px;
                border-top-left-radius: 12px; border-top-right-radius: 12px;
                background: S.t-hue.mix(#1C1D21, 0.55);
                Text { x: 16px; width: parent.width - 140px; text: S.t-path; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; overflow: elide; }
                HorizontalLayout {
                    x: parent.width - 108px; width: 96px; height: parent.height; spacing: 6px; alignment: end;
                    for b[i] in ["more", "expand", "close"]: Rectangle {
                        width: 28px;
                        Icon { x: 6px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; name: b; c: ba.has-hover ? #fff : #ffffffb0; }
                        ba := TouchArea { clicked => { if (i == 0) { root.menu = !root.menu; } else if (i == 1) { root.big = !root.big; } else { S.t-close(); } } mouse-cursor: pointer; }
                    }
                }
            }
            // заголовок
            Rectangle {
                x: 24px; y: 48px; width: parent.width - 48px; height: 36px;
                ti := TextInput {
                    x: 0; width: parent.width - 60px; height: parent.height;
                    text: S.t-title; font-size: 24px; font-weight: 600; color: G.ink;
                    single-line: true; vertical-alignment: center;
                    selection-background-color: G.accent-line;
                    edited => { S.t-title-set(self.text); }
                }
                if S.t-prio > 0: Text { x: parent.width - self.preferred-width; text: S.t-prio == 1 ? "!!!" : S.t-prio == 2 ? "!!" : "!"; font-family: G.mono; font-size: 16px; font-weight: 700; color: S.t-prio == 1 ? G.accent : G.ink; vertical-alignment: center; height: parent.height; }
            }
            Text { x: 24px; y: 86px; width: parent.width - 48px; text: S.t-meta; font-family: G.mono; font-size: 10px; letter-spacing: 1.1px; color: #8A8C96; overflow: elide; }
            // полоса колонок
            if S.t-cols.length > 1: StageBar { x: 24px; y: 110px; width: parent.width - 48px; }
            // середина
            mid := ScrollView {
                x: 0; y: root.top; width: parent.width; height: root.mid-h;
                content-height: root.narrow && !root.note-full ? 300px + 24px + 640px : root.mid-h;
                // левая колонка: подзадачи (не больше 40 %) и заметка до подвала
                property <length> lh: root.narrow && !root.note-full ? 300px : root.mid-h - 8px;
                property <length> sub-h: root.note-full ? 0px : min(lh * 0.4, 36px + max(1, S.t-subs-open.length) * 30px + 30px + (S.t-subs-done > 0 ? 28px : 0px) + (root.done-open ? S.t-subs-donelist.length * 30px : 0px));
                if !root.note-full: Rectangle {
                    x: 24px; y: 0; width: root.lw; height: sub-h;
                    Cap { x: 0; y: 0; height: 20px; text: "ПОДЗАДАЧИ" + (S.t-subs.length > 0 ? " · " + S.t-subs-done + " ИЗ " + S.t-subs.length : ""); }
                    if S.t-subs.length > 0: Rectangle {
                        x: 0; y: 24px; width: parent.width; height: 3px; border-radius: 1.5px; background: #45464D;
                        Rectangle { x: 0; width: parent.width * S.t-subs-done / max(1, S.t-subs.length); border-radius: 1.5px; background: G.green; }
                    }
                    ScrollView {
                        x: 0; y: 34px; width: parent.width; height: parent.height - 34px;
                        content-height: sl.preferred-height;
                        sl := VerticalLayout {
                            spacing: 0; alignment: start;
                            for sb in S.t-subs-open: Rectangle {
                                height: 30px;
                                Icon { x: 0; y: 7px; width: 16px; height: 16px; name: "drag"; c: #55575F; }
                                Rectangle {
                                    x: 22px; y: 8px; width: 14px; height: 14px; border-radius: 3px;
                                    border-width: 1px; border-color: #7C7E88;
                                    TouchArea { clicked => { S.t-sub-toggle(sb.id); } mouse-cursor: pointer; }
                                }
                                Text { x: 46px; width: parent.width - 56px; text: sb.title; color: G.ink; font-size: 13.5px; vertical-alignment: center; height: parent.height; overflow: elide; }
                                Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                            }
                            Field { height: 30px; bare: true; font-size: 13px; placeholder: "+ подзадача · Enter"; accepted(t) => { if (t != "") { S.t-sub-add(t); self.clear(); } } }
                            if S.t-subs-done > 0: Rectangle {
                                height: 28px;
                                HorizontalLayout {
                                    spacing: 6px; alignment: start;
                                    Icon { y: 7px; width: 14px; height: 14px; name: "check"; c: G.green; }
                                    Text { text: "сделано " + S.t-subs-done; font-size: 12.5px; color: #8A8C96; vertical-alignment: center; }
                                    Chev { y: 9px; up: root.done-open; c: #8A8C96; }
                                }
                                TouchArea { clicked => { root.done-open = !root.done-open; } mouse-cursor: pointer; }
                            }
                            if root.done-open: VerticalLayout {
                                for sb in S.t-subs-donelist: Rectangle {
                                    height: 30px;
                                    Rectangle {
                                        x: 22px; y: 8px; width: 14px; height: 14px; border-radius: 3px; background: #3D3E45;
                                        Icon { name: "check"; width: 9px; x: 2.5px; y: 2.5px; c: G.ink; }
                                        TouchArea { clicked => { S.t-sub-toggle(sb.id); } mouse-cursor: pointer; }
                                    }
                                    dn := Text { x: 46px; width: parent.width - 56px; text: sb.title; color: G.dim; font-size: 13.5px; vertical-alignment: center; height: parent.height; overflow: elide; }
                                    Rectangle { x: 46px; y: 15px; height: 1px; width: min(dn.preferred-width, parent.width - 56px); background: G.dim; }
                                }
                            }
                        }
                    }
                }
                // заметка
                Rectangle {
                    x: 24px; y: sub-h + (root.note-full ? 0 : 12px); width: root.lw; height: lh - sub-h - (root.note-full ? 0 : 12px);
                    border-radius: 8px; background: #2A2B30; border-width: 1px; border-color: nb.focused ? G.accent-line : G.line;
                    Cap { x: 12px; y: 0; height: 32px; vertical-alignment: center; text: "ЗАМЕТКА"; }
                    Rectangle {
                        x: parent.width - 32px; y: 4px; width: 24px; height: 24px;
                        Icon { x: 4px; y: 4px; width: 16px; height: 16px; name: root.note-full ? "minimize" : "expand"; c: na.has-hover ? G.ink : #8A8C96; }
                        na := TouchArea { clicked => { root.note-full = !root.note-full; } mouse-cursor: pointer; }
                    }
                    property <length> lk-h: S.t-links.length > 0 ? 34px : 0px;
                    nb := ScrollInput {
                        x: 12px; y: 32px; width: parent.width - 24px; height: parent.height - 40px - lk-h;
                        text: S.t-notes; font-size: 13.5px;
                        enter-grab: S.link-found.length > 0;
                        edited(t) => { S.t-notes-set(t); S.link-search(t); }
                        enter => { root.pick-link(S.link-found[0].label); }
                    }
                    // ссылки на «Знания» плашками: клик открывает заметку
                    if S.t-links.length > 0: HorizontalLayout {
                        x: 12px; y: parent.height - 32px; height: 24px; width: parent.width - 24px;
                        spacing: 6px; alignment: start;
                        for lk in S.t-links: Rectangle {
                            width: min(220px, lt.preferred-width + 34px);
                            border-radius: 4px;
                            background: lka.has-hover ? G.accent-line : G.accent-wash;
                            Icon { x: 7px; y: 5px; width: 14px; height: 14px; name: "read"; c: G.accent; }
                            lt := Text { x: 26px; width: parent.width - 32px; text: lk.label; font-size: 12px; color: lk.id == "" ? #8A8C96 : G.accent; vertical-alignment: center; height: parent.height; overflow: elide; }
                            lka := TouchArea { clicked => { if (lk.id != "") { S.t-close(); S.note-open(lk.id); } } mouse-cursor: pointer; }
                        }
                    }
                    // подсказка после «[[»: поиск по «Знаниям», Enter или клик вставляет ссылку
                    if S.link-found.length > 0 && nb.focused: Rectangle {
                        x: 12px; y: 32px; width: min(320px, parent.width - 24px); height: min(5, S.link-found.length) * 30px + 10px;
                        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.accent-line;
                        drop-shadow-blur: 16px; drop-shadow-color: #0009;
                        VerticalLayout {
                            padding: 5px;
                            for f[i] in S.link-found: Rectangle {
                                visible: i < 5;
                                height: i < 5 ? 30px : 0px;
                                border-radius: 5px;
                                background: i == 0 || fa.has-hover ? G.node-hover : transparent;
                                Icon { x: 8px; y: 8px; width: 14px; height: 14px; name: "read"; c: G.accent; }
                                Text { x: 30px; width: parent.width - 40px; text: f.label; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                                fa := TouchArea { clicked => { root.pick-link(f.label); } mouse-cursor: pointer; }
                            }
                        }
                    }
                }
                // правая колонка (в узком окне — под левой)
                if !root.note-full: VerticalLayout {
                    x: root.narrow ? 24px : root.W - 24px - root.RW;
                    y: root.narrow ? 324px : 0;
                    width: root.narrow ? root.W - 48px : root.RW;
                    height: root.narrow ? 620px : root.mid-h - 8px;
                    spacing: 14px;
                    // Когда
                    VerticalLayout {
                        spacing: 8px;
                        Cap { text: "КОГДА"; }
                        HorizontalLayout {
                            spacing: 6px; alignment: start;
                            Rectangle {
                                height: 32px; width: dl.preferred-width + 44px;
                                border-radius: 6px; border-width: 1px; border-color: da.has-hover ? G.accent : G.line;
                                Icon { x: 10px; y: 8px; width: 16px; height: 16px; name: "calendar"; c: #A3A5AE; }
                                dl := Text { x: 32px; text: S.t-due-label == "" ? "Без срока" : S.t-due-label; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; }
                                da := TouchArea { clicked => { S.dp-open-task(); } mouse-cursor: pointer; }
                            }
                        }
                        Cap { text: "НАПОМНИТЬ"; color: #7A7C86; }
                        Rectangle {
                            height: ceil(S.t-reminds.length / 3) * 32px;
                            for r[i] in S.t-reminds: Chip {
                                x: mod(i, 3) * (parent.width / 3); y: floor(i / 3) * 32px; width: parent.width / 3 - 4px;
                                text: r.label.to-uppercase(); on: r.on;
                                clicked => { S.t-remind(r.id); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: G.line; }
                    // Свойства
                    VerticalLayout {
                        spacing: 8px;
                        Cap { text: "СВОЙСТВА"; }
                        HorizontalLayout {
                            height: 30px; spacing: 8px;
                            Icon { y: 7px; width: 16px; height: 16px; name: "board"; c: #8A8C96; }
                            Text { width: 84px; text: "Список"; font-size: 12.5px; color: #9A9CA6; vertical-alignment: center; }
                            Rectangle {
                                border-radius: 6px; border-width: 1px; border-color: la.has-hover || root.lists-open ? G.accent : G.line;
                                Text { x: 10px; width: parent.width - 34px; text: S.t-list-name; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                                Chev { x: parent.width - 20px; y: 10px; up: root.lists-open; }
                                la := TouchArea { clicked => { root.lists-open = !root.lists-open; } mouse-cursor: pointer; }
                            }
                        }
                        HorizontalLayout {
                            height: 30px; spacing: 8px;
                            Icon { y: 7px; width: 16px; height: 16px; name: "priority"; c: #8A8C96; }
                            Text { width: 84px; text: "Приоритет"; font-size: 12.5px; color: #9A9CA6; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 4px; alignment: start;
                                for p[i] in ["!!!", "!!", "!", "—"]: Chip {
                                    y: 1px; width: 40px;
                                    text: p; on: (i < 3 && S.t-prio == i + 1) || (i == 3 && S.t-prio == 0);
                                    clicked => { S.t-prio-set(i == 3 ? 0 : i + 1); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Icon { y: 7px; width: 16px; height: 16px; name: "repeat"; c: #8A8C96; }
                            Text { width: 84px; height: 30px; text: "Повтор"; font-size: 12.5px; color: #9A9CA6; vertical-alignment: center; }
                            Rectangle {
                                height: ceil(S.t-repeats.length / 3) * 32px;
                                for r[i] in S.t-repeats: Chip {
                                    x: mod(i, 3) * (parent.width / 3); y: floor(i / 3) * 32px; width: parent.width / 3 - 4px;
                                    text: r.label.to-uppercase(); on: r.on;
                                    clicked => { S.t-repeat(r.id); }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: G.line; }
                    // История
                    VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;
                        Cap { text: "ИСТОРИЯ"; }
                        ScrollView {
                            min-height: 60px;
                            vertical-stretch: 1;
                            content-height: hl.preferred-height;
                            hl := VerticalLayout {
                                alignment: start; spacing: 0;
                                for h in S.t-hist: Rectangle {
                                    height: 26px;
                                    Rectangle { x: 2px; y: 10px; width: 6px; height: 6px; border-radius: 3px; background: h.hue; }
                                    Text { x: 16px; width: parent.width - 120px; text: h.label; font-size: 12.5px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                                    Text { x: parent.width - self.preferred-width - 16px; text: h.hint; font-family: G.mono; font-size: 9.5px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
                                }
                                if S.t-hist.length == 0: Text { text: "Пока пусто"; font-size: 12.5px; color: #62646E; }
                            }
                        }
                    }
                }
            }
            // подвал
            Rectangle {
                y: root.H - 56px; height: 56px;
                Rectangle { y: 0; height: 1px; background: G.line; }
                Rectangle { x: 24px; y: 25px; width: 6px; height: 6px; border-radius: 3px; background: G.green; }
                Text { x: 38px; width: parent.width - 360px; text: S.t-saved.to-uppercase(); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.3px; color: #A3A5AE; vertical-alignment: center; height: parent.height; overflow: elide; }
                HorizontalLayout {
                    x: parent.width - 24px - self.preferred-width; y: 11px; height: 34px; spacing: 10px;
                    Rectangle {
                        width: dt.preferred-width + 28px; border-radius: 8px; border-width: 1px; border-color: dla.has-hover ? G.red : G.line;
                        dt := Text { text: "Удалить"; font-size: 13px; color: dla.has-hover ? G.red : #A3A5AE; horizontal-alignment: center; vertical-alignment: center; }
                        dla := TouchArea { clicked => { S.t-delete(); } mouse-cursor: pointer; }
                    }
                    if S.t-next-id != "": Rectangle {
                        width: nt.preferred-width + 48px; border-radius: 8px; background: nxa.has-hover ? G.accent-ink : G.accent;
                        nt := Text { x: 14px; text: S.t-next-name; font-size: 13px; font-weight: 600; color: #1C1D21; vertical-alignment: center; height: parent.height; }
                        Icon { x: parent.width - 26px; y: 11px; width: 12px; height: 12px; name: "next"; c: #1C1D21; }
                        nxa := TouchArea { clicked => { S.t-col(S.t-next-id); } mouse-cursor: pointer; }
                    }
                }
            }
            // меню ⋯
            if root.menu: Rectangle {
                x: root.W - 200px; y: 34px; width: 176px; height: 84px;
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009;
                VerticalLayout {
                    padding: 5px;
                    for it[i] in ["Дублировать", "Удалить"]: Rectangle {
                        height: 36px; border-radius: 5px;
                        background: ia.has-hover ? G.node-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { name: i == 0 ? "copy" : "trash"; c: i == 1 ? G.red : G.muted; width: 14px; y: (parent.height - 14px) / 2; }
                            Text { text: it; font-size: 13px; color: i == 1 ? G.red : G.ink; vertical-alignment: center; }
                        }
                        ia := TouchArea { clicked => { root.menu = false; if (i == 0) { S.t-dup(); } else { S.t-delete(); } } mouse-cursor: pointer; }
                    }
                }
            }
            // выбор списка — под полем «Список», прижат к окну
            if root.lists-open: Rectangle {
                x: max(8px, root.W - 24px - root.RW + 100px - max(0px, 100px + 300px - root.RW));
                y: root.top + 150px;
                width: min(300px, root.W - 16px);
                height: min(260px, S.t-lists.length * 30px + 10px);
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009;
                ScrollView {
                    content-height: lv.preferred-height;
                    lv := VerticalLayout {
                        padding: 5px;
                        for l in S.t-lists: Rectangle {
                            height: 30px; border-radius: 5px;
                            background: lia.has-hover ? G.node-hover : transparent;
                            Rectangle { x: 10px; y: 12px; width: 7px; height: 7px; border-radius: 1.5px; background: l.hue; }
                            Text { x: 26px; width: parent.width - 90px; text: l.label; color: l.on ? G.accent-ink : G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; overflow: elide; }
                            Text { x: parent.width - self.preferred-width - 10px; text: l.hint; color: #7A7C86; font-size: 11px; vertical-alignment: center; height: parent.height; }
                            lia := TouchArea { clicked => { root.lists-open = false; S.t-move(l.id); } }
                        }
                    }
                }
            }
        }
        Brackets { x: win.x; y: win.y; width: win.width; height: win.height; }
    }
    init => { fs.focus(); }
}
