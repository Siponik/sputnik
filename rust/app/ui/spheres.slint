// Сферы (G_Spheres, п.40): обзор сфер, правка выбранной справа; вкладка архива «Сферы и списки» (G_Archive, п.41).
import { G } from "theme.slint";
import { Field, Brackets, ScrollView, Icon, Sat } from "kit.slint";
import { S, SphList } from "store.slint";

// Кнопка макета: acc — оранжевая, sec — с рамкой, ghost — без рамки; sm — 28px.
export component GBtn inherits Rectangle {
    in property <string> text;
    in property <string> kind: "sec";
    in property <bool> sm;
    in property <color> ink: G.ink;
    callback clicked;
    height: sm ? 28px : 32px;
    width: bt.preferred-width + 24px;
    border-radius: 6px;
    background: kind == "acc" ? (ba.has-hover ? G.accent-ink : G.accent) : (ba.has-hover ? G.node-hover : transparent);
    border-width: kind == "sec" ? 1px : 0;
    border-color: G.line-strong;
    bt := Text { text: root.text; font-size: sm ? 12.5px : 13px; font-weight: kind == "acc" ? 600 : 500;
        color: kind == "acc" ? #1C1D21 : kind == "ghost" && root.ink == G.ink ? G.muted : root.ink; horizontal-alignment: center; vertical-alignment: center; }
    ba := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Буква вида списка в квадратике: К / С / Л.
component Kind inherits Rectangle {
    in property <string> t;
    width: 16px; height: 16px;
    border-radius: 4px; border-width: 1px; border-color: G.line;
    Text { text: root.t; font-family: G.mono; font-size: 9px; font-weight: 500; color: G.muted; horizontal-alignment: center; vertical-alignment: center; }
}

component SphNode inherits Rectangle {
    in property <string> sid;
    in property <string> name;
    in property <color> head;
    in property <string> aside;
    in property <bool> sel;
    in property <[SphList]> lists;
    property <bool> adding;
    height: 30px + 16px + (lists.length + 1) * 32px;
    nd := Rectangle {
        border-radius: 8px; background: G.node; border-width: 1px; border-color: root.sel ? G.accent-line : G.line; clip: true;
        Rectangle {
            y: 0; height: 30px; background: root.head;
            Text { x: 12px; text: root.name; font-family: G.mono; font-size: 10.5px; font-weight: 500; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; height: parent.height; width: parent.width - 120px; overflow: elide; }
            Text { x: parent.width - self.width - 34px; text: root.aside; font-family: G.mono; font-size: 10.5px; letter-spacing: 1.5px; color: #ffffffd0; vertical-alignment: center; height: parent.height; }
            Text { x: parent.width - 26px; width: 18px; text: "···"; font-size: 13px; color: #fff; horizontal-alignment: center; vertical-alignment: center; height: parent.height;
                TouchArea { clicked => { S.menu-ctx("sphere", root.sid, self.absolute-position.x, self.absolute-position.y + 22px); } mouse-cursor: pointer; } }
            TouchArea { width: parent.width - 30px; x: 0; clicked => { S.sph-show(root.sid); } mouse-cursor: pointer;
                pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("sphere", root.sid, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
        }
        VerticalLayout {
            y: 30px; height: parent.height - 30px;
            padding: 8px;
            alignment: start;
            for l in root.lists: Rectangle {
                height: 32px; border-radius: 6px;
                background: la.has-hover ? G.node-hover : transparent;
                Kind { x: 6px; y: 8px; t: l.letter; }
                Text { x: 30px; width: parent.width - 70px; text: l.name; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                Text { x: parent.width - self.width - 6px; text: l.count; font-family: G.mono; font-size: 10.5px; color: G.muted; vertical-alignment: center; height: parent.height; }
                la := TouchArea { clicked => { S.sph-close(); S.pick-list(l.id); } mouse-cursor: pointer;
                    pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("list", l.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
            }
            Rectangle {
                height: 32px;
                if !root.adding: Text { x: 6px; text: @tr("＋ Список"); font-size: 13px; color: aa.has-hover ? G.ink : G.muted; vertical-alignment: center; height: parent.height;
                    aa := TouchArea { clicked => { root.adding = true; } mouse-cursor: pointer; } }
                if root.adding: Field { x: 0; y: 1px; height: 30px; width: parent.width; font-size: 13px; placeholder: @tr("Название списка · Enter");
                    init => { self.grab(); }
                    accepted(t) => { if (t != "") { S.sph-add-list(root.sid, t); } root.adding = false; }
                    escape => { root.adding = false; } }
            }
        }
    }
    if root.sel: Brackets { x: nd.x; y: nd.y; width: nd.width; height: nd.height; }
}

component Label inherits Text { font-size: 12.5px; font-weight: 500; color: G.muted; }

component SphEditor inherits Rectangle {
    property <int> ci: S.sph-ecolor;
    property <string> eid: S.sph-edit;
    changed eid => { root.ci = S.sph-ecolor; nf.text = S.sph-ename; }
    property <bool> adding: S.sph-add;
    height: 32px + ev.preferred-height;
    border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
    Rectangle {
        y: 0; height: 32px; background: S.sph-ehead;
        Text { x: 12px; text: @tr("СФЕРА · ПРАВКА"); font-family: G.mono; font-size: 10.5px; font-weight: 500; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; height: parent.height; }
        Text { x: parent.width - self.width - 12px; text: "ESC"; font-family: G.mono; font-size: 10.5px; letter-spacing: 1.5px; color: #ffffffd0; vertical-alignment: center; height: parent.height;
            TouchArea { clicked => { S.sph-show(""); } mouse-cursor: pointer; } }
    }
    ev := VerticalLayout {
        y: 32px;
        padding-left: 18px; padding-right: 18px; padding-top: 16px; padding-bottom: 16px;
        spacing: 18px;
        VerticalLayout { spacing: 8px;
            Label { text: @tr("Название"); }
            nf := Field { height: 38px; font-size: 14px; text: S.sph-ename; accepted(t) => { S.sph-save(t, root.ci); } escape => { S.sph-show(""); } }
        }
        VerticalLayout { spacing: 8px;
            Label { text: @tr("Цвет шапки"); }
            HorizontalLayout { spacing: 6px; alignment: start; height: 34px;
                for c[i] in S.sph-colors: Rectangle {
                    width: 34px; height: 34px;
                    border-radius: 10px; border-width: i == root.ci ? 2px : 0; border-color: G.accent;
                    Rectangle { x: 3px; y: 3px; width: 28px; height: 28px; border-radius: 8px; background: c; }
                    TouchArea { clicked => { root.ci = i; } mouse-cursor: pointer; }
                }
            }
        }
        VerticalLayout { spacing: 8px;
            Label { text: @tr("Списки в сфере"); }
            VerticalLayout { spacing: 6px;
                for row in S.sph-erows: HorizontalLayout { spacing: 6px; alignment: start; height: 30px;
                    for o in row.items: Rectangle {
                        width: ct.preferred-width + 24px; border-radius: 8px;
                        background: G.accent-wash; border-width: 1px; border-color: G.accent;
                        ct := Text { text: o.label; font-size: 13px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { S.sph-close(); S.pick-list(o.id); } mouse-cursor: pointer; }
                    }
                    if row.last && !root.adding: Rectangle {
                        width: at.preferred-width + 24px; border-radius: 8px; border-width: 1px; border-color: G.line;
                        background: aa.has-hover ? G.node-hover : transparent;
                        at := Text { text: @tr("＋ Добавить"); font-size: 13px; color: #C9CAD0; horizontal-alignment: center; vertical-alignment: center; }
                        aa := TouchArea { clicked => { root.adding = true; } mouse-cursor: pointer; }
                    }
                }
                if root.adding: Field { height: 30px; font-size: 13px; placeholder: @tr("Название списка · Enter");
                    init => { self.grab(); }
                    accepted(t) => { if (t != "") { S.sph-add-list(S.sph-edit, t); } root.adding = false; }
                    escape => { root.adding = false; } }
            }
        }
        VerticalLayout { spacing: 8px;
            Label { text: @tr("Вместе с другими"); }
            HorizontalLayout { spacing: 6px; alignment: start;
                Text { text: S.sph-people; font-size: 12.5px; color: G.muted; vertical-alignment: center; }
            }
        }
        VerticalLayout { spacing: 10px;
            Rectangle { height: 5px; Rectangle { y: 4px; height: 1px; background: G.line; } }
            HorizontalLayout { spacing: 8px; height: 32px;
                GBtn { text: @tr("Сохранить"); kind: "acc"; clicked => { S.sph-save(nf.text, root.ci); } }
                if !S.sph-shared: GBtn { text: @tr("В архив"); clicked => { S.sph-archive("sphere", S.sph-edit, true); } }
                Rectangle { }
                GBtn { text: @tr("Удалить"); kind: "ghost"; ink: G.red; clicked => { S.sph-delete("sphere", S.sph-edit); } }
            }
            Text { text: @tr("В архиве сфера со всеми списками пропадает из колонки, «Сегодня», доски и календаря. Задачи остаются в Google, вернуть можно в любой момент.");
                font-size: 12px; color: G.dim; wrap: word-wrap; min-height: 70px; }
        }
    }
}

export component SpheresPage inherits Rectangle {
    property <length> cw: 324px;
    property <bool> ed: S.sph-edit != "";
    // шапка
    Rectangle {
        x: 0; y: 0; width: 2 * root.cw + 20px; height: 48px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        Text { x: 12px; text: @tr("Сферы"); font-size: 15px; font-weight: 600; color: G.ink; vertical-alignment: center; height: parent.height; }
        Text { x: 76px; text: S.sph-info; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.1px; color: G.muted; vertical-alignment: center; height: parent.height; }
        GBtn { x: parent.width - self.width - 12px; y: 10px; sm: true; kind: "acc"; text: @tr("＋ Сфера"); clicked => { S.sph-new(); } }
    }
    ScrollView {
        x: 0; y: 64px; width: 2 * root.cw + 28px; height: parent.height - 64px;
        VerticalLayout {
            alignment: start;
            spacing: 20px;
            padding-right: 8px; padding-top: 6px; padding-left: 0;
            HorizontalLayout {
                spacing: 20px; alignment: start;
                VerticalLayout {
                    width: root.cw; spacing: 20px; alignment: start;
                    for sp in S.sph-cards-l: SphNode { sid: sp.id; name: sp.name; head: sp.head; aside: sp.aside; sel: sp.sel; lists: sp.lists; }
                }
                VerticalLayout {
                    width: root.cw; spacing: 20px; alignment: start;
                    for sp in S.sph-cards-r: SphNode { sid: sp.id; name: sp.name; head: sp.head; aside: sp.aside; sel: sp.sel; lists: sp.lists; }
                }
            }
            if S.sph-arch.length > 0: an := Rectangle {
                property <int> n: S.sph-arch.length;
                height: 30px + 12px + min(3, self.n) * 36px + 8px;
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
                Rectangle { y: 0; height: 30px; background: #3D3E45;
                    Text { x: 12px; text: @tr("В АРХИВЕ"); font-family: G.mono; font-size: 10.5px; font-weight: 500; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; height: parent.height; }
                    Text { x: parent.width - self.width - 12px; text: an.n; font-family: G.mono; font-size: 10.5px; color: #ffffffd0; vertical-alignment: center; height: parent.height; } }
                VerticalLayout { y: 36px; padding-left: 12px; padding-right: 12px; alignment: start;
                    for a[i] in S.sph-arch3: Rectangle { height: 36px;
                        Rectangle { y: 14px; width: 8px; height: 8px; x: 0; border-radius: 2px; background: a.head.brighter(0.6); }
                        Text { x: 18px; text: a.name; font-size: 13px; color: #C9CAD0; vertical-alignment: center; height: parent.height; width: parent.width - 330px; overflow: elide; }
                        Text { x: parent.width - 312px; width: 110px; horizontal-alignment: right; text: (a.kind == "sphere" ? @tr("СФЕРА") : @tr("СПИСОК")) + " · " + a.date.to-uppercase(); font-family: G.mono; font-size: 10.5px; color: G.muted; vertical-alignment: center; height: parent.height; }
                        GBtn { x: parent.width - 192px; y: 4px; sm: true; text: @tr("Вернуть"); clicked => { S.sph-archive(a.kind, a.id, false); } }
                        if i == 0: GBtn { x: parent.width - self.width; y: 4px; sm: true; kind: "ghost"; text: @tr("Весь архив"); clicked => { S.sph-close(); S.open-archive(); S.arch-tab-set(1); } }
                    }
                }
            }
        }
    }
    if root.ed: SphEditor { x: 2 * root.cw + 44px; y: 70px; width: 320px; }
}

// Вкладка архива «Сферы и списки».
export component ArchSpheres inherits Rectangle {
    ScrollView {
        VerticalLayout {
            alignment: start;
            for r in S.sph-arch: VerticalLayout {
                if r.first: Text { height: 40px; x: 16px; text: r.group; font-size: 12.5px; color: G.muted; vertical-alignment: bottom; }
                if r.first: Rectangle { height: 6px; }
                HorizontalLayout { padding-left: 8px; padding-right: 8px;
                Rectangle {
                    height: 48px;
                    Rectangle { x: 10px; y: 13px; width: 22px; height: 22px; border-radius: 6px; background: r.head;
                        Text { text: r.letter; font-family: G.mono; font-size: 9px; font-weight: 500; color: #fff; horizontal-alignment: center; vertical-alignment: center; } }
                    Text { x: 46px; y: 7px; width: parent.width - 320px; text: r.name; font-size: 13.5px; color: G.ink; overflow: elide; }
                    Text { x: 46px; y: 26px; width: parent.width - 320px; text: r.meta; font-size: 12px; color: G.muted; overflow: elide; }
                    Text { x: parent.width - 244px; text: r.date; font-family: G.mono; font-size: 11px; color: G.muted; vertical-alignment: center; height: parent.height; }
                    GBtn { x: parent.width - 150px; y: 10px; sm: true; text: @tr("Вернуть"); clicked => { S.sph-archive(r.kind, r.id, false); } }
                    GBtn { x: parent.width - 52px; y: 10px; sm: true; kind: "ghost"; text: "···"; clicked => { S.sph-delete(r.kind, r.id); } }
                    Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                } }
            }
            Rectangle {
                height: 90px;
                Rectangle {
                    x: 16px; y: 16px; width: parent.width - 32px; height: 62px;
                    border-radius: 8px; border-width: 1px; border-color: #55575F;
                    Sat { x: 12px; y: 12px; width: 38px; height: 38px; c: G.gold; }
                    Text { x: 60px; width: parent.width - 72px; text: S.sph-arch.length == 0 ? @tr("Сфер и списков в архиве нет. Убрать их сюда — правой кнопкой по сфере или списку → «В архив».") : @tr("Сфера в архиве не видна нигде, кроме этой вкладки. Задачи из неё не удаляются из Google. «Удалить навсегда» — в меню ···.");
                        font-size: 12.5px; color: #C9CAD0; vertical-alignment: center; height: parent.height; wrap: word-wrap; }
                }
            }
        }
    }
}
