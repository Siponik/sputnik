// Заметка со ссылками на «Знания»: после «[[» — подсказка (Enter или клик вставляет),
// ниже — плашки ссылок, клик открывает заметку. Одна на все окна с заметкой.
// Пока поле не в фокусе, текст показан как markdown (заголовки, списки, жирный, ссылки); клик — правка.

// Строка таблицы markdown: ячейки поровну по ширине, рамки как у нод; заголовок — жирнее и на подложке.
export component TableRow inherits Rectangle {
    in property <string> raw;
    in property <bool> head;
    in property <length> fs: 13.5px;
    property <[MdRow]> cells: S.table-cells(raw);
    // все ячейки одной ширины, строка — в одну линию текста
    property <length> cw: root.width / max(1, root.cells.length);
    out property <length> row-h: root.fs * 1.5 + 10px;
    background: head ? G.bg : transparent;
    border-width: 1px; border-color: G.line;
    for c[i] in root.cells: Rectangle {
        x: i * root.cw; y: 0; width: root.cw; height: root.height;
        if i > 0: Rectangle { x: 0; width: 1px; background: G.line; }
        ct := StyledText {
            x: 9px; y: 5px; width: parent.width - 18px; height: parent.height - 10px;
            text: c.md; default-font-size: root.fs; default-color: root.head ? G.ink : #D4D5DA; link-color: G.accent;
        }
    }
}

export component MdLine inherits Rectangle {
    in property <MdRow> line;
    in property <length> fs;
    property <bool> h: line.kind == "h1" || line.kind == "h2" || line.kind == "h3";
    property <length> size: line.kind == "h1" ? fs * 1.45 : line.kind == "h2" ? fs * 1.25 : line.kind == "h3" ? fs * 1.1 : fs;
    property <length> ind: line.kind == "quote" ? 12px : (line.kind == "li" || line.kind == "todo" || line.kind == "done" ? 16px : 0);
    height: line.kind == "empty" ? fs * 0.8 : (line.kind == "hr" ? 12px : (line.kind == "fence" || line.kind == "tsep" ? (line.kind == "tsep" ? 0 : 2px) : (line.kind == "table" || line.kind == "th" ? tr.row-h - 1px : st.preferred-height + (h ? 4px : 2px))));
    tr := TableRow { visible: line.kind == "table" || line.kind == "th"; y: 0; height: self.row-h; raw: line.raw; head: line.kind == "th"; fs: root.fs * 0.95; }
    if line.kind == "hr": Rectangle { y: 6px; height: 1px; background: G.line; }
    if line.kind == "quote": Rectangle { x: 0; width: 3px; border-radius: 1.5px; background: G.accent; }
    if line.kind == "li": Rectangle { x: 4px; y: size * 0.6 - 2px; width: 5px; height: 5px; border-radius: 2.5px; background: G.muted; }
    if line.kind == "todo" || line.kind == "done": Rectangle {
        x: 0; y: size * 0.6 - 5.5px; width: 11px; height: 11px; border-radius: 2px;
        border-width: 1.2px; border-color: line.kind == "done" ? G.accent : G.muted; background: line.kind == "done" ? G.accent : transparent;
    }
    if line.kind == "code": Rectangle { background: G.bg; border-radius: 4px; }
    st := StyledText {
        visible: line.kind != "empty" && line.kind != "hr" && line.kind != "fence" && line.kind != "table" && line.kind != "th" && line.kind != "tsep";
        x: root.ind + (line.kind == "code" ? 6px : 0); y: h ? 2px : 1px; width: parent.width - self.x;
        text: line.md;
        default-font-size: root.size;
        default-font-family: line.kind == "code" ? G.mono : G.sans;
        default-color: line.kind == "done" ? G.muted : (line.kind == "code" ? G.gold : (line.kind == "quote" ? #B9BBC4 : G.ink));
        link-color: G.accent;
    }
}
import { G } from "theme.slint";
import { ScrollInput, Icon } from "kit.slint";
import { S, Opt, MdRow } from "store.slint";
import { ScrollView } from "kit.slint";

export component LinkNote inherits Rectangle {
    in-out property <string> text <=> nb.text;
    in property <length> font-size: 13px;
    out property <bool> focused: nb.focused;
    callback edited(string);
    callback escape();
    callback opened();
    public function grab() { nb.grab(); }
    property <[Opt]> chips: S.link-chips(nb.text);
    property <length> lk-h: chips.length > 0 ? 28px : 0px;
    function pick(title: string) {
        nb.text = S.link-insert(nb.text, title);
        root.edited(nb.text);
        S.link-search(nb.text);
        nb.grab();
        nb.to-end();
    }
    property <bool> preview: !nb.focused && nb.text != "";
    property <[MdRow]> rows: preview ? S.md-rows(nb.text) : [];
    nb := ScrollInput {
        x: 0; y: 0; width: parent.width; height: parent.height - root.lk-h;
        opacity: root.preview ? 0 : 1;
        font-size: root.font-size;
        enter-grab: S.link-found.length > 0 && self.focused;
        edited(t) => { root.edited(t); S.link-search(t); }
        enter => { root.pick(S.link-found[0].label); }
        escape => { root.escape(); }
    }
    if root.preview: ScrollView {
        x: 0; y: 0; width: parent.width; height: parent.height - root.lk-h;
        content-height: mv.preferred-height;
        mv := VerticalLayout {
            alignment: start;
            for l in root.rows: MdLine { line: l; fs: root.font-size; }
        }
        TouchArea { width: parent.width; height: max(parent.height, mv.preferred-height); clicked => { nb.grab(); nb.to-end(); } mouse-cursor: MouseCursor.text; }
    }
    if chips.length > 0: HorizontalLayout {
        x: 0; y: parent.height - 24px; height: 22px; width: parent.width;
        spacing: 6px; alignment: start;
        for lk in chips: Rectangle {
            width: min(200px, lt.preferred-width + 30px);
            border-radius: 5px;
            background: lka.has-hover ? G.accent-line : G.accent-wash;
            Icon { x: 6px; y: 5px; width: 12px; height: 12px; name: "read"; c: G.accent; }
            lt := Text { x: 22px; width: parent.width - 28px; text: lk.label; font-size: 12px; color: lk.id == "" ? G.muted : G.accent; vertical-alignment: center; height: parent.height; overflow: elide; }
            lka := TouchArea { clicked => { if (lk.id != "") { root.opened(); S.note-open(lk.id); } } mouse-cursor: pointer; }
        }
    }
    if S.link-found.length > 0 && nb.focused: Rectangle {
        x: 0; y: 22px; width: min(300px, parent.width); height: 26px + min(5, S.link-found.length) * 30px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        drop-shadow-blur: 28px; drop-shadow-offset-y: 12px; drop-shadow-color: #00000080;
        clip: true;
        Text { x: 10px; y: 0; height: 26px; text: "ЗНАНИЯ · ENTER — ВСТАВИТЬ"; font-family: G.mono; font-size: 9.5px; font-weight: 500; letter-spacing: 1.3px; color: G.muted; vertical-alignment: center; }
        for f[i] in S.link-found: Rectangle {
            visible: i < 5;
            y: 26px + i * 30px; height: 30px;
            background: i == 0 || fa.has-hover ? G.accent-wash : transparent;
            Icon { x: 10px; y: 8.5px; width: 13px; height: 13px; name: "read"; c: i == 0 ? G.accent : G.muted; }
            Text { x: 31px; width: parent.width - 42px; text: f.label; font-size: 12.5px; font-weight: i == 0 ? 600 : 400; color: i == 0 ? G.ink : #C9CAD0; vertical-alignment: center; height: parent.height; overflow: elide; }
            fa := TouchArea { clicked => { root.pick(f.label); } mouse-cursor: pointer; }
        }
    }
}
