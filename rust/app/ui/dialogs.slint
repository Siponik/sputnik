// Окна поверх: задача, «Создать», поиск, подтверждение.
import { G } from "theme.slint";
import { Node, Mono, Button, Pill, Check, Field, IconBtn, Overlay, Link, Brackets } from "kit.slint";
import { S, Opt, Sub, Found } from "store.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    min-height: 30px;
    Mono { text: label; width: 92px; vertical-alignment: center; }
    @children
}

// Окно задачи по макету G_TaskPanel: «Куда» сверху, название крупно, главные поля в серой плашке,
// подзадачи, заметка, «▸ Ещё» и строка «Сохранено» внизу.
component MChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> x-mark;
    in property <color> hue: G.accent;
    callback clicked;
    height: 28px;
    width: mt.preferred-width + (x-mark ? 36px : 22px);
    border-radius: 4px;
    border-width: 1px;
    border-color: on ? hue : G.line;
    background: on ? hue.transparentize(0.9) : (ma.has-hover ? G.node-hover : transparent);
    mt := Text { x: 11px; text: root.text; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.2px; color: on ? (hue == G.accent ? G.accent-ink : G.ink) : #A3A5AE; vertical-alignment: center; height: parent.height; }
    if x-mark: Text { x: parent.width - 17px; text: "×"; font-size: 12px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
    ma := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component TRow inherits Rectangle {
    in property <string> label;
    Text { x: 0; y: 0; height: 28px; text: root.label; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #A3A5AE; vertical-alignment: center; }
    @children
}

export component TaskDialog inherits Overlay {
    property <bool> lists-open;
    property <bool> menu;
    property <bool> more;
    property <bool> due-edit;
    property <bool> rem-all;
    property <length> W: min(464px, self.width - 32px);
    property <length> fw: root.W - 36px - 24px - 112px;
    close => { S.t-close(); }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { S.t-close(); return accept; }
            reject
        }
        win := Rectangle {
            x: parent.width - root.W - max(16px, min(56px, (parent.width - 1000px) / 4));
            y: 80px;
            width: root.W;
            height: parent.height - 100px;
            border-radius: 12px;
            background: G.node;
            border-width: 1px;
            border-color: G.accent-line;
            drop-shadow-blur: 28px;
            drop-shadow-color: #000b;
            clip: true;
            TouchArea { }
            // «Куда»
            Rectangle {
                y: 0; height: 46px;
                Text { x: 13px; text: "КУДА"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
                Rectangle {
                    x: 52px; y: 8px; height: 30px;
                    width: lt.preferred-width + 48px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: G.line;
                    background: la0.has-hover ? G.node-hover : G.bg;
                    Rectangle { x: 11px; y: 12px; width: 6px; height: 6px; border-radius: 3px; background: G.blue; }
                    lt := Text { x: 24px; text: S.t-list-name; color: G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                    Text { x: parent.width - 17px; text: "▾"; color: #A3A5AE; font-size: 10px; vertical-alignment: center; height: parent.height; }
                    la0 := TouchArea { clicked => { root.lists-open = !root.lists-open; } mouse-cursor: pointer; }
                }
                Text { x: root.W - 76px; text: "···"; font-size: 15px; color: #A3A5AE; vertical-alignment: center; height: parent.height; TouchArea { clicked => { root.menu = !root.menu; } mouse-cursor: pointer; } }
                Text { x: root.W - 34px; text: "✕"; font-size: 14px; color: #A3A5AE; vertical-alignment: center; height: parent.height; TouchArea { clicked => { S.t-close(); } mouse-cursor: pointer; } }
                Rectangle { y: parent.height - 1px; height: 1px; background: G.line; }
            }
            ScrollView {
                y: 46px; height: parent.height - 46px - 42px;
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 14px;
                    alignment: start;
                    TextInput {
                        text: S.t-title;
                        font-size: 22px;
                        font-weight: 600;
                        color: G.ink;
                        single-line: false;
                        wrap: word-wrap;
                        selection-background-color: G.accent-line;
                        edited => { S.t-title-set(self.text); }
                    }
                    // серая плашка
                    Rectangle {
                        border-radius: 8px;
                        background: #2A2B30;
                        height: pl.preferred-height;
                        pl := VerticalLayout {
                            padding: 12px;
                            spacing: 12px;
                            if S.t-cols.length > 0: TRow {
                                label: "КОЛОНКА";
                                height: ceil(S.t-cols.length / 2) * 34px - 6px;
                                for c[i] in S.t-cols: MChip {
                                    x: 106px + mod(i, 2) * (root.fw / 2 + 4px); y: floor(i / 2) * 34px; width: root.fw / 2 - 2px;
                                    text: c.label.to-uppercase() + (c.hint != "" ? " · " + c.hint : "");
                                    on: c.on; hue: G.accent;
                                    clicked => { S.t-col(c.id); }
                                }
                            }
                            TRow {
                                label: "ПРИОРИТЕТ";
                                height: 28px;
                                for p[i] in ["!!!", "!!", "!", "—"]: MChip {
                                    x: 106px + i * 42px; width: 36px;
                                    text: p; on: (i < 3 && S.t-prio == i + 1) || (i == 3 && S.t-prio == 0);
                                    clicked => { S.t-prio-set(i == 3 ? 0 : i + 1); }
                                }
                            }
                            TRow {
                                label: "СРОК";
                                height: srow.preferred-height;
                                srow := VerticalLayout {
                                    x: 106px; width: parent.width - 106px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        MChip { text: S.t-due-label == "" ? "БЕЗ СРОКА" : S.t-due-label.to-uppercase(); on: S.t-due-label != ""; clicked => { root.due-edit = !root.due-edit; } }
                                    }
                                    if root.due-edit: Field {
                                        height: 30px; font-size: 13px; text: S.t-due; placeholder: "завтра 17:00 · пт · 25.11 · Enter";
                                        init => { self.grab(); }
                                        accepted(t) => { S.t-due-set(t); root.due-edit = false; }
                                        escape => { root.due-edit = false; }
                                    }
                                    if root.due-edit: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        MChip { text: "СЕГОДНЯ"; clicked => { S.t-due-set("сегодня"); root.due-edit = false; } }
                                        MChip { text: "ЗАВТРА"; clicked => { S.t-due-set("завтра"); root.due-edit = false; } }
                                        MChip { text: "БЕЗ СРОКА"; clicked => { S.t-due-set(""); root.due-edit = false; } }
                                    }
                                }
                            }
                            TRow {
                                label: "НАПОМНИТЬ";
                                height: ceil(S.t-reminds.length / 3) * 34px - 6px;
                                for r[i] in S.t-reminds: MChip {
                                    x: 106px + mod(i, 3) * (root.fw / 3 + 2px); y: floor(i / 3) * 34px;
                                    width: root.fw / 3 - 4px;
                                    text: r.label.to-uppercase(); on: r.on; x-mark: r.on;
                                    clicked => { S.t-remind(r.id); }
                                }
                            }
                        }
                    }
                    // подзадачи
                    Text { text: "ПОДЗАДАЧИ" + (S.t-subs.length > 0 ? " · " + S.t-subs.length : ""); font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px; color: #A3A5AE; }
                    VerticalLayout {
                        spacing: 0;
                        for sb in S.t-subs: Rectangle {
                            height: 31px;
                            Rectangle {
                                x: 0; y: 8px; width: 14px; height: 14px; border-radius: 3px;
                                border-width: 1px; border-color: #7C7E88;
                                background: sb.done ? #3D3E45 : transparent;
                                Text { text: "✓"; visible: sb.done; color: G.ink; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { S.t-sub-toggle(sb.id); } mouse-cursor: pointer; }
                            }
                            st := Text {
                                x: 24px; width: parent.width - 24px; text: sb.title; color: sb.done ? G.dim : G.ink; font-size: 13.5px; vertical-alignment: center; height: parent.height; overflow: elide;
                                Rectangle { visible: sb.done; y: parent.height / 2 + 1px; height: 1px; width: min(parent.width, st.preferred-width); background: G.dim; }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                        }
                        Field { height: 32px; bare: true; font-size: 13px; placeholder: "＋ Подзадача"; accepted(t) => { if (t != "") { S.t-sub-add(t); self.clear(); } } }
                    }
                    Text { text: "ЗАМЕТКА"; font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px; color: #A3A5AE; }
                    TextEdit {
                        height: 96px;
                        text: S.t-notes;
                        font-size: 13.5px;
                        wrap: word-wrap;
                        edited(t) => { S.t-notes-set(t); }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 14px;
                        alignment: start;
                        Text { text: (root.more ? "▾" : "▸") + " ЕЩЁ"; font-family: G.mono; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; color: G.ink; vertical-alignment: center; TouchArea { clicked => { root.more = !root.more; } mouse-cursor: pointer; } }
                        Text { text: "ПОВТОР · ЦВЕТ · КАРТИНКА"; font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: #7A7C86; vertical-alignment: center; }
                    }
                    if root.more: TRow {
                        label: "ПОВТОР";
                        height: ceil(S.t-repeats.length / 3) * 34px - 6px;
                        for r[i] in S.t-repeats: MChip {
                            x: 106px + mod(i, 3) * (root.fw / 3 + 2px); y: floor(i / 3) * 34px;
                            width: root.fw / 3 - 4px;
                            text: r.label.to-uppercase(); on: r.on;
                            clicked => { S.t-repeat(r.id); }
                        }
                    }
                }
            }
            // низ
            Rectangle {
                y: parent.height - 42px; height: 42px;
                Rectangle { y: 0; height: 1px; background: G.line; }
                Rectangle { x: 16px; y: 18px; width: 6px; height: 6px; border-radius: 3px; background: G.green; }
                Text { x: 30px; text: S.t-saved.to-uppercase(); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.3px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
            }
            // меню ···
            if root.menu: Rectangle {
                x: root.W - 190px; y: 40px; width: 176px; height: 84px;
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009;
                VerticalLayout {
                    padding: 5px;
                    for it[i] in ["Дублировать", "Удалить"]: Rectangle {
                        height: 36px; border-radius: 5px;
                        background: ia.has-hover ? G.node-hover : transparent;
                        Text { x: 10px; text: it; font-size: 13px; color: i == 1 ? G.red : G.ink; vertical-alignment: center; height: parent.height; }
                        ia := TouchArea { clicked => { root.menu = false; if (i == 0) { S.t-dup(); } else { S.t-delete(); } } mouse-cursor: pointer; }
                    }
                }
            }
            // выбор списка
            if root.lists-open: Rectangle {
                x: 52px; y: 42px;
                width: 300px;
                height: min(260px, S.t-lists.length * 30px + 10px);
                border-radius: 8px;
                background: G.node;
                border-width: 1px;
                border-color: G.line;
                drop-shadow-blur: 16px;
                drop-shadow-color: #0009;
                ScrollView {
                    VerticalLayout {
                        padding: 5px;
                        for l in S.t-lists: Rectangle {
                            height: 30px;
                            border-radius: 5px;
                            background: la.has-hover ? G.node-hover : transparent;
                            Rectangle { x: 10px; y: 12px; width: 7px; height: 7px; border-radius: 1.5px; background: l.hue; }
                            Text { x: 26px; text: l.label; color: l.on ? G.accent-ink : G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - self.preferred-width - 10px; text: l.hint; color: #7A7C86; font-size: 11px; vertical-alignment: center; height: parent.height; }
                            la := TouchArea { clicked => { root.lists-open = false; S.t-move(l.id); } }
                        }
                    }
                }
            }
        }
        Brackets { x: win.x; y: win.y; width: win.width; height: win.height; }
    }
    init => { fs.focus(); }
}

// «Создать»: вид, умная строка, «Понял», «Куда», поля по виду.
component CChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> x-mark;
    callback clicked;
    height: 32px;
    width: ct.preferred-width + (x-mark ? 40px : 26px);
    border-radius: 6px;
    border-width: 1px;
    border-color: on ? G.accent : G.line;
    background: on ? G.accent-wash : (ca.has-hover ? G.node-hover : transparent);
    ct := Text { x: 13px; text: root.text; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; }
    if x-mark: Text { x: parent.width - 18px; text: "×"; font-size: 12px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
    ca := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component FRow inherits Rectangle {
    in property <string> label;
    min-height: 42px;
    Text { x: 0; y: 0; height: 32px; text: root.label; font-size: 13px; color: #A3A5AE; vertical-alignment: center; }
    HorizontalLayout {
        x: 116px; width: parent.width - 116px;
        spacing: 6px;
        alignment: start;
        @children
    }
}

export component CreateDialog inherits Overlay {
    property <bool> dests;
    property <bool> more;
    close => { S.c-close(); }
    property <length> W: min(840px, self.width - 32px);
    property <length> H: min(672px, self.height - 48px);
    win := Rectangle {
        x: (parent.width - root.W) / 2;
        y: max(24px, (parent.height - root.H) / 2 - 10px);
        width: root.W;
        height: root.H;
        border-radius: 12px;
        background: G.node;
        border-width: 1px;
        border-color: G.accent-line;
        drop-shadow-blur: 32px;
        drop-shadow-color: #000c;
        clip: true;
        TouchArea { }
        // вкладки видов
        Rectangle {
            height: 46px; y: 0;
            background: G.head-main;
            for k[i] in ["✓  Задача", "◷  Событие", "↻  Привычка", "✦  День рождения"]: Rectangle {
                x: 12px + i * (root.W - 66px) / 4;
                y: 7px;
                width: (root.W - 66px) / 4 - 4px;
                height: 32px;
                border-radius: 6px;
                background: S.c-kind == i ? G.ink : (ka.has-hover ? #0002 : transparent);
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text { text: k; font-size: 14px; font-weight: 500; color: S.c-kind == i ? #8A4A12 : #fff; vertical-alignment: center; }
                    Text { text: "ALT " + (i + 1); font-family: G.mono; font-size: 9px; letter-spacing: 1px; color: S.c-kind == i ? #B07A4A : #ffffff90; vertical-alignment: center; }
                }
                ka := TouchArea { clicked => { S.c-kind-set(i); line.grab(); } mouse-cursor: pointer; }
            }
            Text { x: root.W - 34px; text: "✕"; font-size: 15px; color: #fff; vertical-alignment: center; height: parent.height; TouchArea { clicked => { S.c-close(); } mouse-cursor: pointer; } }
        }
        // умная строка
        Rectangle {
            x: 22px; y: 64px; width: root.W - 44px; height: 52px;
            border-radius: 8px;
            border-width: 1px;
            border-color: G.accent;
            background: G.bg;
            line := Field {
                x: 16px; width: parent.width - 60px; height: parent.height;
                bare: true;
                font-size: 17px;
                text: S.c-text;
                placeholder: S.c-kind == 0 ? "Сделать иконки для клиента завтра 15:00 @работа !!" : S.c-kind == 1 ? "Созвон с Олей в пт 14:00" : S.c-kind == 2 ? "Вода 8 стаканов каждый день" : "Мама 12 марта";
                edited(t) => { S.c-changed(t); }
                accepted(t) => { if (t != "") { S.c-submit(t, false); } }
                shift-enter(t) => { if (t != "") { S.c-submit(t, true); self.clear(); } }
                escape => { S.c-close(); }
            }
            Rectangle {
                x: parent.width - 36px; y: 13px; width: 26px; height: 26px; border-radius: 13px;
                border-width: 1px; border-color: #6E7079;
                Text { text: "?"; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // поля
        VerticalLayout {
            x: 22px; y: 132px; width: root.W - 44px - 270px - 22px;
            spacing: 10px;
            alignment: start;
            if S.c-kind == 0 || S.c-kind == 2: FRow {
                label: "Куда";
                Rectangle {
                    height: 34px;
                    width: dl.preferred-width + dw.preferred-width + 62px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: G.line;
                    background: da.has-hover ? G.node-hover : G.bg;
                    Rectangle { x: 13px; y: 14px; width: 7px; height: 7px; border-radius: 1.5px; background: S.c-dest-hue; }
                    dl := Text { x: 28px; text: S.c-dest; font-size: 13px; font-weight: 600; color: G.ink; vertical-alignment: center; height: parent.height; }
                    dw := Text { x: 34px + dl.preferred-width; text: S.c-dest-why; font-size: 11.5px; color: G.gold; vertical-alignment: center; height: parent.height; }
                    Text { x: parent.width - 18px; text: "▾"; font-size: 11px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
                    da := TouchArea { clicked => { root.dests = !root.dests; } mouse-cursor: pointer; }
                }
                Text { height: 34px; text: "Alt L"; font-size: 12.5px; color: G.accent; vertical-alignment: center; }
            }
            if S.c-kind == 1 || S.c-kind == 3: FRow {
                label: "Календарь";
                for c in S.c-cals: CChip { text: c.label; on: c.on; clicked => { S.c-cal-set(c.id); } }
            }
            FRow {
                label: "Когда";
                for u[i] in S.c-understood: CChip { text: u; on: true; x-mark: true; visible: i < 3; }
                if S.c-understood.length == 0: CChip { text: S.c-kind == 3 ? "Дата в строке: «12 марта»" : "Сегодня"; }
                if S.c-kind == 0: CChip { text: "Без срока"; }
            }
            if S.c-kind == 1: FRow {
                label: "Длится";
                for d in S.c-durs: CChip { text: d.label; on: d.on; clicked => { S.c-dur-set(d.id); } }
            }
            if S.c-kind == 1 && S.c-free != "": FRow {
                label: "";
                Text { text: S.c-free; color: G.gold; font-size: 12.5px; vertical-alignment: center; height: 32px; }
            }
            if S.c-kind != 2: FRow {
                label: "Напомнить";
                for r[i] in S.c-reminds: CChip { text: r.label; on: r.on; x-mark: r.on; clicked => { S.c-remind(r.id); } }
            }
            Rectangle { height: 4px; }
            Rectangle {
                height: root.more ? 120px : 40px;
                border-radius: 8px;
                border-width: 1px;
                border-color: G.line;
                background: G.bg;
                Text { x: 13px; y: 0; height: 40px; text: (root.more ? "▾" : "▸") + " Ещё параметры"; font-size: 13px; font-weight: 600; color: G.ink; vertical-alignment: center; }
                Text { x: 140px; y: 0; height: 40px; text: S.c-kind == 2 ? "цвет, до какого дня" : "приоритет, подзадачи, повтор, заметка"; font-size: 11.5px; color: #8A8C96; vertical-alignment: center; }
                TouchArea { height: 40px; y: 0; clicked => { root.more = !root.more; } mouse-cursor: pointer; }
                if root.more: Text {
                    x: 13px; y: 44px; width: parent.width - 26px;
                    text: "Приоритет — «!!!» в строке, повтор — «каждую неделю», заметка — вторая строка. Остальное — в окне задачи после создания.";
                    font-size: 12.5px; color: #A3A5AE; wrap: word-wrap;
                }
            }
        }
        // выбор списка
        if root.dests && (S.c-kind == 0 || S.c-kind == 2): Rectangle {
            x: 22px + 116px; y: 132px + 38px;
            width: 300px;
            height: min(260px, S.c-lists.length * 30px + 10px);
            border-radius: 8px;
            background: G.node;
            border-width: 1px;
            border-color: G.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0009;
            ScrollView {
                VerticalLayout {
                    padding: 5px;
                    for l in S.c-lists: Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: la.has-hover ? G.node-hover : transparent;
                        Rectangle { x: 10px; y: 12px; width: 7px; height: 7px; border-radius: 1.5px; background: l.hue; }
                        Text { x: 26px; text: l.label; color: l.on ? G.accent-ink : G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                        Text { x: parent.width - self.preferred-width - 10px; text: l.hint; color: #7A7C86; font-size: 11px; vertical-alignment: center; height: parent.height; }
                        la := TouchArea { clicked => { root.dests = false; S.c-dest-set(l.id); } }
                    }
                }
            }
        }
        // превью справа
        VerticalLayout {
            x: root.W - 22px - 248px; y: 132px; width: 248px;
            spacing: 12px;
            alignment: start;
            Text { text: S.c-kind == 0 ? "Так появится на доске" : S.c-kind == 1 ? "Так появится в календаре" : S.c-kind == 2 ? "Так появится в «Привычках»" : "Так появится в календаре"; font-size: 12.5px; color: #A3A5AE; }
            Rectangle {
                height: 96px;
                border-radius: 8px;
                background: G.node;
                border-width: 1px;
                border-color: G.line;
                clip: true;
                Rectangle {
                    y: 0; height: 28px;
                    background: (S.c-kind == 0 || S.c-kind == 2 ? S.c-dest-hue : (S.c-kind == 3 ? G.violet : G.grey)).mix(#1C1D21, 0.55);
                    Text { x: 10px; text: S.c-kind == 0 || S.c-kind == 2 ? S.c-dest.to-uppercase() : (S.c-kind == 3 ? "ДНИ РОЖДЕНИЯ" : "СОБЫТИЕ"); font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.2px; color: #fff; vertical-alignment: center; height: parent.height; overflow: elide; width: parent.width - 20px; }
                }
                Rectangle {
                    x: 12px; y: 40px; width: 40px; height: 40px; border-radius: 6px;
                    background: S.c-dest-hue.mix(#1C1D21, 0.3);
                    Text { text: S.c-kind == 3 ? "✦" : (S.c-kind == 2 ? "↻" : (S.c-kind == 1 ? "◷" : "✓")); font-size: 16px; color: #fff; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { x: 64px; y: 40px; width: parent.width - 74px; text: line.text == "" ? "Название" : line.text; font-size: 13.5px; font-weight: 600; color: line.text == "" ? #6E7079 : G.ink; overflow: elide; }
                Text { x: 64px; y: 62px; width: parent.width - 74px; text: S.c-understood.length > 0 ? S.c-understood[0] : "сегодня"; font-size: 12px; color: #A3A5AE; overflow: elide; }
            }
            if S.c-dest-why != "" || S.c-free != "": Rectangle {
                height: 80px;
                border-radius: 8px;
                background: #2E2A1E;
                border-width: 1px;
                border-color: #6A5A28;
                Rectangle {
                    x: 12px; y: 17px; width: 44px; height: 44px; border-radius: 22px; border-width: 1px; border-color: #8A8C96;
                    Text { text: "ДУМАЕТ"; font-family: G.mono; font-size: 7.5px; color: #A3A5AE; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { x: 66px; width: parent.width - 76px; text: S.c-free != "" ? "Время: " + S.c-free + "." : "Список выбран " + S.c-dest-why + ". Не то — Alt L."; font-size: 12.5px; color: G.ink; wrap: word-wrap; vertical-alignment: center; height: parent.height; }
            }
            Rectangle {
                height: ht.preferred-height + 24px;
                border-radius: 8px;
                border-width: 1px;
                border-color: G.line;
                ht := Text { x: 12px; width: parent.width - 24px; text: "? " + S.c-hint; font-size: 12px; color: #A3A5AE; wrap: word-wrap; vertical-alignment: center; height: parent.height; }
            }
        }
        // низ
        Rectangle {
            y: root.H - 60px; height: 60px;
            Rectangle { y: 0; height: 1px; background: G.line; }
            Text { x: 22px; text: "Enter — добавить · Shift+Enter — и ещё · Esc — закрыть"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
            HorizontalLayout {
                x: root.W - 22px - self.preferred-width; y: 11px; height: 38px;
                spacing: 10px;
                Rectangle {
                    width: mt.preferred-width + 30px;
                    border-radius: 6px; border-width: 1px; border-color: #8A8C96;
                    background: ma.has-hover ? G.node-hover : transparent;
                    mt := Text { text: "Добавить и ещё"; font-size: 13.5px; font-weight: 500; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                    ma := TouchArea { clicked => { if (line.text != "") { S.c-submit(line.text, true); line.clear(); } } mouse-cursor: pointer; }
                }
                Rectangle {
                    width: pt.preferred-width + 34px;
                    border-radius: 6px;
                    background: pa.has-hover ? G.accent-ink : G.accent;
                    pt := Text { text: ["Добавить задачу", "Добавить событие", "Добавить привычку", "Добавить день рождения"][S.c-kind]; font-size: 13.5px; font-weight: 600; color: G.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                    pa := TouchArea { clicked => { if (line.text != "") { S.c-submit(line.text, false); } } mouse-cursor: pointer; }
                }
            }
        }
    }
    Brackets { x: win.x; y: win.y; width: win.width; height: win.height; }
    init => { line.grab(); }
}

// Поиск Ctrl+K: задачи, списки, разделы.
export component SearchDialog inherits Overlay {
    property <int> cur;
    property <string> q-text;
    background: #0004;
    close => { S.search-open-set(false); }
    property <length> right: self.width - 222px;
    // поле — на месте «Найти» в шапке
    Rectangle {
        x: root.right - 400px; y: 15px; width: 400px; height: 32px;
        border-radius: 6px;
        background: G.bg;
        border-width: 1px;
        border-color: G.accent;
        Text { x: 12px; text: "⌕"; font-size: 13px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
        q := Field {
            x: 30px; width: parent.width - 120px; height: parent.height;
            bare: true;
            font-size: 13.5px;
            placeholder: "Найти задачу, заметку, раздел…";
            edited(t) => { root.cur = 0; root.q-text = t; S.search(t); }
            accepted => { S.search-go(root.cur); }
            escape => { S.search-open-set(false); }
        }
        Text { x: parent.width - self.preferred-width - 10px; text: root.q-text == "" ? "CTRL K" : S.found.length + " найдено"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1px; color: #8A8C96; vertical-alignment: center; height: parent.height; }
    }
    if root.q-text != "": Rectangle {
        x: root.right - 562px; y: 52px; width: 562px;
        height: min(12, S.found.length) * 38px + (S.found.length == 0 ? 52px : 0) + 30px + 40px + 30px;
        border-radius: 8px;
        background: G.node;
        border-width: 1px;
        border-color: G.accent;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000b;
        clip: true;
        TouchArea { }
        VerticalLayout {
            y: 0; height: parent.height - 40px;
            padding: 6px;
            padding-top: 4px;
            alignment: start;
            if S.found.length == 0: Text { height: 52px; x: 10px; text: "Ничего не нашлось — попробуй другое слово"; color: #A3A5AE; font-size: 13px; vertical-alignment: center; }
            for f[i] in S.found: VerticalLayout {
                visible: i < 12;
                if i == 0 || S.found[max(0, i - 1)].kind != f.kind: Text {
                    height: 30px; x: 10px;
                    text: f.kind == "задача" ? "Задачи" : (f.kind == "заметка" ? "В заметках" : "Разделы и списки");
                    font-size: 12px; color: #A3A5AE; vertical-alignment: center;
                }
                Rectangle {
                    height: 38px;
                    border-radius: 5px;
                    background: i == root.cur || fa.has-hover ? G.node-hover : transparent;
                    if f.kind == "задача": Rectangle { x: 12px; y: 12px; width: 13px; height: 13px; border-radius: 3px; border-width: 1px; border-color: #8A8C96; }
                    if f.kind != "задача": Rectangle { x: 14px; y: 16px; width: 6px; height: 6px; border-radius: 3px; background: G.accent; }
                    Text { x: 36px; width: parent.width - 200px; text: f.title; color: G.ink; font-size: 13.5px; vertical-alignment: center; height: parent.height; overflow: elide; }
                    Text { x: parent.width - self.preferred-width - 12px; text: f.sub; color: #A3A5AE; font-size: 12px; vertical-alignment: center; height: parent.height; }
                    fa := TouchArea { clicked => { S.search-go(i); } mouse-cursor: pointer; }
                }
            }
        }
        Rectangle {
            y: parent.height - 40px; height: 40px;
            Rectangle { y: 0; height: 1px; background: G.line; }
            HorizontalLayout {
                x: 14px; spacing: 6px; alignment: start;
                for k[i] in ["↑ ↓", "ENTER", "ESC"]: HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        y: 11px; height: 18px; width: kt.preferred-width + 10px;
                        border-radius: 3px; border-width: 1px; border-color: G.line;
                        kt := Text { text: k; font-family: G.mono; font-size: 8.5px; color: #A3A5AE; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: ["выбрать", "открыть", "закрыть"][i]; font-size: 12px; color: #A3A5AE; vertical-alignment: center; }
                    Rectangle { width: 8px; }
                }
            }
            Text { x: parent.width - self.preferred-width - 14px; text: "ё = е"; font-size: 12px; color: #8A8C96; vertical-alignment: center; height: parent.height; }
        }
    }
    init => { q.grab(); }
}

export component Confirm inherits Overlay {
    close => { S.confirm-no(); }
    Node {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 170px;
        num: "!!";
        title: "ТОЧНО?";
        head: #8A3A2E;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: S.confirm; color: G.ink; font-size: 14px; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                b := Button { text: "Отмена"; clicked => { S.confirm-no(); } }
                Button { text: S.confirm-yes-label; primary: true; clicked => { S.confirm-yes(); } }
            }
        }
    }
}
