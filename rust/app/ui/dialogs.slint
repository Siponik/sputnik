// Окна поверх: задача, «Создать», поиск, подтверждение.
import { G } from "theme.slint";
import { Node, Mono, Button, Pill, Check, Field, IconBtn, Overlay, Link, Brackets } from "kit.slint";
import { S, Opt, Sub, Found } from "store.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    min-height: 30px;
    Mono { text: label; width: 92px; vertical-alignment: center; }
    @children
}

// Окно задачи: «Куда» сверху, название крупно, главные поля в серой плашке, подзадачи и заметка.
export component TaskDialog inherits Overlay {
    property <bool> lists-open;
    close => { S.t-close(); }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { S.t-close(); return accept; }
            reject
        }
        Rectangle {
            x: parent.width - self.width - 16px;
            y: 16px;
            width: min(560px, parent.width - 32px);
            height: parent.height - 32px;
            border-radius: G.r-main;
            background: G.node;
            border-width: 1px;
            border-color: G.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000a;
            TouchArea { }
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Mono { text: "КУДА"; vertical-alignment: center; }
                    Rectangle {
                        width: lt.preferred-width + 24px;
                        height: 26px;
                        border-radius: 13px;
                        background: G.accent-wash;
                        border-width: 1px;
                        border-color: G.accent-line;
                        lt := Text { text: S.t-list-name + " ▾"; color: G.accent-ink; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.lists-open = !root.lists-open; } mouse-cursor: pointer; }
                    }
                    Rectangle { }
                    Button { text: "Копия"; height: 28px; clicked => { S.t-dup(); } }
                    Button { text: "Удалить"; height: 28px; clicked => { S.t-delete(); } }
                    IconBtn { icon: "✕"; clicked => { S.t-close(); } }
                }
                if root.lists-open: Rectangle {
                    height: min(220px, S.t-lists.length * 28px + 8px);
                    border-radius: G.r-node;
                    background: G.bg;
                    border-width: 1px;
                    border-color: G.line;
                    ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            for l in S.t-lists: Rectangle {
                                height: 28px;
                                background: la.has-hover ? G.node-hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 8px;
                                    Rectangle { width: 6px; height: 6px; y: 11px; border-radius: 3px; background: l.hue; }
                                    Text { text: l.label; color: l.on ? G.accent-ink : G.ink; font-size: 13px; vertical-alignment: center; }
                                    Text { text: l.hint; color: G.dim; font-size: 11px; vertical-alignment: center; }
                                }
                                la := TouchArea { clicked => { root.lists-open = false; S.t-move(l.id); } }
                            }
                        }
                    }
                }
                title := TextInput {
                    text: S.t-title;
                    font-size: 22px;
                    font-weight: 500;
                    color: G.ink;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: G.accent-line;
                    edited => { S.t-title-set(self.text); }
                }
                // серая плашка
                Rectangle {
                    border-radius: G.r-node;
                    background: G.bg;
                    height: pl.preferred-height;
                    pl := VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        if S.t-cols.length > 0: Row {
                            label: "КОЛОНКА";
                            for c in S.t-cols: Pill { y: 2px; text: c.label + (c.hint != "" ? " " + c.hint : ""); on: c.on; hue: c.hue; clicked => { S.t-col(c.id); } }
                            Rectangle { }
                        }
                        Row {
                            label: "ПРИОРИТЕТ";
                            for p[i] in ["Высокий", "Обычный", "Низкий"]: Pill { y: 2px; text: p; on: S.t-prio == i + 1; hue: i == 0 ? G.red : i == 2 ? G.grey : G.accent; clicked => { S.t-prio-set(S.t-prio == i + 1 ? 0 : i + 1); } }
                            Rectangle { }
                        }
                        Row {
                            label: "СРОК";
                            due := Field { width: 200px; height: 30px; font-size: 13px; text: S.t-due; placeholder: "завтра 17:00 · пт · 25.11"; accepted(t) => { S.t-due-set(t); } }
                            Text { text: S.t-due-label; color: G.muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                        Row {
                            label: "";
                            Pill { text: "Сегодня"; clicked => { S.t-due-set("сегодня"); } }
                            Pill { text: "Завтра"; clicked => { S.t-due-set("завтра"); } }
                            Pill { text: "Без срока"; clicked => { S.t-due-set(""); } }
                            Rectangle { }
                        }
                        Row {
                            label: "НАПОМНИТЬ";
                            for r in S.t-reminds: Pill { y: 2px; text: r.label; on: r.on; clicked => { S.t-remind(r.id); } }
                            Rectangle { }
                        }
                        Row {
                            label: "ПОВТОР";
                            for r in S.t-repeats: Pill { y: 2px; text: r.label; on: r.on; clicked => { S.t-repeat(r.id); } }
                            Rectangle { }
                        }
                    }
                }
                Mono { text: "ПОДЗАДАЧИ"; }
                for sb in S.t-subs: HorizontalLayout {
                    height: 28px;
                    spacing: 10px;
                    Check { done: sb.done; y: 5px; toggled => { S.t-sub-toggle(sb.id); } }
                    Text { text: sb.title; color: sb.done ? G.dim : G.ink; font-size: 13px; vertical-alignment: center; }
                }
                Field { height: 30px; font-size: 13px; placeholder: "＋ подзадача · Enter"; accepted(t) => { if (t != "") { S.t-sub-add(t); self.clear(); } } }
                Mono { text: "ЗАМЕТКА"; }
                TextEdit {
                    vertical-stretch: 1;
                    min-height: 80px;
                    text: S.t-notes;
                    font-size: 13px;
                    wrap: word-wrap;
                    edited(t) => { S.t-notes-set(t); }
                }
                Mono { text: S.t-saved; color: G.dim; }
            }
        }
    }
    init => { fs.focus(); }
}

// «Создать»: вид, умная строка, «Понял», «Куда», поля по виду.
component CChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> x-mark;
    callback clicked;
    height: 32px;
    width: ct.preferred-width + (x-mark ? 40px : 26px);
    border-radius: 6px;
    border-width: 1px;
    border-color: on ? G.accent : G.line;
    background: on ? G.accent-wash : (ca.has-hover ? G.node-hover : transparent);
    ct := Text { x: 13px; text: root.text; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; }
    if x-mark: Text { x: parent.width - 18px; text: "×"; font-size: 12px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
    ca := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component FRow inherits Rectangle {
    in property <string> label;
    min-height: 42px;
    Text { x: 0; y: 0; height: 32px; text: root.label; font-size: 13px; color: #A3A5AE; vertical-alignment: center; }
    HorizontalLayout {
        x: 116px; width: parent.width - 116px;
        spacing: 6px;
        alignment: start;
        @children
    }
}

export component CreateDialog inherits Overlay {
    property <bool> dests;
    property <bool> more;
    close => { S.c-close(); }
    property <length> W: min(840px, self.width - 32px);
    property <length> H: min(672px, self.height - 48px);
    win := Rectangle {
        x: (parent.width - root.W) / 2;
        y: max(24px, (parent.height - root.H) / 2 - 10px);
        width: root.W;
        height: root.H;
        border-radius: 12px;
        background: G.node;
        border-width: 1px;
        border-color: G.accent-line;
        drop-shadow-blur: 32px;
        drop-shadow-color: #000c;
        clip: true;
        TouchArea { }
        // вкладки видов
        Rectangle {
            height: 46px; y: 0;
            background: G.head-main;
            for k[i] in ["✓  Задача", "◷  Событие", "↻  Привычка", "✦  День рождения"]: Rectangle {
                x: 12px + i * (root.W - 66px) / 4;
                y: 7px;
                width: (root.W - 66px) / 4 - 4px;
                height: 32px;
                border-radius: 6px;
                background: S.c-kind == i ? G.ink : (ka.has-hover ? #0002 : transparent);
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text { text: k; font-size: 14px; font-weight: 500; color: S.c-kind == i ? #8A4A12 : #fff; vertical-alignment: center; }
                    Text { text: "ALT " + (i + 1); font-family: G.mono; font-size: 9px; letter-spacing: 1px; color: S.c-kind == i ? #B07A4A : #ffffff90; vertical-alignment: center; }
                }
                ka := TouchArea { clicked => { S.c-kind-set(i); line.grab(); } mouse-cursor: pointer; }
            }
            Text { x: root.W - 34px; text: "✕"; font-size: 15px; color: #fff; vertical-alignment: center; height: parent.height; TouchArea { clicked => { S.c-close(); } mouse-cursor: pointer; } }
        }
        // умная строка
        Rectangle {
            x: 22px; y: 64px; width: root.W - 44px; height: 52px;
            border-radius: 8px;
            border-width: 1px;
            border-color: G.accent;
            background: G.bg;
            line := Field {
                x: 16px; width: parent.width - 60px; height: parent.height;
                bare: true;
                font-size: 17px;
                text: S.c-text;
                placeholder: S.c-kind == 0 ? "Сделать иконки для клиента завтра 15:00 @работа !!" : S.c-kind == 1 ? "Созвон с Олей в пт 14:00" : S.c-kind == 2 ? "Вода 8 стаканов каждый день" : "Мама 12 марта";
                edited(t) => { S.c-changed(t); }
                accepted(t) => { if (t != "") { S.c-submit(t, false); } }
                shift-enter(t) => { if (t != "") { S.c-submit(t, true); self.clear(); } }
                escape => { S.c-close(); }
            }
            Rectangle {
                x: parent.width - 36px; y: 13px; width: 26px; height: 26px; border-radius: 13px;
                border-width: 1px; border-color: #6E7079;
                Text { text: "?"; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // поля
        VerticalLayout {
            x: 22px; y: 132px; width: root.W - 44px - 270px - 22px;
            spacing: 10px;
            alignment: start;
            if S.c-kind == 0 || S.c-kind == 2: FRow {
                label: "Куда";
                Rectangle {
                    height: 34px;
                    width: dl.preferred-width + dw.preferred-width + 62px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: G.line;
                    background: da.has-hover ? G.node-hover : G.bg;
                    Rectangle { x: 13px; y: 14px; width: 7px; height: 7px; border-radius: 1.5px; background: S.c-dest-hue; }
                    dl := Text { x: 28px; text: S.c-dest; font-size: 13px; font-weight: 600; color: G.ink; vertical-alignment: center; height: parent.height; }
                    dw := Text { x: 34px + dl.preferred-width; text: S.c-dest-why; font-size: 11.5px; color: G.gold; vertical-alignment: center; height: parent.height; }
                    Text { x: parent.width - 18px; text: "▾"; font-size: 11px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
                    da := TouchArea { clicked => { root.dests = !root.dests; } mouse-cursor: pointer; }
                }
                Text { height: 34px; text: "Alt L"; font-size: 12.5px; color: G.accent; vertical-alignment: center; }
            }
            if S.c-kind == 1 || S.c-kind == 3: FRow {
                label: "Календарь";
                for c in S.c-cals: CChip { text: c.label; on: c.on; clicked => { S.c-cal-set(c.id); } }
            }
            FRow {
                label: "Когда";
                for u[i] in S.c-understood: CChip { text: u; on: true; x-mark: true; visible: i < 3; }
                if S.c-understood.length == 0: CChip { text: S.c-kind == 3 ? "Дата в строке: «12 марта»" : "Сегодня"; }
                if S.c-kind == 0: CChip { text: "Без срока"; }
            }
            if S.c-kind == 1: FRow {
                label: "Длится";
                for d in S.c-durs: CChip { text: d.label; on: d.on; clicked => { S.c-dur-set(d.id); } }
            }
            if S.c-kind == 1 && S.c-free != "": FRow {
                label: "";
                Text { text: S.c-free; color: G.gold; font-size: 12.5px; vertical-alignment: center; height: 32px; }
            }
            if S.c-kind != 2: FRow {
                label: "Напомнить";
                for r[i] in S.c-reminds: CChip { text: r.label; on: r.on; x-mark: r.on; clicked => { S.c-remind(r.id); } }
            }
            Rectangle { height: 4px; }
            Rectangle {
                height: root.more ? 120px : 40px;
                border-radius: 8px;
                border-width: 1px;
                border-color: G.line;
                background: G.bg;
                Text { x: 13px; y: 0; height: 40px; text: (root.more ? "▾" : "▸") + " Ещё параметры"; font-size: 13px; font-weight: 600; color: G.ink; vertical-alignment: center; }
                Text { x: 140px; y: 0; height: 40px; text: S.c-kind == 2 ? "цвет, до какого дня" : "приоритет, подзадачи, повтор, заметка"; font-size: 11.5px; color: #8A8C96; vertical-alignment: center; }
                TouchArea { height: 40px; y: 0; clicked => { root.more = !root.more; } mouse-cursor: pointer; }
                if root.more: Text {
                    x: 13px; y: 44px; width: parent.width - 26px;
                    text: "Приоритет — «!!!» в строке, повтор — «каждую неделю», заметка — вторая строка. Остальное — в окне задачи после создания.";
                    font-size: 12.5px; color: #A3A5AE; wrap: word-wrap;
                }
            }
        }
        // выбор списка
        if root.dests && (S.c-kind == 0 || S.c-kind == 2): Rectangle {
            x: 22px + 116px; y: 132px + 38px;
            width: 300px;
            height: min(260px, S.c-lists.length * 30px + 10px);
            border-radius: 8px;
            background: G.node;
            border-width: 1px;
            border-color: G.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0009;
            ScrollView {
                VerticalLayout {
                    padding: 5px;
                    for l in S.c-lists: Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: la.has-hover ? G.node-hover : transparent;
                        Rectangle { x: 10px; y: 12px; width: 7px; height: 7px; border-radius: 1.5px; background: l.hue; }
                        Text { x: 26px; text: l.label; color: l.on ? G.accent-ink : G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                        Text { x: parent.width - self.preferred-width - 10px; text: l.hint; color: #7A7C86; font-size: 11px; vertical-alignment: center; height: parent.height; }
                        la := TouchArea { clicked => { root.dests = false; S.c-dest-set(l.id); } }
                    }
                }
            }
        }
        // превью справа
        VerticalLayout {
            x: root.W - 22px - 248px; y: 132px; width: 248px;
            spacing: 12px;
            alignment: start;
            Text { text: S.c-kind == 0 ? "Так появится на доске" : S.c-kind == 1 ? "Так появится в календаре" : S.c-kind == 2 ? "Так появится в «Привычках»" : "Так появится в календаре"; font-size: 12.5px; color: #A3A5AE; }
            Rectangle {
                height: 96px;
                border-radius: 8px;
                background: G.node;
                border-width: 1px;
                border-color: G.line;
                clip: true;
                Rectangle {
                    y: 0; height: 28px;
                    background: (S.c-kind == 0 || S.c-kind == 2 ? S.c-dest-hue : (S.c-kind == 3 ? G.violet : G.grey)).mix(#1C1D21, 0.55);
                    Text { x: 10px; text: S.c-kind == 0 || S.c-kind == 2 ? S.c-dest.to-uppercase() : (S.c-kind == 3 ? "ДНИ РОЖДЕНИЯ" : "СОБЫТИЕ"); font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.2px; color: #fff; vertical-alignment: center; height: parent.height; overflow: elide; width: parent.width - 20px; }
                }
                Rectangle {
                    x: 12px; y: 40px; width: 40px; height: 40px; border-radius: 6px;
                    background: S.c-dest-hue.mix(#1C1D21, 0.3);
                    Text { text: S.c-kind == 3 ? "✦" : (S.c-kind == 2 ? "↻" : (S.c-kind == 1 ? "◷" : "✓")); font-size: 16px; color: #fff; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { x: 64px; y: 40px; width: parent.width - 74px; text: line.text == "" ? "Название" : line.text; font-size: 13.5px; font-weight: 600; color: line.text == "" ? #6E7079 : G.ink; overflow: elide; }
                Text { x: 64px; y: 62px; width: parent.width - 74px; text: S.c-understood.length > 0 ? S.c-understood[0] : "сегодня"; font-size: 12px; color: #A3A5AE; overflow: elide; }
            }
            if S.c-dest-why != "" || S.c-free != "": Rectangle {
                height: 80px;
                border-radius: 8px;
                background: #2E2A1E;
                border-width: 1px;
                border-color: #6A5A28;
                Rectangle {
                    x: 12px; y: 17px; width: 44px; height: 44px; border-radius: 22px; border-width: 1px; border-color: #8A8C96;
                    Text { text: "ДУМАЕТ"; font-family: G.mono; font-size: 7.5px; color: #A3A5AE; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { x: 66px; width: parent.width - 76px; text: S.c-free != "" ? "Время: " + S.c-free + "." : "Список выбран " + S.c-dest-why + ". Не то — Alt L."; font-size: 12.5px; color: G.ink; wrap: word-wrap; vertical-alignment: center; height: parent.height; }
            }
            Rectangle {
                height: ht.preferred-height + 24px;
                border-radius: 8px;
                border-width: 1px;
                border-color: G.line;
                ht := Text { x: 12px; width: parent.width - 24px; text: "? " + S.c-hint; font-size: 12px; color: #A3A5AE; wrap: word-wrap; vertical-alignment: center; height: parent.height; }
            }
        }
        // низ
        Rectangle {
            y: root.H - 60px; height: 60px;
            Rectangle { y: 0; height: 1px; background: G.line; }
            Text { x: 22px; text: "Enter — добавить · Shift+Enter — и ещё · Esc — закрыть"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
            HorizontalLayout {
                x: root.W - 22px - self.preferred-width; y: 11px; height: 38px;
                spacing: 10px;
                Rectangle {
                    width: mt.preferred-width + 30px;
                    border-radius: 6px; border-width: 1px; border-color: #8A8C96;
                    background: ma.has-hover ? G.node-hover : transparent;
                    mt := Text { text: "Добавить и ещё"; font-size: 13.5px; font-weight: 500; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                    ma := TouchArea { clicked => { if (line.text != "") { S.c-submit(line.text, true); line.clear(); } } mouse-cursor: pointer; }
                }
                Rectangle {
                    width: pt.preferred-width + 34px;
                    border-radius: 6px;
                    background: pa.has-hover ? G.accent-ink : G.accent;
                    pt := Text { text: ["Добавить задачу", "Добавить событие", "Добавить привычку", "Добавить день рождения"][S.c-kind]; font-size: 13.5px; font-weight: 600; color: G.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                    pa := TouchArea { clicked => { if (line.text != "") { S.c-submit(line.text, false); } } mouse-cursor: pointer; }
                }
            }
        }
    }
    Brackets { x: win.x; y: win.y; width: win.width; height: win.height; }
    init => { line.grab(); }
}

// Поиск Ctrl+K: задачи, списки, разделы.
export component SearchDialog inherits Overlay {
    property <int> cur;
    close => { S.search-open-set(false); }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.12;
        width: min(640px, parent.width - 32px);
        height: 64px + min(10, S.found.length) * 40px;
        border-radius: G.r-main;
        background: G.node;
        border-width: 1px;
        border-color: G.line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000a;
        TouchArea { }
        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            q := Field {
                height: 40px;
                font-size: 16px;
                placeholder: "Найти задачу, список или раздел…";
                edited(t) => { root.cur = 0; S.search(t); }
                accepted => { S.search-go(root.cur); }
                escape => { S.search-open-set(false); }
            }
            for f[i] in S.found: Rectangle {
                height: 38px;
                visible: i < 10;
                border-radius: 4px;
                background: i == root.cur || fa.has-hover ? G.node-hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Mono { text: f.kind; width: 70px; vertical-alignment: center; }
                    Text { text: f.title; color: G.ink; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: f.sub; color: G.dim; font-size: 12px; vertical-alignment: center; }
                }
                fa := TouchArea { clicked => { S.search-go(i); } }
            }
        }
    }
    init => { q.grab(); }
}

export component Confirm inherits Overlay {
    close => { S.confirm-no(); }
    Node {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 170px;
        num: "!!";
        title: "ТОЧНО?";
        head: #8A3A2E;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: S.confirm; color: G.ink; font-size: 14px; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                b := Button { text: "Отмена"; clicked => { S.confirm-no(); } }
                Button { text: S.confirm-yes-label; primary: true; clicked => { S.confirm-yes(); } }
            }
        }
    }
}
