// Окна поверх: задача, «Создать», поиск, подтверждение.
import { G } from "theme.slint";
import { Node, Mono, Button, Pill, Check, Field, IconBtn, Overlay, Link, Brackets, Icon, Chev, ScrollInput } from "kit.slint";
import { Sat } from "kit.slint";
import { S, Opt, Sub, Found, DpCell } from "store.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    min-height: 30px;
    Mono { text: label; width: 92px; vertical-alignment: center; }
    @children
}

// Окно задачи по макету G_TaskPanel: «Куда» сверху, название крупно, главные поля в серой плашке,
// подзадачи, заметка, «▸ Ещё» и строка «Сохранено» внизу.
component MChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> x-mark;
    in property <color> hue: G.accent;
    callback clicked;
    height: 28px;
    width: mt.preferred-width + (x-mark ? 36px : 22px);
    border-radius: 4px;
    border-width: 1px;
    border-color: on ? hue : G.line;
    background: on ? hue.transparentize(0.9) : (ma.has-hover ? G.node-hover : transparent);
    mt := Text { x: 11px; text: root.text; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.2px; color: on ? (hue == G.accent ? G.accent-ink : G.ink) : #A3A5AE; vertical-alignment: center; height: parent.height; }
    if x-mark: Text { x: parent.width - 17px; text: "×"; font-size: 12px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
    ma := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component TRow inherits Rectangle {
    in property <string> label;
    Text { x: 0; y: 0; height: 28px; text: root.label; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #A3A5AE; vertical-alignment: center; }
    @children
}

export component TaskDialog inherits Overlay {
    property <bool> lists-open;
    property <bool> menu;
    property <bool> more;
    property <bool> due-edit;
    property <bool> rem-all;
    property <length> W: min(464px, self.width - 32px);
    property <length> fw: root.W - 36px - 24px - 112px;
    close => { S.t-close(); }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { S.t-close(); return accept; }
            reject
        }
        win := Rectangle {
            x: parent.width - root.W - 8px;
            y: 80px;
            width: root.W;
            height: parent.height - 100px;
            border-radius: 12px;
            background: G.node;
            border-width: 1px;
            border-color: G.accent-line;
            drop-shadow-blur: 28px;
            drop-shadow-color: #000b;
            clip: true;
            TouchArea { }
            // «Куда»
            Rectangle {
                y: 0; height: 46px;
                Text { x: 13px; text: "КУДА"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
                Rectangle {
                    x: 52px; y: 8px; height: 30px;
                    width: lt.preferred-width + 48px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: G.line;
                    background: la0.has-hover ? G.node-hover : G.bg;
                    Rectangle { x: 11px; y: 12px; width: 6px; height: 6px; border-radius: 3px; background: G.blue; }
                    lt := Text { x: 24px; text: S.t-list-name; color: G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                    Chev { x: parent.width - 17px; y: (parent.height - 10px) / 2; }
                    la0 := TouchArea { clicked => { root.lists-open = !root.lists-open; } mouse-cursor: pointer; }
                }
                Text { x: root.W - 76px; text: "···"; font-size: 15px; color: #A3A5AE; vertical-alignment: center; height: parent.height; TouchArea { clicked => { root.menu = !root.menu; } mouse-cursor: pointer; } }
                Text { x: root.W - 34px; text: "✕"; font-size: 14px; color: #A3A5AE; vertical-alignment: center; height: parent.height; TouchArea { clicked => { S.t-close(); } mouse-cursor: pointer; } }
                Rectangle { y: parent.height - 1px; height: 1px; background: G.line; }
            }
            ScrollView {
                y: 46px; height: parent.height - 46px - 42px;
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 14px;
                    alignment: start;
                    // раскладка: в прокрутке (колонка окна прокручивается)
                    TextInput {
                        text: S.t-title;
                        font-size: 22px;
                        font-weight: 600;
                        color: G.ink;
                        single-line: false;
                        wrap: word-wrap;
                        selection-background-color: G.accent-line;
                        edited => { S.t-title-set(self.text); }
                    }
                    // серая плашка
                    Rectangle {
                        border-radius: 8px;
                        background: #2A2B30;
                        height: pl.preferred-height;
                        pl := VerticalLayout {
                            padding: 12px;
                            spacing: 12px;
                            if S.t-cols.length > 0: TRow {
                                label: "КОЛОНКА";
                                height: ceil(S.t-cols.length / 2) * 34px - 6px;
                                for c[i] in S.t-cols: MChip {
                                    x: 106px + mod(i, 2) * (root.fw / 2 + 4px); y: floor(i / 2) * 34px; width: root.fw / 2 - 2px;
                                    text: c.label.to-uppercase() + (c.hint != "" ? " · " + c.hint : "");
                                    on: c.on; hue: G.accent;
                                    clicked => { S.t-col(c.id); }
                                }
                            }
                            TRow {
                                label: "ПРИОРИТЕТ";
                                height: 28px;
                                for p[i] in ["!!!", "!!", "!", "—"]: MChip {
                                    x: 106px + i * 42px; width: 36px;
                                    text: p; on: (i < 3 && S.t-prio == i + 1) || (i == 3 && S.t-prio == 0);
                                    clicked => { S.t-prio-set(i == 3 ? 0 : i + 1); }
                                }
                            }
                            TRow {
                                label: "СРОК";
                                height: srow.preferred-height;
                                srow := VerticalLayout {
                                    x: 106px; width: parent.width - 106px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        MChip { text: S.t-due-label == "" ? "БЕЗ СРОКА" : S.t-due-label.to-uppercase(); on: S.t-due-label != ""; clicked => { S.dp-open-task(); } }
                                    }
                                    if root.due-edit: Field {
                                        height: 30px; font-size: 13px; text: S.t-due; placeholder: "завтра 17:00 · пт · 25.11 · Enter";
                                        init => { self.grab(); }
                                        accepted(t) => { S.t-due-set(t); root.due-edit = false; }
                                        escape => { root.due-edit = false; }
                                    }
                                    if root.due-edit: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        MChip { text: "СЕГОДНЯ"; clicked => { S.t-due-set("сегодня"); root.due-edit = false; } }
                                        MChip { text: "ЗАВТРА"; clicked => { S.t-due-set("завтра"); root.due-edit = false; } }
                                        MChip { text: "БЕЗ СРОКА"; clicked => { S.t-due-set(""); root.due-edit = false; } }
                                    }
                                }
                            }
                            TRow {
                                label: "НАПОМНИТЬ";
                                height: ceil(S.t-reminds.length / 3) * 34px - 6px;
                                for r[i] in S.t-reminds: MChip {
                                    x: 106px + mod(i, 3) * (root.fw / 3 + 2px); y: floor(i / 3) * 34px;
                                    width: root.fw / 3 - 4px;
                                    text: r.label.to-uppercase(); on: r.on; x-mark: r.on;
                                    clicked => { S.t-remind(r.id); }
                                }
                            }
                        }
                    }
                    // подзадачи
                    Text { text: "ПОДЗАДАЧИ" + (S.t-subs.length > 0 ? " · " + S.t-subs.length : ""); font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px; color: #A3A5AE; }
                    VerticalLayout {
                        spacing: 0;
                        for sb in S.t-subs: Rectangle {
                            height: 31px;
                            Rectangle {
                                x: 0; y: 8px; width: 14px; height: 14px; border-radius: 3px;
                                border-width: 1px; border-color: #7C7E88;
                                background: sb.done ? #3D3E45 : transparent;
                                Text { text: "✓"; visible: sb.done; color: G.ink; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { S.t-sub-toggle(sb.id); } mouse-cursor: pointer; }
                            }
                            st := Text {
                                x: 24px; width: parent.width - 24px; text: sb.title; color: sb.done ? G.dim : G.ink; font-size: 13.5px; vertical-alignment: center; height: parent.height; overflow: elide;
                                Rectangle { visible: sb.done; y: parent.height / 2 + 1px; height: 1px; width: min(parent.width, st.preferred-width); background: G.dim; }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                        }
                        Field { height: 32px; bare: true; font-size: 13px; placeholder: "＋ Подзадача"; accepted(t) => { if (t != "") { S.t-sub-add(t); self.clear(); } } }
                    }
                    Text { text: "ЗАМЕТКА"; font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px; color: #A3A5AE; }
                    TextEdit {
                        height: 96px;
                        text: S.t-notes;
                        font-size: 13.5px;
                        wrap: word-wrap;
                        edited(t) => { S.t-notes-set(t); }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 14px;
                        alignment: start;
                        Text { text: (root.more ? "− " : "+ ") + "ЕЩЁ"; font-family: G.mono; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; color: G.ink; vertical-alignment: center; TouchArea { clicked => { root.more = !root.more; } mouse-cursor: pointer; } }
                        Text { text: "ПОВТОР · ЦВЕТ · КАРТИНКА"; font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: #7A7C86; vertical-alignment: center; }
                    }
                    if root.more: TRow {
                        label: "ПОВТОР";
                        height: ceil(S.t-repeats.length / 3) * 34px - 6px;
                        for r[i] in S.t-repeats: MChip {
                            x: 106px + mod(i, 3) * (root.fw / 3 + 2px); y: floor(i / 3) * 34px;
                            width: root.fw / 3 - 4px;
                            text: r.label.to-uppercase(); on: r.on;
                            clicked => { S.t-repeat(r.id); }
                        }
                    }
                }
            }
            // низ
            Rectangle {
                y: parent.height - 42px; height: 42px;
                Rectangle { y: 0; height: 1px; background: G.line; }
                Rectangle { x: 16px; y: 18px; width: 6px; height: 6px; border-radius: 3px; background: G.green; }
                Text { x: 30px; text: S.t-saved.to-uppercase(); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.3px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
            }
            // меню ···
            if root.menu: Rectangle {
                x: root.W - 190px; y: 40px; width: 176px; height: 84px;
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009;
                VerticalLayout {
                    padding: 5px;
                    for it[i] in ["Дублировать", "Удалить"]: Rectangle {
                        height: 36px; border-radius: 5px;
                        background: ia.has-hover ? G.node-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { name: i == 0 ? "copy" : "trash"; c: i == 1 ? G.red : G.muted; width: 14px; y: (parent.height - 14px) / 2; }
                            Text { text: it; font-size: 13px; color: i == 1 ? G.red : G.ink; vertical-alignment: center; }
                        }
                        ia := TouchArea { clicked => { root.menu = false; if (i == 0) { S.t-dup(); } else { S.t-delete(); } } mouse-cursor: pointer; }
                    }
                }
            }
            // выбор списка
            if root.lists-open: Rectangle {
                x: 52px; y: 42px;
                width: 300px;
                height: min(260px, S.t-lists.length * 30px + 10px);
                border-radius: 8px;
                background: G.node;
                border-width: 1px;
                border-color: G.line;
                drop-shadow-blur: 16px;
                drop-shadow-color: #0009;
                ScrollView {
                    VerticalLayout {
                        padding: 5px;
                        for l in S.t-lists: Rectangle {
                            height: 30px;
                            border-radius: 5px;
                            background: la.has-hover ? G.node-hover : transparent;
                            Rectangle { x: 10px; y: 12px; width: 7px; height: 7px; border-radius: 1.5px; background: l.hue; }
                            Text { x: 26px; text: l.label; color: l.on ? G.accent-ink : G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - self.preferred-width - 10px; text: l.hint; color: #7A7C86; font-size: 11px; vertical-alignment: center; height: parent.height; }
                            la := TouchArea { clicked => { root.lists-open = false; S.t-move(l.id); } }
                        }
                    }
                }
            }
        }
        Brackets { x: win.x; y: win.y; width: win.width; height: win.height; }
    }
    init => { fs.focus(); }
}

// «Создать»: вид, умная строка, «Понял», «Куда», поля по виду.
// Акцент окна «Создать» — под цвет вида: задача рыжая, событие синее, привычка зелёная, день рождения фиолетовый.
global CK {
    out property <color> accent: S.c-kind == 1 ? G.blue : S.c-kind == 2 ? G.gold : S.c-kind == 3 ? G.violet : G.accent;
    out property <color> accent-wash: S.c-kind == 0 ? G.accent-wash : accent.mix(#1C1D21, 0.18);
    out property <color> accent-line: S.c-kind == 0 ? G.accent-line : accent.mix(#1C1D21, 0.45);
    out property <color> accent-ink: S.c-kind == 0 ? G.accent-ink : accent.mix(#FFFFFF, 0.6);
    out property <color> on-accent: S.c-kind == 0 ? G.on-accent : accent.mix(#000000, 0.2);
}

component CChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> x-mark;
    callback clicked;
    height: 32px;
    width: ct.preferred-width + (x-mark ? 40px : 26px);
    border-radius: 6px;
    border-width: 1px;
    border-color: on ? CK.accent : G.line;
    background: on ? CK.accent-wash : (ca.has-hover ? G.node-hover : transparent);
    ct := Text { x: 13px; text: root.text; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; }
    if x-mark: Text { x: parent.width - 18px; text: "×"; font-size: 12px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
    ca := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Превью «Появится на доске» — нода вне окна, провод цвета вида (§19).
component Preview inherits Rectangle {
    width: 236px;
    height: S.c-kind == 1 ? 30px + 4 * 28px + 12px : S.c-kind == 2 ? 30px + 118px : 30px + 92px;
    border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
    drop-shadow-blur: 16px; drop-shadow-color: #0008;
    property <color> hue: S.c-kind == 0 ? S.c-dest-hue : S.c-kind == 2 ? G.gold : (S.c-kind == 3 ? G.violet : G.blue);
    property <string> name: S.c-title == "" ? "Название" : S.c-title;
    Text { x: 12px; y: 8px; text: S.c-kind == 0 ? "ПОЯВИТСЯ НА ДОСКЕ" : S.c-kind == 2 ? "ПОЯВИТСЯ В «ПРИВЫЧКАХ»" : "ПОЯВИТСЯ В КАЛЕНДАРЕ"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1px; color: #A3A5AE; }
    Rectangle {
        x: 8px; y: 30px; width: parent.width - 16px; height: parent.height - 38px;
        border-radius: 6px; border-width: 1px; border-color: G.line; background: G.bg; clip: true;
        // задача — карточка доски
        if S.c-kind == 0: Rectangle {
            Rectangle {
                y: 0; height: 26px; background: root.hue.mix(#1C1D21, 0.55);
                Text { x: 10px; width: parent.width - 20px; text: S.c-dest.to-uppercase(); font-family: G.mono; font-size: 9.5px; font-weight: 600; letter-spacing: 1.2px; color: #fff; vertical-alignment: center; height: parent.height; overflow: elide; }
            }
            Rectangle {
                x: 10px; y: 38px; width: 36px; height: 36px; border-radius: 6px; background: root.hue.mix(#1C1D21, 0.3);
                Icon { x: 9px; y: 9px; width: 18px; height: 18px; name: "check"; c: #fff; }
            }
            Text { x: 56px; y: 38px; width: parent.width - 66px; text: root.name; font-size: 13.5px; font-weight: 600; color: S.c-title == "" ? #6E7079 : G.ink; overflow: elide; }
            Text { x: 56px; y: 58px; width: parent.width - 66px; text: S.c-meta + (S.c-subs.length > 0 ? " · 0 / " + S.c-subs.length : ""); font-size: 11.5px; color: #A3A5AE; overflow: elide; }
        }
        // событие — кусок дня в календаре
        if S.c-kind == 1: Rectangle {
            for h[i] in S.c-pv-hours: Rectangle {
                y: 6px + i * 28px; height: 28px;
                Text { x: 10px; y: 0; text: h; font-family: G.mono; font-size: 10px; color: #8A8C96; }
                Rectangle { y: 0; x: 52px; width: parent.width - 60px; height: 1px; background: G.line; }
            }
            Rectangle {
                x: 54px; y: 6px + 28px + 2px; width: parent.width - 64px; height: 44px;
                border-radius: 5px; border-width: 1px; border-color: G.blue; background: G.blue.mix(#1C1D21, 0.25);
                Text { x: 8px; y: 5px; width: parent.width - 16px; text: root.name; font-size: 12.5px; font-weight: 600; color: G.ink; overflow: elide; }
                Text { x: 8px; y: 23px; text: S.c-pv-sub; font-size: 11px; color: #C8CAD2; }
            }
        }
        // привычка — карточка с серией
        if S.c-kind == 2: Rectangle {
            Rectangle {
                x: 10px; y: 10px; width: 24px; height: 24px; border-radius: 5px; background: G.gold;
                Icon { x: 5px; y: 5px; width: 14px; height: 14px; name: "habits"; c: #2A1A0A; }
            }
            Text { x: 42px; y: 10px; height: 24px; width: parent.width - 100px; text: root.name; font-size: 13.5px; font-weight: 600; color: S.c-title == "" ? #6E7079 : G.ink; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width - self.preferred-width - 10px; y: 10px; height: 24px; text: S.c-pv-b; font-family: G.mono; font-size: 9.5px; letter-spacing: 1px; color: #A3A5AE; vertical-alignment: center; }
            Rectangle { y: 44px; height: 1px; background: G.line; }
            big := Text { x: 14px; y: 50px; text: S.c-pv-a; font-size: 40px; font-weight: 300; color: G.ink; }
            Text { x: 24px + big.preferred-width; y: 76px; text: "ДН ПОДРЯД"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1px; color: #A3A5AE; }
        }
        // день рождения — плашка с датой
        if S.c-kind == 3: Rectangle {
            Rectangle {
                x: 12px; y: 14px; width: 40px; height: 48px; border-radius: 5px; background: G.violet.mix(#1C1D21, 0.55);
                Text { y: 4px; width: parent.width; text: S.c-pv-a; font-size: 18px; font-weight: 600; color: #fff; horizontal-alignment: center; }
                Text { y: 30px; width: parent.width; text: S.c-pv-b; font-family: G.mono; font-size: 9px; letter-spacing: 1px; color: #fff; horizontal-alignment: center; }
            }
            Text { x: 62px; y: 14px; width: parent.width - 72px; text: S.c-title == "" ? "День рождения" : "День рождения " + S.c-title; font-size: 13px; font-weight: 600; color: G.ink; wrap: word-wrap; }
            Text { x: 62px; y: 34px; width: parent.width - 72px; text: S.c-pv-sub; font-size: 11.5px; color: #A3A5AE; wrap: word-wrap; }
        }
    }
}

component Cap inherits Text {
    font-family: G.mono; font-size: 10px; letter-spacing: 1.2px; color: #A3A5AE;
}

component Box inherits Rectangle {
    border-radius: 6px; border-width: 1px; border-color: G.line; background: G.bg;
}

// Поле даты со своим выпадающим календарём (не большое окно «Срок»).
component DateBox inherits Box {
    in property <bool> dated: true;
    out property <bool> open;
    border-color: root.open ? CK.accent : G.line;
    Icon { x: 12px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; name: "calendar"; c: #A3A5AE; }
    Text { x: 36px; text: S.c-day; font-size: 13.5px; font-weight: 600; color: root.dated ? G.ink : #8A8C96; vertical-alignment: center; height: parent.height; }
    Chev { x: parent.width - 20px; y: (parent.height - 10px) / 2; }
    TouchArea { clicked => { root.open = !root.open; } mouse-cursor: pointer; }
    if root.open: Rectangle {
        x: 0; y: parent.height + 4px; width: 7 * 36px + 20px; height: 44px + 26px + ceil(S.c-cal.length / 7) * 32px + 10px; z: 20;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        drop-shadow-blur: 16px; drop-shadow-color: #0009;
        TouchArea { }
        Text { x: 12px; y: 0; height: 40px; text: S.c-cal-month; font-size: 13.5px; font-weight: 600; color: G.ink; vertical-alignment: center; }
        for st[k] in [-1, 1]: Rectangle {
            x: parent.width - 70px + k * 30px; y: 8px; width: 26px; height: 24px; border-radius: 5px;
            border-width: 1px; border-color: G.line; background: sa.has-hover ? G.node-hover : transparent;
            Text { text: st < 0 ? "‹" : "›"; color: G.ink; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { clicked => { S.c-cal-step(st); } mouse-cursor: pointer; }
        }
        for d[i] in ["ПН", "ВТ", "СР", "ЧТ", "ПТ", "СБ", "ВС"]: Text {
            x: 10px + i * 36px; y: 44px; width: 36px; text: d; font-family: G.mono; font-size: 9.5px; color: #8A8C96; horizontal-alignment: center;
        }
        for c[i] in S.c-cal: Rectangle {
            x: 10px + mod(i, 7) * 36px; y: 64px + floor(i / 7) * 32px; width: 34px; height: 30px; border-radius: 5px;
            background: c.sel ? CK.accent : (ca.has-hover ? G.node-hover : transparent);
            border-width: c.today && !c.sel ? 1px : 0; border-color: CK.accent-line;
            Text { text: c.n; font-size: 13px; color: c.sel ? CK.on-accent : (c.other ? #5A5C66 : G.ink); horizontal-alignment: center; vertical-alignment: center; }
            ca := TouchArea { clicked => { S.c-strip-set(c.day); root.open = false; } mouse-cursor: pointer; }
        }
    }
}

// Тело окна задачи (§18–19): «Когда», полоса дней, «Попадёт», подзадачи и заметка; справа «Свойства».
component TaskBody inherits Rectangle {
    callback sub-focus;
    callback grab-line;
    property <bool> topen;
    property <length> LW: self.width - 248px - 22px;
    property <bool> dated: S.c-day != "Без срока";
    lv := VerticalLayout {
        x: 0; y: 0;
        width: root.LW; height: root.height;
        spacing: 8px;
        Cap { text: "КОГДА"; }
        HorizontalLayout {
            height: 36px; spacing: 8px;
            Box {
                width: 104px;
                border-color: root.topen ? CK.accent : G.line;
                Icon { x: 12px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; name: "clock"; c: #A3A5AE; }
                Text { x: 32px; text: S.c-time == "" ? "—:—" : S.c-time; font-family: G.mono; font-size: 13.5px; color: S.c-time == "" ? #6E7079 : G.ink; vertical-alignment: center; height: parent.height; }
                Chev { x: parent.width - 18px; y: (parent.height - 10px) / 2; }
                TouchArea { clicked => { root.topen = !root.topen; } mouse-cursor: pointer; }
            }
            wdate1 := DateBox { dated: root.dated; }
        }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            for q in S.c-quick: CChip { text: q.label; on: q.on; clicked => { S.c-quick-set(q.id); root.grab-line(); } }
        }
        HorizontalLayout {
            spacing: 6px; alignment: start; height: 24px;
            Text { text: "→ Попадёт"; font-size: 12.5px; font-weight: 600; color: CK.accent; vertical-alignment: center; }
            for l in S.c-lands: Rectangle {
                width: lt.preferred-width + 16px; border-radius: 4px; background: G.node-hover;
                lt := Text { text: l; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        for l in S.c-lands2: HorizontalLayout {
            alignment: start; height: 24px; padding-left: 78px;
            Rectangle {
                width: lt2.preferred-width + 16px; border-radius: 4px; background: G.node-hover;
                lt2 := Text { text: l; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Rectangle { height: 4px; }
        VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;
            // подзадачи: список прокручивается, окно не растёт
            Box {
                height: 124px;
                Cap { x: 10px; y: 0; height: 30px; text: "ПОДЗАДАЧИ"; vertical-alignment: center; }
                Cap { x: parent.width - self.preferred-width - 10px; y: 0; height: 30px; text: "0 / " + S.c-subs.length; vertical-alignment: center; }
                Rectangle { y: 30px; height: 1px; background: G.line; }
                ScrollView {
                    y: 31px; height: parent.height - 31px - 32px;
                    VerticalLayout {
                        alignment: start;
                        for st[i] in S.c-subs: Rectangle {
                            height: 30px;
                            Rectangle { x: 10px; y: 8px; width: 14px; height: 14px; border-radius: 3px; border-width: 1.5px; border-color: G.line-strong; }
                            Text { x: 32px; width: parent.width - 58px; text: st; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                            Text { x: parent.width - 20px; text: "×"; visible: xa.has-hover; color: #A3A5AE; font-size: 13px; vertical-alignment: center; height: parent.height; }
                            xa := TouchArea { x: parent.width - 26px; width: 26px; clicked => { S.c-sub-del(i); } mouse-cursor: pointer; }
                            Rectangle { y: parent.height - 1px; height: 1px; background: G.line; }
                        }
                    }
                }
                sf := Field {
                    x: 6px; y: parent.height - 32px; width: parent.width - 12px; height: 32px;
                    bare: true; font-size: 12.5px;
                    placeholder: "+ подзадача · Enter";
                    accepted(t) => { S.c-sub-add(t); sf.clear(); sf.grab(); root.sub-focus(); }
                    edited(t) => { root.sub-focus(); }
                    escape => { root.grab-line(); }
                }
            }
            // заметка
            Box {
                vertical-stretch: 1; min-height: 80px;
                clip: true;
                Cap { x: 10px; y: 0; height: 30px; text: "ЗАМЕТКА"; vertical-alignment: center; }
                Rectangle { y: 30px; height: 1px; background: G.line; }
                TouchArea { clicked => { nt.grab(); root.sub-focus(); } mouse-cursor: text; }
                Text { x: 10px; y: 38px; width: parent.width - 20px; visible: nt.text == ""; text: "Ракурс, референсы…"; font-size: 12.5px; color: #6E7079; wrap: word-wrap; }
                nt := ScrollInput {
                    x: 10px; y: 38px; width: parent.width - 20px; height: parent.height - 46px;
                    text: S.c-notes;
                    edited(t) => { S.c-notes-set(t); root.sub-focus(); }
                    escape => { root.grab-line(); }
                }
            }
        }
    }
    // время — шаг 15 минут
    if root.topen: Rectangle {
        x: 0; y: 54px; width: 130px; height: 260px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        drop-shadow-blur: 16px; drop-shadow-color: #0009;
        TouchArea { }
        ScrollView {
            VerticalLayout {
                padding: 5px;
                Rectangle {
                    height: 28px; border-radius: 5px; background: na.has-hover ? G.node-hover : transparent;
                    Text { x: 10px; text: "без времени"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
                    na := TouchArea { clicked => { S.c-time-set(""); root.topen = false; root.grab-line(); } mouse-cursor: pointer; }
                }
                for tm in S.c-times: Rectangle {
                    height: 28px; border-radius: 5px; background: ta.has-hover ? G.node-hover : (tm == S.c-time ? CK.accent-wash : transparent);
                    Text { x: 10px; text: tm; font-family: G.mono; font-size: 12.5px; color: tm == S.c-time ? CK.accent : G.ink; vertical-alignment: center; height: parent.height; }
                    ta := TouchArea { clicked => { S.c-time-set(tm); root.topen = false; root.grab-line(); } mouse-cursor: pointer; }
                }
            }
        }
    }
    // «Свойства»
    Rectangle {
        x: root.width - 248px; y: 0; width: 248px; height: pv.preferred-height;
        border-radius: 8px; border-width: 1px; border-color: G.line; background: G.bg;
        pv := VerticalLayout {
            alignment: start;
            Cap { height: 32px; text: "   СВОЙСТВА"; vertical-alignment: center; }
            for p[i] in S.c-props: Rectangle {
                height: 31px;
                z: p.id == S.c-popen ? 10 : 0;
                property <bool> can: p.id != "color" && p.id != "image" && p.id != "who";
                Rectangle { y: 0; height: 1px; background: G.line; }
                Rectangle { background: pa.has-hover && can ? G.node-hover : transparent; }
                Icon { x: 10px; y: (parent.height - 13px) / 2; width: 13px; height: 13px; name: p.id == "list" ? "board" : p.id == "col" ? "stage" : p.id == "prio" ? "priority" : p.id == "remind" ? "bell" : p.id == "repeat" ? "repeat" : "calendar"; c: #8A8C96; }
                Text { x: 30px; text: p.label; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
                Rectangle { x: 114px; y: 12px; width: 8px; height: 8px; border-radius: 4px; background: p.hue; visible: p.id == "list"; }
                Text { x: p.id == "list" ? 128px : 114px; width: parent.width - self.x - 24px; text: p.hint; font-size: 12.5px; font-weight: p.on ? 600 : 400;
                    color: !p.on ? #6E7079 : (p.id == "prio" ? #F0785F : (p.id == "list" ? CK.accent : G.ink)); vertical-alignment: center; height: parent.height; overflow: elide; }
                Chev { x: parent.width - 18px; y: (parent.height - 10px) / 2; visible: can && p.on; }
                pa := TouchArea { clicked => { S.c-prop(p.id); } mouse-cursor: can ? pointer : default; }
                if p.id == S.c-popen: Rectangle {
                    x: parent.width - 212px; y: parent.height; width: 208px;
                    height: min(240px, S.c-popts.length * 28px + 10px);
                    border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                    drop-shadow-blur: 16px; drop-shadow-color: #0009;
                    TouchArea { }
                    ScrollView {
                        VerticalLayout {
                            padding: 5px;
                            for o in S.c-popts: Rectangle {
                                height: 28px; border-radius: 5px; background: oa.has-hover ? G.node-hover : transparent;
                                Rectangle { x: 10px; y: 11px; width: 6px; height: 6px; border-radius: 3px; background: o.on ? CK.accent : transparent; }
                                Text { x: 24px; text: o.label; font-size: 12.5px; color: o.on ? CK.accent : G.ink; vertical-alignment: center; height: parent.height; }
                                Text { x: parent.width - self.preferred-width - 10px; text: o.hint; font-size: 11px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
                                oa := TouchArea { clicked => { S.c-prop-set(p.id, o.id); } mouse-cursor: pointer; }
                            }
                        }
                    }
                }
            }
        }
    }
}

// «Свойства» справа (§18–19): состав строк зависит от вида окна (задаёт rust).
component PropsPanel inherits Rectangle {
    width: 248px;
    height: pv.preferred-height;
    border-radius: 8px; border-width: 1px; border-color: G.line; background: G.bg;
    pv := VerticalLayout {
        alignment: start;
        Cap { height: 32px; text: "   СВОЙСТВА"; vertical-alignment: center; }
        for p[i] in S.c-props: Rectangle {
            height: 31px;
            z: p.id == S.c-popen ? 10 : 0;
            property <bool> can: p.id != "color" && p.id != "image" && p.id != "who";
            Rectangle { y: 0; height: 1px; background: G.line; }
            Rectangle { background: pa.has-hover && can ? G.node-hover : transparent; }
            Icon { x: 10px; y: (parent.height - 13px) / 2; width: 13px; height: 13px; name: p.id == "list" ? "board" : p.id == "col" ? "stage" : p.id == "prio" ? "priority" : p.id == "remind" ? "bell" : p.id == "repeat" ? "repeat" : "calendar"; c: #8A8C96; }
            Text { x: 30px; text: p.label; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
            Rectangle { x: 114px; y: 12px; width: 8px; height: 8px; border-radius: 4px; background: p.hue; visible: p.id == "list"; }
            Text { x: p.id == "list" ? 128px : 114px; width: parent.width - self.x - 24px; text: p.hint; font-size: 12.5px; font-weight: p.on ? 600 : 400;
                color: !p.on ? #6E7079 : (p.id == "prio" ? #F0785F : (p.id == "list" ? CK.accent : G.ink)); vertical-alignment: center; height: parent.height; overflow: elide; }
            Chev { x: parent.width - 18px; y: (parent.height - 10px) / 2; visible: can && p.on; }
            pa := TouchArea { clicked => { S.c-prop(p.id); } mouse-cursor: can ? pointer : default; }
            if p.id == S.c-popen: Rectangle {
                x: parent.width - 212px; y: parent.height; width: 208px;
                height: min(240px, S.c-popts.length * 28px + 10px);
                border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
                drop-shadow-blur: 16px; drop-shadow-color: #0009;
                TouchArea { }
                ScrollView {
                    VerticalLayout {
                        padding: 5px;
                        for o in S.c-popts: Rectangle {
                            height: 28px; border-radius: 5px; background: oa.has-hover ? G.node-hover : transparent;
                            Rectangle { x: 10px; y: 11px; width: 6px; height: 6px; border-radius: 3px; background: o.on ? CK.accent : transparent; }
                            Text { x: 24px; text: o.label; font-size: 12.5px; color: o.on ? CK.accent : G.ink; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - self.preferred-width - 10px; text: o.hint; font-size: 11px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
                            oa := TouchArea { clicked => { S.c-prop-set(p.id, o.id); } mouse-cursor: pointer; }
                        }
                    }
                }
            }
        }
    }
}

// Поле времени с выпадающим списком (шаг 15 минут); пустое — «—:—». clearable — строка «без времени».
component TimeBox inherits Box {
    callback picked(string);
    in property <string> val;
    in property <bool> clearable;
    out property <bool> open;
    width: 104px;
    border-color: root.open ? CK.accent : G.line;
    function put(raw: string) {
        if (raw == "") { return; }
        if (raw == "none") { root.picked(""); root.open = false; return; }
        let t = S.c-tnorm(raw, root.val);
        if (t != "") { root.picked(t); }
    }
    Icon { x: 12px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; name: "clock"; c: #A3A5AE; }
    Text { x: 32px; text: root.val == "" ? "—:—" : root.val; font-family: G.mono; font-size: 13.5px; color: root.val == "" ? #6E7079 : G.ink; vertical-alignment: center; height: parent.height; }
    Chev { x: parent.width - 18px; y: (parent.height - 10px) / 2; }
    TouchArea {
        clicked => { root.open = !root.open; }
        mouse-cursor: pointer;
        // колесо: ±15 минут без открытия выбора
        scroll-event(e) => {
            if (e.delta-y > 0) { root.put("+15"); return accept; }
            if (e.delta-y < 0) { root.put("-15"); return accept; }
            reject
        }
    }
    if root.open: Rectangle {
        x: 0; y: parent.height + 4px; width: 300px; height: 12px + 34px + 8px + 30px + 10px + 4 * 30px + 12px; z: 20;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        drop-shadow-blur: 16px; drop-shadow-color: #0009;
        TouchArea { }
        inp := Field {
            x: 12px; y: 12px; width: parent.width - 24px; height: 34px; mono: true;
            placeholder: "1730, 17, 5pm…";
            accepted(t) => { root.put(t); root.open = false; }
            escape => { root.open = false; }
        }
        HorizontalLayout {
            x: 12px; y: 54px; width: parent.width - 24px; height: 30px; spacing: 4px;
            for q[i] in ["Через час", "Утром 9:00", "Вечером 19:00", "Без времени"]: Rectangle {
                visible: i < 3 || root.clearable;
                border-radius: 5px; border-width: 1px; border-color: G.line; background: qa.has-hover ? G.node-hover : transparent;
                Text { text: q; font-size: 11px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                qa := TouchArea { clicked => { root.put(["hour", "09:00", "19:00", "none"][i]); root.open = false; } mouse-cursor: pointer; }
            }
        }
        // часы 6×4 и минуты
        for h[i] in 24: Rectangle {
            x: 12px + mod(i, 6) * 38px; y: 94px + floor(i / 6) * 30px; width: 35px; height: 27px; border-radius: 5px;
            property <string> hs: (i < 10 ? "0" : "") + i;
            property <string> nx: (i + 1 < 10 ? "0" : "") + (i + 1);
            property <bool> on: root.val != "" && root.val >= hs + ":00" && root.val < nx + ":00";
            background: on ? CK.accent-wash : (ha.has-hover ? G.node-hover : transparent);
            border-width: 1px; border-color: on ? CK.accent : G.line;
            Text { text: parent.hs; font-family: G.mono; font-size: 12px; color: parent.on ? CK.accent : G.ink; horizontal-alignment: center; vertical-alignment: center; }
            ha := TouchArea { clicked => { root.put("h" + parent.hs); } mouse-cursor: pointer; }
        }
        for m[i] in ["00", "15", "30", "45"]: Rectangle {
            x: parent.width - 12px - 46px; y: 94px + i * 30px; width: 46px; height: 27px; border-radius: 5px;
            background: ma.has-hover ? G.node-hover : transparent;
            border-width: 1px; border-color: G.line;
            Text { text: ":" + m; font-family: G.mono; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
            ma := TouchArea { clicked => { root.put("m" + m); root.open = false; } mouse-cursor: pointer; }
        }
        init => { inp.grab(); }
    }
}

// Заметка во всю ширину левой колонки (событие, привычка, день рождения).
component NoteBox inherits Box {
    callback sub-focus;
    callback grab-line;
    in property <string> hint: "Заметка…";
    height: 124px;
    Cap { x: 10px; y: 0; height: 30px; text: "ЗАМЕТКА"; vertical-alignment: center; }
    Rectangle { y: 30px; height: 1px; background: G.line; }
    TouchArea { clicked => { nt.grab(); root.sub-focus(); } mouse-cursor: text; }
    Text { x: 10px; y: 38px; width: parent.width - 20px; visible: nt.text == ""; text: root.hint; font-size: 12.5px; color: #6E7079; wrap: word-wrap; }
    nt := ScrollInput {
        x: 10px; y: 38px; width: parent.width - 20px; height: parent.height - 46px;
        text: S.c-notes;
        edited(t) => { S.c-notes-set(t); root.sub-focus(); }
        escape => { root.grab-line(); }
    }
}

// Событие (G_CreateEvent): «Когда» (время, дата, быстрые кнопки, полоса дней), «Длится», «свободно до…», место, заметка.
component EventBody inherits Rectangle {
    callback sub-focus;
    callback grab-line;
    property <length> LW: self.width - 248px - 22px;
    property <bool> dated: S.c-day != "Без срока";
    height: max(lv.preferred-height, pp.height);
    lv := VerticalLayout {
        x: 0; y: 0;
        width: root.LW;
        spacing: 8px;
        alignment: start;
        Cap { text: "КОГДА"; }
        HorizontalLayout {
            height: 36px; spacing: 8px;
            z: wtime.open ? 20 : 0;
            wtime := TimeBox { val: S.c-time; clearable: true; picked(t) => { S.c-time-set(t); root.grab-line(); } }
            wdate2 := DateBox { dated: root.dated; }
        }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            for q in S.c-quick: CChip { text: q.label; on: q.on; clicked => { S.c-quick-set(q.id); root.grab-line(); } }
        }
        Cap { text: "ДЛИТСЯ"; }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            z: wend.open ? 20 : 0;
            for d in S.c-durs: CChip { text: d.label; on: d.on; clicked => { S.c-dur-set(d.id); root.grab-line(); } }
            Text { text: "  или до"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; }
            wend := TimeBox { height: 32px; val: S.c-end; picked(t) => { S.c-end-set(t); root.grab-line(); } }
        }
        if S.c-free != "": HorizontalLayout {
            height: 26px; spacing: 8px; alignment: start;
            Rectangle { y: 9px; width: 8px; height: 8px; border-radius: 4px; background: S.c-free-warn ? G.red : G.green; }
            Text { text: S.c-free; font-size: 12.5px; font-weight: 600; color: S.c-free-warn ? G.red : G.green; vertical-alignment: center; }
        }
        Cap { text: "МЕСТО"; }
        Field {
            height: 36px;
            placeholder: "Адрес или ссылка на созвон";
            text: S.c-place;
            edited(t) => { S.c-place-set(t); root.sub-focus(); }
            accepted => { root.grab-line(); }
            escape => { root.grab-line(); }
        }
        Rectangle { height: 4px; }
        NoteBox { height: 76px; hint: "Повестка, ссылки…"; sub-focus => { root.sub-focus(); } grab-line => { root.grab-line(); } }
    }
    pp := PropsPanel { x: root.width - 248px; y: 0; }
}

// Привычка (G_CreateHabit): значок, «Как часто» (свои дни / N раз), окно времени и часть дня, заметка.
component HabitBody inherits Rectangle {
    callback sub-focus;
    callback grab-line;
    property <length> LW: self.width - 248px - 22px;
    height: max(lv.preferred-height, pp.height);
    lv := VerticalLayout {
        x: 0; y: 0;
        width: root.LW;
        spacing: 8px;
        alignment: start;
        Cap { text: "ЗНАЧОК"; }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            for ic in S.c-hicons: Rectangle {
                width: 34px; height: 32px; border-radius: 6px; border-width: 1px;
                border-color: ic.on ? CK.accent : G.line; background: ic.on ? CK.accent-wash : (ia.has-hover ? G.node-hover : transparent);
                Icon { x: 9px; y: 8px; width: 16px; height: 16px; name: ic.id; c: ic.on ? CK.accent : G.ink; }
                ia := TouchArea { clicked => { S.c-hicon(ic.id); root.grab-line(); } mouse-cursor: pointer; }
            }
            Text { height: 32px; text: "будет в списке привычек"; font-size: 11.5px; color: #8A8C96; vertical-alignment: center; }
        }
        Cap { text: "КОГДА"; }
        HorizontalLayout {
            height: 36px; spacing: 8px; alignment: start;
            z: ws.open || we.open ? 20 : 0;
            ws := TimeBox { val: S.c-hwin-s; picked(t) => { S.c-hwin-s-set(t); root.grab-line(); } }
            Text { text: "до"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; }
            we := TimeBox { val: S.c-hwin-e; picked(t) => { S.c-hwin-e-set(t); root.grab-line(); } }
            for p in S.c-hpart: CChip { text: p.label; on: p.on; clicked => { S.c-hpart-set(p.id); root.grab-line(); } }
        }
        Cap { text: "КАК ЧАСТО"; }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            for fq in S.c-hfreq: CChip { text: fq.label; on: fq.on; clicked => { S.c-hfreq-set(fq.id); root.grab-line(); } }
        }
        if S.c-hfreq.length > 2 && S.c-hfreq[2].on: HorizontalLayout {
            spacing: 6px; alignment: start;
            for d[i] in S.c-hdays: CChip { text: d.label; on: d.on; clicked => { S.c-hday(i); root.grab-line(); } }
        }
        if S.c-hfreq.length > 3 && S.c-hfreq[3].on: HorizontalLayout {
            spacing: 6px; alignment: start;
            for p in S.c-hper: CChip { text: p.label; on: p.on; clicked => { S.c-hper-set(p.id); root.grab-line(); } }
            Text { height: 32px; text: "в неделю"; font-size: 11.5px; color: #8A8C96; vertical-alignment: center; }
        }
        Rectangle { height: 4px; }
        NoteBox { hint: "Зачем и как…"; sub-focus => { root.sub-focus(); } grab-line => { root.grab-line(); } }
    }
    pp := PropsPanel { x: root.width - 248px; y: 0; }
}

// День рождения (G_CreateBday): дата и год, «подарок заранее», заметка.
component BdayBody inherits Rectangle {
    callback sub-focus;
    callback grab-line;
    property <length> LW: self.width - 248px - 22px;
    height: max(lv.preferred-height, pp.height);
    lv := VerticalLayout {
        x: 0; y: 0;
        width: root.LW;
        spacing: 8px;
        alignment: start;
        Cap { text: "КОГДА"; }
        HorizontalLayout {
            height: 36px; spacing: 8px;
            wdate3 := DateBox { dated: true; }
            Field {
                width: 90px; height: 36px; mono: true;
                placeholder: "год";
                text: S.c-year;
                edited(t) => { S.c-year-set(t); root.sub-focus(); }
                accepted => { root.grab-line(); }
                escape => { root.grab-line(); }
            }
        }
        Cap { text: "КАЖДЫЙ ГОД · ГОД НЕОБЯЗАТЕЛЕН — НУЖЕН ДЛЯ «ИСПОЛНИТСЯ N»"; }
        Rectangle { height: 2px; }
        Cap { text: "ПОДАРОК, НАПОМНИТЬ ЗАРАНЕЕ"; }
        HorizontalLayout {
            spacing: 6px; alignment: start;
            for gf in S.c-gift: CChip { text: gf.label; on: gf.on; clicked => { S.c-gift-set(gf.id); root.grab-line(); } }
        }
        Rectangle { height: 4px; }
        NoteBox { hint: "Идеи подарков, размеры, что любит…"; sub-focus => { root.sub-focus(); } grab-line => { root.grab-line(); } }
    }
    pp := PropsPanel { x: root.width - 248px; y: 0; }
}

// Окно «Создать» (как в старом трекере): строка понимает дату, время, !!!, @список, #тип и повтор — в название они не идут;
// всё понятое — чипы «×» (вернуть в название), срок и приоритет — ещё и кнопками (кнопка главнее текста, текст не трогает).
// Клавиши работают и из строки: Alt+1…4 вид, Alt+L список/календарь, Alt+D срок, Ctrl+Enter добавить,
// Tab — выйти из строки (тогда те же клавиши без Alt), Esc — закрыть.
export component CreateDialog inherits Overlay {
    property <bool> dp: S.dp-open;
    changed dp => { if (self.dp) { keys.focus(); } else { line.grab(); } }
    close => { S.c-close(); }
    property <bool> inner;   // фокус в подзадаче или заметке — клавиши без Alt не перехватывать
    property <length> W: min(840px, self.width - 32px);
    property <length> body-h: S.c-kind == 0 ? 0px : (S.c-kind == 1 ? eb.height : (S.c-kind == 2 ? hb2.height : bb.height));
    // высота по содержимому
    property <length> H: min(620px, self.height - 48px);   // одна высота для всех видов, окно не скачет
    // превью — отдельная нода справа от окна, если хватает места
    property <bool> side: self.width >= root.W + 300px;
    property <color> hue: S.c-kind == 0 ? S.c-dest-hue : S.c-kind == 2 ? G.gold : (S.c-kind == 3 ? G.violet : G.blue);
    // цвет окна по виду: задача — рыжий, событие — синий, привычка — зелёный, день рождения — фиолетовый
    property <color> kc: S.c-kind == 1 ? #2F5A9A : S.c-kind == 2 ? #8A6A1E : S.c-kind == 3 ? #6A4A9A : G.head-main;
    property <bool> fits: hl.preferred-width < line.width - 4px && S.c-text == line.text;
    function submit(more: bool) {
        if (line.text == "") { line.grab(); return; }
        S.c-submit(line.text, more);
        if (more) { line.clear(); line.grab(); }
    }
    // общие клавиши; bare — строка не в фокусе (можно без Alt)
    function hk(e: KeyEvent, bare: bool) -> bool {
        if (e.text == Key.Escape) {
            if (S.c-popen != "") { S.c-prop(S.c-popen); } else { S.c-close(); }
            return true;
        }
        if (e.text == Key.Return && e.modifiers.control) { root.submit(false); return true; }
        if (e.text == Key.Tab && !e.modifiers.control) {
            if (line.focused) { keys.focus(); } else { line.grab(); }
            return true;
        }
        if (!(e.modifiers.alt || bare) || e.modifiers.control) { return false; }
        if (e.text == "1") { S.c-kind-set(0); return true; }
        if (e.text == "2") { S.c-kind-set(1); return true; }
        if (e.text == "3") { S.c-kind-set(2); return true; }
        if (e.text == "4") { S.c-kind-set(3); return true; }
        if (e.text == "l" || e.text == "L" || e.text == "д" || e.text == "Д") {
            if (S.c-kind == 0 || S.c-kind == 2) { S.c-prop("list"); }
            if (S.c-kind == 1 || S.c-kind == 3) { S.c-prop("cal"); }
            return true;
        }
        if (e.text == "d" || e.text == "D" || e.text == "в" || e.text == "В") {
            if (S.c-kind != 2) { S.c-pick-date(); }
            return true;
        }
        if (bare && e.text == Key.Return) { root.submit(e.modifiers.shift); return true; }
        false
    }
    keys := FocusScope {
        capture-key-pressed(e) => {
            if (S.dp-open || self.has-focus || root.inner) { return reject; }
            if (root.hk(e, false)) { return accept; }
            reject
        }
        key-pressed(e) => {
            if (S.dp-open) { return reject; }
            if (root.hk(e, true)) { return accept; }
            reject
        }
    win := Rectangle {
        x: (parent.width - root.W - (root.side ? 270px : 0)) / 2;
        y: max(24px, (parent.height - root.H) / 2 - 10px);
        width: root.W;
        height: root.H;
        border-radius: 12px;
        background: G.node;
        border-width: 1px;
        border-color: root.kc;
        drop-shadow-blur: 32px;
        drop-shadow-color: #000c;
        // без clip: выпадающие списки «Свойств» не должны обрезаться краем окна
        // клик по пустому месту — выйти из строки (клавиши без Alt)
        TouchArea { clicked => { keys.focus(); } }
        // вкладки видов
        Rectangle {
            height: 46px; y: 0;
            border-top-left-radius: 12px; border-top-right-radius: 12px;
            background: root.kc;
            animate background { duration: 150ms; }
            for k[i] in ["Задача", "Событие", "Привычка", "День рождения"]: Rectangle {
                x: 12px + i * (root.W - 66px) / 4;
                y: 7px;
                width: (root.W - 66px) / 4 - 4px;
                height: 32px;
                border-radius: 6px;
                background: S.c-kind == i ? G.ink : (ka.has-hover ? #0002 : transparent);
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Icon { y: (parent.height - 14px) / 2; width: 14px; height: 14px; name: ["check", "event", "habits", "birthday"][i]; c: S.c-kind == i ? root.kc.mix(#000, 0.6) : #fff; }
                    Text { text: k; font-size: 14px; font-weight: 500; color: S.c-kind == i ? root.kc.mix(#000, 0.6) : #fff; vertical-alignment: center; }
                    Text { text: "ALT " + (i + 1); font-family: G.mono; font-size: 9px; letter-spacing: 1px; color: S.c-kind == i ? root.kc.mix(#000, 0.8) : #ffffff90; vertical-alignment: center; }
                }
                ka := TouchArea { clicked => { S.c-kind-set(i); line.grab(); } mouse-cursor: pointer; }
            }
            Icon { x: root.W - 36px; y: 15px; width: 16px; height: 16px; name: "close"; c: #fff; TouchArea { clicked => { S.c-close(); } mouse-cursor: pointer; } }
        }
        // умная строка
        Rectangle {
            x: 22px; y: 64px; width: root.W - 44px; height: 52px;
            border-radius: 8px;
            border-width: 1px;
            border-color: line.focused ? CK.accent : G.line;
            background: G.bg;
            TouchArea { clicked => { line.grab(); } mouse-cursor: text; }
            // подсветка понятого: та же строка в цвете под прозрачным текстом поля; не влезает — обычный текст
            hl := StyledText {
                x: 16px; y: (parent.height - self.preferred-height) / 2;
                text: S.c-line-md; default-font-size: 17px; default-font-family: G.sans; default-color: G.ink; max-lines: 1;
                visible: line.text != "" && root.fits;
            }
            line := Field {
                x: 16px; width: parent.width - 32px; height: parent.height;
                bare: true;
                ink: root.fits && line.text != "" ? transparent : G.ink;
                font-size: 17px;
                text: S.c-text;
                placeholder: S.c-kind == 0 ? "Сделать иконки для клиента завтра 15:00 @работа !!" : S.c-kind == 1 ? "Созвон с Олей в пт 14:00" : S.c-kind == 2 ? "Вода 8 стаканов каждый день" : "Мама 12 марта";
                edited(t) => { S.c-changed(t); }
                accepted(t) => { root.submit(false); }
                shift-enter(t) => { root.submit(true); }
                escape => { S.c-close(); }
            }
        }
        // §19: задача — «Когда» слева, «Свойства» справа
        tb := TaskBody {
            visible: S.c-kind == 0;
            x: 22px; y: 132px; width: root.W - 44px; height: root.H - 132px - 60px - 18px;
            sub-focus => { root.inner = true; }
            grab-line => { root.inner = false; line.grab(); }
        }
        // виды 1–3 (§18–19): главное слева, «Свойства» справа
        eb := EventBody {
            visible: S.c-kind == 1;
            x: 22px; y: 132px; width: root.W - 44px;
            sub-focus => { root.inner = true; }
            grab-line => { root.inner = false; line.grab(); }
        }
        hb2 := HabitBody {
            visible: S.c-kind == 2;
            x: 22px; y: 132px; width: root.W - 44px;
            sub-focus => { root.inner = true; }
            grab-line => { root.inner = false; line.grab(); }
        }
        bb := BdayBody {
            visible: S.c-kind == 3;
            x: 22px; y: 132px; width: root.W - 44px;
            sub-focus => { root.inner = true; }
            grab-line => { root.inner = false; line.grab(); }
        }
        // низ
        Rectangle {
            y: root.H - 60px; height: 60px;
            Rectangle { y: 0; height: 1px; background: G.line; }
            Text { x: 22px; width: root.W - 22px - bl.preferred-width - 40px; text: "Enter — добавить · Esc — закрыть"; font-size: 12px; color: #A3A5AE; vertical-alignment: center; height: parent.height; overflow: elide; }
            bl := HorizontalLayout {
                x: root.W - 22px - self.preferred-width; y: 11px; height: 38px;
                spacing: 10px;
                Rectangle {
                    width: mt.preferred-width + 30px;
                    border-radius: 6px; border-width: 1px; border-color: #8A8C96;
                    background: ma.has-hover ? G.node-hover : transparent;
                    mt := Text { text: "Добавить и ещё"; font-size: 13.5px; font-weight: 500; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                    ma := TouchArea { clicked => { root.submit(true); } mouse-cursor: pointer; }
                }
                Rectangle {
                    width: pt.preferred-width + 34px;
                    border-radius: 6px;
                    background: pa.has-hover ? CK.accent-ink : CK.accent;
                    pt := Text { text: ["Добавить задачу", "Добавить событие", "Добавить привычку", "Добавить день рождения"][S.c-kind]; font-size: 13.5px; font-weight: 600; color: CK.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                    pa := TouchArea { clicked => { root.submit(false); } mouse-cursor: pointer; }
                }
            }
        }
    }
    Brackets { x: win.x; y: win.y; width: win.width; height: win.height; }
    if root.side: Preview { x: win.x + win.width + 34px; y: win.y + 132px; }
    if root.side: Rectangle {
        x: win.x + win.width; y: win.y + 132px + 46px; width: 34px; height: 2px;
        background: root.hue;
        Rectangle { x: 30px; y: -3px; width: 8px; height: 8px; border-radius: 4px; background: root.hue; }
    }
    }
    init => { line.grab(); }
}

// Поиск Ctrl+K (макет G_Search): панель по центру сверху — поле, группы с числом найденного,
// клавиши ↑ ↓ / Enter / Esc, «ё = е».
// Поиск (G_Search, п.8): поле «Найти» в шапке вырастает до 400 px, результаты — прямо под ним, 560 px по правому краю.
export component SearchDialog inherits Overlay {
    in property <length> right: root.width - 300px;
    in property <length> top: 14px;
    property <int> cur;
    property <string> q-text;
    background: transparent;
    close => { S.search-open-set(false); }
    property <length> fw: 400px;
    property <length> pw: min(560px, root.right - 16px);
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.DownArrow) { root.cur = min(S.found.length - 1, root.cur + 1); return accept; }
            if (e.text == Key.UpArrow) { root.cur = max(0, root.cur - 1); return accept; }
            reject
        }
        // поле на месте «Найти»
        Rectangle {
            x: root.right - root.fw; y: root.top; width: root.fw; height: 32px;
            border-radius: 8px; background: G.node; border-width: 1px; border-color: G.accent;
            TouchArea { }
            Icon { name: "search"; x: 10px; width: 14px; y: 9px; c: G.muted; }
            q := Field {
                x: 30px; width: parent.width - 120px; height: 30px; y: 1px;
                bare: true;
                font-size: 13.5px;
                placeholder: "Найти задачу, заметку, раздел…";
                edited(t) => { root.cur = 0; root.q-text = t; S.search(t); }
                accepted => { S.search-go(root.cur); }
                escape => { S.search-open-set(false); }
            }
            Text { x: parent.width - self.preferred-width - 10px; text: root.q-text == "" ? "CTRL K" : S.found.length + " найдено"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1px; color: #8A8C96; vertical-alignment: center; height: parent.height; }
        }
        // результаты под полем
        if root.q-text != "": Rectangle {
            x: root.right - root.pw; y: root.top + 38px; width: root.pw;
            height: min(root.height - self.y - 16px, rl.preferred-height + 41px);
            border-radius: 12px;
            background: G.node;
            border-width: 1px;
            border-color: G.accent;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000b;
            clip: true;
            TouchArea { }
            rl := VerticalLayout {
                y: 0; width: parent.width;
                padding: 6px; padding-top: 4px;
                alignment: start;
                if S.found.length == 0: Text { height: 52px; x: 10px; text: "Ничего не нашлось — попробуй другое слово"; color: #A3A5AE; font-size: 13px; vertical-alignment: center; }
                for f[i] in S.found: VerticalLayout {
                    visible: i < 14;
                    if f.head != "": Text {
                        height: 30px;
                        text: "    " + f.head;
                        font-size: 12.5px; color: #A3A5AE; vertical-alignment: center;
                    }
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: i == root.cur || fa.has-hover ? G.node-hover : transparent;
                        if f.kind != "раздел": Rectangle { x: 10px; y: 12px; width: 14px; height: 14px; border-radius: 3px; border-width: 1.2px; border-color: #8A8C96; }
                        if f.kind == "раздел": Rectangle { x: 13px; y: 16px; width: 6px; height: 6px; border-radius: 3px; background: f.hue; }
                        StyledText { x: f.kind == "раздел" ? 30px : 36px; width: parent.width - 240px; y: (parent.height - self.preferred-height) / 2; text: f.mark; default-color: G.ink; default-font-size: 13.5px; max-lines: 1; }
                        HorizontalLayout {
                            x: parent.width - self.preferred-width - 12px; height: parent.height; spacing: 16px;
                            if f.sub != "" && f.kind == "задача": HorizontalLayout {
                                spacing: 7px;
                                Rectangle { width: 6px; Rectangle { y: (parent.height - 6px) / 2; height: 6px; border-radius: 3px; background: f.hue; } }
                                Text { text: f.sub; color: #A3A5AE; font-size: 12.5px; vertical-alignment: center; }
                            }
                            if f.kind == "заметка" && f.sub != "": Text { text: "«…" + f.sub + "…»"; color: #A3A5AE; font-size: 12.5px; vertical-alignment: center; max-width: 220px; overflow: elide; }
                            if f.due != "": Text { text: f.due; color: #A3A5AE; font-size: 12.5px; vertical-alignment: center; }
                        }
                        fa := TouchArea { clicked => { S.search-go(i); } mouse-cursor: pointer; }
                    }
                }
            }
            // подвал с клавишами
            Rectangle {
                y: parent.height - 41px; height: 41px; width: parent.width;
                Rectangle { y: 0; height: 1px; background: G.line; }
                HorizontalLayout {
                    x: 14px; spacing: 6px; alignment: start;
                    for k[i] in ["↑ ↓", "ENTER", "ESC"]: HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            y: 11px; height: 18px; width: kt.preferred-width + 12px;
                            border-radius: 3px; border-width: 1px; border-color: G.line;
                            kt := Text { text: k; font-family: G.mono; font-size: 8.5px; color: #A3A5AE; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: ["выбрать", "открыть", "закрыть"][i]; font-size: 12px; color: #A3A5AE; vertical-alignment: center; }
                        Rectangle { width: 8px; }
                    }
                }
                Text { x: parent.width - self.preferred-width - 14px; text: "ё = е"; font-size: 12px; color: #8A8C96; vertical-alignment: center; height: parent.height; }
            }
        }
    }
    init => { q.grab(); }
}

export component Confirm inherits Overlay {
    close => { S.confirm-no(); }
    Node {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(420px, parent.width - 32px);
        // высота по тексту вопроса: длинный вопрос не прячет кнопки
        height: max(170px, 30px + cl.preferred-height);
        num: "!!";
        title: "ТОЧНО?";
        head: #8A3A2E;
        TouchArea { }
        cl := VerticalLayout {
            padding: 16px;
            spacing: 14px;
            Text { text: S.confirm; color: G.ink; font-size: 14px; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                b := Button { text: "Отмена"; clicked => { S.confirm-no(); } }
                Button { text: S.confirm-yes-label; primary: true; clicked => { S.confirm-yes(); } }
            }
        }
    }
}
