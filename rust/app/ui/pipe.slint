// Конвейер: строка — ассет, дорожка этапов; клик по этапу переносит, «→» — следующий.
import { G } from "theme.slint";
import { Node, Field, Empty, IconBtn, Brackets, Icon, Chev, ScrollView } from "kit.slint";
import { LinkNote } from "linknote.slint";
import { S, PipeRow } from "store.slint";

component StageChip inherits Rectangle {
    in property <string> text;
    in property <int> state; // 0 — пройден, 1 — сейчас, 2 — впереди
    in property <string> tip; // при наведении: «СКЕТЧ · 2 ДН · 10.11 → 12.11»
    callback clicked;
    height: 30px;
    border-radius: 6px;
    background: state == 1 ? G.accent : state == 0 ? #2C3A2F : (ca.has-hover ? G.node-hover : transparent);
    border-width: state == 1 ? 0 : 1px;
    border-color: state == 0 ? #3F6B47 : #4A4B52;
    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        width: parent.width - 8px;
        x: 4px;
        if state == 0: Icon { name: "check"; width: 10px; y: (parent.height - 10px) / 2; c: G.green; }
        Text {
            text: root.text;
            font-size: 12.5px;
            font-weight: state == 1 ? 600 : 400;
            color: state == 1 ? #1C1D21 : state == 0 ? G.green : #62646E;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ca := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    if ca.has-hover && root.tip != "": Rectangle {
        x: 0; y: parent.height + 4px; width: tt.preferred-width + 16px; height: 22px; z: 10;
        border-radius: 4px; background: #111214; border-width: 1px; border-color: G.line;
        tt := Text { text: root.tip; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.1px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// Строка конвейера. Раскрытая часть (п.30–33): слева подзадачи по этапам, справа срок, приоритет и заметка,
// внизу время по этапам.
component PipeLine inherits Rectangle {
    in property <PipeRow> r;
    property <bool> open: S.pipe-open == r.id;
    property <int> past-open: -1;     // раскрытый пройденный этап
    property <int> drag-b: -1;
    property <int> drag-i: -1;
    property <int> drag-to: -1;
    height: open ? 62px + 340px : 62px;
    border-radius: 8px;
    background: G.node;
    border-width: 1px;
    border-color: open ? G.accent-line : G.line;
    animate height { duration: G.mid; easing: ease-out; }
    clip: true;
    ra := TouchArea { clicked => { S.pipe-toggle(r.id); } mouse-cursor: pointer; }
    Chev { x: 12px; y: 26px; up: !open; c: #8A8C96; }
    Text { x: 36px; y: 14px; width: 224px; text: r.title; font-size: 14.5px; font-weight: 600; color: r.done ? #62646E : G.ink; overflow: elide; }
    Text { x: 36px; y: 35px; width: 224px; text: r.meta; font-size: 12px; color: #8A8C96; overflow: elide; }
    HorizontalLayout {
        x: 276px; y: 16px; height: 30px;
        width: parent.width - 276px - 200px;
        spacing: 4px;
        for st[i] in S.stages: StageChip {
            text: st;
            state: r.done || i < r.stage ? 0 : i == r.stage ? 1 : 2;
            tip: open && i < S.pipe-tips.length ? S.pipe-tips[i] : "";
            clicked => { S.move-card(r.list-id, r.id, i, 999); }
        }
    }
    Text { x: parent.width - 196px; y: 16px; width: 60px; height: 30px; text: r.due; font-size: 13px; color: r.overdue ? G.red : G.accent; horizontal-alignment: right; vertical-alignment: center; }
    if !r.done && r.next-name != "": Rectangle {
        x: parent.width - 118px; y: 15px; width: 104px; height: 32px;
        border-radius: 8px;
        background: open ? (na.has-hover ? G.accent-ink : G.accent) : (na.has-hover ? G.node-hover : transparent);
        border-width: open ? 0 : 1px;
        border-color: #55575F;
        HorizontalLayout {
            alignment: center; spacing: 4px; width: parent.width - 10px; x: 5px;
            Text { text: r.next-name; font-size: 13px; font-weight: 600; color: open ? #1C1D21 : G.ink; vertical-alignment: center; overflow: elide; }
            Icon { name: "next"; width: 11px; y: (parent.height - 11px) / 2; c: open ? #1C1D21 : G.ink; }
        }
        na := TouchArea { clicked => { S.next-stage(r.list-id, r.id); } mouse-cursor: pointer; }
    }
    if open: Rectangle {
        x: 0; y: 62px; width: parent.width; height: 340px;
        TouchArea { }
        // слева — подзадачи по этапам
        ScrollView {
            x: 36px; y: 12px; width: min(440px, parent.width * 0.5); height: 262px;
            viewport-height: bvl.preferred-height;
            bvl := VerticalLayout {
                spacing: 8px; alignment: start;
                for b[bi] in S.pipe-blocks: Rectangle {
                    property <bool> expanded: b.state == 1 || root.past-open == bi || (b.state == 2 && root.past-open == bi);
                    height: hd.height + (expanded ? b.subs.length * 28px + 30px + 8px : 0);
                    border-radius: 8px;
                    background: b.state == 1 ? G.accent-wash : transparent;
                    border-width: 1px;
                    border-color: b.state == 1 ? G.accent-line : b.state == 0 ? #3F6B47 : G.line;
                    hd := Rectangle {
                        y: 0; height: b.state == 1 ? 44px : 34px;
                        if b.state == 0: Icon { x: 10px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; name: "check"; c: G.green; }
                        Text { x: b.state == 0 ? 28px : 12px; width: parent.width * 0.45; text: b.name; font-size: 13px; font-weight: 600; color: b.state == 0 ? G.green : b.state == 1 ? G.ink : #8A8C96; vertical-alignment: center; height: b.state == 1 ? 30px : parent.height; overflow: elide; }
                        Text { x: parent.width - self.preferred-width - 12px; text: b.info; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.1px; color: b.state == 1 ? G.accent-ink : #8A8C96; vertical-alignment: center; height: b.state == 1 ? 30px : parent.height; }
                        if b.state == 1: Rectangle {
                            x: 12px; y: 32px; width: parent.width - 24px; height: 3px; border-radius: 1.5px; background: #45464D;
                            Rectangle { x: 0; width: parent.width * (b.total > 0 ? b.done-n / b.total : 0); border-radius: 1.5px; background: G.accent; }
                        }
                        if b.state != 1: TouchArea { clicked => { root.past-open = root.past-open == bi ? -1 : bi; } mouse-cursor: pointer; }
                    }
                    if expanded: VerticalLayout {
                        x: 8px; y: hd.height; width: parent.width - 16px;
                        spacing: 0;
                        for sb[si] in b.subs: Rectangle {
                            height: 28px;
                            background: root.drag-b == bi && root.drag-to == si && root.drag-to != root.drag-i ? G.accent-wash : transparent;
                            Rectangle {
                                x: 0; width: 18px;
                                Icon { x: 0; y: 7px; width: 14px; height: 14px; name: "drag"; c: hda.has-hover || (root.drag-b == bi && root.drag-i == si) ? G.ink : #55575F; }
                                hda := TouchArea {
                                    mouse-cursor: move;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) { root.drag-b = bi; root.drag-i = si; root.drag-to = si; }
                                        if (e.kind == PointerEventKind.up && root.drag-i >= 0) {
                                            if (root.drag-to != root.drag-i) {
                                                S.sub-move(r.list-id, r.id, sb.id, root.drag-to > root.drag-i
                                                    ? (root.drag-to + 1 < b.subs.length ? b.subs[root.drag-to + 1].id : "")
                                                    : b.subs[root.drag-to].id);
                                            }
                                            root.drag-b = -1; root.drag-i = -1; root.drag-to = -1;
                                        }
                                    }
                                    moved => { if (root.drag-i >= 0) { root.drag-to = max(0, min(b.subs.length - 1, si + round((self.mouse-y - self.pressed-y) / 28px))); } }
                                }
                            }
                            Rectangle {
                                x: 20px; y: 7px; width: 14px; height: 14px; border-radius: 3px;
                                background: sb.done ? #45464D : transparent;
                                border-width: sb.done ? 0 : 1px; border-color: #8A8C96;
                                Icon { name: "check"; width: 9px; x: 2.5px; y: 2.5px; visible: sb.done; c: G.ink; stroke-width: 2.2px; }
                            }
                            st := Text { x: 42px; text: sb.title; font-size: 13px; color: sb.done ? #62646E : G.ink; vertical-alignment: center; height: parent.height; overflow: elide; width: parent.width - 48px; }
                            if sb.done: Rectangle { x: 42px; y: 14px; height: 1px; width: min(st.preferred-width, parent.width - 48px); background: #62646E; }
                            TouchArea { x: 20px; width: parent.width - 20px; clicked => { S.toggle(r.list-id, sb.id); } mouse-cursor: pointer; }
                        }
                        Field { height: 30px; bare: true; font-size: 12.5px; placeholder: "+ подзадача · Enter"; accepted(t) => { if (t != "") { S.pipe-sub-add(r.list-id, r.id, b.stage-id, t); self.clear(); } } }
                    }
                }
            }
        }
        // справа — срок и приоритет в одну строку, под ними заметка
        property <length> rx: 36px + min(440px, parent.width * 0.5) + 24px;
        HorizontalLayout {
            x: rx; y: 12px; width: parent.width - rx - 20px; height: 30px;
            spacing: 8px;
            Text { text: "Срок"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; }
            Rectangle { width: dt.preferred-width + 24px; border-radius: 8px; border-width: 1px; border-color: G.accent-line; dt := Text { text: S.pipe-due; font-size: 13px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { S.open-task(r.list-id, r.id); } mouse-cursor: pointer; } }
            Rectangle { width: 8px; }
            Text { text: "Приоритет"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; }
            for p[k] in ["!!!", "!!", "!"]: Rectangle {
                width: 34px; border-radius: 8px;
                border-width: 1px; border-color: S.pipe-prio == k + 1 ? G.accent : G.line;
                background: S.pipe-prio == k + 1 ? G.accent-wash : transparent;
                Text { text: p; font-family: G.mono; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { S.pipe-prio-set(r.list-id, r.id, k + 1); } mouse-cursor: pointer; }
            }
            Rectangle { }
        }
        Rectangle {
            x: rx; y: 52px; width: parent.width - rx - 20px; height: 222px;
            border-radius: 8px; background: #2C2D33; border-width: 1px; border-color: G.line;
            Text { x: 10px; y: 8px; text: "ЗАМЕТКА"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.3px; color: #8A8C96; }
            IconBtn { x: parent.width - 30px; y: 4px; icon: "expand"; clicked => { S.open-task(r.list-id, r.id); } }
            if S.pipe-note == "" && !pn.focused: Text { x: 10px; y: 30px; text: "Заметка… [[ — ссылка на «Знания»"; font-size: 12.5px; color: #62646E; }
            pn := LinkNote {
                x: 10px; y: 30px; width: parent.width - 20px; height: parent.height - 38px;
                font-size: 12.5px;
                text: S.pipe-note;
                edited(t) => { S.pipe-notes-set(r.list-id, r.id, t); }
            }
        }
        // низ: назад, время по этапам, «Открыть полностью»
        Rectangle { x: 0; y: 286px; height: 1px; background: G.line; }
        HorizontalLayout {
            x: 36px; y: 287px; width: parent.width - 56px; height: 52px;
            spacing: 14px;
            if S.pipe-prev != "": Text {
                text: "← " + S.pipe-prev; font-size: 12.5px; color: ba.has-hover ? G.ink : #A3A5AE; vertical-alignment: center;
                ba := TouchArea { clicked => { S.pipe-back(r.list-id, r.id); } mouse-cursor: pointer; }
            }
            if S.pipe-total != "": HorizontalLayout {
                spacing: 8px;
                Icon { y: (parent.height - 14px) / 2; width: 14px; height: 14px; name: "timer"; c: #A3A5AE; }
                Text { text: S.pipe-total; font-size: 12.5px; color: G.ink; vertical-alignment: center; }
            }
            if S.pipe-segs.length > 0: VerticalLayout {
                alignment: center; spacing: 5px;
                Rectangle {
                    height: 6px;
                    HorizontalLayout {
                        spacing: 2px;
                        for sg in S.pipe-segs: Rectangle {
                            horizontal-stretch: max(0.02, sg.w);
                            border-radius: 2px;
                            background: sg.kind == 0 ? G.green : sg.kind == 1 ? G.accent : #45464D;
                        }
                    }
                }
                Text { text: S.pipe-caption; font-family: G.mono; font-size: 9px; letter-spacing: 1.1px; color: #8A8C96; overflow: elide; }
            }
            if S.pipe-segs.length == 0: Rectangle { }
            Text {
                text: "Открыть полностью"; font-size: 12.5px; color: G.accent; vertical-alignment: center;
                TouchArea { clicked => { S.open-task(r.list-id, r.id); } mouse-cursor: pointer; }
            }
        }
    }
    if open: Brackets { x: 0; y: 0; width: parent.width; height: parent.height; }
}

export component Pipe inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding-bottom: 16px;
            spacing: 8px;
            for r[i] in S.pipe: VerticalLayout {
                spacing: 8px;
                if r.first: HorizontalLayout {
                    height: 22px;
                    spacing: 8px;
                    Rectangle { width: 6px; height: 6px; y: 8px; border-radius: 2px; background: G.accent; }
                    Text { text: r.group; font-size: 13px; font-weight: 600; color: G.ink; vertical-alignment: center; }
                    Text { text: r.group-info; font-size: 12px; color: #8A8C96; vertical-alignment: center; }
                    Rectangle { }
                }
                PipeLine { r: r; }
            }
            if S.pipe.length == 0: Empty { height: 220px; text: "Ассетов пока нет — добавь первый строкой ниже"; }
            Rectangle {
                height: 40px;
                border-radius: 8px;
                border-width: 1px;
                border-color: #55575F;
                Field { x: 6px; y: 3px; width: parent.width - 12px; bare: true; font-size: 13px; placeholder: "+ Новый ассет · Enter"; accepted(t) => { if (t != "") { S.add-card(S.board-id, "", t); self.clear(); } } }
            }
        }
    }
}

