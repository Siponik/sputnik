// Холст: кнопка панели и меню у выделенного (как в Obsidian: удалить, цвет, приблизить, стрелка, править, открыть…).
import { G } from "theme.slint";
import { Icon, IconBtn, Mono, Field } from "kit.slint";
import { S } from "store.slint";

export component ToolBtn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> outlined;
    in property <bool> accent;
    callback clicked;
    width: lb.preferred-width + (icon != "" ? 38px : 24px);
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? G.node-hover : transparent;
    border-width: outlined ? 1px : 0;
    border-color: G.line-strong;
    if icon != "": Icon { name: root.icon; x: 10px; width: 13px; y: (parent.height - 13px) / 2; c: root.outlined ? G.ink : G.muted; }
    lb := Text { x: icon != "" ? 28px : 12px; text: root.text; font-size: 13px; color: root.accent ? G.accent : (root.outlined ? G.ink : #C9CBD3); vertical-alignment: center; height: parent.height; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component SelMenu inherits Rectangle {
    in property <bool> below;            // меню под объектом (над ним не влезло)
    in-out property <bool> palette;
    callback zoom();
    width: row.preferred-width + 12px; height: 38px;
    border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
    drop-shadow-blur: 20px; drop-shadow-offset-y: 6px; drop-shadow-color: #00000070;
    TouchArea { }
    row := HorizontalLayout {
        x: 6px; spacing: 2px; alignment: start; padding-top: 5px; padding-bottom: 5px;
        IconBtn { icon: "trash"; tip: "Удалить"; clicked => { root.palette = false; S.cv-key("delete", 0, 0); } }
        IconBtn { icon: "accent"; tip: "Цвет"; on: root.palette; clicked => { root.palette = !root.palette; } }
        IconBtn { icon: "focus"; tip: "Приблизить к выделенному"; clicked => { root.zoom(); } }
        if S.cv-sel-kind == "edge": IconBtn { icon: "next"; tip: "Стрелка"; clicked => { S.cv-key("arrow", 0, 0); } }
        if S.cv-sel-kind == "edge" || S.cv-sel-kind == "text" || S.cv-sel-kind == "group" || S.cv-sel-kind == "file": IconBtn {
            icon: "edit"; tip: "Править"; clicked => { root.palette = false; S.cv-key("edit", 0, 0); }
        }
        if S.cv-sel-kind == "file" || S.cv-sel-kind == "link" || S.cv-sel-kind == "image": IconBtn { icon: "open"; tip: "Открыть"; clicked => { S.cv-key("open", 0, 0); } }
        if S.cv-sel-kind != "edge": IconBtn { icon: "canvas"; tip: "В группу"; clicked => { S.cv-key("group", 0, 0); } }
        if S.cv-sel-kind != "edge": IconBtn { icon: "copy"; tip: "Дублировать"; clicked => { S.cv-key("dup", 0, 0); } }
    }
    // цвета — полоской рядом с меню
    if root.palette: Rectangle {
        // в сторону от объекта: меню над ним — цвета ещё выше
        x: 0; y: root.below ? parent.height + 6px : -self.height - 6px; width: prow.preferred-width + 16px; height: 34px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        drop-shadow-blur: 16px; drop-shadow-color: #00000070;
        TouchArea { }
        prow := HorizontalLayout {
            x: 8px; spacing: 8px; alignment: start;
            for c[i] in ["", "1", "2", "3", "4", "5", "6"]: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px; height: 18px; border-radius: 9px;
                    background: i == 0 ? transparent : [#E5484D, #F0A04B, #E8C547, #5BB98B, #4FB3D9, #A78BFA][i - 1];
                    border-width: i == 0 || ca.has-hover ? 1.5px : 0; border-color: ca.has-hover ? G.ink : G.line-strong;
                    ca := TouchArea { mouse-cursor: pointer; clicked => { S.cv-key("color:" + c, 0, 0); } }
                }
            }
        }
    }
}

// Поиск заметки для «＋ Заметка»: Enter — первая найденная, Esc — закрыть.
export component NotePick inherits Rectangle {
    callback picked(string);
    callback closed();
    property <string> q;
    width: 320px; height: 44px + min(8, S.cv-note-find(root.q).length) * 32px;
    border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
    drop-shadow-blur: 24px; drop-shadow-offset-y: 10px; drop-shadow-color: #00000080;
    TouchArea { }
    Field {
        x: 6px; y: 6px; width: parent.width - 12px; height: 32px; placeholder: "Найти заметку";
        init => { self.grab(); }
        edited(t) => { root.q = t; }
        escape => { root.closed(); }
        accepted => {
            if (S.cv-note-find(root.q).length > 0) { root.picked(S.cv-note-find(root.q)[0].path); } else { root.closed(); }
        }
    }
    for r[i] in S.cv-note-find(root.q): Rectangle {
        y: 44px + i * 32px; height: 32px;
        background: pa.has-hover || i == 0 ? G.accent-wash : transparent;
        Icon { name: "note"; x: 12px; width: 13px; y: 9.5px; c: i == 0 ? G.accent : G.muted; }
        Text { x: 34px; width: parent.width - 140px; text: r.title; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
        Mono { x: parent.width - self.width - 12px; width: min(self.preferred-width, 90px); text: r.sub.to-uppercase(); font-size: 9px; vertical-alignment: center; height: parent.height; overflow: elide; }
        pa := TouchArea { mouse-cursor: pointer; clicked => { root.picked(r.path); } }
    }
}
