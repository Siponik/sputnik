// «Календарь» по макету G_CalWeek / G_CalMonth / G_CalAdd: панель-нода сверху, главная нода недели или месяца,
// справа — нода выбранного дня, связанная проводом; под ними — обзор и штамп листа.
// Неделя — calweek.slint.
import { G } from "theme.slint";
import { Sat, Mono, Brackets, Button, Field, Link, DashBox, Chev, Hatch, CSeg, Icon, ScrollView } from "kit.slint";
import { S, Day, Chip, Opt } from "store.slint";
import { Week } from "calweek.slint";

component Sq inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: G.line-strong.transparentize(0.4);
    background: qa.has-hover ? G.node-hover : transparent;
    Icon { name: root.icon; width: 13px; x: (parent.width - 13px) / 2; y: (parent.height - 13px) / 2; c: G.ink; }
    qa := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}




component Month inherits Rectangle {
    property <length> cw: self.width / 7;
    property <int> rows: max(1, ceil(S.days.length / 7));
    property <length> ch: (self.height - 24px) / root.rows;
    for w[i] in ["ПН", "ВТ", "СР", "ЧТ", "ПТ", "СБ", "ВС"]: Text {
        x: i * root.cw + 10px; y: 0; height: 24px; text: w;
        font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #7A7C86; vertical-alignment: center;
    }
    Rectangle { y: 24px; height: 1px; background: G.line; }
    for d[i] in S.days: cell := Rectangle {
        x: mod(i, 7) * root.cw;
        y: 24px + floor(i / 7) * root.ch;
        width: root.cw;
        height: root.ch;
        Rectangle { x: parent.width - 1px; width: 1px; background: G.line-soft; }
        Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: d.today ? 6px : 0;
            border-width: d.today ? 1px : 0;
            border-color: G.accent;
            background: d.today ? #2C2620 : (d.sel ? G.accent-wash : (ma.has-hover ? G.node-hover : transparent));
        }
        ma := TouchArea { clicked => { S.cal-pick(d.ymd); } }
        Text { x: 10px; y: 8px; text: d.num; font-family: G.mono; font-size: 11px; font-weight: 600; letter-spacing: 1px; color: d.today ? G.accent : (d.in-month ? G.ink : #55575F); }
        if d.today: Text { x: parent.width - self.preferred-width - 10px; y: 9px; text: "СЕГОДНЯ"; font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: G.accent; }
        // дела без времени: ДР — розовая плашка с тортиком, дальше точка цвета и название; не влезло — «+N ещё»
        property <int> cap: max(1, floor((root.ch - 26px - 12px) / 18px));
        property <int> shown: d.all.length <= self.cap ? d.all.length : self.cap - 1;
        VerticalLayout {
            x: 4px; y: 24px; width: parent.width - 8px;
            height: parent.height - 34px;
            spacing: 0;
            alignment: start;
            for c[k] in d.all: Rectangle {
                visible: k < cell.shown;
                height: k < cell.shown ? (c.kind == 3 ? 23px : 18px) : 0;
                if c.kind == 3: Rectangle {
                    y: 0; height: 20px;
                    border-radius: 4px;
                    background: #F08CC029;
                    Icon { x: 6px; name: "birthday"; width: 11px; y: (parent.height - 11px) / 2; c: #F08CC0; }
                    Text { x: 22px; width: parent.width - 26px; text: c.title; font-size: 11.5px; color: #F08CC0; vertical-alignment: center; height: parent.height; overflow: elide; }
                }
                if c.kind != 3: Rectangle {
                    Rectangle { x: 4px; width: 6px; height: 6px; y: (parent.height - 6px) / 2; border-radius: 3px; background: c.hue; opacity: c.done ? 0.5 : 1; }
                    Text { x: 16px; width: parent.width - 18px; text: c.title; font-size: 11.5px; color: c.done ? G.dim : #C9CAD0; vertical-alignment: center; height: parent.height; overflow: elide; }
                }
                TouchArea { clicked => { if (c.kind == 1) { S.open-task(c.list-id, c.id); } else { S.open-event(c.id); } } mouse-cursor: pointer; }
            }
            if d.all.length > cell.shown: Text { height: 16px; x: 4px; text: "+" + (d.all.length - cell.shown) + " ещё"; font-family: G.mono; font-size: 10px; color: G.muted; vertical-alignment: center; }
        }
        // привычки — полоска внизу клетки: золото — сделано, пунктир — впереди
        for v[k] in d.hdots: Rectangle {
            x: 8px + k * (root.cw - 16px) / max(1, d.hdots.length);
            y: parent.height - 9px;
            width: (root.cw - 16px) / max(1, d.hdots.length) - 3px;
            height: v == 3 ? 1px : 3px;
            border-radius: 1.5px;
            background: v == 1 ? G.gold : (v == 3 ? #4A4B52 : #3A3B42);
            opacity: d.in-month ? 1 : 0.4;
        }
    }
}

// Строка дня в панели — как в «Сегодня».
component DayLine inherits Rectangle {
    in property <Chip> c;
    in property <bool> next;
    height: 40px;
    border-radius: next ? 6px : 0;
    border-width: next ? 1px : 0;
    border-color: G.accent;
    background: next ? #2E2620 : (la.has-hover ? G.node-hover : transparent);
    if next: Hatch { border-radius: 6px; c: #F0A04B0C; }
    la := TouchArea { clicked => { if (c.kind == 1) { S.open-task(c.list-id, c.id); } else { S.open-event(c.id); } } mouse-cursor: pointer; }
    Rectangle {
        x: 10px; y: 13px; width: 14px; height: 14px; border-radius: 3px;
        border-width: 1px; border-color: c.done ? #7C7E88 : (next ? G.accent : #7C7E88);
        background: c.done ? #3D3E45 : transparent;
        visible: c.kind == 1;
        Icon { name: "check"; width: 10px; x: 2px; y: 2px; visible: c.done; c: G.ink; stroke-width: 2.2px; }
        TouchArea { clicked => { S.toggle(c.list-id, c.id); } mouse-cursor: pointer; }
    }
    if c.kind != 1: Rectangle { x: 10px; y: 13px; width: 14px; height: 14px; border-radius: 3px; border-width: 1px; border-color: #55575F; }
    Text { x: 34px; text: c.time; font-family: G.mono; font-size: 11px; color: next ? G.accent : #8A8C96; vertical-alignment: center; height: parent.height; }
    tl := Text {
        x: 84px; width: parent.width - 110px;
        text: (c.kind == 3 ? "★ " : "") + c.title;
        font-size: 13px; color: c.done ? G.dim : G.ink; vertical-alignment: center; height: parent.height; overflow: elide;
        Rectangle { visible: c.done; y: parent.height / 2 + 1px; height: 1px; width: min(parent.width, tl.preferred-width); background: G.dim; }
    }
    Rectangle { x: parent.width - 16px; y: 17px; width: 6px; height: 6px; border-radius: 1.5px; background: c.hue; }
    if !next: Rectangle { x: 0; y: parent.height - 1px; height: 1px; background: G.line-soft; }
}

export component CalendarPage inherits Rectangle {
    property <bool> adding;
    property <bool> add-event;
    property <length> pw: 324px;
    property <length> mx: 8px;
    property <length> mw: self.width - 2 * root.mx - root.pw - 8px;
    // главная нода — по высоте окна (сетка недели внутри прокручивается), снизу место под обзор и штамп;
    // раньше не меньше 420 px,
    // и в низком окне (масштаб 125–150 %) низ календаря и обзор уходили за край
    property <length> mh: max(260px, self.height - 64px - 76px);
    // форма «Добавить на этот день» — не выше окна и не ниже его края
    property <length> fh: min(400px, self.height - 64px - 16px);
    property <length> fy: max(64px, min(64px + 86px, self.height - root.fh - 8px));
    property <bool> form: root.adding || S.add-time != "";
    // выбор месяца и года по клику на «МАРТ 2027»
    property <bool> mp-open;
    property <int> mp-year;
    // «Показывать»: список типов с галочками
    property <bool> sh-open;

    // ---------- панель ----------
    // слева «НЕДЕЛЯ | МЕСЯЦ», стрелки, месяц и год постоянной ширины (стрелки не прыгают), «к сейчас»;
    // справа — что показывать, выпадающим списком
    bar := Rectangle {
        x: root.mx; y: 8px; width: parent.width - 2 * root.mx; height: 48px;
        border-radius: 8px;
        background: G.node;
        border-width: 1px;
        border-color: G.line;
        HorizontalLayout {
            padding-left: 9px;
            padding-right: 9px;
            spacing: 8px;
            
            CSeg {
                y: 8px;
                items: ["НЕДЕЛЯ", "МЕСЯЦ"];
                current: S.cal-mode == "month" ? 1 : 0;
                picked(i) => { root.mp-open = false; S.cal-mode-set(i == 1 ? "month" : "week"); }
            }
            Rectangle { width: 1px; height: 20px; y: 14px; background: G.line; }
            Sq { y: 10px; icon: "prev"; clicked => { root.mp-open = false; S.cal-shift(-1); } }
            Sq { y: 10px; icon: "next"; clicked => { root.mp-open = false; S.cal-shift(1); } }
            // месяц и год постоянной ширины: клик — выбрать и перейти
            mbtn := Rectangle {
                y: 10px; width: 150px; height: 28px;
                border-radius: 7px;
                background: mba.has-hover && !root.mp-open ? G.node-hover : transparent;
                border-width: 1px;
                border-color: root.mp-open ? G.accent : G.line;
                Text { x: 10px; width: parent.width - 30px; text: S.cal-title; font-family: G.mono; font-size: 11px; font-weight: 600; letter-spacing: 1.3px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                Chev { x: parent.width - 20px; y: (parent.height - 10px) / 2; c: G.muted; up: root.mp-open; }
                mba := TouchArea { mouse-cursor: pointer; clicked => { root.mp-year = S.cal-y; root.mp-open = !root.mp-open; } }
            }
            // «к сейчас» — только когда сегодня не видно
            if S.cal-away: Rectangle {
                y: 10px; width: nt.preferred-width + 32px; height: 28px;
                border-radius: 7px;
                background: na.has-hover ? G.node-hover : transparent;
                DashBox { c: na.has-hover ? G.line-strong : G.line; }
                Rectangle { x: 10px; y: 11px; width: 6px; height: 6px; border-radius: 3px; background: G.accent; }
                nt := Text { x: 22px; text: "К СЕЙЧАС"; font-family: G.mono; font-size: 10px; font-weight: 500; letter-spacing: 1px; color: na.has-hover ? G.ink : G.muted; vertical-alignment: center; height: parent.height; }
                na := TouchArea { mouse-cursor: pointer; clicked => { root.mp-open = false; S.cal-today(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            // что показывать: точки включённых типов, клик — список с галочками
            Rectangle {
                y: 10px; width: shl.preferred-width + 24px; height: 28px;
                border-radius: 7px;
                border-width: 1px;
                border-color: root.sh-open ? G.accent : (sba.has-hover ? G.line-strong : G.line);
                background: sba.has-hover ? G.node-hover : transparent;
                shl := HorizontalLayout {
                    padding-left: 10px; spacing: 3px; alignment: start;
                    st := Text { text: "ПОКАЗЫВАТЬ"; font-family: G.mono; font-size: 10px; font-weight: 500; letter-spacing: 1px; color: G.ink; vertical-alignment: center; }
                    Rectangle { width: 5px; }
                    for f in S.cal-filters: Rectangle {
                        width: f.on ? 6px : 0px; visible: f.on;
                        Rectangle { y: 11px; width: 6px; height: 6px; border-radius: 3px; background: f.hue; }
                    }
                }
                Chev { x: parent.width - 18px; y: (parent.height - 10px) / 2; c: G.muted; up: root.sh-open; }
                sba := TouchArea { mouse-cursor: pointer; clicked => { root.mp-open = false; root.sh-open = !root.sh-open; } }
            }
        }
    }

    // ---------- главная нода ----------
    main := Rectangle {
        x: root.mx; y: 64px; width: root.mw; height: root.mh;
        border-radius: 12px;
        background: G.node;
        border-width: 1px;
        border-color: G.accent-line;
        clip: true;
        Rectangle {
            height: 34px; y: 0;
            background: G.head-main;
            Text { x: 13px; width: parent.width - 26px; text: S.cal-head; font-family: G.mono; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; color: #ffffff; vertical-alignment: center; height: parent.height; overflow: elide; }
            Text { x: parent.width - self.preferred-width - 13px; text: S.cal-head-r; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #ffffffc0; vertical-alignment: center; height: parent.height; }
        }
        Rectangle {
            y: 34px; height: parent.height - 34px;
            if S.cal-mode == "week": Week { }
            if S.cal-mode == "month": Month { }
        }
    }
    Brackets { x: main.x; y: main.y; width: main.width; height: main.height; }

    // провод «неделя → день»
    Rectangle { x: main.x + main.width - 4px; y: main.y + 21px; width: 28px; height: 1.5px; background: G.accent; }
    Rectangle { x: main.x + main.width - 4px; y: main.y + 17px; width: 9px; height: 9px; border-radius: 3px; background: G.accent; border-width: 1px; border-color: #6A4A28; }
    Rectangle { x: main.x + main.width + 20px; y: main.y + 17px; width: 9px; height: 9px; border-radius: 3px; background: G.accent; border-width: 1px; border-color: #6A4A28; }

    // ---------- нода дня ----------
    panel := Rectangle {
        x: root.width - root.mx - root.pw; y: 64px; width: root.pw; height: root.mh;
        border-radius: 8px;
        background: G.node;
        border-width: 1px;
        border-color: G.line;
        clip: true;
        Rectangle {
            height: 34px; y: 0;
            background: G.head-main;
            Text { x: 13px; width: parent.width - 26px; text: S.day-head; font-family: G.mono; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; color: #ffffff; vertical-alignment: center; height: parent.height; overflow: elide; }
            Text { x: parent.width - self.preferred-width - 13px; text: S.day-count; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #ffffffc0; vertical-alignment: center; height: parent.height; }
        }
        ScrollView {
            y: 34px; height: parent.height - 34px;
            VerticalLayout {
                padding: 12px;
                padding-top: 10px;
                spacing: 0;
                for c[i] in S.day-items: DayLine { c: c; next: i == S.day-next; }
                if S.day-items.length == 0: Text { height: 48px; text: "Свободный день — енот дремлет"; color: G.muted; font-size: 13px; vertical-alignment: center; }
                Rectangle { height: 10px; }
                Rectangle { height: 1px; background: G.accent-line; }
                if S.day-habits.length > 0: Text { height: 34px; text: S.day-habits-sum; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.6px; color: G.gold; vertical-alignment: center; }
                for h in S.day-habits: Rectangle {
                    height: 28px;
                    Text { x: 0; width: parent.width - 60px; text: (h.on ? "✓ " : "") + h.label; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; }
                    Text { x: parent.width - self.preferred-width; text: h.hint; font-family: G.mono; font-size: 10px; letter-spacing: 1px; color: h.on ? G.gold : #8A8C96; vertical-alignment: center; height: parent.height; }
                    TouchArea { clicked => { S.habit-tap(h.id); } mouse-cursor: pointer; }
                }
                Rectangle { height: 14px; }
                DashBox {
                    height: 32px;
                    c: #6E7079;
                    background: ad.has-hover ? G.node-hover : transparent;
                    Text { text: "＋ Добавить на этот день"; font-size: 13px; font-weight: 500; color: G.ink; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                    ad := TouchArea { clicked => { root.adding = true; } mouse-cursor: pointer; }
                }
                Rectangle { height: 12px; }
                if S.free-hint != "": DashBox {
                    height: 76px;
                    c: #8A7430;
                    Sat { x: 11px; y: 10px; c: G.gold; }
                    Text { x: 67px; y: 14px; width: parent.width - 78px; text: S.free-hint + ". Поставить туда задачу?"; font-size: 12.5px; color: G.ink; wrap: word-wrap; }
                    Link { x: 67px; y: 50px; text: "Поставить"; font-size: 12.5px; clicked => { S.cal-free-take(); } }
                }
            }
        }
    }

    // ---------- форма «добавить на этот день» (G_CalAdd) ----------
    if root.form: Rectangle {
        x: panel.x - 24px; y: root.fy; width: root.pw + 24px; height: root.fh;
        border-radius: 12px;
        background: G.node;
        border-width: 1px;
        border-color: G.accent-line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #0008;
        clip: true;
        Rectangle {
            height: 34px; y: 0;
            background: G.head-main;
            Text { x: 13px; width: parent.width - 26px; text: S.day-head + " · ДОБАВИТЬ НА ЭТОТ ДЕНЬ"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #ffffff; vertical-alignment: center; height: parent.height; overflow: elide; }
            Text { x: parent.width - self.preferred-width - 13px; text: "ENTER"; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #ffffffc0; vertical-alignment: center; height: parent.height; }
        }
        VerticalLayout {
            y: 34px; height: parent.height - 34px;
            padding: 16px;
            spacing: 8px;
            Text { text: "Что добавить"; font-size: 12.5px; color: G.muted; }
            nm := Field {
                height: 40px;
                placeholder: "Название";
                init => { self.grab(); }
                accepted(t) => { if (t != "") { S.cal-add("", tm.text, t, root.add-event); self.clear(); root.adding = false; } }
                escape => { root.adding = false; S.cal-add-close(); }
            }
            Rectangle { height: 2px; }
            Text { text: "Это"; font-size: 12.5px; color: G.muted; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for k[i] in ["Задача", "Событие"]: Rectangle {
                    height: 30px;
                    width: kt.preferred-width + 26px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: (i == 1) == root.add-event ? G.accent : G.line;
                    background: (i == 1) == root.add-event ? G.accent-wash : transparent;
                    kt := Text { text: k; font-size: 13px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.add-event = i == 1; } mouse-cursor: pointer; }
                }
            }
            Rectangle { height: 2px; }
            Text { text: "Когда"; font-size: 12.5px; color: G.muted; }
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: G.accent;
                    background: G.accent-wash;
                    Text { x: 12px; text: S.day-title; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; width: parent.width - 20px; }
                }
                tm := Field { width: 86px; height: 32px; mono: true; placeholder: "весь день"; text: S.add-time; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Rectangle {
                    width: 72px; height: 30px;
                    Text { text: "Отмена"; font-size: 13px; color: ca.has-hover ? G.ink : G.muted; horizontal-alignment: center; vertical-alignment: center; }
                    ca := TouchArea { clicked => { root.adding = false; S.cal-add-close(); } mouse-cursor: pointer; }
                }
                Button {
                    height: 30px;
                    primary: true;
                    text: "Добавить";
                    clicked => { if (nm.text != "") { S.cal-add("", tm.text, nm.text, root.add-event); nm.clear(); root.adding = false; } }
                }
            }
        }
    }
    if root.form && root.fy + root.fh + 18px + 52px <= root.height: DashBox {
        x: panel.x - 24px; y: root.fy + root.fh + 18px; width: root.pw + 24px; height: 52px;
        c: #8A7430;
        Rectangle {
            x: 10px; y: 6px; width: 40px; height: 40px; border-radius: 20px; border-width: 1px; border-color: #6E7079;
            Text { text: "ДУМАЕТ"; font-family: G.mono; font-size: 7.5px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { x: 60px; width: parent.width - 70px; text: "Клик по пустому часу открывает эту форму. Esc — убрать черновик."; font-size: 12px; color: G.ink; wrap: word-wrap; vertical-alignment: center; height: parent.height; }
    }

    // ---------- обзор и штамп ----------
    HorizontalLayout {
        x: root.mx; y: main.y + main.height + 16px; width: root.mw; height: 16px;
        spacing: 14px;
        alignment: start;
        Text { text: S.cal-mode == "week" ? "ОБЗОР НЕДЕЛИ" : S.cal-foot; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.4px; color: S.cal-mode == "week" ? G.ink : #8A8C96; }
        if S.cal-mode == "week": Text { text: S.cal-foot; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: #8A8C96; }
        Text { text: S.cal-foot-hl; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.gold; }
        if S.cal-mode == "month": Text { text: "ПУНКТИР — ЕЩЁ ВПЕРЕДИ"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: #8A8C96; }
    }
    // размерная линия
    Rectangle {
        x: root.mx; y: main.y + main.height + 42px; width: root.mw; height: 12px;
        Rectangle { x: 0; width: 1px; height: 10px; y: 1px; background: #55575F; }
        Rectangle { x: parent.width - 1px; width: 1px; height: 10px; y: 1px; background: #55575F; }
        Rectangle { x: 12px; y: 6px; height: 1px; width: (parent.width - rl.preferred-width) / 2 - 24px; background: #3A3B42; }
        Rectangle { x: (parent.width + rl.preferred-width) / 2 + 12px; y: 6px; height: 1px; width: (parent.width - rl.preferred-width) / 2 - 24px; background: #3A3B42; }
        rl := Text { x: (parent.width - self.preferred-width) / 2; text: S.cal-rule; font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
    }
    if S.cal-stamp.length >= 4: Rectangle {
        x: panel.x + panel.width - 280px; y: main.y + main.height + 16px; width: 280px; height: 52px;
        border-radius: 6px;
        border-width: 1px;
        border-color: G.line;
        Text { x: 8px; y: 6px; text: S.cal-stamp[0]; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.ink; }
        Rectangle { x: 0; y: 24px; height: 1px; background: G.line; }
        HorizontalLayout {
            y: 24px; height: 28px;
            Text { text: S.cal-stamp[1]; font-family: G.mono; font-size: 9.5px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { width: 1px; background: G.line; }
            Text { text: S.cal-stamp[2]; font-family: G.mono; font-size: 9.5px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { width: 1px; background: G.line; }
            Text { text: S.cal-stamp[3]; font-family: G.mono; font-size: 9.5px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    // добавление кликом в неделе: всё вокруг недели тоже затемняется, клик — отмена (сама неделя затемняет себя)
    for r in [
        { x: 0px, y: 0px, w: root.width, h: main.y + 34px },
        { x: 0px, y: main.y + 34px, w: main.x, h: root.height },
        { x: main.x + main.width, y: main.y + 34px, w: root.width, h: root.height },
        { x: main.x, y: main.y + main.height, w: main.width, h: root.height },
    ]: Rectangle {
        x: r.x; y: r.y; width: r.w - r.x; height: r.h;
        background: #15161AA6;
        opacity: S.cal-mode == "week" && S.draft-col >= 0 ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 120ms; }
        TouchArea { clicked => { S.cal-draft-cancel(); } }
    }

    // ---------- выбор месяца и года (G_CalHead) ----------
    if root.mp-open || root.sh-open: TouchArea { clicked => { root.mp-open = false; root.sh-open = false; } }
    if root.mp-open: Rectangle {
        x: bar.x + mbtn.x;
        y: bar.y + bar.height + 4px;
        width: 240px;
        height: mpl.preferred-height;
        border-radius: 9px;
        background: G.node;
        border-width: 1px;
        border-color: G.accent;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #0000008c;
        TouchArea { }
        mfs := FocusScope {
            init => { self.focus(); }
            key-pressed(e) => { if e.text == Key.Escape { root.mp-open = false; return accept; } reject }
        }
        mpl := VerticalLayout {
            HorizontalLayout {
                padding: 10px; padding-left: 12px; padding-right: 12px;
                Sq { icon: "prev"; clicked => { root.mp-year -= 1; } }
                Text { text: root.mp-year; font-family: G.mono; font-size: 13px; font-weight: 600; letter-spacing: 1.3px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
                Sq { icon: "next"; clicked => { root.mp-year += 1; } }
            }
            VerticalLayout {
                padding-left: 12px; padding-right: 12px; padding-bottom: 10px;
                spacing: 6px;
                for row in 4: HorizontalLayout {
                    spacing: 6px;
                    for col in 3: Rectangle {
                        property <int> m: row * 3 + col;
                        property <bool> cur: root.mp-year == S.cal-y && self.m == S.cal-m;
                        property <bool> now: root.mp-year == S.cal-now-y && self.m == S.cal-now-m;
                        height: 34px;
                        border-radius: 6px;
                        background: self.cur ? G.accent : (ma.has-hover ? G.node-hover : transparent);
                        border-width: self.now && !self.cur ? 1px : 0px;
                        border-color: G.accent.transparentize(0.4);
                        Text {
                            text: ["ЯНВ", "ФЕВ", "МАР", "АПР", "МАЙ", "ИЮН", "ИЮЛ", "АВГ", "СЕН", "ОКТ", "НОЯ", "ДЕК"][parent.m];
                            font-family: G.mono; font-size: 11px; font-weight: 500; letter-spacing: 1.1px;
                            color: parent.cur ? G.on-accent : (parent.now ? G.accent : G.ink);
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        ma := TouchArea { mouse-cursor: pointer; clicked => { root.mp-open = false; S.cal-goto(root.mp-year, parent.m); } }
                    }
                }
            }
            Rectangle { height: 1px; background: G.line-soft; }
            Rectangle {
                height: 32px;
                Text {
                    x: 12px; height: parent.height; vertical-alignment: center;
                    text: "СЕЙЧАС · " + ["ЯНВ", "ФЕВ", "МАР", "АПР", "МАЙ", "ИЮН", "ИЮЛ", "АВГ", "СЕН", "ОКТ", "НОЯ", "ДЕК"][S.cal-now-m] + " " + S.cal-now-y;
                    font-family: G.mono; font-size: 10px; color: G.muted; letter-spacing: 0.6px;
                }
                Text {
                    x: parent.width - self.width - 12px; height: parent.height; vertical-alignment: center;
                    text: "СЕЙЧАС"; font-family: G.mono; font-size: 10.5px; font-weight: 500; letter-spacing: 1.1px;
                    color: nwa.has-hover ? G.ink : G.accent;
                    nwa := TouchArea { mouse-cursor: pointer; clicked => { root.mp-open = false; S.cal-today(); } }
                }
            }
        }
    }

    // ---------- «Показывать»: галочки, окно не закрывается ----------
    if root.sh-open: Rectangle {
        x: bar.x + bar.width - self.width - 9px;
        y: bar.y + bar.height + 4px;
        width: 220px;
        height: shp.preferred-height;
        border-radius: 9px;
        background: G.node;
        border-width: 1px;
        border-color: G.line;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #0000008c;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => { if e.text == Key.Escape { root.sh-open = false; return accept; } reject }
        }
        shp := VerticalLayout {
            padding-top: 6px; padding-bottom: 6px;
            for f in S.cal-filters: Rectangle {
                height: 32px;
                background: fa.has-hover ? G.node-hover : transparent;
                Rectangle {
                    x: 12px; y: 9px; width: 14px; height: 14px; border-radius: 4px;
                    background: f.on ? G.accent : transparent;
                    border-width: f.on ? 0px : 1.5px; border-color: G.line;
                    if f.on: Icon { x: 2px; y: 2px; name: "check"; width: 10px; c: #1A1B1F; stroke-width: 2px; }
                }
                Rectangle { x: 36px; y: 12.5px; width: 7px; height: 7px; border-radius: 3.5px; background: f.hue; }
                Text { x: 52px; height: parent.height; vertical-alignment: center; text: f.label; font-size: 13px; color: G.ink; }
                fa := TouchArea { mouse-cursor: pointer; clicked => { S.cal-filter(f.id); } }
            }
        }
    }
}
