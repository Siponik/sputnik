    callback cv-add-image(float, float);
    callback cv-new();
    callback cv-key(string, float, float);   // undo redo all esc copy cut paste dup group delete layout color:N open edit arrow
    in property <[GDot]> graph-dots;
    in property <[GLine]> graph-lines;
    // граф знаний (G_NotesGraph): фильтры и панель «Читаю»
    in property <string> graph-info;
    in property <[Opt]> graph-groups;
    // «Теги точками», «Вложения», «Без связей», «Ещё не созданные»
    in property <[bool]> graph-show;
    // «Отталкивание», «Длина связей», «Притяжение к центру», 0…1
    in property <[float]> graph-forces;
    in property <bool> graph-local;
    in property <string> graph-q;
    in property <string> graph-sel;
    in property <string> graph-sel-title;
    in property <string> graph-sel-head;
    in property <string> graph-sel-crumb;
    in property <color> graph-sel-hue;
    in property <[string]> graph-sel-tags;
    in property <[MdRow]> graph-sel-lines;
    in property <string> graph-sel-more;
    in property <int> graph-sel-n;
    in property <[Opt]> graph-sel-near;
    // начальный масштаб графа (для проверки окна: SPUTNIK_GRAPH_K=3)
    in property <float> graph-zoom: 1;
    in property <bool> graph-live;                // живой граф ещё движется — нужен следующий кадр
    callback graph-tick();
    callback graph-rebuild();
    callback graph-hover(string);
    callback graph-hold(string, float, float);    // тянут точку: id и место на листе 0…1000; "" — отпустили
    in property <int> graph-sel-rest;
    in property <int> note-sort;
    callback note-sort-set(int);
    callback graph-pick(string);
    callback graph-search(string);
    callback graph-local-set(bool);
    callback graph-group(string);
    callback graph-show-set(int);
    callback graph-force(int, float);
    callback note-mode(int);
    callback note-graph-set(bool);
    callback note-tab-open(string);
    callback note-tab-close(string);
    callback notes-pick();                   // выбрать папку заметок системным окном
    in property <string> upd-version;
    in property <string> upd-notes;
    in property <[Opt]> upd-rows;            // «Что нового» по версиям: id "h" — заголовок «версия · дата», "i" — пункт
    in property <string> upd-info;
    in property <bool> upd-busy;
    callback upd-check();
    callback upd-install();
    callback upd-later();
    callback graph-open(string, string);
}
