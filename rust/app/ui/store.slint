// Связь окна с Rust: модели экранов (их собирает src/view/*) и действия (их ловит src/view/wire.rs).
// Окно ничего не считает само — только показывает и сообщает, что нажали. Так отклик мгновенный:
// Rust меняет память, перерисовывает модели, а Google обновляется фоном.

export struct TaskRow { list-id: string, id: string, title: string, list: string, hue: color, when: string, overdue: bool, done: bool, prio: int, sub: string }
export struct Chip { title: string, hue: color, done: bool, kind: int, list-id: string, id: string, time: string }
export struct Card { list-id: string, id: string, title: string, hue: color, due: string, overdue: bool, prio: int, subs: string, note: bool, done: bool, who: string, topic: string, pin: bool, sub-done: int, sub-total: int, tag: string, sel: bool }
// стикер, разложенный по месту: x/y/h считает Rust, Slint только едет к ним (перелёт при смене раскладки)
export struct StkItem { card: Card, lane: string, hue: color, x: length, y: length, h: length }
export struct Column { id: string, name: string, count: int, limit: int, over: bool, done: bool, hue: color, cards: [Card] }
export struct PipeRow { list-id: string, id: string, title: string, stage: int, stage-name: string, project: string, due: string, overdue: bool, prio: int, done: bool, meta: string, next-name: string, group: string, group-info: string, first: bool, thumb: image, has-thumb: bool, size: string }
export struct SideRow { id: string, name: string, count: int, header: bool, hue: color, active: bool, view: string }
export struct SrcRow { title: string, right: string, done: bool, accent: bool, fold: bool, hue: color }
export struct SrcNode { title: string, label: string, hue: color, y: float, h: float, rows: [SrcRow], dashed: bool }
export struct Wire { y1: float, y2: float, hue: color, dashed: bool }
export struct ArchRow { list-id: string, id: string, title: string, list: string, hue: color, date: string, group: string, first: bool }
export struct InboxRow { list-id: string, id: string, title: string, list: string, when: string }
export struct HabitChip { id: string, name: string, icon: string, hue: color, done: bool, count: int, goal: int }
export struct HabitCard { id: string, name: string, icon: string, hue: color, streak: int, streak-label: string, line: string, sched: string, done: bool, count: int, goal: int, week: [int], off: bool, sched-up: string, unit-up: string, foot: string, foot-hi: bool, now-i: int, letter: string }
export struct MonthRow { id: string, name: string, icon: string, hue: color, cells: [int] }
// всплывашка дела в неделе: название, «ЧТ 19 НОЯ · 11:00–13:00 · 2 Ч», «РАБОТА · ЗАКАЗ», заметка
export struct CalTip { title: string, when: string, src: string, note: string, hue: color }
export struct BlockRow { chip: Chip, tip: CalTip }
// блок недели: kind 0 событие · 1 задача · 2 привычка · 3 ДР · 4 «N дел» (rows, more — «+N ещё»); one — в одну строку
export struct Block { title: string, sub: string, y: float, h: float, x: float, w: float, hue: color, done: bool, kind: int, list-id: string, id: string, one: bool, tip: CalTip, rows: [BlockRow], more: int }
// длинная привычка — фон дня (п. 47); top/bot — видны ли начало и конец
export struct WkBg { y: float, h: float, text: string, top: bool, bot: bool }
export struct Label { text: string, y: float, small: bool }
export struct Day { ymd: string, label: string, num: string, today: bool, sel: bool, all: [Chip], blocks: [Block], habits: string, load: float, more: int, in-month: bool, hdots: [int], all-tips: [CalTip], bg: [WkBg], up: string, down: string, up-h: int, down-h: int }
export struct SphList { id: string, name: string, letter: string, count: int }
export struct SphCard { id: string, name: string, head: color, aside: string, sel: bool, lists: [SphList] }
export struct ArchSph { kind: string, id: string, name: string, meta: string, date: string, head: color, letter: string, group: string, first: bool }
export struct MItem { id: string, label: string, icon: string, key: string, red: bool, sep: bool, sub: bool, off: bool, on: bool, hue: color }
export struct EdOut { text: string, a: int, b: int }
export struct Opt { id: string, label: string, hint: string, hue: color, on: bool }
export struct SphRow { items: [Opt], last: bool }
export struct Sub { id: string, title: string, done: bool }
// блок подзадач этапа в раскрытой строке конвейера (п.32): state 0 пройден, 1 сейчас, 2 следующий
export struct PipeBlock { stage-id: string, name: string, state: int, info: string, done-n: int, total: int, subs: [Sub] }
// отрезок полоски времени (п.33): kind 0 пройден, 1 сейчас, 2 до срока; w — доля
export struct PipeSeg { w: float, kind: int, tip: string }
export struct DpCell { n: int, day: string, other: bool, today: bool, sel: bool }
export struct Found { kind: string, title: string, sub: string, list-id: string, id: string, head: string, mark: styled-text, hue: color, due: string, smark: styled-text }
export struct NoteRow { path: string, title: string, sub: string, cur: bool }
// top/tn — строка таблицы: первая строка таблицы и сколько в ней строк (иначе -1 и 0); block — вся таблица (у первой строки)
export struct MdRow { kind: string, raw: string, md: styled-text, plain: string, top: int, tn: int, block: string }
// Таблица заметки: ячейки по строкам (rows × cols), ширина колонок в em (w, сумма — sum), выравнивание 0–3
export struct TModel { rows: int, cols: int, head: bool, cells: [MdRow], w: [float], sum: float, align: [int] }
export struct CvNode { id: string, kind: string, x: float, y: float, w: float, h: float, title: string, tag: string,
    rows: [MdRow], img: image, missing: bool, head: color, colored: bool, text: string, sel: bool, mv: bool, main: bool, path: string, page: bool, fill: color }
export struct CvEdge { id: string, ax: float, ay: float, c1x: float, c1y: float, c2x: float, c2y: float, bx: float, by: float,
    amv: bool, bmv: bool, label: string, sel: bool, arrow: bool, color: color, colored: bool }
// Строка заметки в режиме «Чтение»: kind — h1/h2/h3/p/li/todo/done/quote/code/hr/img.
export struct GDot { x: float, y: float, r: float, title: string, path: string, missing: bool, near: bool, cur: bool, hue: color, dim: bool, label: bool, id: string }
// строка дерева «Знаний» (G_Notes): kind — dir / note / canvas; у папки path — путь папки
export struct TreeRow { path: string, title: string, kind: string, depth: int, open: bool, n: string, hue: color, own: bool }
export struct GLine { x1: float, y1: float, x2: float, y2: float, near: bool, hue: color }

export global S {
    // ---------- оболочка ----------
    in-out property <int> tab: 0;              // 0 Сегодня · 1 Календарь · 2 Доска · 3 Привычки · 4 Знания · 5 Настройки
    in property <bool> signed-in;
    in property <bool> logging-in;
    in property <bool> busy;
    in property <bool> offline;
    in property <string> status;               // «синхр. 14:02», ошибка
    in property <string> error;
    in property <int> inbox-count;
    in property <int> today-count;
    in property <string> toast;
    in property <string> toast-label;
    in property <int> toast-id;
    in property <string> version;
    callback go(int);                       // 5 — открыть окно настроек поверх раздела
    in property <bool> set-open;            // окно настроек открыто
    callback set-close();
    callback tab-step(int, int) -> int;    // соседняя вкладка по порядку пользователя (Q/E): id, направление ±1 → id
    callback win-drag();
    callback win-min();
    callback win-max();
    callback win-close();
    in-out property <bool> win-maxed;
    callback win-resize(int);              // 0 угол · 1 право · 2 низ · 3 лево
    callback login();
    callback cancel-login();
    callback refresh();
    callback toast-act();
    in property <string> confirm;              // вопрос «Удалить…?»; пусто — окна нет
    in property <string> confirm-yes-label;
    in property <bool> confirm-field;          // в окне есть поле ввода (переименование)
    in property <string> confirm-input;        // его начальный текст
    callback confirm-yes(string);              // ответ: текст поля (без поля — пусто)
    callback confirm-no();

    // ---------- Сегодня ----------
    in property <string> today-label;
    in property <[TaskRow]> today;
    in property <[TaskRow]> overdue;
    in property <[SrcNode]> today-src;
    in property <[Wire]> today-wires;
    in property <[TaskRow]> day-rows;
    in property <int> next-at: -1;
    in property <float> rows-top;
    in property <float> habits-y;
    in property <float> habits-top;
    in property <float> center-h;
    // низ схемы «Сегодня» (источники и середина) — для прокрутки
    in property <float> today-h;
    in property <[color]> hour-cells;
    in property <float> claude-y;
    // п.39 (G_TodayMany): когда задач и списков много — свёрнутые строки «Ещё N задач» и «Сделано · N»
    in property <bool> today-many;
    in property <float> more-y: -1;
    in property <int> more-n;
    in property <float> fold-y: -1;
    in property <int> fold-n;
    in property <bool> fold-open;
    in property <float> hub-y;
    in property <[float]> row-ys;
    callback today-fold(int);   // 0 — «Ещё N задач», 1 — «Сделано»
    in property <int> habits-done;
    in property <string> now-label;
    in property <bool> status-ok: true;
    in property <string> next-time;
    in property <string> next-meta;
    in property <[Chip]> today-events;
    in property <[HabitChip]> today-habits;
    in property <[InboxRow]> inbox;
    in property <int> done-count;
    in property <int> total-count;
    in property <string> next-title;
    in property <string> next-why;
    in property <[string]> understood;         // «Понял: завтра · 17:00 · → Работа»
    in property <string> dest;                 // куда ляжет задача из строки
    callback quick-changed(string);
    callback quick-add(string);
    callback quick-full(string);
    callback toggle(string, string);
    callback open-task(string, string);
    callback habit-tap(string);
    callback accept(string, string);
    callback reject(string, string);
    callback accept-all();

    // ---------- Доска ----------
    in property <[SideRow]> side;
    in property <string> board-id;
    in property <string> board-title;
    in property <string> board-tpl;
    in property <color> board-hue;
    in property <int> board-open;
    in property <string> board-tip;
    in property <string> board-flow;
    in property <int> side-spheres;
    in property <length> board-colw: 232px;     // ширина колонок канбана, 200–360 (п.26)
    callback board-colw-set(length);
    in property <string> board-view;           // kanban | pipe | stickers | list
    in property <[Column]> columns;
    in property <[string]> stages;
    in property <[PipeRow]> pipe;
    in property <string> pipe-open;
    in property <bool> pipe-gallery;
    in property <int> pipe-stage: -1;
    callback pipe-gallery-set(bool);
    callback pipe-stage-set(int);
    in property <string> stk-by;               // topic | due
    in property <int> stk-jar;
    in property <[StkItem]> stk-items;
    in property <length> stk-h;                // высота поля стикеров (до баночки)
    callback stk-drop(string, string, string); // список, задача, тема/срок — бросили стикер в колонку
    in property <string> stk-last;
    callback stk-by-set(string);
    callback open-archive();
    in property <bool> arch-open;
    in property <[ArchRow]> arch-rows;
    in property <[Opt]> arch-spheres;
    in property <string> arch-info;
    callback arch-close();
    callback arch-q-set(string);
    callback arch-sphere-set(string);
    in property <string> pipe-by;              // project | stage
    in property <string> pipe-info;
    in property <[Sub]> pipe-subs;
    in property <string> pipe-note;
    in property <string> pipe-client;
    in property <string> pipe-due;
    in property <int> pipe-prio;
    in property <string> pipe-prev;
    in property <[PipeBlock]> pipe-blocks;
    in property <[PipeSeg]> pipe-segs;
    in property <string> pipe-total;     // «5 дн всего»
    in property <string> pipe-caption;   // «СКЕТЧ 2 · БЛОКИНГ 3 ИДЁТ · ДО СРОКА 4»
    in property <[string]> pipe-tips;    // подсказки на чипах этапов открытой строки
    callback pipe-toggle(string);
    callback pipe-by-set(string);
    callback pipe-sub-add(string, string, string, string); // список, задача, этап, текст
    callback pipe-prio-set(string, string, int);
    callback pipe-back(string, string);
    in property <int> archived;
    callback pick-list(string);
    callback set-view(string);
    callback move-card(string, string, int, int); // список, задача, номер колонки, место в ней
    callback next-stage(string, string);
    callback card-select(string, string);      // список, задача — выбрать карточку
    callback card-key(string);                 // left | right | up | down | open | esc
    callback add-card(string, string, string); // список, колонка, текст
    callback new-list(string);
    callback rename-list(string, string);
    callback delete-list(string);
    callback pin-card(string, string);
    callback card-menu(string, string, string); // список, задача, действие: dup | del | prio1..3 | today | tomorrow

    // ---------- Календарь ----------
    in property <string> cal-title;
    in property <string> cal-mode;             // week | month
    in property <[Day]> days;
    in property <[Label]> hours;
    in property <bool> cal-up;                // неделя раскрыта вверх/вниз кликом по чипу
    in property <bool> cal-down;
    in property <bool> cal-any-up;            // хоть у одного дня есть чип «↑ раньше» / «↓ позже»
    in property <bool> cal-any-down;
    in property <int> today-col: -1;          // колонка сегодня (now-col — только если «сейчас» в видимых часах)
    in property <float> grid-h;
    in property <float> now-y;
    in property <int> now-col;
    in property <string> day-title;
    in property <[Chip]> day-items;
    in property <[Opt]> cal-filters;
    in property <string> free-hint;
    in property <string> cal-sub;              // «НЕДЕЛЯ 45» · «5 ИЗ 30»
    in property <string> cal-head;             // «НЕДЕЛЯ · 02–08 НОЯБРЯ»
    in property <string> cal-head-r;           // «ЗАНЯТО 31 Ч»
    in property <int> free-col: -1;
    in property <float> free-y;
    in property <float> free-h;
    in property <int> free-free: -1;           // свободный день — дремлющий енот
    in property <string> day-head;             // «ЧТ 05 · СЕГОДНЯ»
    in property <string> day-count;
    in property <int> day-next: -1;
    in property <[Opt]> day-habits;
    in property <string> day-habits-sum;
    in property <string> cal-foot;
    in property <string> cal-foot-hl;
    in property <string> cal-rule;
    in property <[string]> cal-stamp;
    callback cal-free-take();
    callback cal-add-close();
    callback cal-shift(int);
    callback cal-today();
    callback cal-goto(int, int);              // год, месяц (0–11) из выбора по клику на «МАРТ 2027»
    in property <int> cal-y;                  // выбранный год и месяц (0–11)
    in property <int> cal-m;
    in property <int> cal-now-y;              // сейчас
    in property <int> cal-now-m;
    in property <int> cal-pos;                // номер показанной недели/месяца — в какую сторону листать
    in property <bool> cal-away;              // ушли с текущей недели/месяца — «к сейчас» ярче
    callback cal-mode-set(string);
    callback cal-pick(string);
    callback cal-filter(string);
    callback cal-add(string, string, string, bool); // день, время, название, событие?
    callback cal-drop(string, string, string, float); // список, задача, день, y в сетке (−1 — весь день)
    // добавление кликом (п. 48): наведение спрашивает, куда встанет рамка; протяжка/клик — черновик; окно рядом
    pure callback cal-snap(float) -> float;          // y под курсором → y начала (шаг 15 мин)
    pure callback cal-time-at(float) -> string;      // y → «17:00»
    callback cal-draft(string, float, float);        // день, y начала и конца протяжки
    callback cal-draft-cancel();
    callback cal-avail(float);                       // высота под сетку недели изменилась
    callback cal-draft-kind(bool);                   // тип в окне сменили — запомнить
    callback cal-draft-add(string, bool);            // название, событие?
    in property <int> draft-col: -1;
    in property <float> draft-y;
    in property <float> draft-h;
    in property <string> draft-time;
    in property <string> draft-head;
    in property <bool> draft-event;
    in property <string> add-time;
    callback cal-edge(bool, int);             // чип «↑ раньше» (true) / «↓ позже»: раскрыть до часа или свернуть
    callback open-event(string);

    // ---------- Привычки ----------
    in property <[HabitCard]> habits;
    in property <[MonthRow]> habit-month;
    in property <[string]> month-days;
    in property <string> habit-mode;           // today | month
    in property <string> habit-tip;
    in property <[Opt]> parts;
    callback habit-mode-set(string);
    callback habit-part(string);
    callback habit-cell(string, int);          // привычка, день месяца
    callback habit-add(string);
    callback habit-remove(string);
    callback habit-pick(string);
    callback habit-day-set(string, int, string); // done | skip | none
    callback habit-all();
    callback habit-new();
    in property <string> habit-meta;           // «6 ПРИВЫЧЕК · СЕГОДНЯ 1 / 5»
    in property <string> hp-id;
    in property <string> hp-name;
    in property <color> hp-hue;
    in property <string> hp-sched;
    in property <int> hp-streak;
    in property <string> hp-label;
    in property <float> hp-ms;                 // 0..1 по дорожке вех 7·21·50·100
    in property <string> hp-month;
    in property <[Opt]> hp-cells;              // id — число, hint — состояние: done/today/miss/fut/off/blank
    in property <[string]> hp-stats;           // лучшая, всего, % за месяц
    in property <string> hp-win;
    in property <string> hp-part;
    in property <bool> hp-tg;
    in property <bool> hp-winrem;
    in property <string> hm-title;
    in property <[string]> hm-wd;              // дни недели над числами месяца
    in property <[string]> hm-pct;
    in property <[string]> hm-sum;             // три карточки итога: заголовок|текст
    in property <int> hm-today;
    // окно правки привычки (G_HabitEdit, #193): правки пишутся в слой сразу, серия не сбрасывается
    in property <bool> he-open;
    in property <string> he-name;
    in property <color> he-hue;
    in property <int> he-streak;               // «серия N дней не сбросится»
    in property <[Opt]> he-icons;              // значки (id — имя иконки), on — выбран
    in property <string> he-icon;              // текущий значок ("" — не выбран)
    in property <[Opt]> he-freq;               // как часто: daily | weekdays | days | week
    in property <[Opt]> he-days;               // свои дни Пн–Вс (id — номер дня 0–6)
    in property <[Opt]> he-per;                // «N раз в неделю» (2..6)
    in property <[Opt]> he-part;               // утро/день/вечер/любое (все off — своё окно)
    in property <string> he-win-s;             // окно «с …»
    in property <string> he-win-e;             // окно «до …»
    in property <string> he-goal;              // цель строкой: «Сделать» | «8 раз»
    in property <int> he-goal-n;               // цель числом: 0 — просто «сделать»
    in property <bool> he-tg;                  // напомнить в Telegram
    in property <bool> he-wrem;                // напомнить в Windows
    in property <string> he-notes;
    callback habit-edit(string);               // открыть правку привычки
    callback he-close();
    callback he-name-set(string);
    callback he-icon-set(string);
    callback he-freq-set(string);
    callback he-day(int);                      // переключить свой день
    callback he-per-set(string);
    callback he-part-set(string);
    callback he-win-s-set(string);             // "" — убрать своё окно, останется часть дня
    callback he-win-e-set(string);
    callback he-goal-set(string);              // "0" — без цели, иначе число раз в день
    callback he-remind(string, bool);          // tg | win
    callback he-notes-set(string);
    callback he-delete();

    // ---------- Окно задачи ----------
    in property <bool> task-open;
    in property <string> t-list;
    in property <string> t-id;
    in property <string> t-title;
    in property <string> t-notes;
    in property <string> t-list-name;
    in property <string> t-due;
    in property <string> t-due-label;
    in property <string> t-time;        // начало «12:30» или пусто — весь день
    in property <string> t-time-label;  // «12:30–13:30»
    callback t-time-set(string);
    in property <string> pipe-time;
    in property <string> pipe-time-label;
    in property <[Opt]> pipe-reminds;
    in property <int> pipe-remind-n;
    callback w-time(string, string, string);   // список, задача, «12:30» или ""
    callback w-date(string, string);           // открыть выбор даты для задачи
    callback w-remind(string, string, string); // список, задача, минуты
    in property <int> t-prio;
    in property <[Opt]> t-cols;
    in property <[Sub]> t-subs;
    in property <[Opt]> t-reminds;
    in property <int> t-remind-n;
    // открытый выпадающий список: одновременно только один (номер выдаёт drop-n)
    in-out property <length> ul-x;            // черта под активной вкладкой шапки
    in-out property <length> ul-y;
    in-out property <length> ul-w;
    in-out property <int> fly-n;              // ←/→ на канбане: карточка «перелетает» в соседнюю колонку
    in-out property <int> fly-dir;
    in-out property <int> list-find;          // Ctrl+Shift+L: +1 — фокус в поле «Список…» на доске
    in-out property <int> drop;
    in-out property <int> drop-n;             // сколько напоминаний включено
    in property <[Opt]> t-repeats;
