// Настройки списка (G_ListSettings): окно по центру поверх доски.
import { G } from "theme.slint";
import { Mono, Button, Node, Field, Brackets, Overlay, Icon, ScrollView } from "kit.slint";
import { S, Opt } from "store.slint";

component Seg3 inherits Rectangle {
    in property <[Opt]> items;
    callback picked(string);
    height: 32px;
    width: sl.preferred-width + 6px;
    border-radius: 6px; border-width: 1px; border-color: G.line;
    sl := HorizontalLayout {
        padding: 3px; spacing: 2px;
        for it in items: Rectangle {
            width: st.preferred-width + 20px;
            border-radius: 4px;
            background: it.on ? G.ink : (sa.has-hover ? G.node-hover : transparent);
            st := Text { text: it.label.to-uppercase(); font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.2px; color: it.on ? #1C1D21 : #A3A5AE; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { clicked => { root.picked(it.id); } mouse-cursor: pointer; }
        }
    }
}

component Switch inherits Rectangle {
    in property <bool> on;
    callback clicked;
    width: 36px; height: 20px; border-radius: 10px;
    background: on ? G.accent : G.line;
    animate background { duration: G.fast; }
    Rectangle { x: on ? parent.width - 18px : 2px; y: 2px; width: 16px; height: 16px; border-radius: 8px; background: #fff; animate x { duration: G.fast; } }
    TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component Row inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    min-height: 60px;
    HorizontalLayout {
        VerticalLayout {
            alignment: center; spacing: 2px;
            Text { text: root.label; color: G.ink; font-size: 13.5px; }
            if root.hint != "": Text { text: root.hint; color: #8A8C96; font-size: 12px; }
        }
        Rectangle { }
        HorizontalLayout { alignment: end; spacing: 6px; VerticalLayout { alignment: center; @children } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
}


// п.24: строка на колонку — ручка, цвет, имя по клику, лимит, корзина. «Готово» последняя и не удаляется.
component ColEditor inherits VerticalLayout {
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    property <int> editing: -1;
    spacing: 0;
    Rectangle {
        height: 40px;
        Text { x: 0; text: "Колонки"; color: G.ink; font-size: 13.5px; vertical-alignment: center; height: parent.height; }
        Text { x: parent.width - self.preferred-width; text: "ИЗ ШАБЛОНА…"; font-family: G.mono; font-size: 10px; letter-spacing: 1.2px; color: tpa.has-hover ? G.accent : #8A8C96; vertical-alignment: center; height: parent.height;
            tpa := TouchArea { clicked => { S.ls-close(); S.tp-show(); } mouse-cursor: pointer; }
        }
    }
    for c[i] in S.ls-cols: Rectangle {
        height: 44px;
        background: root.drag-from >= 0 && root.drag-to == i ? G.accent.transparentize(0.9) : transparent;
        border-radius: 6px;
        Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
        // ручка
        Rectangle {
            x: 0; width: 24px;
            Icon { x: 4px; y: 14px; width: 16px; height: 16px; name: "drag"; c: c.on ? #45464D : (ha.has-hover || root.drag-from == i ? G.ink : #6E7079); }
            ha := TouchArea {
                enabled: !c.on;
                mouse-cursor: c.on ? default : move;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { root.drag-from = i; root.drag-to = i; }
                    if (e.kind == PointerEventKind.up && root.drag-from >= 0) {
                        if (root.drag-to != root.drag-from) { S.ls-set("col-move", root.drag-from + "|" + root.drag-to); }
                        root.drag-from = -1; root.drag-to = -1;
                    }
                }
                moved => { if (root.drag-from >= 0) { root.drag-to = max(0, min(S.ls-cols.length - 2, i + round((self.mouse-y - self.pressed-y) / 44px))); } }
            }
        }
        // цвет
        Rectangle {
            x: 30px; y: 13px; width: 18px; height: 18px; border-radius: 4px; background: c.hue;
            border-width: 1px; border-color: cla.has-hover ? G.ink : transparent;
            cla := TouchArea { clicked => { S.ls-set("col-color", i); } mouse-cursor: pointer; }
        }
        // имя
        if root.editing != i: Text {
            x: 60px; width: parent.width - 60px - 190px; height: parent.height;
            text: c.label; color: G.ink; font-size: 13.5px; vertical-alignment: center; overflow: elide;
            TouchArea { clicked => { root.editing = i; } mouse-cursor: text; }
        }
        if root.editing == i: Field {
            x: 56px; y: 6px; width: parent.width - 56px - 190px; height: 32px; font-size: 13.5px;
            text: c.label;
            init => { self.grab(); }
            escape => { root.editing = -1; }
            accepted(t) => { S.ls-set("col-name", i + "|" + t); root.editing = -1; }
        }
        if c.on: Text { x: parent.width - 182px; text: "ГОТОВО"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.green; vertical-alignment: center; height: parent.height; }
        // задач в колонке
        Text { x: parent.width - 120px - self.preferred-width; text: c.hint; font-family: G.mono; font-size: 10px; color: #62646E; vertical-alignment: center; height: parent.height; }
        // лимит: − N +
        HorizontalLayout {
            x: parent.width - 108px; width: 74px; height: parent.height; spacing: 0;
            Rectangle { width: 22px; Text { text: "−"; color: ma.has-hover ? G.ink : #8A8C96; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } ma := TouchArea { clicked => { S.ls-set("col-limit", i + "|-1"); } mouse-cursor: pointer; } }
            Text { width: 30px; text: c.id == "0" ? "НЕТ" : c.id; font-family: G.mono; font-size: 9.5px; color: c.id == "0" ? #62646E : G.ink; horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { width: 22px; Text { text: "+"; color: pa.has-hover ? G.ink : #8A8C96; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } pa := TouchArea { clicked => { S.ls-set("col-limit", i + "|1"); } mouse-cursor: pointer; } }
        }
        // корзина
        if !c.on && S.ls-cols.length > 2: Rectangle {
            x: parent.width - 26px; width: 22px;
            Icon { x: 3px; y: 14px; width: 16px; height: 16px; name: "trash"; c: da.has-hover ? G.red : #6E7079; }
            da := TouchArea { clicked => { S.ls-set("col-del", i); } mouse-cursor: pointer; }
        }
    }
    Rectangle {
        height: 40px;
        Text { x: 4px; text: "+ КОЛОНКА"; font-family: G.mono; font-size: 10.5px; letter-spacing: 1.2px; color: aa.has-hover ? G.accent : #A3A5AE; vertical-alignment: center; height: parent.height; }
        aa := TouchArea { width: 120px; x: 0; clicked => { S.ls-set("col-add", ""); } mouse-cursor: pointer; }
    }
}

export component ListSettings inherits Overlay {
    close => { S.ls-close(); }
    TouchArea { x: dlg.x; y: dlg.y; width: dlg.width; height: dlg.height; }
    dlg := Node {
        x: (parent.width - self.width) / 2;
        y: max(8px, (parent.height - self.height) / 2);
        width: min(640px, parent.width - 16px);
        height: min(720px, 34px + bl.preferred-height, parent.height - 16px);
        num: "НАСТРОЙКИ СПИСКА"; title: "CTRL .";
        aside: S.ls-tpl;
        head: G.accent.darker(0.3);
        border-color: G.accent-line;
        drop-shadow-blur: 30px; drop-shadow-color: #000c;
        body := ScrollView {
            viewport-height: bl.preferred-height;
            bl := VerticalLayout {
            padding: 22px; padding-bottom: 14px; spacing: 0;
            Text { text: "Название"; color: #A3A5AE; font-size: 13px; }
            Rectangle { height: 8px; }
            name := Field { height: 38px; font-size: 14px; text: S.ls-name; accepted(t) => { S.ls-set("name", t); } }
            Rectangle { height: 6px; }
            Row { label: "Сфера";
                ScrollView {
                    width: min(sph.preferred-width, 400px); height: 28px;
                    viewport-width: sph.preferred-width;
                    sph := HorizontalLayout { spacing: 4px;
                    for o in S.ls-spheres: Rectangle {
                        height: 28px; width: lt.preferred-width + (o.id == "" ? 20px : 32px);
                        border-radius: 4px; border-width: 1px;
                        border-color: o.on ? G.accent : G.line;
                        background: o.on ? G.accent.transparentize(0.88) : (oa.has-hover ? G.node-hover : transparent);
                        if o.id != "": Rectangle { x: 10px; y: (parent.height - 7px) / 2; width: 7px; height: 7px; border-radius: 4px; background: o.hue; }
                        lt := Text { x: o.id == "" ? 10px : 22px; text: o.label; color: o.on ? G.ink : #A3A5AE; font-size: 12.5px; vertical-alignment: center; height: parent.height; }
                        oa := TouchArea { clicked => { S.ls-set("sphere", o.id); } mouse-cursor: pointer; }
                    }
                    }
                }
            }
            Rectangle { height: 6px; }
            ColEditor { }
            Rectangle { height: 6px; }
            Row { label: "Порядок задач"; hint: "Как сортировать карточки в колонках";
                Seg3 {
                    items: [{ id: "own", label: "Свой", on: S.ls-sort == "own" }, { id: "due", label: "По сроку", on: S.ls-sort == "due" }, { id: "prio", label: "По приоритету", on: S.ls-sort == "prio" }];
                    picked(id) => { S.ls-set("sort", id); }
                }
            }
            Row { label: "Показывать в «Сегодня»"; hint: "Задачи с датой попадают на главный экран";
                Switch { on: S.ls-today; clicked => { S.ls-set("today", ""); } }
            }
            Row { label: "В сводке и боте"; hint: "Выключи, если список тихий: доска и напоминания останутся";
                Switch { on: !S.ls-quiet; clicked => { S.ls-set("quiet", ""); } }
            }
            Rectangle { height: 14px; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { }
                Button { text: "Готово"; primary: true; clicked => { S.ls-set("name", name.text); S.ls-close(); } }
            }
            }
        }
    }
    Brackets { x: dlg.x; y: dlg.y; width: dlg.width; height: dlg.height; }
}
