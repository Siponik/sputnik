// Настройки: Вид, Что показывать, Напоминания, Синхронизация, Клавиши, Знания.
// Открываются окном поверх раздела (SettingsWin): ⚙, Ctrl+, или «Настройки» в поиске; цифры 1–6 — разделы (клавиши — app.slint).
import { G } from "theme.slint";
import { Node, Mono, Button, Pill, Check, Field, IconBtn, Link, Icon, ScrollView, Overlay, UpdBar, UpdFail } from "kit.slint";
import { S, Opt } from "store.slint";

component Sw inherits Rectangle {
    in property <Opt> o;
    callback clicked;
    height: 34px;
    preferred-height: 34px;
    background: sa.has-hover ? G.node-hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle { width: 8px; height: 8px; y: 13px; border-radius: 2px; background: o.hue; }
        Text { text: o.label; color: G.ink; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: o.hint; color: G.dim; font-size: 12px; vertical-alignment: center; }
        Rectangle {
            width: 34px;
            height: 18px;
            y: 8px;
            border-radius: 9px;
            background: o.on ? G.accent : G.line;
            animate background { duration: G.fast; }
            Rectangle { x: o.on ? 18px : 2px; y: 2px; width: 14px; height: 14px; border-radius: 7px; background: o.on ? G.on-accent : G.muted; animate x { duration: G.fast; } }
        }
    }
    sa := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Переключатель-чип G: точка цвета, моно-подпись, обводка когда включено.
component TChip inherits Rectangle {
    in property <Opt> o;
    callback clicked;
    height: 30px;
    preferred-height: 30px;
    width: min(tl.preferred-width + (o.hue == #00000000 ? 24px : 38px), 240px);
    border-radius: 5px;
    border-width: 1px;
    border-color: o.on ? G.accent-line.mix(G.accent, 0.4) : G.line;
    background: o.on ? G.accent-wash : (ta.has-hover ? G.node-hover : transparent);
    Rectangle { visible: o.hue != #00000000; x: 12px; y: 12px; width: 6px; height: 6px; border-radius: 1.5px; background: o.hue; opacity: o.on ? 1 : 0.5; }
    tl := Text { x: o.hue == #00000000 ? 12px : 24px; width: parent.width - self.x - 12px; text: o.label.to-uppercase(); font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.3px; color: o.on ? G.ink : G.dim; vertical-alignment: center; height: parent.height; overflow: elide; }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Галочка (radio — кружок, один из вариантов): квадрат с ✓ и подпись.
component CBox inherits Rectangle {
    in property <Opt> o;
    in property <bool> radio;
    callback clicked;
    height: 30px;
    preferred-height: 30px;
    width: cl.preferred-width + 38px;
    border-radius: 5px;
    background: ca.has-hover ? G.node-hover : transparent;
    Rectangle {
        x: 6px; y: 7px; width: 16px; height: 16px;
        border-radius: radio ? 8px : 3px;
        border-width: 1.5px;
        border-color: o.on ? G.accent : (ca.has-hover ? G.ink : G.line-strong);
        background: o.on && !radio ? G.accent : transparent;
        animate background, border-color { duration: G.fast; }
        Icon { name: "check"; width: 10px; x: 3px; y: 3px; visible: o.on && !radio; c: G.on-accent; stroke-width: 2.2px; }
        Rectangle { visible: o.on && radio; x: 4px; y: 4px; width: 8px; height: 8px; border-radius: 4px; background: G.accent; }
    }
    cl := Text { x: 28px; text: o.label; font-size: 13px; color: o.on ? G.ink : G.grey; vertical-alignment: center; height: parent.height; }
    ca := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Сегмент из Opt: выбранное — светлая заливка.
component OSeg inherits Rectangle {
    in property <[Opt]> items;
    callback picked(string);
    height: 32px;
    preferred-height: 32px;
    width: sl.preferred-width + 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: G.line;
    sl := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for it in items: Rectangle {
            width: st.preferred-width + 20px;
            border-radius: 4px;
            background: it.on ? G.ink : (sa.has-hover ? G.node-hover : transparent);
            st := Text { text: it.label.to-uppercase(); font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.2px; color: it.on ? G.bg : G.grey; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { clicked => { root.picked(it.id); } mouse-cursor: pointer; }
        }
    }
}

component SRow inherits Rectangle {
    in property <string> label;
    min-height: 36px;
    preferred-height: 36px;
    Text { x: 0; y: 0; height: 32px; text: root.label; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: G.grey; vertical-alignment: center; }
    HorizontalLayout {
        x: 126px; width: parent.width - 126px;
        spacing: 8px;
        alignment: start;
        @children
    }
}

component Sec inherits Rectangle {
    in property <string> num;
    in property <string> title;
    in property <string> aside;
    in property <bool> main;
    border-radius: main ? 12px : 8px;
    background: G.node;
    border-width: 1px;
    border-color: main ? G.accent-line : G.line;
    clip: true;
    height: 34px + sv.preferred-height;
    Rectangle {
        y: 0; height: 34px;
        background: main ? G.head-main : #3D3E45;
        Text { x: 13px; text: num + "  " + title; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; }
        Text { x: parent.width - self.preferred-width - 13px; text: aside; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: #ffffffc0; vertical-alignment: center; height: parent.height; }
    }
    // высота — по содержимому: без явной высоты раскладка растягивается на всю карточку
    // и уезжает на 34 px шапки вниз — низ (кнопки) обрезался
    sv := VerticalLayout {
        y: 34px;
        height: self.preferred-height;
        padding: 18px;
        padding-left: 20px;
        spacing: 12px;
        @children
    }
}

component Note inherits Text {
    font-family: G.mono;
    font-size: 9px;
    letter-spacing: 1.2px;
    color: G.dim;
    wrap: word-wrap;
}

export component SettingsPage inherits Rectangle {
    callback close;
    // набранная, но не подтверждённая Enter папка заметок — окно сохранит её при клике мимо
    out property <string> typed-root;
    // строка «Найти настройку»
    property <string> q;
    // Смена раздела: содержимое въезжает снизу, если раздел ниже в списке, и сверху — если выше.
    // snap — поставить начальное положение без анимации, через кадр (Timer) — плавно к месту.
    property <int> cur: S.set-tab;
    property <int> last: S.set-tab;
    property <bool> snap;
    property <length> off: 0;
    property <float> op: 1;
    animate off, op { duration: root.snap ? 0ms : G.mid; easing: ease-out; }
    changed cur => {
        root.snap = true;
        root.off = (root.cur > root.last ? 1 : -1) * 18px;
        root.op = 0;
        root.last = root.cur;
        tin.running = true;
    }
    tin := Timer { interval: 16ms; running: false; triggered => { self.running = false; root.snap = false; root.off = 0; root.op = 1; } }
    function pick(tab: int) { S.set-tab = tab; root.q = ""; fq.clear(); S.set-find(""); }
    // Ctrl+K на этом экране — сюда, а не в общий поиск
    property <int> find-ask: S.set-find-focus;
    changed find-ask => { fq.grab(); }
    property <length> mx: 8px;
    property <length> cx: root.mx + 264px;
    property <length> cw: self.width - root.cx - root.mx - 12px;
    // чипов «Что показывать» в ряд: столько, сколько точно влезет (чип не шире 240 px)
    property <int> per: max(1, floor((root.cw - 40px) / 248px));
    // навигация
    Rectangle {
        x: root.mx; y: 20px; width: 240px; height: parent.height - 40px;
        border-radius: 8px;
        background: G.node;
        border-width: 1px;
        border-color: G.line;
        Text { x: 12px; y: 0; height: 32px; text: "НАСТРОЙКИ"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: G.ink; vertical-alignment: center; }
        // закрыть окно: «ESC ×» в шапке меню
        Rectangle {
            x: parent.width - self.width - 6px; y: 4px; width: xl.preferred-width + 16px; height: 24px;
            border-radius: 4px;
            background: xa.has-hover ? G.node-hover : transparent;
            xl := Text { x: 8px; text: "ESC ×"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: xa.has-hover ? G.ink : G.dim; vertical-alignment: center; height: parent.height; }
            xa := TouchArea { clicked => { root.close(); } mouse-cursor: pointer; }
        }
        Rectangle { y: 31px; height: 1px; background: G.line; }
        // выбранный раздел — одна плашка, переезжает к пункту (шаг строки 36 + 2 px)
        if root.q == "": Rectangle {
            x: 9px; y: 82px + S.set-tab * 38px; width: parent.width - 18px; height: 36px;
            border-radius: 6px; border-width: 1px; border-color: G.accent; background: G.accent-wash;
            animate y { duration: G.mid; easing: ease-out; }
        }
        if root.q == "": VerticalLayout {
            x: 9px; y: 82px; width: parent.width - 18px;
            spacing: 2px;
            alignment: start;
            for t[i] in ["ВИД", "ЧТО ПОКАЗЫВАТЬ", "НАПОМИНАНИЯ", "СИНХРОНИЗАЦИЯ", "КЛАВИШИ", "ЗНАНИЯ"]: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: S.set-tab != i && ta.has-hover ? G.node-hover : transparent;
                // номер — клавиша раздела (1–6, пока окно открыто)
                Text { x: 10px; text: "0" + (i + 1); font-family: G.mono; font-size: 9.5px; color: S.set-tab == i ? G.accent : G.dim; vertical-alignment: center; height: parent.height; animate color { duration: G.mid; } }
                Text { x: 32px; text: t; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.3px; color: S.set-tab == i ? G.ink : G.grey; vertical-alignment: center; height: parent.height; animate color { duration: G.mid; } }
                ta := TouchArea { clicked => { S.set-tab = i; } mouse-cursor: pointer; }
            }
        }
        // поиск по настройкам (не общий поиск задач): результаты — вместо списка разделов
        fq := Field {
            x: 10px; y: 42px; width: parent.width - 20px; height: 32px;
            font-size: 13px;
            placeholder: "Найти настройку";
            edited(t) => { root.q = t; S.set-find(t); }
            accepted(t) => { if (S.set-found.length > 0) { root.pick(S.set-found[0].id.to-float()); } }
            escape => { root.pick(S.set-tab); }
        }
        if root.q != "": VerticalLayout {
            x: 9px; y: 82px; width: parent.width - 18px;
            spacing: 2px;
            alignment: start;
            for r in S.set-found: Rectangle {
                height: 44px;
                border-radius: 6px;
                background: ra.has-hover ? G.node-hover : transparent;
                Text { x: 10px; y: 5px; width: parent.width - 20px; text: r.label; font-size: 13px; color: G.ink; overflow: elide; }
                Text { x: 10px; y: 25px; width: parent.width - 20px; text: r.hint.to-uppercase(); font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: G.dim; overflow: elide; }
                ra := TouchArea { clicked => { root.pick(r.id.to-float()); } mouse-cursor: pointer; }
            }
            if S.set-found.length == 0: Text { text: "  Ничего не нашлось"; font-size: 13px; color: G.dim; }
        }
        Text { x: 12px; y: parent.height - 30px; text: "СПУТНИК " + S.version; font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: G.dim; }
    }
    // разделы
    ScrollView {
        x: root.cx - 6px; y: 14px + root.off; width: root.cw + 12px; height: parent.height - 14px;
        opacity: root.op;
        VerticalLayout {
            padding: 6px;
            padding-bottom: 30px;
            spacing: 24px;
            alignment: start;
            if S.set-tab == 0: Sec {
                main: true; num: "01"; title: "ВИД";
                SRow { label: "ТЕМА";
                    OSeg { items: S.set-theme; picked(id) => { S.set-toggle("theme", id); } }
                }
                SRow { label: "АКЦЕНТ";
                    for o in S.set-accent: Rectangle {
                        width: 32px; height: 32px; border-radius: 7px;
                        background: o.hue;
                        border-width: 2px;
                        border-color: o.on ? G.ink : (aa.has-hover ? G.ink.with-alpha(0.4) : transparent);
                        aa := TouchArea { clicked => { S.accent-set(o.id); } mouse-cursor: pointer; }
                    }
                }
                SRow { label: "АНИМАЦИИ"; OSeg { items: S.set-anim; picked(id) => { S.anim-set(id); } }
                    Text { text: "Провода рисуются при открытии экрана"; font-size: 12.5px; color: G.grey; vertical-alignment: center; }
                }
                SRow { label: "ПРИ ЗАПУСКЕ"; OSeg { items: S.set-start; picked(id) => { S.set-toggle("start", id); } } }
                // порядок разделов в шапке: перетаскиваются, номер — клавиша.
                // Пока тащишь, карточка идёт за мышью, а соседи плавно раздвигаются под место, куда она встанет.
                Rectangle {
                    height: 30px + 40px;
                    Text { x: 0; y: 0; height: 26px; text: "ПОРЯДОК ВКЛАДОК · ПЕРЕТАЩИ"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: G.grey; vertical-alignment: center; }
                    property <length> cw: min(150px, (self.width - (S.tab-order.length - 1) * 18px) / max(1, S.tab-order.length));
                    property <length> step: cw + 18px;
                    property <int> drag: -1;      // кого тащим
                    property <length> dx;         // насколько сдвинули
                    property <int> n: S.tab-order.length;
                    // куда встанет: ближайшее место к центру карточки
                    property <int> tgt: drag < 0 ? -1 : max(0, min(n - 1, drag + round(dx / step)));
                    for t[i] in S.tab-order: Rectangle {
                        // место в ряду: соседи между старым и новым местом сдвигаются на одно
                        property <int> slot: drag < 0 || i == drag ? i : (i > drag && i <= tgt ? i - 1 : (i < drag && i >= tgt ? i + 1 : i));
                        property <bool> me: i == drag;
                        x: slot * step;
                        // после отпускания порядок меняется сразу, без анимации — иначе карточки «перепрыгивают»
                        animate x { duration: drag < 0 ? 0ms : G.mid; easing: ease-out; }
                        y: 30px; width: cw; height: 40px;
                        z: me ? 10 : 0;
                        if i > 0 && drag < 0: Rectangle { x: -18px; y: 19px; width: 18px; height: 2px; background: G.accent; }
                        Rectangle {
                            // карточку, которую тащат, держим в пределах ряда
                            x: me ? max(-i * step - 6px, min((n - 1 - i) * step + 6px, dx)) : 0;
                            y: me ? -3px : 0;
                            border-radius: 8px; border-width: 1px;
                            border-color: me || (drag < 0 && i == 0) ? G.accent : (dg.has-hover ? G.line-strong : G.line);
                            background: me ? G.node-hover : G.node;
                            drop-shadow-blur: me ? 16px : 0;
                            drop-shadow-offset-y: me ? 6px : 0;
                            drop-shadow-color: #0009.transparentize(1 - G.shade);
                            animate y, drop-shadow-blur { duration: G.fast; }
                            Icon { x: 10px; width: 14px; name: "drag"; c: me ? G.accent : G.dim; }
                            Text { x: 30px; text: ["СЕГОДНЯ", "КАЛЕНДАРЬ", "ДОСКА", "ПРИВЫЧКИ", "ЗНАНИЯ"][t]; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.3px; color: G.ink; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - 18px; text: ((me ? tgt : slot) + 1) + ""; font-family: G.mono; font-size: 9.5px; color: me ? G.accent : G.dim; vertical-alignment: center; height: parent.height; }
                        }
                        dg := TouchArea {
                            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    drag = i;
                                    dx = 0;
                                } else if (e.kind == PointerEventKind.up && drag == i) {
                                    if (tgt != i) { S.tab-move(i, tgt); }
                                    drag = -1;
                                    dx = 0;
                                } else if (e.kind == PointerEventKind.cancel) {
                                    drag = -1;
                                    dx = 0;
                                }
                            }
                            moved => { if (self.pressed && drag == i) { dx = self.mouse-x - self.pressed-x; } }
                        }
                    }
                }
                Note { text: "ПО ЭТОМУ ПОРЯДКУ РАБОТАЮТ КЛАВИШИ 1–" + S.tab-order.length + " И Q / E"; }
            }
            if S.set-tab == 0 || S.set-tab == 1: Sec {
                main: S.set-tab == 1; num: S.set-tab == 0 ? "02" : "01"; title: "ЧТО ПОКАЗЫВАТЬ";
                aside: S.set-lists.length + " СПИСКОВ · " + S.set-cals.length + " КАЛЕНДАРЕЙ";
                ll := Rectangle {
                    height: lf.preferred-height;
                    lf := VerticalLayout {
                        spacing: 8px;
                        for row in ceil(S.set-lists.length / root.per): HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for k in root.per: Rectangle {
                                width: row * root.per + k < S.set-lists.length ? tc.width : 0;
                                height: 30px;
                                tc := TChip { visible: row * root.per + k < S.set-lists.length; o: S.set-lists[min(row * root.per + k, S.set-lists.length - 1)]; clicked => { S.set-toggle("list", S.set-lists[row * root.per + k].id); } }
                            }
                        }
                        for row in ceil(S.set-cals.length / root.per): HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for k in root.per: Rectangle {
                                width: row * root.per + k < S.set-cals.length ? cc.width : 0;
                                height: 30px;
                                cc := TChip { visible: row * root.per + k < S.set-cals.length; o: S.set-cals[min(row * root.per + k, S.set-cals.length - 1)]; clicked => { S.set-toggle("cal", S.set-cals[row * root.per + k].id); } }
                            }
                        }
                    }
                }
                Note { text: "СКРЫТЫЕ СПИСКИ НЕ ПОПАДАЮТ В «СЕГОДНЯ», КАЛЕНДАРЬ И НАПОМИНАНИЯ"; }
            }
            if S.set-tab == 2: Sec {
                main: true; num: "01"; title: "НАПОМИНАНИЯ"; aside: "МОЖНО НЕСКОЛЬКО";
                // «не напоминать» — это «ничего не отмечено», отдельной галочки нет (её убирает settings.rs)
                SRow { label: "ЗАДАЧАМ"; for o in S.set-remind-task: CBox { o: o; clicked => { S.set-toggle("remind-task", o.id); } } }
                SRow { label: "СОБЫТИЯМ"; for o in S.set-remind-event: CBox { o: o; clicked => { S.set-toggle("remind-event", o.id); } } }
                SRow { label: "ДНЯМ РОЖДЕНИЯ"; for o in S.set-remind-bday: CBox { o: o; clicked => { S.set-toggle("remind-bday", o.id); } } }
                Note { text: "НИЧЕГО НЕ ОТМЕЧЕНО — НЕ НАПОМИНАТЬ. ЭТО УМОЛЧАНИЯ ДЛЯ НОВЫХ: У ЗАДАЧИ МОЖНО ПОМЕНЯТЬ В ЕЁ ОКНЕ"; }
                SRow { label: "БЕЗ ВРЕМЕНИ — В"; for o in S.set-remind-hour: CBox { radio: true; o: o; clicked => { S.set-toggle("hour", o.id); } } }
                Rectangle { height: 1px; background: G.line-soft; }
                SRow { label: "КУДА СЛАТЬ"; for o in S.set-flags: CBox { o: o; clicked => { S.set-toggle("flag", o.id); } } }
                for o in S.set-flags: Note { text: o.label.to-uppercase() + " — " + o.hint.to-uppercase(); }
            }
            if S.set-tab == 2: Sec {
                num: "02"; title: "TELEGRAM · @SPUTNIKTASKSBOT"; aside: S.bot-name != "" ? "ПОДКЛЮЧЁН" : "";
                Text { text: S.bot-name != "" ? "Подключён: " + S.bot-name : "Напиши боту /start, он пришлёт код из 6 цифр — введи его здесь."; color: G.ink; font-size: 13px; wrap: word-wrap; }
                if S.bot-status != "": Note { text: S.bot-status.to-uppercase(); }
                if S.bot-name == "": Field { width: 220px; mono: true; placeholder: "код 123456"; accepted(t) => { S.bot-link(t); self.clear(); } }
                if S.bot-name != "": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Проверить"; clicked => { S.bot-test(); } }
                    Button { text: "Отключить"; clicked => { S.bot-unlink(); } }
                }
            }
            if S.set-tab == 3: Sec {
                main: true; num: "01"; title: "СИНХРОНИЗАЦИЯ";
                Text { text: S.sync-info; color: G.ink; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Синхронизировать сейчас"; primary: true; clicked => { S.refresh(); } }
                    Button { text: "Выйти из Google"; clicked => { S.sign-out(); } }
                }
                Note { text: S.backup-info.to-uppercase(); }
                HorizontalLayout { alignment: start; Button { text: "Открыть папку с копиями"; clicked => { S.open-backups(); } } }
            }
            if S.set-tab == 5: Sec {
                main: true; num: "01"; title: "ЗНАНИЯ · ПАПКА ЗАМЕТОК";
                Text { text: "Папка с Markdown-файлами (можно ту же, что у Obsidian). Заметки лежат в ней обычными файлами — Спутник их не трогает, только читает и дополняет."; color: G.grey; font-size: 13px; wrap: word-wrap; }
                Field { width: 100%; mono: true; font-size: 12px; text: S.notes-root; edited(t) => { root.typed-root = t; } accepted(t) => { root.typed-root = ""; S.notes-root-set(t); } }
                Note { text: "РАЗДЕЛ «ЗНАНИЯ» — ПЯТАЯ ВКЛАДКА В ШАПКЕ. ТАМ ЖЕ ПОИСК, СВЯЗИ И ГРАФ"; }
            }
            if S.set-tab == 4: Sec {
                main: true; num: "01"; title: "КЛАВИШИ";
                for k in [
                    ["1 … 5", "разделы: Сегодня, Календарь, Доска, Привычки, Знания"],
                    ["Q / E", "раздел левее / правее"],
                    ["N, Ctrl+N", "создать"],
                    ["Ctrl+K, /", "поиск"],
                    ["R, F5", "синхронизировать"],
                    ["Ctrl+,", "настройки"],
                    ["1 … 6, ↑ ↓", "в настройках: разделы"],
                    ["Shift+1…9", "отметить привычку"],
                    ["[ ]", "предыдущий / следующий список на доске"],
                    ["Ctrl+Shift+L", "найти список на доске"],
                    ["Ctrl+.", "настройки списка"],
                    ["← → T W M", "календарь: листать, сегодня, неделя, месяц"],
                    ["Esc", "закрыть окно"],
                ]: Rectangle {
                    height: 30px;
                    Rectangle {
                        x: 0; y: 4px; height: 22px; width: kt.preferred-width + 14px;
                        border-radius: 4px; border-width: 1px; border-color: G.line;
                        kt := Text { text: k[0]; font-family: G.mono; font-size: 10px; color: G.accent-ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { x: 150px; text: k[1]; color: G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                }
            }
            if S.set-tab == 3: Sec {
                num: "02"; title: "ОБНОВЛЕНИЯ"; aside: "СТОИТ " + S.version;
                Text { text: "Спутник " + S.version + " — Rust + Slint. Данные в Google Tasks и Календаре, свой слой — на этом компьютере и в скрытой папке приложения на Google Drive. Своего сервера нет."; color: G.ink; font-size: 13px; wrap: word-wrap; }
                if S.upd-rows.length > 0: VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    for r in S.upd-rows: Text {
                        text: r.id == "h" ? r.label.to-uppercase() : "· " + r.label;
                        font-family: r.id == "h" ? G.mono : G.sans;
                        font-size: r.id == "h" ? 9.5px : 12.5px;
                        letter-spacing: r.id == "h" ? 1.2px : 0px;
                        color: r.id == "h" ? G.gold : G.ink;
                        wrap: word-wrap;
                    }
                }
                Note { text: (S.upd-phase == 2 ? "СКАЧИВАЮ ВЕРСИЮ " + S.upd-version : S.upd-phase == 3 ? "СТАВЛЮ ВЕРСИЮ " + S.upd-version + " — СПУТНИК ПЕРЕЗАПУСТИТСЯ САМ" : S.upd-version != "" ? "ВЫШЛА ВЕРСИЯ " + S.upd-version + " — ЧИП «ВЕРСИЯ» В ШАПКЕ" : S.upd-info).to-uppercase(); }
                if S.upd-phase == 2 || S.upd-phase == 3: UpdBar { frac: S.upd-phase == 3 ? -1 : S.upd-frac; text: S.upd-progress; }
                if S.upd-phase == 4: UpdFail { what: S.upd-err; hint: S.upd-hint; }
                HorizontalLayout { alignment: start; spacing: 8px;
                    if S.upd-phase != 2 && S.upd-phase != 3: Button { text: S.upd-busy ? "Проверяю…" : "Проверить обновления"; clicked => { S.upd-check(); } }
                    if S.upd-version != "" && S.upd-phase != 2 && S.upd-phase != 3: Button { text: S.upd-phase == 4 ? "Повторить" : "Обновить сейчас"; primary: true; clicked => { S.upd-install(); } }
                    if S.upd-phase == 2: Button { text: "Остановить"; clicked => { S.upd-cancel(); } }
                }
            }
        }
    }
}

// Окно настроек поверх текущего раздела: фон затемнён, клик мимо — закрыть (всё и так сохраняется сразу,
// набранную, но не подтверждённую папку заметок окно сохраняет само). Появляется плавно: всплывает на 14 px.
export component SettingsWin inherits Overlay {
    property <bool> shown;
    close => { S.set-close(); }
    dismiss => {
        if (page.typed-root != S.notes-root && page.typed-root != "") { S.notes-root-set(page.typed-root); }
        S.set-close();
    }
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: G.mid; easing: ease-out; }
    tshow := Timer { interval: 16ms; running: true; triggered => { self.running = false; root.shown = true; } }
    // клик по самому окну не закрывает его
    TouchArea { x: win.x; y: win.y; width: win.width; height: win.height; }
    win := Rectangle {
        width: min(1120px, parent.width - 96px);
        height: min(760px, parent.height - 96px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.shown ? 0 : 14px);
        animate y { duration: G.mid; easing: ease-out; }
        border-radius: 12px;
        background: G.ground;
        border-width: 1px;
        border-color: G.line-strong;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000c.transparentize(1 - G.shade);
        clip: true;
        Image { width: 100%; height: 100%; source: @image-url("dot.svg"); horizontal-tiling: repeat; vertical-tiling: repeat; }
        page := SettingsPage { width: 100%; height: 100%; close => { root.dismiss(); } }
    }
}
