// Настройки: Вид, Что показывать, Напоминания, Синхронизация, Клавиши.
import { G } from "theme.slint";
import { Node, Mono, Button, Pill, Check, Field, IconBtn, Link } from "kit.slint";
import { S, Opt } from "store.slint";
import { ScrollView } from "std-widgets.slint";

component Sw inherits Rectangle {
    in property <Opt> o;
    callback clicked;
    height: 34px;
    background: sa.has-hover ? G.node-hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle { width: 8px; height: 8px; y: 13px; border-radius: 2px; background: o.hue; }
        Text { text: o.label; color: G.ink; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: o.hint; color: G.dim; font-size: 12px; vertical-alignment: center; }
        Rectangle {
            width: 34px;
            height: 18px;
            y: 8px;
            border-radius: 9px;
            background: o.on ? G.accent : G.line;
            animate background { duration: G.fast; }
            Rectangle { x: o.on ? 18px : 2px; y: 2px; width: 14px; height: 14px; border-radius: 7px; background: o.on ? G.on-accent : G.muted; animate x { duration: G.fast; } }
        }
    }
    sa := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component Sec inherits Node {
    preferred-height: 30px + sv.preferred-height;
    sv := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        @children
    }
}

export component SettingsPage inherits Rectangle {
    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: G.bg;
            Rectangle { x: parent.width - 1px; width: 1px; background: G.line; }
            VerticalLayout {
                padding-top: 16px;
                alignment: start;
                for t[i] in ["Вид", "Что показывать", "Напоминания", "Синхронизация", "Клавиши", "О программе"]: Rectangle {
                    height: 36px;
                    background: S.set-tab == i ? G.accent-wash : (ta.has-hover ? G.node-hover : transparent);
                    Rectangle { x: 0; visible: S.set-tab == i; width: 2px; background: G.accent; }
                    Text { x: 18px; text: t; color: S.set-tab == i ? G.ink : G.muted; font-size: 14px; vertical-alignment: center; height: parent.height; }
                    ta := TouchArea { clicked => { S.set-tab = i; } mouse-cursor: pointer; }
                }
            }
        }
        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 18px;
                alignment: start;
                if S.set-tab == 0: Sec {
                    num: "01"; title: "ВИД";
                    Text { text: "Открывать при запуске"; color: G.muted; font-size: 13px; }
                    HorizontalLayout { spacing: 6px; alignment: start; for o in S.set-start: Pill { text: o.label; on: o.on; clicked => { S.set-toggle("start", o.id); } } }
                    for o in S.set-flags: Sw { o: o; clicked => { S.set-toggle("flag", o.id); } }
                }
                if S.set-tab == 1: Sec {
                    num: "02"; title: "СПИСКИ НА ДОСКЕ И В «СЕГОДНЯ»";
                    for o in S.set-lists: Sw { o: o; clicked => { S.set-toggle("list", o.id); } }
                }
                if S.set-tab == 1: Sec {
                    num: "03"; title: "КАЛЕНДАРИ";
                    for o in S.set-cals: Sw { o: o; clicked => { S.set-toggle("cal", o.id); } }
                }
                if S.set-tab == 2: Sec {
                    num: "04"; title: "НАПОМИНАНИЯ";
                    Text { text: "Для новых задач по умолчанию"; color: G.muted; font-size: 13px; }
                    HorizontalLayout { spacing: 6px; alignment: start; for o in S.set-remind-task: Pill { text: o.label; on: o.on; clicked => { S.set-toggle("remind", o.id); } } }
                    Text { text: "Задачам без времени напоминать в"; color: G.muted; font-size: 13px; }
                    HorizontalLayout { spacing: 6px; alignment: start; for o in S.set-remind-hour: Pill { text: o.label; on: o.on; clicked => { S.set-toggle("hour", o.id); } } }
                }
                if S.set-tab == 2: Sec {
                    num: "05"; title: "TELEGRAM · @SPUTNIKTASKSBOT";
                    Text { text: S.bot-name != "" ? "Подключён: " + S.bot-name : "Напиши боту /start, он пришлёт код из 6 цифр — введи его здесь."; color: G.ink; font-size: 13px; wrap: word-wrap; }
                    Text { text: S.bot-status; color: G.dim; font-size: 12px; }
                    if S.bot-name == "": Field { width: 220px; mono: true; placeholder: "код 123456"; accepted(t) => { S.bot-link(t); self.clear(); } }
                    if S.bot-name != "": HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { text: "Проверить"; clicked => { S.bot-test(); } }
                        Button { text: "Отключить"; clicked => { S.bot-unlink(); } }
                    }
                }
                if S.set-tab == 3: Sec {
                    num: "06"; title: "СИНХРОНИЗАЦИЯ";
                    Text { text: S.sync-info; color: G.ink; font-size: 13px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { text: "Синхронизировать сейчас"; primary: true; clicked => { S.refresh(); } }
                        Button { text: "Выйти из Google"; clicked => { S.sign-out(); } }
                    }
                    Text { text: S.backup-info; color: G.muted; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout { alignment: start; Button { text: "Открыть папку с копиями"; clicked => { S.open-backups(); } } }
                }
                if S.set-tab == 3: Sec {
                    num: "07"; title: "ЗНАНИЯ · ПАПКА ЗАМЕТОК";
                    Text { text: "Папка с Markdown-файлами (можно ту же, что у Obsidian):"; color: G.muted; font-size: 13px; }
                    Field { mono: true; font-size: 12px; text: S.notes-root; accepted(t) => { S.notes-root-set(t); } }
                }
                if S.set-tab == 4: Sec {
                    num: "08"; title: "КЛАВИШИ";
                    for k in [
                        ["1 … 5", "разделы: Сегодня, Календарь, Доска, Привычки, Знания"],
                        ["Q / E", "раздел левее / правее"],
                        ["N, Ctrl+N", "создать"],
                        ["Ctrl+K, /", "поиск"],
                        ["R, F5", "синхронизировать"],
                        ["Ctrl+,", "настройки"],
                        ["Shift+1…9", "отметить привычку"],
                        ["[ ]", "предыдущий / следующий список на доске"],
                        ["← → T W M", "календарь: листать, сегодня, неделя, месяц"],
                        ["Esc", "закрыть окно"],
                    ]: HorizontalLayout {
                        height: 26px;
                        spacing: 12px;
                        Mono { text: k[0]; width: 120px; color: G.accent-ink; vertical-alignment: center; }
                        Text { text: k[1]; color: G.ink; font-size: 13px; vertical-alignment: center; }
                    }
                }
                if S.set-tab == 5: Sec {
                    num: "09"; title: "О ПРОГРАММЕ";
                    Text { text: "Спутник " + S.version + " — Rust + Slint. Данные в Google Tasks и Календаре, свой слой — на этом компьютере и в скрытой папке приложения на Google Drive. Своего сервера нет."; color: G.ink; font-size: 13px; wrap: word-wrap; }
                    Text { text: S.sync-info; color: G.dim; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
    }
}
