// Настройки: Вид, Что показывать, Напоминания, Синхронизация, Клавиши.
import { G } from "theme.slint";
import { Node, Mono, Button, Pill, Check, Field, IconBtn, Link, Icon } from "kit.slint";
import { S, Opt } from "store.slint";
import { ScrollView } from "std-widgets.slint";

component Sw inherits Rectangle {
    in property <Opt> o;
    callback clicked;
    height: 34px;
    preferred-height: 34px;
    background: sa.has-hover ? G.node-hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle { width: 8px; height: 8px; y: 13px; border-radius: 2px; background: o.hue; }
        Text { text: o.label; color: G.ink; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: o.hint; color: G.dim; font-size: 12px; vertical-alignment: center; }
        Rectangle {
            width: 34px;
            height: 18px;
            y: 8px;
            border-radius: 9px;
            background: o.on ? G.accent : G.line;
            animate background { duration: G.fast; }
            Rectangle { x: o.on ? 18px : 2px; y: 2px; width: 14px; height: 14px; border-radius: 7px; background: o.on ? G.on-accent : G.muted; animate x { duration: G.fast; } }
        }
    }
    sa := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Переключатель-чип G: точка цвета, моно-подпись, обводка когда включено.
component TChip inherits Rectangle {
    in property <Opt> o;
    callback clicked;
    height: 30px;
    preferred-height: 30px;
    width: tl.preferred-width + (o.hue == #00000000 ? 24px : 38px);
    border-radius: 5px;
    border-width: 1px;
    border-color: o.on ? G.accent-line.mix(G.accent, 0.4) : G.line;
    background: o.on ? #2C2620 : (ta.has-hover ? G.node-hover : transparent);
    Rectangle { visible: o.hue != #00000000; x: 12px; y: 12px; width: 6px; height: 6px; border-radius: 1.5px; background: o.hue; opacity: o.on ? 1 : 0.5; }
    tl := Text { x: o.hue == #00000000 ? 12px : 24px; text: o.label.to-uppercase(); font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.3px; color: o.on ? G.ink : #7A7C86; vertical-alignment: center; height: parent.height; }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Сегмент из Opt: выбранное — светлая заливка.
component OSeg inherits Rectangle {
    in property <[Opt]> items;
    callback picked(string);
    height: 32px;
    preferred-height: 32px;
    width: sl.preferred-width + 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: G.line;
    sl := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for it in items: Rectangle {
            width: st.preferred-width + 20px;
            border-radius: 4px;
            background: it.on ? G.ink : (sa.has-hover ? G.node-hover : transparent);
            st := Text { text: it.label.to-uppercase(); font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.2px; color: it.on ? #1C1D21 : #A3A5AE; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { clicked => { root.picked(it.id); } mouse-cursor: pointer; }
        }
    }
}

component SRow inherits Rectangle {
    in property <string> label;
    min-height: 36px;
    preferred-height: 36px;
    Text { x: 0; y: 0; height: 32px; text: root.label; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #A3A5AE; vertical-alignment: center; }
    HorizontalLayout {
        x: 126px; width: parent.width - 126px;
        spacing: 8px;
        alignment: start;
        @children
    }
}

component Sec inherits Rectangle {
    in property <string> num;
    in property <string> title;
    in property <string> aside;
    in property <bool> main;
    border-radius: main ? 12px : 8px;
    background: G.node;
    border-width: 1px;
    border-color: main ? G.accent-line : G.line;
    clip: true;
    height: 34px + sv.preferred-height;
    Rectangle {
        y: 0; height: 34px;
        background: main ? G.head-main : #3D3E45;
        Text { x: 13px; text: num + "  " + title; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; }
        Text { x: parent.width - self.preferred-width - 13px; text: aside; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: #ffffffc0; vertical-alignment: center; height: parent.height; }
    }
    // высота — по содержимому: без явной высоты раскладка растягивается на всю карточку
    // и уезжает на 34 px шапки вниз — низ (кнопки) обрезался
    sv := VerticalLayout {
        y: 34px;
        height: self.preferred-height;
        padding: 18px;
        padding-left: 20px;
        spacing: 12px;
        @children
    }
}

component Note inherits Text {
    font-family: G.mono;
    font-size: 9px;
    letter-spacing: 1.2px;
    color: #7A7C86;
    wrap: word-wrap;
}

export component SettingsPage inherits Rectangle {
    property <length> mx: 8px;
    property <length> cx: root.mx + 264px;
    property <length> rw: 260px;
    // предпросмотр справа — только когда хватает ширины (масштаб 125–150 % и маленькие экраны)
    property <bool> prev: S.set-tab == 0 && self.width >= 1100px;
    property <length> cw: root.prev ? self.width - root.cx - root.rw - 24px - root.mx : self.width - root.cx - root.mx - 12px;
    // навигация
    Rectangle {
        x: root.mx; y: 20px; width: 240px; height: parent.height - 40px;
        border-radius: 8px;
        background: G.node;
        border-width: 1px;
        border-color: G.line;
        Text { x: 12px; y: 0; height: 32px; text: "НАСТРОЙКИ"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: G.ink; vertical-alignment: center; }
        Text { x: parent.width - self.preferred-width - 12px; y: 0; height: 32px; text: "CTRL ,"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: #7A7C86; vertical-alignment: center; }
        Rectangle { y: 31px; height: 1px; background: G.line; }
        VerticalLayout {
            x: 9px; y: 82px; width: parent.width - 18px;
            spacing: 2px;
            alignment: start;
            for t[i] in ["ВИД", "ЧТО ПОКАЗЫВАТЬ", "НАПОМИНАНИЯ", "СИНХРОНИЗАЦИЯ", "КЛАВИШИ", "ОБНОВЛЕНИЯ", "ЗНАНИЯ"]: Rectangle {
                height: 36px;
                border-radius: 6px;
                border-width: S.set-tab == i ? 1px : 0;
                border-color: G.accent;
                background: S.set-tab == i ? #2E2620 : (ta.has-hover ? G.node-hover : transparent);
                Text { x: 10px; text: "0" + (i + 1); font-family: G.mono; font-size: 9.5px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
                Text { x: 32px; text: t; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.3px; color: S.set-tab == i ? G.ink : #A3A5AE; vertical-alignment: center; height: parent.height; }
                ta := TouchArea { clicked => { S.set-tab = i; } mouse-cursor: pointer; }
            }
        }
        Rectangle {
            x: 10px; y: 42px; width: parent.width - 20px; height: 32px;
            border-radius: 6px; border-width: 1px; border-color: #6E7079;
            Text { x: 10px; text: "Найти настройку — Ctrl K"; font-size: 13px; color: #8A8C96; vertical-alignment: center; height: parent.height; }
            TouchArea { clicked => { S.search-open-set(true); } mouse-cursor: pointer; }
        }
        Text { x: 12px; y: parent.height - 30px; text: "СПУТНИК " + S.version; font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: #7A7C86; }
    }
    // разделы
    ScrollView {
        x: root.cx - 6px; y: 14px; width: root.cw + 12px; height: parent.height - 14px;
        VerticalLayout {
            padding: 6px;
            padding-bottom: 30px;
            spacing: 24px;
            alignment: start;
            if S.set-tab == 0: Sec {
                main: true; num: "01"; title: "ВИД";
                SRow { label: "ТЕМА";
                    OSeg { items: [{ id: "dark", label: "Тёмная", on: true }, { id: "light", label: "Светлая" }, { id: "sys", label: "Как в системе" }]; }
                    Text { text: "светлая появится позже"; font-size: 12.5px; color: #7A7C86; vertical-alignment: center; }
                }
                SRow { label: "АКЦЕНТ";
                    for o in S.set-accent: Rectangle {
                        width: 32px; height: 32px; border-radius: 7px;
                        background: o.hue;
                        border-width: 2px;
                        border-color: o.on ? G.ink : (aa.has-hover ? G.ink.with-alpha(0.4) : transparent);
                        aa := TouchArea { clicked => { S.accent-set(o.id); } mouse-cursor: pointer; }
                    }
                }
                SRow { label: "АНИМАЦИИ"; OSeg { items: S.set-anim; picked(id) => { S.anim-set(id); } }
                    Text { text: "Провода рисуются при открытии экрана"; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; }
                }
                SRow { label: "ПРИ ЗАПУСКЕ"; OSeg { items: S.set-start; picked(id) => { S.set-toggle("start", id); } } }
                for o in S.set-flags: SRow {
                    label: "";
                    TChip { o: o; clicked => { S.set-toggle("flag", o.id); } }
                    Text { text: o.hint; font-size: 12.5px; color: #A3A5AE; vertical-alignment: center; }
                }
                // порядок разделов в шапке: перетаскиваются, номер — клавиша
                Rectangle {
                    height: 30px + 40px;
                    Text { x: 0; y: 0; height: 26px; text: "ПОРЯДОК ВКЛАДОК · ПЕРЕТАЩИ"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #A3A5AE; vertical-alignment: center; }
                    property <length> cw: min(150px, (self.width - (S.tab-order.length - 1) * 18px) / max(1, S.tab-order.length));
                    for t[i] in S.tab-order: Rectangle {
                        x: i * (cw + 18px) + (dg.pressed ? dg.mouse-x - dg.pressed-x : 0);
                        y: 30px; width: cw; height: 40px;
                        if i > 0 && !dg.pressed: Rectangle { x: -18px; y: 19px; width: 18px; height: 2px; background: G.accent; }
                        Rectangle {
                            border-radius: 8px; border-width: 1px;
                            border-color: dg.pressed || i == 0 ? G.accent : G.line;
                            background: dg.pressed ? G.node-hover : G.node;
                            drop-shadow-blur: dg.pressed ? 12px : 0;
                            drop-shadow-color: #0008;
                            Icon { x: 10px; width: 14px; name: "drag"; c: G.dim; }
                            Text { x: 30px; text: ["СЕГОДНЯ", "КАЛЕНДАРЬ", "ДОСКА", "ПРИВЫЧКИ", "ЗНАНИЯ"][t]; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.3px; color: G.ink; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - 18px; text: (i + 1) + ""; font-family: G.mono; font-size: 9.5px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
                        }
                        dg := TouchArea {
                            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up) {
                                    S.tab-move(i, max(0, min(S.tab-order.length - 1, i + round((self.mouse-x - self.pressed-x) / (cw + 18px)))));
                                }
                            }
                        }
                    }
                }
                Note { text: "ПО ЭТОМУ ПОРЯДКУ РАБОТАЮТ КЛАВИШИ 1–" + S.tab-order.length + " И Q / E"; }
            }
            if S.set-tab == 0 || S.set-tab == 1: Sec {
                main: S.set-tab == 1; num: "02"; title: "ЧТО ПОКАЗЫВАТЬ";
                aside: S.set-lists.length + " СПИСКОВ · " + S.set-cals.length + " КАЛЕНДАРЕЙ";
                ll := Rectangle {
                    height: lf.preferred-height;
                    lf := VerticalLayout {
                        spacing: 8px;
                        for row in ceil(S.set-lists.length / 4): HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for k in 4: Rectangle {
                                width: row * 4 + k < S.set-lists.length ? tc.width : 0;
                                height: 30px;
                                tc := TChip { visible: row * 4 + k < S.set-lists.length; o: S.set-lists[min(row * 4 + k, S.set-lists.length - 1)]; clicked => { S.set-toggle("list", S.set-lists[row * 4 + k].id); } }
                            }
                        }
                        for row in ceil(S.set-cals.length / 4): HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for k in 4: Rectangle {
                                width: row * 4 + k < S.set-cals.length ? cc.width : 0;
                                height: 30px;
                                cc := TChip { visible: row * 4 + k < S.set-cals.length; o: S.set-cals[min(row * 4 + k, S.set-cals.length - 1)]; clicked => { S.set-toggle("cal", S.set-cals[row * 4 + k].id); } }
                            }
                        }
                    }
                }
                Note { text: "СКРЫТЫЕ СПИСКИ НЕ ПОПАДАЮТ В «СЕГОДНЯ», КАЛЕНДАРЬ И НАПОМИНАНИЯ"; }
            }
            if S.set-tab == 2: Sec {
                main: true; num: "03"; title: "НАПОМИНАНИЯ";
                SRow { label: "ЗАДАЧАМ"; for o in S.set-remind-task: TChip { o: { id: o.id, label: o.label, hint: o.hint, hue: #00000000, on: o.on }; clicked => { S.set-toggle("remind-task", o.id); } } }
                SRow { label: "СОБЫТИЯМ"; for o in S.set-remind-event: TChip { o: { id: o.id, label: o.label, hint: o.hint, hue: #00000000, on: o.on }; clicked => { S.set-toggle("remind-event", o.id); } } }
                SRow { label: "ДНЯМ РОЖДЕНИЯ"; for o in S.set-remind-bday: TChip { o: { id: o.id, label: o.label, hint: o.hint, hue: #00000000, on: o.on }; clicked => { S.set-toggle("remind-bday", o.id); } } }
                SRow { label: "БЕЗ ВРЕМЕНИ — В"; for o in S.set-remind-hour: TChip { o: { id: o.id, label: o.label, hint: o.hint, hue: #00000000, on: o.on }; clicked => { S.set-toggle("hour", o.id); } } }
            }
            if S.set-tab == 2: Sec {
                num: "04"; title: "TELEGRAM · @SPUTNIKTASKSBOT"; aside: S.bot-name != "" ? "ПОДКЛЮЧЁН" : "";
                Text { text: S.bot-name != "" ? "Подключён: " + S.bot-name : "Напиши боту /start, он пришлёт код из 6 цифр — введи его здесь."; color: G.ink; font-size: 13px; wrap: word-wrap; }
                if S.bot-status != "": Note { text: S.bot-status.to-uppercase(); }
                if S.bot-name == "": Field { width: 220px; mono: true; placeholder: "код 123456"; accepted(t) => { S.bot-link(t); self.clear(); } }
                if S.bot-name != "": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Проверить"; clicked => { S.bot-test(); } }
                    Button { text: "Отключить"; clicked => { S.bot-unlink(); } }
                }
            }
            if S.set-tab == 3: Sec {
                main: true; num: "05"; title: "СИНХРОНИЗАЦИЯ";
                Text { text: S.sync-info; color: G.ink; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Синхронизировать сейчас"; primary: true; clicked => { S.refresh(); } }
                    Button { text: "Выйти из Google"; clicked => { S.sign-out(); } }
                }
                Note { text: S.backup-info.to-uppercase(); }
                HorizontalLayout { alignment: start; Button { text: "Открыть папку с копиями"; clicked => { S.open-backups(); } } }
            }
            if S.set-tab == 6: Sec {
                main: true; num: "08"; title: "ЗНАНИЯ · ПАПКА ЗАМЕТОК";
                Text { text: "Папка с Markdown-файлами (можно ту же, что у Obsidian). Заметки лежат в ней обычными файлами — Спутник их не трогает, только читает и дополняет."; color: #A3A5AE; font-size: 13px; wrap: word-wrap; }
                Field { width: 100%; mono: true; font-size: 12px; text: S.notes-root; accepted(t) => { S.notes-root-set(t); } }
                Note { text: "РАЗДЕЛ «ЗНАНИЯ» — ПЯТАЯ ВКЛАДКА В ШАПКЕ. ТАМ ЖЕ ПОИСК, СВЯЗИ И ГРАФ"; }
            }
            if S.set-tab == 4: Sec {
                main: true; num: "07"; title: "КЛАВИШИ";
                for k in [
                    ["1 … 5", "разделы: Сегодня, Календарь, Доска, Привычки, Знания"],
                    ["Q / E", "раздел левее / правее"],
                    ["N, Ctrl+N", "создать"],
                    ["Ctrl+K, /", "поиск"],
                    ["R, F5", "синхронизировать"],
                    ["Ctrl+,", "настройки"],
                    ["Shift+1…9", "отметить привычку"],
                    ["[ ]", "предыдущий / следующий список на доске"],
                    ["← → T W M", "календарь: листать, сегодня, неделя, месяц"],
                    ["Esc", "закрыть окно"],
                ]: Rectangle {
                    height: 30px;
                    Rectangle {
                        x: 0; y: 4px; height: 22px; width: kt.preferred-width + 14px;
                        border-radius: 4px; border-width: 1px; border-color: G.line;
                        kt := Text { text: k[0]; font-family: G.mono; font-size: 10px; color: G.accent-ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { x: 150px; text: k[1]; color: G.ink; font-size: 13px; vertical-alignment: center; height: parent.height; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                }
            }
            if S.set-tab == 5: Sec {
                main: true; num: "08"; title: "ОБНОВЛЕНИЯ"; aside: "ВЕРСИЯ " + S.version;
                Text { text: "Спутник " + S.version + " — Rust + Slint. Данные в Google Tasks и Календаре, свой слой — на этом компьютере и в скрытой папке приложения на Google Drive. Своего сервера нет."; color: G.ink; font-size: 13px; wrap: word-wrap; }
                Note { text: (S.upd-version != "" ? "ВЫШЛА ВЕРСИЯ " + S.upd-version + " — ЧИП «✦ ВЕРСИЯ» В ШАПКЕ" : S.upd-info).to-uppercase(); }
                HorizontalLayout { alignment: start; spacing: 8px;
                    Button { text: S.upd-busy ? "Проверяю…" : "Проверить обновления"; clicked => { S.upd-check(); } }
                    if S.upd-version != "": Button { text: "Обновить сейчас"; primary: true; clicked => { S.upd-install(); } }
                }
            }
        }
    }
    // справа: предпросмотр (Вид) и штамп
    if root.prev: Rectangle {
        x: parent.width - root.mx - root.rw; y: 20px; width: root.rw; height: 248px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
        Rectangle { y: 0; height: 32px; background: G.head-main;
            Text { x: 12px; text: "ПРЕДПРОСМОТР"; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; } }
        Rectangle {
            x: 14px; y: 44px; width: parent.width - 28px; height: 156px;
            border-radius: 6px; border-width: 1px; border-color: G.line; background: G.bg;
            Text { x: 40px; y: 10px; text: "СЕГОДНЯ   КАЛЕНДАРЬ"; font-family: G.mono; font-size: 8.5px; letter-spacing: 1px; color: G.ink; }
            Rectangle { x: 0; y: 34px; height: 1px; background: G.line; }
            Rectangle { x: 14px; y: 56px; width: 72px; height: 34px; border-radius: 4px; background: #2C2D33; border-width: 1px; border-color: G.line; }
            Rectangle { x: 86px; y: 72px; width: 46px; height: 1.5px; background: G.accent; }
            Rectangle { x: 130px; y: 50px; width: parent.width - 144px; height: 92px; border-radius: 6px; border-width: 1px; border-color: G.accent; }
        }
        Text { x: 14px; y: 208px; width: parent.width - 28px; text: "Так выглядят шапка и ноды с акцентом."; font-size: 12px; color: #A3A5AE; wrap: word-wrap; }
    }
    if root.prev: Rectangle { x: root.cx + root.cw; y: 42px; width: 24px; height: 1.5px; background: G.accent; }
    if root.prev && root.height >= 400px: Rectangle {
        x: parent.width - root.mx - root.rw; y: parent.height - 86px; width: root.rw; height: 52px;
        border-radius: 6px; border-width: 1px; border-color: G.line;
        Text { x: 8px; y: 6px; text: "ЛИСТ · НАСТРОЙКИ"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.ink; }
        Rectangle { x: 0; y: 24px; height: 1px; background: G.line; }
        HorizontalLayout {
            y: 24px; height: 28px;
            Text { text: S.now-label; font-family: G.mono; font-size: 9px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { width: 1px; background: G.line; }
            Text { text: "РАЗДЕЛОВ 07"; font-family: G.mono; font-size: 9px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { width: 1px; background: G.line; }
            Text { text: ["ВИД", "ПОКАЗ", "НАПОМ.", "СИНХР.", "КЛАВИШИ", "ОБНОВЛ.", "ЗНАНИЯ"][min(S.set-tab, 6)]; font-family: G.mono; font-size: 9px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
