// Выбор даты и времени (G_DateTime): слева — словами, быстрые, месяц; справа — час, минуты, «до».
import { G } from "theme.slint";
import { Mono, Button, Node, Field, Icon, ScrollView, Catch, Pop } from "kit.slint";
import { S } from "store.slint";

component Chip inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> on;
    in property <bool> busy;
    callback clicked;
    height: 28px;
    min-width: root.icon != "" ? 28px : ct.preferred-width + 20px;
    border-radius: 4px;
    border-width: 1px;
    border-color: on ? G.accent : G.line;
    background: on ? G.accent.transparentize(0.85) : (ta.has-hover ? G.node-hover : transparent);
    animate background { duration: G.motion == 2 ? 0ms : G.fast; }
    if busy && !on: Rectangle { x: 3px; y: parent.height - 5px; width: parent.width - 6px; height: 2px; background: #55575F; }
    ct := Text { visible: root.icon == ""; text: root.text; font-family: G.mono; font-size: 11px; font-weight: 600; color: on ? G.accent-ink : #A3A5AE; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
    if root.icon != "": Icon { name: root.icon; width: 12px; x: (parent.width - 12px) / 2; y: (parent.height - 12px) / 2; c: on ? G.accent-ink : #A3A5AE; }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component HourRow inherits HorizontalLayout {
    in property <string> label;
    in property <int> from;
    spacing: 4px;
    Mono { text: root.label; width: 52px; vertical-alignment: center; }
    for i in 6: Chip {
        width: 40px;
        text: (root.from + i < 10 ? "0" : "") + (root.from + i);
        on: S.dp-hour == root.from + i;
        busy: S.dp-busy[root.from + i] > 0;
        clicked => { S.dp-hour-set(root.from + i); }
    }
}

export component DatePicker inherits Node {
    in property <length> max-h: 720px;
    num: @tr("СРОК");
    title: @tr("ВЫБОР ДАТЫ И ВРЕМЕНИ");
    aside: @tr("ПРО «{}»", S.dp-title);
    head: G.accent.darker(0.3);
    width: max(860px, dpb.preferred-width);
    height: min(34px + dpb.preferred-height, root.max-h);   // у ScrollView нет своей высоты — меряем содержимое
    drop-shadow-blur: 24px;
    drop-shadow-color: #000b;
    body := ScrollView {
        viewport-height: dpb.preferred-height;
        dpb := VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 18px;
            VerticalLayout {
                width: max(330px, qr.preferred-width);
                spacing: 8px;
                Mono { text: @tr("СЛОВАМИ"); }
                Field { placeholder: @tr("завтра в 15, в пятницу…"); edited(t) => { S.dp-words(t); } accepted(t) => { S.dp-words(t); } escape => { S.dp-cancel(); } }
                Text { text: S.dp-said == "" ? " " : @tr("Понял: {}", S.dp-said); color: G.accent-ink; font-size: 12px; wrap: word-wrap; }
                ScrollView {
                    height: 30px;
                    viewport-width: qr.preferred-width;
                    qr := HorizontalLayout { spacing: 4px; alignment: start;
                        for q in S.dp-quick: Chip { text: q.label; on: q.on; clicked => { S.dp-quick-set(q.id); } }
                    }
                }
                HorizontalLayout {
                    Text { text: S.dp-month; color: G.ink; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                    Rectangle { }
                    Chip { icon: "prev"; width: 28px; clicked => { S.dp-month-step(-1); } }
                    Rectangle { width: 4px; }
                    Chip { icon: "next"; width: 28px; clicked => { S.dp-month-step(1); } }
                }
                HorizontalLayout { spacing: 2px;
                    for d in [@tr("ПН"), @tr("ВТ"), @tr("СР"), @tr("ЧТ"), @tr("ПТ"), @tr("СБ"), @tr("ВС")]: Mono { text: d; width: 45px; horizontal-alignment: center; font-size: 10px; }
                }
                Rectangle {
                    height: 6 * 32px;
                    for c[i] in S.dp-cells: Rectangle {
                        x: mod(i, 7) * 47px;
                        y: floor(i / 7) * 32px;
                        width: 45px; height: 30px;
                        border-radius: 4px;
                        background: c.sel ? G.accent : (da.has-hover ? G.node-hover : transparent);
                        animate background { duration: G.motion == 2 ? 0ms : G.fast; }
                        border-width: c.today && !c.sel ? 1px : 0;
                        border-color: G.accent;
                        Text { text: c.n; color: c.sel ? G.on-accent : (c.other ? G.dim : G.ink); font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        da := TouchArea { clicked => { S.dp-day(c.day); } mouse-cursor: pointer; }
                    }
                }
            }
            Rectangle { width: 1px; background: G.line; }
            VerticalLayout {
                spacing: 8px;
                Mono { text: @tr("ВРЕМЯ · СЕРАЯ ПОЛОСКА — ЧАС УЖЕ ЗАНЯТ"); }
                HourRow { label: @tr("НОЧЬ"); from: 0; }
                HourRow { label: @tr("УТРО"); from: 6; }
                HourRow { label: @tr("ДЕНЬ"); from: 12; }
                HourRow { label: @tr("ВЕЧЕР"); from: 18; }
                Mono { text: @tr("МИНУТЫ"); }
                HorizontalLayout { spacing: 4px; alignment: start;
                    for m in [0, 15, 30, 45]: Chip { width: 44px; text: m == 0 ? ":00" : ":" + m; on: S.dp-hour >= 0 && S.dp-min == m; clicked => { S.dp-min-set(m); } }
                    Mono { text: @tr("  ИЛИ ТОЧНО"); vertical-alignment: center; }
                    Field { width: 80px; height: 28px; mono: true; placeholder: @tr("чч:мм"); text: S.dp-exact; accepted(t) => { S.dp-exact-set(t); } }
                }
                Mono { text: @tr("ДО"); }
                HorizontalLayout { spacing: 4px; alignment: start;
                    Chip { text: @tr("БЕЗ КОНЦА"); on: S.dp-dur == 0; clicked => { S.dp-dur-set(0); } }
                    Chip { text: @tr("30 МИН"); on: S.dp-dur == 30; clicked => { S.dp-dur-set(30); } }
                    Chip { text: @tr("1 ЧАС"); on: S.dp-dur == 60; clicked => { S.dp-dur-set(60); } }
                    Chip { text: S.dp-dur-long; on: S.dp-dur > 60; clicked => { S.dp-dur-set(120); } }
                }
                Rectangle { }
            }
        }
        Rectangle { height: 1px; background: G.line; }
        HorizontalLayout {
            spacing: 8px;
            Icon { name: "calendar"; width: 16px; c: G.accent; }
            Text { text: S.dp-summary; color: G.ink; font-size: 13px; vertical-alignment: center; overflow: elide; }
            Rectangle { }
            Button { text: @tr("Отмена"); clicked => { S.dp-cancel(); } }
            Button { text: @tr("Готово"); primary: true; clicked => { S.dp-done(); } }
        }
        }
    }
}

// Выпадашка даты у поля (§20, G_CreateDate): 268 px, месяц с ‹ ›, сегодня обведено, выбранный залит;
// снизу «Сегодня · Завтра · Пн · +1 нед» и «Без срока». Клик по дню сразу ставит срок, время не трогает.
// Ставится внутрь поля даты (x/y — от его нижнего края; у правого края окна — выровнять по правому краю поля). Клик мимо и Esc закрывают.
export component DueDrop inherits Rectangle {
    in property <bool> clearable: true;
    width: 268px;
    height: 44px + 22px + ceil(S.dp-cells.length / 7) * 32px + 8px + 30px + (root.clearable ? 34px : 0) + 12px;
    z: 30;
    // клик мимо — закрыть (правило окон поверх: выбранное не теряется)
    Catch { clicked => { S.dp-dismiss(); } }
    Pop {
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        drop-shadow-blur: 16px; drop-shadow-color: #0009;
        TouchArea { }
        Text { x: 12px; y: 0; height: 40px; text: S.dp-month; font-size: 13.5px; font-weight: 600; color: G.ink; vertical-alignment: center; }
        for st[k] in [-1, 1]: Rectangle {
            x: parent.width - 70px + k * 30px; y: 8px; width: 26px; height: 24px; border-radius: 5px;
            border-width: 1px; border-color: G.line; background: sa.has-hover ? G.node-hover : transparent;
            Text { text: st < 0 ? "‹" : "›"; color: G.ink; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { clicked => { S.dp-month-step(st); } mouse-cursor: pointer; }
        }
        for d[i] in [@tr("ПН"), @tr("ВТ"), @tr("СР"), @tr("ЧТ"), @tr("ПТ"), @tr("СБ"), @tr("ВС")]: Text {
            x: 10px + i * 35px; y: 44px; width: 35px; text: d; font-family: G.mono; font-size: 9.5px; color: #8A8C96; horizontal-alignment: center;
        }
        for c[i] in S.dp-cells: Rectangle {
            x: 10px + mod(i, 7) * 35px; y: 64px + floor(i / 7) * 32px; width: 33px; height: 30px; border-radius: 5px;
            background: c.sel ? G.accent : (ca.has-hover ? G.node-hover : transparent);
            animate background { duration: G.motion == 2 ? 0ms : G.fast; }
            border-width: c.today && !c.sel ? 1px : 0; border-color: G.accent;
            Text { text: c.n; font-size: 13px; color: c.sel ? G.on-accent : (c.other ? #5A5C66 : G.ink); horizontal-alignment: center; vertical-alignment: center; }
            ca := TouchArea { clicked => { S.dp-day(c.day); S.dp-done(); } mouse-cursor: pointer; }
        }
        HorizontalLayout {
            x: 10px; y: 64px + ceil(S.dp-cells.length / 7) * 32px + 8px; width: parent.width - 20px; height: 30px; spacing: 4px;
            for q[i] in [{ id: "today", t: @tr("Сегодня") }, { id: "tomorrow", t: @tr("Завтра") }, { id: "mon", t: @tr("Пн") }, { id: "week", t: @tr("+1 нед") }]: Rectangle {
                horizontal-stretch: i == 2 ? 0.6 : 1;
                border-radius: 5px; border-width: 1px; border-color: G.line; background: qa.has-hover ? G.node-hover : transparent;
                Text { text: q.t; font-size: 11px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                qa := TouchArea { clicked => { S.dp-quick-set(q.id); S.dp-done(); } mouse-cursor: pointer; }
            }
        }
        // «Без срока» — отдельной строкой снизу, как «Без времени» у времени
        if root.clearable: Rectangle {
            x: 10px; y: parent.height - 42px; width: parent.width - 20px; height: 30px; border-radius: 5px;
            background: na.has-hover ? G.node-hover : transparent;
            animate background { duration: G.motion == 2 ? 0ms : G.fast; }
            Text { x: 10px; text: @tr("Без срока"); font-size: 12px; color: #A3A5AE; vertical-alignment: center; height: parent.height; }
            na := TouchArea { clicked => { S.dp-quick-set("none"); S.dp-done(); } mouse-cursor: pointer; }
        }
    }
}
