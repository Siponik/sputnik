// «Сегодня»: главная нода со строкой быстрого добавления и задачами дня; справа — «Дальше», итог, встречи,
// привычки и «Входящие» отдельными нодами, соединёнными проводом с главной.
import { G } from "theme.slint";
import { Node, Socket, Mono, Brackets, Button, Pill, Check, Field, Empty, IconBtn } from "kit.slint";
import { S, TaskRow, InboxRow } from "store.slint";
import { ScrollView } from "std-widgets.slint";

export component TaskLine inherits Rectangle {
    in property <TaskRow> item;
    in property <int> n;
    height: 42px;
    background: ta.has-hover ? G.node-hover : transparent;
    animate background { duration: G.fast; }
    ta := TouchArea { clicked => { S.open-task(item.list-id, item.id); } mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Mono { text: n < 10 ? "0" + n : n; color: G.dim; vertical-alignment: center; width: 20px; }
        Check { done: item.done; y: (parent.height - self.height) / 2; toggled => { S.toggle(item.list-id, item.id); } }
        Text {
            text: (item.prio == 1 ? "!!! " : "") + item.title;
            font-size: 15px;
            color: item.done ? G.dim : G.ink;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text { text: item.sub; color: G.dim; font-size: 12px; vertical-alignment: center; }
        Rectangle {
            width: min(lt.preferred-width + 16px, 160px);
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: item.hue.transparentize(0.82);
            lt := Text { text: item.list; font-size: 12px; color: item.hue; horizontal-alignment: center; vertical-alignment: center; overflow: elide; width: parent.width - 10px; }
        }
        Mono { text: item.when; width: 84px; horizontal-alignment: right; vertical-alignment: center; color: item.overdue ? G.red : G.muted; }
    }
    Rectangle { visible: item.done; x: 80px; y: parent.height / 2; height: 1px; width: parent.width * 0.4; background: G.dim; }
    Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
}

export component TodayPage inherits Rectangle {
    public function focus-quick() { quick.grab(); }
    property <length> side: 280px;
    property <length> gap: 40px;

    main := Node {
        x: 28px;
        y: 24px;
        width: parent.width - 28px - root.side - root.gap - 28px;
        height: parent.height - 48px;
        num: "01";
        title: "СЕГОДНЯ";
        aside: S.today-label;
        head: G.head-main;
        main: true;
        VerticalLayout {
            Rectangle {
                height: S.understood.length > 0 ? 82px : 58px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    quick := Field {
                        placeholder: "Что нужно сделать? «скетч завтра 17:00 @работа !!»  ·  Shift+Enter — полное окно";
                        edited(t) => { S.quick-changed(t); }
                        accepted(t) => { if (t != "") { S.quick-add(t); self.clear(); S.quick-changed(""); } }
                        shift-enter(t) => { S.quick-full(t); self.clear(); }
                        escape => { self.clear(); S.quick-changed(""); }
                    }
                    if S.understood.length > 0: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Mono { text: "ПОНЯЛ:"; vertical-alignment: center; }
                        for u in S.understood: Rectangle {
                            height: 20px;
                            width: ut.preferred-width + 14px;
                            border-radius: 4px;
                            background: G.node-hover;
                            ut := Text { text: u; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 20px;
                            width: dt.preferred-width + 14px;
                            border-radius: 4px;
                            background: G.accent-wash;
                            border-width: 1px;
                            border-color: G.accent-line;
                            dt := Text { text: "→ " + S.dest; font-size: 12px; color: G.accent-ink; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: G.line; }
            }
            if S.today.length == 0 && S.overdue.length == 0: Empty {
                vertical-stretch: 1;
                pose: S.done-count > 0 ? "cheer" : "hi";
                text: S.busy ? "Загружаю задачи…" : S.done-count > 0 ? "Всё на сегодня сделано" : "На сегодня ничего — добавь первое дело в строку сверху";
            }
            if S.today.length + S.overdue.length > 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    if S.overdue.length > 0: Rectangle {
                        height: 28px;
                        Mono { x: 14px; text: "ПРОСРОЧЕНО · " + S.overdue.length; color: G.red; vertical-alignment: center; }
                    }
                    for t[i] in S.overdue: TaskLine { item: t; n: i + 1; }
                    if S.overdue.length > 0: Rectangle {
                        height: 28px;
                        Mono { x: 14px; text: "СЕГОДНЯ · " + S.today.length; vertical-alignment: center; }
                    }
                    for t[i] in S.today: TaskLine { item: t; n: S.overdue.length + i + 1; }
                }
            }
        }
    }
    Brackets { x: main.x; y: main.y; width: main.width; height: main.height; }

    // Правая колонка нод
    col := VerticalLayout {
        x: parent.width - root.side - 28px;
        y: 24px;
        width: root.side;
        height: parent.height - 48px;
        spacing: 18px;
        alignment: start;

        next := Node {
            height: 104px;
            num: "02";
            title: "ДАЛЬШЕ";
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                Text { text: S.next-title == "" ? "Пусто — можно отдохнуть" : S.next-title; color: S.next-title == "" ? G.muted : G.accent-ink; font-size: 15px; wrap: word-wrap; overflow: elide; }
                Text { text: S.next-why; color: G.dim; font-size: 12px; }
            }
        }
        Node {
            height: 96px;
            num: "03";
            title: "ИТОГ ДНЯ";
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text { text: S.done-count; font-size: 34px; font-weight: 200; color: G.ink; }
                    Text { text: "/ " + S.total-count; font-size: 18px; font-weight: 200; color: G.muted; vertical-alignment: bottom; }
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: G.line-soft;
                    Rectangle {
                        x: 0;
                        width: S.total-count == 0 ? 0 : parent.width * S.done-count / S.total-count;
                        border-radius: 2px;
                        background: G.accent;
                        animate width { duration: G.mid; easing: ease-out; }
                    }
                }
            }
        }
        if S.today-events.length > 0: Node {
            height: 30px + 12px + min(S.today-events.length, 5) * 26px;
            num: "04";
            title: "ВСТРЕЧИ";
            aside: S.today-events.length;
            VerticalLayout {
                padding: 6px;
                padding-left: 14px;
                for e in S.today-events: HorizontalLayout {
                    height: 26px;
                    spacing: 10px;
                    Mono { text: e.time; width: 44px; vertical-alignment: center; color: G.muted; }
                    Rectangle { width: 3px; height: 14px; y: 6px; background: e.hue; border-radius: 1px; }
                    Text { text: e.title; color: G.ink; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }
        if S.today-habits.length > 0: Node {
            height: 30px + 18px + S.today-habits.length * 34px;
            num: "05";
            title: "ПРИВЫЧКИ";
            aside: "Shift+1…9";
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                for h[i] in S.today-habits: Rectangle {
                    height: 30px;
                    border-radius: 15px;
                    background: h.done ? h.hue.transparentize(0.7) : (ha.has-hover ? G.node-hover : transparent);
                    border-width: 1px;
                    border-color: h.done ? h.hue : G.line;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 18px; height: 18px; y: 6px; border-radius: 9px; background: h.hue.transparentize(0.6);
                            Text { text: h.icon; color: G.ink; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: h.name; color: h.done ? G.ink : G.muted; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Mono { text: h.goal > 1 ? h.count + "/" + h.goal : (h.done ? "✓" : ""); vertical-alignment: center; color: h.hue; }
                    }
                    ha := TouchArea { clicked => { S.habit-tap(h.id); } mouse-cursor: pointer; }
                }
            }
        }
        if S.inbox.length > 0: Node {
            height: 30px + 44px + min(S.inbox.length, 5) * 34px;
            num: "06";
            title: "ВХОДЯЩИЕ ОТ CLAUDE";
            aside: S.inbox.length;
            head: G.head-main;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                for x in S.inbox: HorizontalLayout {
                    height: 32px;
                    spacing: 6px;
                    Text { text: x.title; color: G.ink; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: "→ " + x.list; color: G.accent; font-size: 11px; vertical-alignment: center; width: min(self.preferred-width, 80px); overflow: elide; }
                    IconBtn { icon: "✓"; y: 2px; clicked => { S.accept(x.list-id, x.id); } }
                    IconBtn { icon: "✕"; y: 2px; clicked => { S.reject(x.list-id, x.id); } }
                }
                HorizontalLayout { alignment: end; Button { text: "Принять все"; height: 28px; clicked => { S.accept-all(); } } }
            }
        }
    }
    // Провод: главная нода → «Дальше».
    Path {
        x: main.x + main.width;
        y: 24px + 40px;
        width: root.gap;
        height: 2px;
        commands: "M 0 1 L 40 1";
        viewbox-width: 40;
        viewbox-height: 2;
        stroke: G.accent;
        stroke-width: 1.5px;
    }
    Socket { x: main.x + main.width - 5px; y: 24px + 36px; hue: G.accent; }
    Socket { x: col.x - 5px; y: 24px + 36px; hue: G.accent; }
}
