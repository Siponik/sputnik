// «Знания»: слева заметки и поиск, в центре — заметка (правка сохраняется только по кнопке/Ctrl+S),
// справа — ссылки [[…]] из неё и обратные ссылки.
import { G } from "theme.slint";
import { Node, Mono, Button, Field, Empty, IconBtn, Link, Seg, Brackets, Icon, Sat, ScrollView, Tip, Pop } from "kit.slint";
import { S, NoteRow, TreeRow, MdRow, GDot, GLine } from "store.slint";
import { CanvasView, CvCam } from "canvas.slint";
import { MdLine } from "linknote.slint";
import { TableBlock } from "mdtable.slint";
import { GraphPage, ModeSwitch } from "graph.slint";

// Строка заметки: оформлена сразу; строка с курсором показывает разметку и правится.
component LiveLine inherits Rectangle {
    in property <MdRow> line;
    in property <bool> editing;
    in property <int> caret: -1;
    in property <float> zoom: 1;
    in property <bool> has-link;
    // в заметке правят какую-то строку
    in property <bool> line-edit;
    callback pick();
    callback commit(string);
    callback split(string, int);
    callback join(string);
    callback move(string, int, int);
    callback leave(string);
    callback undo(bool);
    callback pick-at(int);
    callback toggle();
    callback focus-mode();
    property <bool> h: line.kind == "h1" || line.kind == "h2" || line.kind == "h3";
    property <bool> wrapped: ed.preferred-height > root.fs * 1.9;
    property <int> arrow;
    property <int> arrow-from;
    property <int> hint-i;
    property <bool> hints: editing && ed.has-focus && S.link-found.length > 0;
    Timer {
        interval: 1ms;
        running: root.arrow != 0;
        triggered => {
            if (ed.cursor-position-byte-offset == root.arrow-from) { root.move(ed.text, root.arrow, root.arrow-from); }
            root.arrow = 0;
        }
    }
    property <length> fs: (line.kind == "h1" ? 22px : line.kind == "h2" ? 17.5px : line.kind == "h3" ? 15.5px : 14.5px) * zoom;
    property <length> pad: line.kind == "h1" ? 14px : line.kind == "h2" ? 10px : line.kind == "h3" ? 6px : 3px;
    property <length> ind: line.kind == "quote" ? 14px : (line.kind == "li" || line.kind == "todo" || line.kind == "done" ? 18px : (line.kind == "code" ? 12px : 0));
    // строка таблицы: таблицу целиком рисует её первая строка, остальные — нулевой высоты
    property <bool> tbl: line.top >= 0;
    property <bool> thead: line.block != "";
    height: root.tbl ? (root.thead ? tb.full-h : 0px) : (line.kind == "empty" && !editing ? 12px * zoom : (line.kind == "fence" && !editing ? 6px : (line.kind == "hr" && !editing ? 18px : (editing ? ed.preferred-height : st.preferred-height) + pad + 5px)));
    tb := TableBlock { visible: root.thead; x: -20px; y: 0; block: root.thead ? line.block : ""; line: line.top; fs: root.fs * 0.95; avail: root.width; editable: true; line-edit: root.line-edit;
        exit(d) => { root.move(line.raw, d < 0 ? -1 : line.tn, 0); }
    }
    ta := TouchArea { enabled: !root.tbl; mouse-cursor: MouseCursor.text; clicked => {
        if ((line.kind == "todo" || line.kind == "done") && self.mouse-x < root.ind) { root.toggle(); } else { root.pick(); }
    }
        // правый клик — меню правки (G-стиль): строка становится редактируемой, выделение сохраняется
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                let sel = editing ? S.ed-sel(ed.text, ed.anchor-position-byte-offset, ed.cursor-position-byte-offset) : "";
                if (!editing) { root.pick(); }
                S.menu-ctx("ed", sel, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    property <int> cmd-n: S.ed-cmd-n;
    changed cmd-n => { if (editing) { root.run(S.ed-cmd); } }
    if line.kind == "code" && !editing: Rectangle { x: -8px; y: 0; width: parent.width + 16px; height: parent.height; background: G.bg; }
    if line.kind == "hr" && !editing: Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: G.line; }
    if line.kind == "quote" && !editing: Rectangle { x: 0; y: pad; width: 3px; height: parent.height - pad - 3px; border-radius: 1.5px; background: G.accent; }
    if line.kind == "li" && !editing: Rectangle { x: 6px; y: pad + fs * 0.62 - 2.5px; width: 5px; height: 5px; border-radius: 2.5px; background: G.muted; }
    if (line.kind == "todo" || line.kind == "done") && !editing: Rectangle {
        x: 0; y: pad + fs * 0.62 - 6.5px; width: 13px; height: 13px; border-radius: 3px;
        border-width: 1.2px; border-color: line.kind == "done" ? G.accent : G.muted; background: line.kind == "done" ? G.accent : transparent;
        if line.kind == "done": Icon { name: "check"; width: 9px; x: 2px; y: 2px; c: #1C1D21; stroke-width: 2.4px; }
    }
    if line.kind == "img" && !editing: Rectangle {
        y: pad; height: parent.height - pad - 5px; border-radius: 6px; border-width: 1px; border-color: G.line; background: G.bg;
    }
    st := StyledText {
        visible: !editing && line.kind != "empty" && line.kind != "fence" && line.kind != "hr" && !root.tbl;
        x: ind; y: pad; width: root.has-link ? min(self.preferred-width, parent.width - ind) : parent.width - ind;
        text: line.md;
        default-font-size: fs;
        default-font-family: line.kind == "code" ? G.mono : G.sans;
        default-color: line.kind == "done" || line.kind == "img" ? G.muted : (line.kind == "code" ? G.gold : (line.kind == "quote" ? #B9BBC4 : (h ? G.ink : #D8DAE2)));
        link-color: G.accent;
        link-clicked(l) => { S.note-link(l); }
    }
    // раскладка: в прокрутке (невидимое поле во всю строку, растёт с ней)
    // Клик по оформленному тексту: невидимое поле с тем же видимым текстом поверх — оно знает, в какую букву попали;
    // Rust переводит это место в место в строке файла (или открывает ссылку). StyledText сам клики глотает.
    // в строке со ссылками сверху оформленный текст: ссылка — рука и переход по клику; Ctrl+клик или клик правее текста — правка
    if !editing && line.kind != "empty" && line.kind != "fence" && line.kind != "hr" && line.kind != "img" && !root.tbl && (!root.has-link || S.ctrl-held): hit := TextInput {
        x: ind; y: pad; width: parent.width - ind;
        text: line.plain;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        font-size: root.fs;
        font-family: line.kind == "code" ? G.mono : G.sans;
        color: transparent;
        selection-background-color: transparent;
        selection-foreground-color: transparent;
        changed has-focus => {
            if (self.has-focus && !root.editing) {
                root.pick-at(self.cursor-position-byte-offset);
            }
        }
    }
    fs-scope := FocusScope {
        x: 0; y: pad; width: parent.width; height: ed.preferred-height;
        visible: editing;
        enabled: editing;
        capture-key-pressed(e) => {
            if (!editing) { return reject; }
            // подсказка после «[[»: Enter/Tab — вставить, стрелки — выбрать, Esc — закрыть
            if (root.hints) {
                if (e.text == Key.Return || e.text == Key.Tab) { root.put(S.link-found[min(root.hint-i, S.link-found.length - 1)].label); return accept; }
                if (e.text == Key.DownArrow) { root.hint-i = min(root.hint-i + 1, S.link-found.length - 1); return accept; }
                if (e.text == Key.UpArrow) { root.hint-i = max(root.hint-i - 1, 0); return accept; }
                if (e.text == Key.Escape) { S.note-link-q("", 0); return accept; }
            }
            if (e.text == Key.Return && !e.modifiers.shift) { root.split(ed.text, ed.cursor-position-byte-offset); return accept; }
            // в длинном абзаце стрелки ходят по его строкам; на краю — на соседнюю строку заметки, в ту же колонку
            // (поле двигает курсор само; не сдвинулся — значит, край абзаца)
            if ((e.text == Key.UpArrow || e.text == Key.DownArrow) && !e.modifiers.shift) {
                if (root.wrapped) { root.arrow-from = ed.cursor-position-byte-offset; root.arrow = e.text == Key.UpArrow ? -1 : 1; return reject; }
                root.move(ed.text, e.text == Key.UpArrow ? -1 : 1, ed.cursor-position-byte-offset); return accept;
            }
            if (e.text == Key.Escape) { root.leave(ed.text); S.focus-keys += 1; return accept; }
            if (e.text == Key.Backspace && ed.cursor-position-byte-offset == 0 && ed.anchor-position-byte-offset == 0) { root.join(ed.text); return accept; }
            if (e.modifiers.control && (e.text == "e" || e.text == "E" || e.text == "у" || e.text == "У")) { root.focus-mode(); return accept; }
            if (e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "ы" || e.text == "Ы")) { root.commit(ed.text); return accept; }
            // Ctrl+Z / Ctrl+Shift+Z / Ctrl+Y: строка сохраняется, и вся заметка откатывается на шаг
            if (e.modifiers.control && (e.text == "z" || e.text == "Z" || e.text == "я" || e.text == "Я" || e.text == "\u{1a}")) { root.leave(ed.text); root.undo(e.modifiers.shift); S.focus-keys += 1; return accept; }
            if (e.modifiers.control && (e.text == "y" || e.text == "Y" || e.text == "н" || e.text == "Н" || e.text == "\u{19}")) { root.leave(ed.text); root.undo(true); S.focus-keys += 1; return accept; }
            reject
        }
        // раскладка: в прокрутке (колонка окна прокручивается)
        ed := TextInput {
            x: 0; y: 0; width: parent.width;
            text: line.raw;
            single-line: false;
            wrap: word-wrap;
            font-size: root.fs;
            font-family: line.kind == "code" ? G.mono : G.sans;
            font-weight: root.h ? 600 : 400;
            color: G.ink;
            selection-background-color: G.accent.with-alpha(0.4);
            selection-foreground-color: #FFFFFF;
            changed has-focus => { if (!self.has-focus && root.editing) { root.leave(self.text); } }
            edited => { root.hint-i = 0; S.note-link-q(self.text, self.cursor-position-byte-offset); }
            cursor-position-changed => { if (root.editing) { S.note-peek-at(self.text, self.cursor-position-byte-offset); } }
        }
    }
    // предпросмотр ссылки, в которой стоит курсор (над строкой); Ctrl+клик — перейти
    if editing && ed.has-focus && !root.hints && S.peek-title != "": Pop {
        up: true;
        x: root.ind; y: -self.height - 6px; width: min(360px, root.width - root.ind);
        height: min(220px, pv.preferred-height + 16px);
        border-radius: 10px; background: G.node; border-width: 1px; border-color: G.accent-line;
        drop-shadow-blur: 18px; drop-shadow-color: #000a; clip: true;
        TouchArea { mouse-cursor: pointer; clicked => { S.note-link(S.peek-title); } }
        pv := VerticalLayout {
            x: 12px; y: 8px; width: parent.width - 24px; spacing: 4px; alignment: LayoutAlignment.start;
            HorizontalLayout { spacing: 8px;
                Text { text: S.peek-title; font-size: 13px; font-weight: 600; color: G.ink; overflow: elide; horizontal-stretch: 1; }
                Text { text: "CTRL + КЛИК"; font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: G.muted; vertical-alignment: center; }
            }
            if S.peek-sub != "": Text { text: S.peek-sub; font-family: G.mono; font-size: 10px; color: #8A8C96; overflow: elide; }
            for l in S.peek-rows: MdLine { line: l; fs: 12px; }
        }
    }
    // подсказка названий над строкой (ниже её закрыли бы следующие строки)
    if root.hints: Pop {
        up: true;
        x: root.ind; y: -self.height - 4px; width: min(320px, root.width - root.ind);
        height: 8px + min(6, S.link-found.length) * 30px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        drop-shadow-blur: 14px; drop-shadow-color: #0009;
        for f[k] in S.link-found: Rectangle {
            x: 4px; y: 4px + k * 30px; width: parent.width - 8px; height: 30px; visible: k < 6;
            border-radius: 6px; background: k == root.hint-i || fa.has-hover ? G.node-hover : transparent;
            Icon { name: "link"; x: 8px; y: 8px; width: 14px; c: G.accent; }
            Text { x: 30px; width: parent.width - 38px; text: f.label; font-size: 13px; color: G.ink; vertical-alignment: center; overflow: elide; }
            fa := TouchArea { mouse-cursor: pointer; clicked => { root.put(f.label); } }
        }
    }
    function put(title: string) {
        let at = ed.cursor-position-byte-offset;
        let n = S.note-link-put(ed.text, at, title);
        let c = S.byte-len(n) - (S.byte-len(ed.text) - at);
        ed.text = n;
        ed.set-selection-offsets(c, c);
        S.note-link-q("", 0);
    }
    function run(c: string) {
        ed.focus();
        if (c == "cut") { ed.cut(); return; }
        if (c == "copy") { ed.copy(); return; }
        if (c == "paste") { ed.paste(); return; }
        if (c == "all") { ed.select-all(); return; }
        let r = S.ed-apply(ed.text, ed.anchor-position-byte-offset, ed.cursor-position-byte-offset, c);
        ed.text = r.text;
        ed.set-selection-offsets(r.a, r.b);
        if (c == "link" && r.a == r.b) { S.note-link-q(ed.text, r.a); }
    }
    function start() {
        ed.text = line.raw;
        ed.focus();
        if (caret >= 0) { ed.set-selection-offsets(caret, caret); } else { ed.set-selection-offsets(999999, 999999); }
    }
    // таблица правится ячейками: строку таблицы как текст не открываем
    function to-table() { S.tk-line = line.top; S.tk-r = 0; S.tk-n += 1; root.leave(line.raw); }
    changed editing => { if (editing && root.tbl) { root.to-table(); } else if (editing) { start(); } }
    init => { if (editing && root.tbl) { root.to-table(); } else if (editing) { start(); } }
}

// Строка дерева G_Notes: 28 px, отступ 8 + 14 на уровень, стрелка ▾/▸ у папок, у корневой папки — цветная точка,
// у вложенной — ▭, у заметки — ¶; выбранная — тёплая заливка с полоской слева.
component TreeLine inherits Rectangle {
    in property <TreeRow> r;
    in property <string> cur;
    property <bool> on: r.kind != "dir" && r.path == cur;
    height: 28px;
    Rectangle {
        x: 6px; width: parent.width - 12px; border-radius: 6px; clip: true;
        background: root.on ? G.accent-wash : (ta.has-hover ? G.node-hover : transparent);
        if root.on: Rectangle { x: 0; width: 2px; background: G.accent; }
        HorizontalLayout {
            padding-left: 8px + r.depth * 14px; padding-right: 10px; spacing: 7px;
            Rectangle { width: 10px;
                if r.kind == "dir": Path { y: (parent.height - 10px) / 2; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; fill: transparent; stroke: G.dim; stroke-width: 1.4px;
                    stroke-line-cap: round; stroke-line-join: round; commands: r.open ? "M2.5 3.5 L5 6.5 L7.5 3.5" : "M3.5 2.5 L6.5 5 L3.5 7.5"; } }
            if r.kind == "dir": Icon { name: "folder"; width: 14px; y: 7px; c: r.depth == 0 || r.own ? r.hue : G.dim; }
            if r.kind == "note": Icon { name: "note"; width: 14px; y: 7px; c: G.dim; }
            if r.kind == "canvas": Icon { name: "canvas"; width: 14px; y: 7px; c: G.dim; }
            Text { horizontal-stretch: 1; text: r.title; font-size: 13px; color: root.on || (r.kind == "dir" && r.depth == 0) ? G.ink : #C9CAD0; vertical-alignment: center; overflow: elide; }
            if r.kind != "dir" && r.open: Icon { name: "pin"; width: 12px; y: 8px; c: G.accent; }
            if r.n != "": Text { text: r.n; font-family: G.mono; font-size: 11px; color: G.muted; vertical-alignment: center; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (r.kind == "dir") { S.note-fold(r.path); } else { S.note-open(r.path); } }
        pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx(r.kind == "dir" ? "dir" : "note", r.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    }
}

component NoteList inherits VerticalLayout {
    in property <[NoteRow]> rows;
    in property <string> cur;
    callback drag(string, length, length);
    callback drop(string, length, length);
    property <length> px0;
    property <length> py0;
    property <bool> dragging;
    for r in rows: Rectangle {
        height: r.path == "" ? 30px : 30px;
        background: r.path != "" && r.path == cur ? G.accent-wash : (r.path != "" && na.has-hover ? G.node-hover : transparent);
        if r.path != "" && r.path == cur: Rectangle { x: 0; width: 2px; background: G.accent; }
        if r.path == "": Rectangle { x: 14px; y: 13px; width: 6px; height: 6px; border-radius: 2px; background: #7C7E88; }
        if r.path == "": Text { x: 28px; y: 6px; height: 22px; text: r.title; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #8A8C96; vertical-alignment: center; overflow: elide; width: parent.width - 60px; }
        if r.path == "": Text { x: parent.width - self.preferred-width - 12px; y: 6px; height: 22px; text: r.sub; font-family: G.mono; font-size: 10px; color: #62646E; vertical-alignment: center; }
        if r.sub == "canvas": Icon { name: "canvas"; x: 10px; width: 13px; y: 8.5px; c: r.path == cur ? G.accent : G.muted; }
        if r.path != "": Text { x: 28px; width: parent.width - 40px; text: r.title; color: r.path == cur ? G.ink : #C9CBD3; font-size: 13px; vertical-alignment: center; overflow: elide; }
        na := TouchArea { enabled: r.path != ""; clicked => { if (!root.dragging) { S.note-open(r.path); } } mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", r.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { root.px0 = self.mouse-x; root.py0 = self.mouse-y; root.dragging = false; }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                    root.drop(r.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                // тянуть заметку (не канвас) — положить на канвас
                if (self.pressed && r.sub != "canvas" && (root.dragging || abs(self.mouse-x - root.px0) > 6px || abs(self.mouse-y - root.py0) > 6px)) {
                    root.dragging = true;
                    root.drag(r.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            } }
    }
}

// Граф: точки — заметки, линии — [[ссылки]]. Колесо — масштаб, тянуть — двигать, клик — открыть.
// С ×1.8 у точек видны названия, у выбранной заметки соседи подсвечены.
// Раскладка G: слева нода «Заметки» 264 px, справа нода «Связи» 300 px, середина тянется; поля 8 px.
export component NotesPage inherits Rectangle {
    property <string> body: S.note-body;
    property <bool> wide: self.width >= 1100px;
    property <length> lw: zen ? 0px : 264px;
    property <length> rw: wide && !zen && !S.note-canvas ? 300px : 0px;
    property <length> mx0: zen ? 8px : 8px + lw + 8px;
    property <length> mw: self.width - mx0 - 8px - (rw > 0 ? rw + 8px : 0px);
    property <string> q;
    in-out property <bool> zen;
    property <length> tab-off;   // сдвиг полосы вкладок колёсиком
    // заметку тянут из списка на канвас
    property <string> drag-path;
    property <length> drag-x;
    property <length> drag-y;
    property <int> edit-i: -1;
    property <int> caret: -1;

    // 01 · заметки (G_Notes): переключатель раздела, поиск с «＋», «Недавние», дерево папок
    if !root.zen && !S.note-graph: Rectangle {
        x: 8px; y: 8px; width: root.lw; height: parent.height - 16px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
        ModeSwitch { y: 0; width: parent.width; current: 0; picked(i) => { S.note-mode(i); } }
        Rectangle {
            x: 10px; y: 55px; width: parent.width - 58px; height: 32px;
            border-radius: 8px; background: G.bg; border-width: 1px; border-color: G.line;
            Icon { name: "search"; x: 10px; width: 13px; y: 9.5px; c: G.dim; }
            Field { x: 28px; y: 1px; height: 30px; width: parent.width - 36px; bare: true; placeholder: "Найти заметку  Ctrl K"; font-size: 13px;
                edited(t) => { root.q = t; S.note-search(t); }
                accepted(t) => { if (t != "" && S.notes.length == 0) { S.note-new(t); self.clear(); S.note-search(""); } } }
        }
        Rectangle {
            x: parent.width - 42px; y: 55px; width: 32px; height: 32px; border-radius: 8px;
            background: pa.has-hover ? G.accent.brighter(0.1) : G.accent;
            Text { text: "＋"; color: G.on-accent; font-size: 16px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            pa := TouchArea { mouse-cursor: pointer; clicked => { S.menu-ctx("newnote", root.q != "" ? root.q : "Новая заметка", self.absolute-position.x, self.absolute-position.y + self.height + 4px); } }
            Tip { text: "Новая заметка, холст или папка"; on: pa.has-hover; }
        }
        ScrollView {
            x: 0; y: 93px; width: parent.width; height: parent.height - 93px - 37px; content-height: col.preferred-height;
            // список стал короче (свернули папку, открыли холст) — не оставаться прокрученным в пустоту
            changed content-height => { self.viewport-y = max(self.viewport-y, min(0px, self.visible-height - self.content-height)); }
            col := VerticalLayout {
                x: 0; y: 0; width: root.lw; alignment: start;
                if S.note-recent.length > 0 && root.q == "": Text { height: 24px; x: 16px; text: "НЕДАВНИЕ"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.muted; vertical-alignment: bottom; }
                if S.note-recent.length > 0 && root.q == "": Rectangle { height: 4px; }
                if root.q == "": VerticalLayout { for r in S.note-recent: TreeLine { r: r; cur: S.note-path; } }
                if S.note-recent.length > 0 && root.q == "": Rectangle { height: 9px; Rectangle { y: 8px; height: 1px; background: G.line; } }
                Text { height: 28px; x: 16px; text: root.q == "" ? "ПАПКИ" : "НАЙДЕНО"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.muted; vertical-alignment: bottom; }
                Rectangle { height: 4px; }
                for r in S.note-tree: TreeLine { r: r; cur: S.note-path; }
                Rectangle { height: 8px; }
            }
        }
        Rectangle { x: 0; y: parent.height - 37px; height: 1px; background: G.line; }
        Text { x: 14px; y: parent.height - 36px; height: 36px; text: "ПАПКА · " + S.notes-count; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.muted; vertical-alignment: center; }
        // порядок внутри папок: клик — следующий
        so := Text { x: parent.width - self.preferred-width - 14px; y: parent.height - 36px; height: 36px;
            text: (S.note-sort == 0 ? "ИЗМЕНЕНО" : S.note-sort == 1 ? "А–Я" : "СВЯЗИ") ; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px;
            color: soa.has-hover ? G.ink : G.muted; vertical-alignment: center;
            soa := TouchArea { mouse-cursor: pointer; clicked => { S.note-sort-set(Math.mod(S.note-sort + 1, 3)); } }
            Tip { text: "Порядок заметок — клик меняет"; on: soa.has-hover; } }
    }

    if S.note-graph: GraphPage {
        width: parent.width; height: parent.height;
        mode(i) => { S.note-mode(i); }
        opened(p, t) => { S.graph-open(p, t); }
        focus-open(p, t) => { S.graph-open(p, t); root.zen = true; }
    }

    // 02 · заметка
    if !S.note-graph: Rectangle {
        x: root.mx0; y: 8px; width: root.mw; height: parent.height - 16px;
        border-radius: 12px; background: G.node; border-width: 1px; border-color: G.accent-line; clip: true;
        // шапка со вкладками (G_Notes): 44px, текущая — светлая плашка с ×, остальные — текст; колёсико листает вбок
        Rectangle {
            y: 0; height: 44px; background: G.head-main; border-radius: 11px;
            Rectangle { y: 33px; height: 11px; background: parent.background; }
            if S.note-tabs.length > 0: Rectangle {
                x: 10px; y: 7px; width: parent.width - 20px; height: 30px; clip: true;
                // новая вкладка встаёт в конец — показать её
                property <int> tab-n: S.note-tabs.length;
                changed tab-n => { root.tab-off = max(0px, tl.preferred-width - tsa.width); }
                init => { root.tab-off = max(0px, tl.preferred-width - tsa.width); }
                tsa := TouchArea {
                    scroll-event(e) => {
                        let d = abs(e.delta-x) > abs(e.delta-y) ? e.delta-x : e.delta-y;
                        root.tab-off = max(0px, min(root.tab-off - d, tl.preferred-width - self.width));
                        accept
                    }
                    tl := HorizontalLayout {
                        x: -root.tab-off; y: 0; width: max(self.preferred-width, tsa.width); height: parent.height; spacing: 4px; alignment: start;
                        for t in S.note-tabs: Rectangle {
                            // крестик — у текущей всегда, у остальных при наведении
                            property <bool> hov: ta.has-hover || ca.has-hover;
                            height: 30px; width: min(tt.preferred-width + 50px, 220px);
                            border-radius: 7px;
                            background: t.cur ? #FFFFFFEB : (ta.has-hover ? #FFFFFF1A : transparent);
                            tt := Text { x: 12px; width: parent.width - 38px; text: t.title; font-size: 13px; font-weight: t.cur ? 500 : 400;
                                color: t.cur ? G.head-main.darker(0.4) : #FFFFFFD1; vertical-alignment: center; overflow: elide; }
                            if t.cur && S.note-dirty: Text { x: parent.width - 26px; width: 18px; text: "●"; font-size: 9px; color: G.head-main; vertical-alignment: center; horizontal-alignment: center; }
                            if (t.cur && !S.note-dirty) || (!t.cur && hov): Icon { name: "close"; width: 11px; x: parent.width - 23px; y: (parent.height - 11px) / 2; c: ca.has-hover ? G.red : (t.cur ? G.head-main.darker(0.4).with-alpha(0.6) : #FFFFFFB0); }
                            ta := TouchArea { width: parent.width - 28px; mouse-cursor: pointer; clicked => { S.note-tab-open(t.path); }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.up) { S.note-tab-close(t.path); }
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("tab", t.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                                } }
                            ca := TouchArea { x: parent.width - 28px; width: 28px; mouse-cursor: pointer; clicked => { S.note-tab-close(t.path); } }
                        }
                        // «＋» — новая заметка / холст / папка
                        Rectangle {
                            width: 30px; height: 30px; border-radius: 7px; background: pla.has-hover ? #FFFFFF1A : transparent;
                            Text { text: "+"; font-size: 17px; color: #FFFFFFCC; horizontal-alignment: center; vertical-alignment: center; }
                            Tip { text: "Новая заметка, холст или папка"; on: pla.has-hover; }
                            pla := TouchArea { mouse-cursor: pointer; clicked => { S.menu-ctx("newnote", "Новая заметка", self.absolute-position.x, self.absolute-position.y + self.height + 4px); } }
                        }
                    }
                }
            }
            if S.note-tabs.length == 0: Text { x: 14px; text: "02  ЗАМЕТКА"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; }
        }
        if S.note-path == "" && S.notes-count == 0: VerticalLayout {
            y: 44px; height: parent.height - 44px; alignment: center; spacing: 16px;
            HorizontalLayout { alignment: center; Sat { width: 50px; height: 50px; c: #7C7E88; } }
            Text { text: "Заметок пока нет. Выбери папку с заметками (подойдёт и папка Obsidian) — или нажми «+» слева."; color: G.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
            HorizontalLayout { alignment: center; Button { text: "Выбрать папку…"; primary: true; clicked => { S.notes-pick(); } } }
        }
        if S.note-canvas: CanvasView { y: 44px; height: parent.height - 44px; }
        if S.note-path == "" && S.notes-count != 0: Empty { y: 44px; height: parent.height - 44px; text: "Выбери заметку слева"; pose: "sleep"; }
        if S.note-path != "" && !S.note-canvas: Rectangle {
            y: 44px; height: 40px;
            Text { x: 16px; text: S.note-crumb; font-family: G.mono; font-size: 10.5px; letter-spacing: 1.2px; color: #8A8C96; vertical-alignment: center; overflow: elide; width: parent.width - 200px; }
            Rectangle {
                x: parent.width - self.width - 12px; y: 6px; width: ft.preferred-width + 40px; height: 28px; border-radius: 6px;
                border-width: 1px; border-color: root.zen ? G.accent : G.line; background: fa.has-hover ? G.node-hover : transparent;
                Icon { name: "focus"; x: 9px; width: 14px; y: 7px; c: root.zen ? G.accent : G.muted; }
                ft := Text { x: 29px; text: "ФОКУС · CTRL E"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: root.zen ? G.accent-ink : #A3A5AE; vertical-alignment: center; }
                fa := TouchArea { mouse-cursor: pointer; clicked => { root.zen = !root.zen; } }
                Tip { text: "Фокус — только заметка на весь экран"; on: fa.has-hover; }
            }
            // вставить таблицу
            Rectangle {
                x: parent.width - self.width - 20px - ft.preferred-width - 40px; y: 6px; width: tbt.preferred-width + 40px; height: 28px; border-radius: 6px;
                border-width: 1px; border-color: G.line; background: tba.has-hover ? G.node-hover : transparent;
                Icon { name: "board"; x: 9px; width: 14px; y: 7px; c: G.muted; }
                tbt := Text { x: 29px; text: "ТАБЛИЦА"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: #A3A5AE; vertical-alignment: center; }
                tba := TouchArea { mouse-cursor: pointer; clicked => { S.note-table(root.edit-i); root.edit-i = -1; } }
                Tip { text: "Вставить таблицу"; on: tba.has-hover; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
        }
        if S.note-path != "" && !S.note-canvas: sv := ScrollView {
            y: 84px; height: parent.height - 84px - 34px;
            property <length> cw: min(root.zen ? 780px : 700px, self.width - 64px);
            // высота прокрутки — вся заметка целиком, до «Ссылаются сюда» включительно
            content-height: nbody.preferred-height;
            // другая заметка — с начала; заметка стала короче — не оставлять текст за краем
            property <string> path: S.note-path;
            changed path => { self.viewport-y = 0; }
            changed content-height => { self.viewport-y = max(self.viewport-y, min(0px, self.visible-height - self.content-height)); }
            nbody := VerticalLayout {
                x: (sv.width - sv.cw) / 2; y: 0; width: sv.cw;
                padding-top: 22px; padding-bottom: 40px; spacing: 0; alignment: start;
                // название — правится прямо здесь: Enter или клик мимо — переименовать файл (ссылки обновятся)
                tti := TextInput {
                    text: S.note-title; font-size: root.zen ? 30px : 26px; font-weight: 600; color: G.ink; wrap: word-wrap; single-line: true;
                    selection-background-color: G.accent-line;
                    accepted => { S.note-retitle(self.text); self.clear-focus(); }
                    changed has-focus => { if (!self.has-focus && self.text != S.note-title) { S.note-retitle(self.text); } }
                    key-pressed(e) => { if (e.text == Key.Escape) { self.text = S.note-title; self.clear-focus(); return accept; } reject }
                }
                // теги и свойства под заголовком
                if S.note-props.length > 0: Rectangle { height: 12px; }
                if S.note-props.length > 0: ScrollView {
                    height: 24px;
                    viewport-width: props.preferred-width;
                    props := HorizontalLayout {
                        spacing: 6px; alignment: start;
                        for p in S.note-props: Rectangle {
                            width: pt.preferred-width + 18px; height: 22px; border-radius: 11px;
                            background: p.cur ? G.accent-wash : G.bg;
                            border-width: 1px; border-color: p.cur ? G.accent-line : G.line;
                            pt := Text { text: p.title; font-size: 11.5px; color: p.cur ? G.accent-ink : (p.path == "tag" ? G.accent : G.muted); horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { height: 14px; }
                for b[i] in S.note-lines: LiveLine {
                    line: b;
                    has-link: i < S.note-line-links.length && S.note-line-links[i];
                    zoom: root.zen ? 1.12 : 1;
                    editing: i == root.edit-i;
                    line-edit: root.edit-i >= 0;
                    caret: root.caret;
                    pick => { root.caret = -1; root.edit-i = i; }
                    leave(t) => { if (t != b.raw) { S.note-line-set(i, t); } if (root.edit-i == i) { root.edit-i = -1; } S.note-commit(); }
                    undo(r) => { S.note-undo(r); }
                    commit(t) => { if (t != b.raw) { S.note-line-set(i, t); } S.note-commit(); }
                    split(t, at) => { root.caret = S.note-line-split(i, t, at); root.edit-i = i + 1; }
                    join(t) => {
                        if (i > 0 && S.note-lines[i - 1].top >= 0) {
                            // над строкой таблица: Backspace в начале строки — в последнюю ячейку таблицы
                            if (t != b.raw) { S.note-line-set(i, t); }
                            root.edit-i = -1; S.tk-line = S.note-lines[i - 1].top; S.tk-r = 999; S.tk-n += 1;
                        } else if (i > 0) { if (t != b.raw) { S.note-line-set(i, t); } root.caret = S.note-line-join(i); root.edit-i = i - 1; }
                    }
                    move(t, d, at) => {
                        if (t != b.raw) { S.note-line-set(i, t); }
                        if (i + d >= 0 && i + d < S.note-lines.length && S.note-lines[i + d].top >= 0 && S.note-lines[i + d].top != b.top) {
                            // стрелкой в таблицу: сверху — в первую строку, снизу — в последнюю
                            root.edit-i = -1; S.tk-line = S.note-lines[i + d].top; S.tk-r = d > 0 ? 0 : 999; S.tk-n += 1;
                        } else if (i + d >= 0 && i + d < S.note-lines.length) { root.caret = S.note-col(i, t, at, i + d); root.edit-i = i + d; }
                        else if (d > 0 && b.top >= 0) {
                            // из таблицы в самом конце заметки — новая пустая строка под ней
                            S.note-line-set(S.note-lines.length, ""); root.caret = -1; root.edit-i = S.note-lines.length - 1;
                        }
                    }
                    pick-at(at) => { root.caret = S.note-hit(i, at, S.ctrl-held); if (root.caret >= 0) { root.edit-i = i; } else { root.edit-i = -1; } }
                    toggle => { S.note-todo(i); }
                    focus-mode => { root.zen = !root.zen; }
                }
                // клик под текстом — новая строка в конце
                Rectangle {
                    height: 60px;
                    TouchArea { mouse-cursor: MouseCursor.text; clicked => {
                        if (S.note-lines.length == 0 || S.note-lines[S.note-lines.length - 1].raw != "") { S.note-line-set(S.note-lines.length, ""); }
                        root.caret = -1; root.edit-i = S.note-lines.length - 1;
                    } }
                }
                // ссылаются сюда
                if S.note-back.length > 0: VerticalLayout {
                    spacing: 10px;
                    Rectangle { height: 1px; background: G.line-soft; }
                    HorizontalLayout {
                        spacing: 8px;
                        Icon { name: "backlinks"; width: 14px; y: 1px; c: G.accent; }
                        Text { text: "ССЫЛАЮТСЯ СЮДА · " + S.note-back.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: G.accent-ink; }
                    }
                    for r in (S.note-back.length + 1) / 2: HorizontalLayout {
                        spacing: 10px;
                        for k in 2: Rectangle {
                            property <NoteRow> n: S.note-back[r * 2 + k];
                            property <bool> has: r * 2 + k < S.note-back.length;
                            height: 74px;
                            border-radius: 8px; background: has ? (bb.has-hover ? G.node-hover : G.bg) : transparent;
                            border-width: has ? 1px : 0; border-color: G.line;
                            if has: Text { x: 12px; y: 10px; width: parent.width - 24px; text: n.title; font-size: 13px; font-weight: 600; color: G.ink; overflow: elide; }
                            if has: Text { x: 12px; y: 30px; width: parent.width - 24px; height: 36px; text: n.sub; font-size: 12px; color: #A3A5AE; wrap: word-wrap; overflow: elide; }
                            bb := TouchArea { enabled: has; mouse-cursor: pointer; clicked => { S.note-open(n.path); } pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", n.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        }
                    }
                }
            }
        }
        if S.note-path != "" && !S.note-canvas: Rectangle {
            y: parent.height - 34px; height: 34px;
            Rectangle { y: 0; height: 1px; background: G.line-soft; }
            Rectangle { x: 16px; y: 14px; width: 6px; height: 6px; border-radius: 3px; background: S.note-dirty ? G.accent : G.green; }
            Text { x: 30px; width: parent.width - 140px; text: (S.note-dirty ? "НЕ СОХРАНЕНО · " : "СОХРАНЕНО · ") + S.note-file; font-family: G.mono; font-size: 10px; letter-spacing: 1.2px; color: #8A8C96; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width - self.preferred-width - 16px; text: S.note-words + " СЛОВ"; font-family: G.mono; font-size: 10px; letter-spacing: 1.2px; color: #62646E; vertical-alignment: center; }
        }
    }
    if !S.note-graph && S.note-path != "" && !S.note-canvas: Brackets { x: root.mx0; y: 8px; width: root.mw; height: parent.height - 16px; }

    // 03 · связи
    if !S.note-graph && root.rw > 0: Rectangle {
        x: parent.width - 8px - root.rw; y: 8px; width: root.rw; height: parent.height - 16px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
        Rectangle {
            y: 0; height: 34px; background: #3D3E45; border-radius: 7px;
            Rectangle { y: 27px; height: 7px; background: parent.background; }
            Text { x: 12px; text: "03  СВЯЗИ"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; }
            Text { x: parent.width - self.preferred-width - 12px; text: (S.note-links.length + S.note-back.length) + ""; font-family: G.mono; font-size: 10.5px; color: #FFFFFFE6; vertical-alignment: center; }
        }
        ScrollView {
            y: 34px; height: parent.height - 34px;
            VerticalLayout {
                x: 0; y: 0; width: root.rw;
                padding: 12px; spacing: 8px; alignment: start;
                Text { text: "ССЫЛАЕТСЯ НА · " + S.note-links.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #8A8C96; }
                if S.note-links.length == 0: Text { text: "Ссылок нет — напиши [[название]]"; font-size: 12.5px; color: #62646E; }
                for l in S.note-links: Rectangle {
                    height: 30px;
                    border-radius: 6px; background: la.has-hover ? G.node-hover : transparent;
                    Icon { name: "link"; x: 6px; y: 8px; width: 14px; c: l.path == "" ? #62646E : G.accent; }
                    Text { x: 26px; width: parent.width - 34px; text: l.title + (l.path == "" ? "  · создать" : ""); font-size: 13px; color: l.path == "" ? #8A8C96 : G.ink; vertical-alignment: center; overflow: elide; }
                    la := TouchArea { mouse-cursor: pointer; clicked => { S.note-link(l.title); } }
                }
                Rectangle { height: 8px; }
                Text { text: "ССЫЛАЮТСЯ СЮДА · " + S.note-back.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: G.accent-ink; }
                if S.note-back.length == 0: Text { text: "Пока никто"; font-size: 12.5px; color: #62646E; }
                for l in S.note-back: Rectangle {
                    height: bt.preferred-height + 38px;
                    border-radius: 8px; background: ba.has-hover ? G.node-hover : G.bg; border-width: 1px; border-color: G.line;
                    Rectangle { x: 0; y: 8px; width: 2px; height: parent.height - 16px; background: G.accent; }
                    Text { x: 12px; y: 8px; width: parent.width - 22px; text: l.title; font-size: 13px; font-weight: 600; color: G.ink; overflow: elide; }
                    bt := Text { x: 12px; y: 28px; width: parent.width - 22px; text: "«" + l.sub + "»"; font-size: 12px; color: #A3A5AE; wrap: word-wrap; }
                    ba := TouchArea { mouse-cursor: pointer; clicked => { S.note-open(l.path); } pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", l.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                }
                Rectangle { height: 8px; }
                Text { text: "УПОМЯНУТО БЕЗ ССЫЛКИ · " + S.note-mentions.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #8A8C96; }
                if S.note-mentions.length == 0: Text { text: "Нет"; font-size: 12.5px; color: #62646E; }
                for l in S.note-mentions: Rectangle {
                    height: mt.preferred-height + 38px;
                    border-radius: 8px; background: ma.has-hover ? G.node-hover : transparent; border-width: 1px; border-color: G.line-soft;
                    Text { x: 10px; y: 8px; width: parent.width - 90px; text: l.title; font-size: 13px; color: G.ink; overflow: elide; }
                    mt := Text { x: 10px; y: 28px; width: parent.width - 20px; text: l.sub; font-size: 12px; color: #8A8C96; wrap: word-wrap; }
                    ma := TouchArea { mouse-cursor: pointer; clicked => { S.note-open(l.path); } pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", l.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                    // «Связать»: упоминание в той заметке становится [[ссылкой]]
                    Rectangle {
                        x: parent.width - self.width - 6px; y: 5px; width: lk.preferred-width + 18px; height: 22px; border-radius: 5px;
                        background: la2.has-hover ? G.accent-line : transparent; border-width: 1px; border-color: G.accent-line;
                        lk := Text { text: "Связать"; font-size: 11.5px; color: G.accent; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        la2 := TouchArea { mouse-cursor: pointer; clicked => { S.note-mention-link(l.path); } }
                    }
                }
            }
        }
    }
    if root.drag-path != "": Rectangle {
        x: root.drag-x + 12px; y: root.drag-y + 8px; width: gt.preferred-width + 34px; height: 28px;
        border-radius: 6px; background: G.node; border-width: 1px; border-color: G.accent-line;
        drop-shadow-blur: 16px; drop-shadow-color: #00000080;
        Icon { name: "note"; x: 9px; width: 13px; y: 7.5px; c: G.accent; }
        gt := Text { x: 28px; text: S.note-canvas ? "на канвас" : "открой канвас, чтобы положить"; font-size: 12px; color: G.ink; vertical-alignment: center; height: parent.height; }
    }
}
