// «Знания»: слева заметки и поиск, в центре — заметка (правка сохраняется только по кнопке/Ctrl+S),
// справа — ссылки [[…]] из неё и обратные ссылки.
import { G } from "theme.slint";
import { Node, Mono, Button, Field, Empty, IconBtn, Link, Seg, Brackets, Icon, Sat } from "kit.slint";
import { S, NoteRow, MdRow, GDot, GLine } from "store.slint";
import { ScrollView } from "std-widgets.slint";

// Строка заметки: оформлена сразу; строка с курсором показывает разметку и правится.
component LiveLine inherits Rectangle {
    in property <MdRow> line;
    in property <bool> editing;
    in property <int> caret: -1;
    in property <float> zoom: 1;
    callback pick();
    callback commit(string);
    callback split(string, int);
    callback join(string);
    callback move(string, int);
    callback leave(string);
    callback focus-mode();
    property <bool> h: line.kind == "h1" || line.kind == "h2" || line.kind == "h3";
    property <length> fs: (line.kind == "h1" ? 22px : line.kind == "h2" ? 17.5px : line.kind == "h3" ? 15.5px : 14.5px) * zoom;
    property <length> pad: line.kind == "h1" ? 14px : line.kind == "h2" ? 10px : line.kind == "h3" ? 6px : 3px;
    property <length> ind: line.kind == "quote" ? 14px : (line.kind == "li" || line.kind == "todo" || line.kind == "done" ? 18px : (line.kind == "code" ? 12px : 0));
    height: line.kind == "empty" && !editing ? 12px * zoom : (line.kind == "fence" && !editing ? 6px : (line.kind == "hr" && !editing ? 18px : (editing ? ed.preferred-height : st.preferred-height) + pad + 5px));
    ta := TouchArea { mouse-cursor: MouseCursor.text; clicked => { root.pick(); } }
    if line.kind == "code" && !editing: Rectangle { x: -8px; y: 0; width: parent.width + 16px; height: parent.height; background: G.bg; }
    if line.kind == "hr" && !editing: Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: G.line; }
    if line.kind == "quote" && !editing: Rectangle { x: 0; y: pad; width: 3px; height: parent.height - pad - 3px; border-radius: 1.5px; background: G.accent; }
    if line.kind == "li" && !editing: Rectangle { x: 6px; y: pad + fs * 0.62 - 2.5px; width: 5px; height: 5px; border-radius: 2.5px; background: G.muted; }
    if (line.kind == "todo" || line.kind == "done") && !editing: Rectangle {
        x: 0; y: pad + fs * 0.62 - 6.5px; width: 13px; height: 13px; border-radius: 3px;
        border-width: 1.2px; border-color: line.kind == "done" ? G.accent : G.muted; background: line.kind == "done" ? G.accent : transparent;
        if line.kind == "done": Icon { name: "check"; width: 9px; x: 2px; y: 2px; c: #1C1D21; stroke-width: 2.4px; }
    }
    if line.kind == "img" && !editing: Rectangle {
        y: pad; height: parent.height - pad - 5px; border-radius: 6px; border-width: 1px; border-color: G.line; background: G.bg;
    }
    st := StyledText {
        visible: !editing && line.kind != "empty" && line.kind != "fence" && line.kind != "hr";
        x: ind; y: pad; width: parent.width - ind;
        text: line.md;
        default-font-size: fs;
        default-font-family: line.kind == "code" ? G.mono : G.sans;
        default-color: line.kind == "done" || line.kind == "img" ? G.muted : (line.kind == "code" ? G.gold : (line.kind == "quote" ? #B9BBC4 : (h ? G.ink : #D8DAE2)));
        link-color: G.accent;
        link-clicked(l) => { S.note-link(l); }
    }
    fs-scope := FocusScope {
        x: 0; y: pad; width: parent.width; height: ed.preferred-height;
        visible: editing;
        enabled: editing;
        capture-key-pressed(e) => {
            if (!editing) { return reject; }
            if (e.text == Key.Return && !e.modifiers.shift) { root.split(ed.text, ed.cursor-position-byte-offset); return accept; }
            if (e.text == Key.UpArrow) { root.move(ed.text, -1); return accept; }
            if (e.text == Key.DownArrow) { root.move(ed.text, 1); return accept; }
            if (e.text == Key.Escape) { root.leave(ed.text); return accept; }
            if (e.text == Key.Backspace && ed.cursor-position-byte-offset == 0 && ed.anchor-position-byte-offset == 0) { root.join(ed.text); return accept; }
            if (e.modifiers.control && (e.text == "e" || e.text == "E" || e.text == "у" || e.text == "У")) { root.focus-mode(); return accept; }
            if (e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "ы" || e.text == "Ы")) { root.commit(ed.text); return accept; }
            reject
        }
        // раскладка: в прокрутке (колонка окна прокручивается)
        ed := TextInput {
            x: 0; y: 0; width: parent.width;
            text: line.raw;
            single-line: false;
            wrap: word-wrap;
            font-size: root.fs;
            font-family: line.kind == "code" ? G.mono : G.sans;
            font-weight: root.h ? 600 : 400;
            color: G.ink;
            selection-background-color: G.accent-wash;
            changed has-focus => { if (!self.has-focus && root.editing) { root.leave(self.text); } }
        }
    }
    function start() {
        ed.text = line.raw;
        ed.focus();
        if (caret >= 0) { ed.set-selection-offsets(caret, caret); } else { ed.set-selection-offsets(999999, 999999); }
    }
    changed editing => { if (editing) { start(); } }
    init => { if (editing) { start(); } }
}

component NoteList inherits VerticalLayout {
    in property <[NoteRow]> rows;
    in property <string> cur;
    for r in rows: Rectangle {
        height: r.path == "" ? 30px : 30px;
        background: r.path != "" && r.path == cur ? G.accent-wash : (r.path != "" && na.has-hover ? G.node-hover : transparent);
        if r.path != "" && r.path == cur: Rectangle { x: 0; width: 2px; background: G.accent; }
        if r.path == "": Rectangle { x: 14px; y: 13px; width: 6px; height: 6px; border-radius: 2px; background: #7C7E88; }
        if r.path == "": Text { x: 28px; y: 6px; height: 22px; text: r.title; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #8A8C96; vertical-alignment: center; overflow: elide; width: parent.width - 60px; }
        if r.path == "": Text { x: parent.width - self.preferred-width - 12px; y: 6px; height: 22px; text: r.sub; font-family: G.mono; font-size: 10px; color: #62646E; vertical-alignment: center; }
        if r.path != "": Text { x: 28px; width: parent.width - 40px; text: r.title; color: r.path == cur ? G.ink : #C9CBD3; font-size: 13px; vertical-alignment: center; overflow: elide; }
        na := TouchArea { enabled: r.path != ""; clicked => { S.note-open(r.path); } mouse-cursor: pointer; pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", r.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
    }
}

// Граф: точки — заметки, линии — [[ссылки]]. Колесо — масштаб, тянуть — двигать, клик — открыть.
// С ×1.8 у точек видны названия, у выбранной заметки соседи подсвечены.
component Graph inherits Rectangle {
    in-out property <float> k: 1;
    in-out property <length> ox;
    in-out property <length> oy;
    property <length> base: min(self.width, self.height) / 1000 * 0.92;
    property <length> lx;
    property <length> ly;
    property <bool> moved-far;
    clip: true;
    background: G.bg;
    pan := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.lx = self.mouse-x; root.ly = self.mouse-y; root.moved-far = false; }
        }
        moved => {
            if (self.pressed) {
                root.ox += self.mouse-x - root.lx;
                root.oy += self.mouse-y - root.ly;
                root.lx = self.mouse-x;
                root.ly = self.mouse-y;
            }
        }
        scroll-event(e) => {
            if (e.delta-y != 0) {
                root.k = max(0.3, min(8, root.k * (e.delta-y > 0 ? 1.15 : 1 / 1.15)));
                return accept;
            }
            reject
        }
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
    }
    for l in S.graph-lines: Path {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: l.near ? G.accent : G.line-strong;
        stroke-width: l.near ? 1.5px : 1px;
        opacity: l.near ? 1 : 0.6;
        MoveTo { x: (root.width / 2 + (l.x1 - 500) * root.base * root.k + root.ox) / 1px; y: (root.height / 2 + (l.y1 - 500) * root.base * root.k + root.oy) / 1px; }
        LineTo { x: (root.width / 2 + (l.x2 - 500) * root.base * root.k + root.ox) / 1px; y: (root.height / 2 + (l.y2 - 500) * root.base * root.k + root.oy) / 1px; }
    }
    for d in S.graph-dots: Rectangle {
        property <length> cx: root.width / 2 + (d.x - 500) * root.base * root.k + root.ox;
        property <length> cy: root.height / 2 + (d.y - 500) * root.base * root.k + root.oy;
        property <length> rr: d.r * 1px * min(2, max(1, root.k * 0.7)) + (da.has-hover ? 2px : 0);
        x: cx - rr;
        y: cy - rr;
        width: rr * 2;
        height: rr * 2;
        border-radius: rr;
        background: d.cur ? G.accent : (d.missing ? transparent : (d.near ? G.accent-ink : G.ink.with-alpha(0.75)));
        border-width: d.missing ? 1px : 0;
        border-color: G.dim;
        da := TouchArea { clicked => { S.graph-open(d.path, d.title); } mouse-cursor: pointer; pointer-event(e) => { if (d.path != "" && e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", d.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
        if root.k >= 1.8 || d.cur || d.near || da.has-hover: Text {
            x: (parent.width - self.preferred-width) / 2;
            y: parent.height + 3px;
            text: d.title;
            font-size: 11px;
            color: d.cur ? G.accent-ink : (d.missing ? G.dim : G.ink);
        }
    }
    HorizontalLayout {
        x: parent.width - 150px;
        width: 138px;
        height: 30px;
        y: parent.height - 42px;
        spacing: 6px;
        Button { text: "−"; clicked => { root.k = max(0.3, root.k / 1.3); } }
        Button { text: "＋"; clicked => { root.k = min(8, root.k * 1.3); } }
        Button { text: "⤢"; clicked => { root.k = 1; root.ox = 0; root.oy = 0; } }
    }
    Mono { x: 14px; y: parent.height - 30px; text: S.graph-dots.length + " ЗАМЕТОК · " + S.graph-lines.length + " СВЯЗЕЙ"; }
}

// Раскладка G: слева нода «Заметки» 264 px, справа нода «Связи» 300 px, середина тянется; поля 8 px.
export component NotesPage inherits Rectangle {
    property <string> body: S.note-body;
    property <bool> wide: self.width >= 1100px;
    property <length> lw: zen ? 0px : 264px;
    property <length> rw: wide && !zen ? 300px : 0px;
    property <length> mx0: zen ? 8px : 8px + lw + 8px;
    property <length> mw: self.width - mx0 - 8px - (wide && !zen ? rw + 8px : 0px);
    property <string> q;
    in-out property <bool> zen;
    property <int> edit-i: -1;
    property <int> caret: -1;

    // 01 · заметки
    if !root.zen: Rectangle {
        x: 8px; y: 8px; width: root.lw; height: parent.height - 16px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
        Rectangle {
            y: 0; height: 34px; background: #3D3E45; border-radius: 7px;
            Rectangle { y: 27px; height: 7px; background: parent.background; }
            Text { x: 12px; text: "01  ЗАМЕТКИ"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; }
            Text { x: parent.width - self.preferred-width - 12px; text: S.notes-count + ""; font-family: G.mono; font-size: 10.5px; letter-spacing: 1.4px; color: #ffffffb0; vertical-alignment: center; }
        }
        Seg { x: 10px; y: 44px; width: parent.width - 20px; items: ["¶ ЗАМЕТКИ", "◉ ГРАФ"]; current: S.note-graph ? 1 : 0; picked(i) => { S.note-graph-set(i == 1); } }
        Rectangle {
            x: 10px; y: 84px; width: parent.width - 54px; height: 32px;
            border-radius: 8px; background: G.bg; border-width: 1px; border-color: G.line;
            Field { x: 8px; y: 1px; height: 30px; width: parent.width - 16px; bare: true; placeholder: "Найти заметку"; font-size: 13px;
                edited(t) => { root.q = t; S.note-search(t); }
                accepted(t) => { if (t != "" && S.notes.length == 0) { S.note-new(t); self.clear(); S.note-search(""); } } }
        }
        Rectangle {
            x: parent.width - 42px; y: 84px; width: 32px; height: 32px; border-radius: 8px;
            background: pa.has-hover ? G.accent.brighter(0.1) : G.accent;
            Text { text: "+"; color: #1C1D21; font-size: 18px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            pa := TouchArea { mouse-cursor: pointer; clicked => { S.note-new(root.q != "" ? root.q : "Новая заметка"); } }
        }
        ScrollView { x: 0; y: 124px; width: parent.width; height: parent.height - 124px - 32px; NoteList { x: 0; y: 0; width: root.lw; rows: S.notes; cur: S.note-path; } }
        Rectangle { x: 0; y: parent.height - 32px; height: 1px; background: G.line-soft; }
        Text { x: 12px; y: parent.height - 32px; height: 32px; text: "ПАПКА ЗАМЕТОК · " + S.notes-count; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.3px; color: #62646E; vertical-alignment: center; }
    }

    if S.note-graph: Rectangle {
        x: root.mx0; y: 8px; width: parent.width - root.mx0 - 8px; height: parent.height - 16px;
        border-radius: 12px; border-width: 1px; border-color: G.line; clip: true;
        Graph { }
    }

    // 02 · заметка
    if !S.note-graph: Rectangle {
        x: root.mx0; y: 8px; width: root.mw; height: parent.height - 16px;
        border-radius: 12px; background: G.node; border-width: 1px; border-color: G.accent-line; clip: true;
        Rectangle {
            y: 0; height: 34px; background: G.head-main; border-radius: 11px;
            Rectangle { y: 23px; height: 11px; background: parent.background; }
            // вкладки открытых заметок
            if S.note-tabs.length > 0: Rectangle {
                x: 6px; y: 4px; width: parent.width - 12px; height: 30px; clip: true;
                HorizontalLayout {
                    x: 0; y: 0; height: parent.height; spacing: 3px; alignment: start;
                    for t in S.note-tabs: Rectangle {
                        height: 26px; y: 2px; width: min(tt.preferred-width + 40px, 200px);
                        border-radius: 6px;
                        background: t.cur ? G.node : (ta.has-hover ? G.node-hover : transparent);
                        border-width: t.cur ? 1px : 0;
                        border-color: G.line;
                        tt := Text { x: 10px; width: parent.width - 34px; text: t.title; font-size: 12.5px; color: t.cur ? G.ink : G.muted; vertical-alignment: center; overflow: elide; }
                        if t.cur && S.note-dirty: Text { x: parent.width - 22px; width: 18px; text: "●"; font-size: 9px; color: G.accent; vertical-alignment: center; horizontal-alignment: center; }
                        if !(t.cur && S.note-dirty): Icon { name: "close"; width: 11px; x: parent.width - 18px; y: (parent.height - 11px) / 2; c: ca.has-hover ? G.red : G.dim; }
                        ta := TouchArea { width: parent.width - 24px; mouse-cursor: pointer; clicked => { S.note-tab-open(t.path); } pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("tab", t.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        ca := TouchArea { x: parent.width - 24px; width: 24px; mouse-cursor: pointer; clicked => { S.note-tab-close(t.path); } }
                    }
                }
            }
            if S.note-tabs.length == 0: Text { x: 12px; text: "02  ЗАМЕТКА"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; }
        }
        if S.note-path == "" && S.notes-count == 0: VerticalLayout {
            y: 34px; height: parent.height - 34px; alignment: center; spacing: 16px;
            HorizontalLayout { alignment: center; Sat { width: 50px; height: 50px; c: #7C7E88; } }
            Text { text: "Заметок пока нет. Выбери папку с заметками (подойдёт и папка Obsidian) — или нажми «+» слева."; color: G.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
            HorizontalLayout { alignment: center; Button { text: "Выбрать папку…"; primary: true; clicked => { S.notes-pick(); } } }
        }
        if S.note-path == "" && S.notes-count != 0: Empty { y: 34px; height: parent.height - 34px; text: "Выбери заметку слева"; pose: "sleep"; }
        if S.note-path != "": Rectangle {
            y: 34px; height: 40px;
            Text { x: 16px; text: S.note-crumb; font-family: G.mono; font-size: 10.5px; letter-spacing: 1.2px; color: #8A8C96; vertical-alignment: center; overflow: elide; width: parent.width - 200px; }
            Rectangle {
                x: parent.width - self.width - 12px; y: 6px; width: ft.preferred-width + 40px; height: 28px; border-radius: 6px;
                border-width: 1px; border-color: root.zen ? G.accent : G.line; background: fa.has-hover ? G.node-hover : transparent;
                Icon { name: "focus"; x: 9px; width: 14px; y: 7px; c: root.zen ? G.accent : G.muted; }
                ft := Text { x: 29px; text: "ФОКУС · CTRL E"; font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: root.zen ? G.accent-ink : #A3A5AE; vertical-alignment: center; }
                fa := TouchArea { mouse-cursor: pointer; clicked => { root.zen = !root.zen; } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
        }
        if S.note-path != "": sv := ScrollView {
            y: 74px; height: parent.height - 74px - 34px;
            property <length> cw: min(root.zen ? 780px : 700px, self.width - 64px);
            VerticalLayout {
                x: (sv.width - sv.cw) / 2; y: 0; width: sv.cw;
                padding-top: 22px; padding-bottom: 40px; spacing: 0; alignment: start;
                Text { text: S.note-title; font-size: root.zen ? 30px : 26px; font-weight: 600; color: G.ink; wrap: word-wrap; }
                // теги и свойства под заголовком
                if S.note-props.length > 0: Rectangle { height: 12px; }
                if S.note-props.length > 0: HorizontalLayout {
                    height: 24px; spacing: 6px; alignment: start;
                    for p in S.note-props: Rectangle {
                        width: pt.preferred-width + 18px; height: 22px; border-radius: 11px;
                        background: p.cur ? G.accent-wash : G.bg;
                        border-width: 1px; border-color: p.cur ? G.accent-line : G.line;
                        pt := Text { text: p.title; font-size: 11.5px; color: p.cur ? G.accent-ink : (p.path == "tag" ? G.accent : G.muted); horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle { height: 14px; }
                for b[i] in S.note-lines: LiveLine {
                    line: b;
                    zoom: root.zen ? 1.12 : 1;
                    editing: i == root.edit-i;
                    caret: root.caret;
                    pick => { root.caret = -1; root.edit-i = i; }
                    leave(t) => { if (t != b.raw) { S.note-line-set(i, t); } if (root.edit-i == i) { root.edit-i = -1; } S.note-commit(); }
                    commit(t) => { if (t != b.raw) { S.note-line-set(i, t); } S.note-commit(); }
                    split(t, at) => { root.caret = S.note-line-split(i, t, at); root.edit-i = i + 1; }
                    join(t) => { if (i > 0) { if (t != b.raw) { S.note-line-set(i, t); } root.caret = S.note-line-join(i); root.edit-i = i - 1; } }
                    move(t, d) => { if (t != b.raw) { S.note-line-set(i, t); } root.caret = -1; root.edit-i = max(0, min(S.note-lines.length - 1, i + d)); }
                    focus-mode => { root.zen = !root.zen; }
                }
                // клик под текстом — новая строка в конце
                Rectangle {
                    height: 60px;
                    TouchArea { mouse-cursor: MouseCursor.text; clicked => {
                        if (S.note-lines.length == 0 || S.note-lines[S.note-lines.length - 1].raw != "") { S.note-line-set(S.note-lines.length, ""); }
                        root.caret = -1; root.edit-i = S.note-lines.length - 1;
                    } }
                }
                // ссылаются сюда
                if S.note-back.length > 0: VerticalLayout {
                    spacing: 10px;
                    Rectangle { height: 1px; background: G.line-soft; }
                    HorizontalLayout {
                        spacing: 8px;
                        Icon { name: "backlinks"; width: 14px; y: 1px; c: G.accent; }
                        Text { text: "ССЫЛАЮТСЯ СЮДА · " + S.note-back.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: G.accent-ink; }
                    }
                    for r in (S.note-back.length + 1) / 2: HorizontalLayout {
                        spacing: 10px;
                        for k in 2: Rectangle {
                            property <NoteRow> n: S.note-back[r * 2 + k];
                            property <bool> has: r * 2 + k < S.note-back.length;
                            height: 74px;
                            border-radius: 8px; background: has ? (bb.has-hover ? G.node-hover : G.bg) : transparent;
                            border-width: has ? 1px : 0; border-color: G.line;
                            if has: Text { x: 12px; y: 10px; width: parent.width - 24px; text: n.title; font-size: 13px; font-weight: 600; color: G.ink; overflow: elide; }
                            if has: Text { x: 12px; y: 30px; width: parent.width - 24px; height: 36px; text: n.sub; font-size: 12px; color: #A3A5AE; wrap: word-wrap; overflow: elide; }
                            bb := TouchArea { enabled: has; mouse-cursor: pointer; clicked => { S.note-open(n.path); } pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", n.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                        }
                    }
                }
            }
        }
        if S.note-path != "": Rectangle {
            y: parent.height - 34px; height: 34px;
            Rectangle { y: 0; height: 1px; background: G.line-soft; }
            Rectangle { x: 16px; y: 14px; width: 6px; height: 6px; border-radius: 3px; background: S.note-dirty ? G.accent : G.green; }
            Text { x: 30px; text: (S.note-dirty ? "НЕ СОХРАНЕНО · " : "СОХРАНЕНО · ") + S.note-file; font-family: G.mono; font-size: 10px; letter-spacing: 1.2px; color: #8A8C96; vertical-alignment: center; }
            Text { x: parent.width - self.preferred-width - 16px; text: S.note-words + " СЛОВ"; font-family: G.mono; font-size: 10px; letter-spacing: 1.2px; color: #62646E; vertical-alignment: center; }
        }
    }
    if !S.note-graph && S.note-path != "": Brackets { x: root.mx0; y: 8px; width: root.mw; height: parent.height - 16px; }

    // 03 · связи
    if !S.note-graph && root.wide && !root.zen: Rectangle {
        x: parent.width - 8px - root.rw; y: 8px; width: root.rw; height: parent.height - 16px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
        Rectangle {
            y: 0; height: 34px; background: #3D3E45; border-radius: 7px;
            Rectangle { y: 27px; height: 7px; background: parent.background; }
            Text { x: 12px; text: "03  СВЯЗИ"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.5px; color: #fff; vertical-alignment: center; }
            Text { x: parent.width - self.preferred-width - 12px; text: (S.note-links.length + S.note-back.length) + ""; font-family: G.mono; font-size: 10.5px; color: #ffffffb0; vertical-alignment: center; }
        }
        ScrollView {
            y: 34px; height: parent.height - 34px;
            VerticalLayout {
                x: 0; y: 0; width: root.rw;
                padding: 12px; spacing: 8px; alignment: start;
                Text { text: "ССЫЛАЕТСЯ НА · " + S.note-links.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #8A8C96; }
                if S.note-links.length == 0: Text { text: "Ссылок нет — напиши [[название]]"; font-size: 12.5px; color: #62646E; }
                for l in S.note-links: Rectangle {
                    height: 30px;
                    border-radius: 6px; background: la.has-hover ? G.node-hover : transparent;
                    Icon { name: "link"; x: 6px; y: 8px; width: 14px; c: l.path == "" ? #62646E : G.accent; }
                    Text { x: 26px; width: parent.width - 34px; text: l.title + (l.path == "" ? "  · создать" : ""); font-size: 13px; color: l.path == "" ? #8A8C96 : G.ink; vertical-alignment: center; overflow: elide; }
                    la := TouchArea { mouse-cursor: pointer; clicked => { S.note-link(l.title); } }
                }
                Rectangle { height: 8px; }
                Text { text: "ССЫЛАЮТСЯ СЮДА · " + S.note-back.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: G.accent-ink; }
                if S.note-back.length == 0: Text { text: "Пока никто"; font-size: 12.5px; color: #62646E; }
                for l in S.note-back: Rectangle {
                    height: bt.preferred-height + 38px;
                    border-radius: 8px; background: ba.has-hover ? G.node-hover : G.bg; border-width: 1px; border-color: G.line;
                    Rectangle { x: 0; y: 8px; width: 2px; height: parent.height - 16px; background: G.accent; }
                    Text { x: 12px; y: 8px; width: parent.width - 22px; text: l.title; font-size: 13px; font-weight: 600; color: G.ink; overflow: elide; }
                    bt := Text { x: 12px; y: 28px; width: parent.width - 22px; text: "«" + l.sub + "»"; font-size: 12px; color: #A3A5AE; wrap: word-wrap; }
                    ba := TouchArea { mouse-cursor: pointer; clicked => { S.note-open(l.path); } pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", l.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                }
                Rectangle { height: 8px; }
                Text { text: "УПОМЯНУТО БЕЗ ССЫЛКИ · " + S.note-mentions.length; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #8A8C96; }
                if S.note-mentions.length == 0: Text { text: "Нет"; font-size: 12.5px; color: #62646E; }
                for l in S.note-mentions: Rectangle {
                    height: mt.preferred-height + 38px;
                    border-radius: 8px; background: ma.has-hover ? G.node-hover : transparent; border-width: 1px; border-color: G.line-soft;
                    Text { x: 10px; y: 8px; width: parent.width - 20px; text: l.title; font-size: 13px; color: G.ink; overflow: elide; }
                    mt := Text { x: 10px; y: 28px; width: parent.width - 20px; text: l.sub; font-size: 12px; color: #8A8C96; wrap: word-wrap; }
                    ma := TouchArea { mouse-cursor: pointer; clicked => { S.note-open(l.path); } pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { S.menu-ctx("note", l.path, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } } }
                }
            }
        }
    }
}
