// Общие детали «Системы G»: нода с цветной шапкой, сокет, кнопка, моно-подпись.
import { G } from "theme.slint";

export component Mono inherits Text {
    font-family: G.mono;
    font-size: 11px;
    letter-spacing: 1.2px;
    color: G.muted;
}

// Квадрат 10px на краю ноды — сюда приходит провод.
export component Socket inherits Rectangle {
    in property <color> hue: G.line-strong;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: G.node;
    border-width: 1.5px;
    border-color: hue;
}

// Нода: шапка «NN · НАЗВАНИЕ» на заливке, тело — содержимое. main — главная нода (крупнее, скобки по углам).
export component Node inherits Rectangle {
    in property <string> num;
    in property <string> title;
    in property <string> aside;
    in property <color> head: #3D3E45;
    in property <bool> main;
    background: G.node;
    border-radius: main ? G.r-main : G.r-node;
    border-width: 1px;
    border-color: main ? G.accent-line : G.line;
    clip: true;
    VerticalLayout {
        Rectangle {
            height: main ? 38px : 30px;
            background: head;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: num + " · " + title;
                    font-family: G.mono;
                    font-size: main ? 13px : 11px;
                    font-weight: 600;
                    letter-spacing: 1.4px;
                    color: #ffffff;
                    vertical-alignment: center;
                }
                Rectangle { }
                Text {
                    text: aside;
                    font-family: G.mono;
                    font-size: 11px;
                    color: #ffffffb0;
                    vertical-alignment: center;
                }
            }
        }
        @children
    }
}

// Уголки-скобки главной ноды.
export component Brackets inherits Rectangle {
    in property <color> c: G.accent;
    out property <length> k: 14px;
    Path { x: -6px; y: -6px; width: root.k; height: root.k; commands: "M 0 14 L 0 0 L 14 0"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
    Path { x: root.width - root.k + 6px; y: -6px; width: root.k; height: root.k; commands: "M 0 0 L 14 0 L 14 14"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
    Path { x: -6px; y: root.height - root.k + 6px; width: root.k; height: root.k; commands: "M 0 0 L 0 14 L 14 14"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
    Path { x: root.width - root.k + 6px; y: root.height - root.k + 6px; width: root.k; height: root.k; commands: "M 14 0 L 14 14 L 0 14"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 34px;
    min-width: label.preferred-width + 28px;
    border-radius: G.r-btn;
    background: primary ? (ta.has-hover ? G.accent-ink : G.accent) : (ta.has-hover ? G.node-hover : G.node);
    border-width: primary ? 0 : 1px;
    border-color: G.line;
    animate background { duration: G.fast; }
    label := Text {
        text: root.text;
        font-family: G.sans;
        font-size: 14px;
        font-weight: 500;
        color: primary ? G.on-accent : G.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Таблетка-переключатель (фильтры, части дня, варианты).
export component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <color> hue: G.accent;
    callback clicked;
    height: 26px;
    min-width: pt.preferred-width + 20px;
    border-radius: 13px;
    background: on ? hue.transparentize(0.78) : (pa.has-hover ? G.node-hover : transparent);
    border-width: 1px;
    border-color: on ? hue : G.line;
    animate background, border-color { duration: G.fast; }
    pt := Text { text: root.text; font-size: 12px; color: on ? G.ink : G.muted; horizontal-alignment: center; vertical-alignment: center; }
    pa := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Сегмент «Неделя | Месяц»: подписи через «|».
export component Seg inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback picked(int);
    height: 28px;
    border-radius: G.r-btn;
    border-width: 1px;
    border-color: G.line;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for it[i] in items: Rectangle {
            min-width: st.preferred-width + 20px;
            border-radius: 4px;
            background: i == current ? G.accent-wash : (sa.has-hover ? G.node-hover : transparent);
            st := Text { text: it; font-family: G.mono; font-size: 11px; letter-spacing: 1px; color: i == current ? G.accent-ink : G.muted; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { clicked => { root.picked(i); } mouse-cursor: pointer; }
        }
    }
}

// Круглая отметка «сделано».
export component Check inherits Rectangle {
    in property <bool> done;
    in property <color> hue: G.accent;
    callback toggled;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 1.5px;
    border-color: done ? hue : (ca.has-hover ? G.ink : G.line-strong);
    background: done ? hue : transparent;
    animate background, border-color { duration: G.fast; }
    Text { text: "✓"; visible: done; color: G.on-accent; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    ca := TouchArea { clicked => { root.toggled(); } mouse-cursor: pointer; }
}

// Маленькая кнопка-значок (‹ › ✕ ⋯).
export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> on;
    out property <bool> hover: ia.has-hover;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: G.r-btn;
    background: on ? G.accent-wash : (ia.has-hover ? G.node-hover : transparent);
    Text { text: icon; color: on ? G.accent-ink : (ia.has-hover ? G.ink : G.muted); font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
    ia := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Ссылка-текст.
export component Link inherits Text {
    callback clicked;
    color: la.has-hover ? G.accent-ink : G.accent;
    font-size: 13px;
    la := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Поле ввода в стиле G (без системной рамки).
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    in property <length> font-size: 14px;
    in property <bool> mono;
    in property <bool> bare;
    callback accepted(string);
    callback edited(string);
    callback escape();
    callback shift-enter(string);
    out property <bool> focused: ti.has-focus;
    public function grab() { ti.focus(); }
    public function clear() { ti.text = ""; }
    height: 34px;
    border-radius: G.r-btn;
    background: bare ? transparent : G.bg;
    border-width: bare ? 0 : 1px;
    border-color: ti.has-focus ? G.accent-line : G.line;
    clip: true;
    Text {
        x: bare ? 0 : 10px;
        text: placeholder;
        visible: ti.text == "";
        color: G.dim;
        font-size: root.font-size;
        font-family: mono ? G.mono : G.sans;
        vertical-alignment: center;
        height: parent.height;
    }
    ti := TextInput {
        x: bare ? 0 : 10px;
        width: parent.width - (bare ? 0 : 20px);
        height: parent.height;
        color: G.ink;
        font-size: root.font-size;
        font-family: mono ? G.mono : G.sans;
        vertical-alignment: center;
        selection-background-color: G.accent-line;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.escape(); return accept; }
            if (e.text == Key.Return && e.modifiers.shift) { root.shift-enter(self.text); return accept; }
            reject
        }
    }
}

// Затемнение и окно поверх всего (диалоги).
export component Overlay inherits Rectangle {
    callback close;
    background: #0009;
    TouchArea { clicked => { root.close(); } }
    @children
}

// Пустое место с енотом-подписью.
export component Empty inherits VerticalLayout {
    in property <string> text;
    in property <string> pose: "sleep";
    alignment: center;
    spacing: 10px;
    Image {
        height: 96px;
        source: pose == "cheer" ? @image-url("../../../app/assets/coon/coon-cheer.svg") : pose == "think" ? @image-url("../../../app/assets/coon/coon-think.svg") : pose == "hi" ? @image-url("../../../app/assets/coon/coon-hi.svg") : pose == "flag" ? @image-url("../../../app/assets/coon/coon-flag.svg") : pose == "oops" ? @image-url("../../../app/assets/coon/coon-oops.svg") : @image-url("../../../app/assets/coon/coon-sleep.svg");
        image-fit: contain;
    }
    Text { text: root.text; color: G.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
}

// Пунктирная рамка (Slint не рисует пунктир сам): штрихи 4 px через 3 px.
export component DashBox inherits Rectangle {
    in property <color> c: G.line-strong;
    in property <length> dash: 4px;
    property <int> nx: floor(self.width / (root.dash + 3px));
    property <int> ny: floor(self.height / (root.dash + 3px));
    for i in root.nx: Rectangle { x: i * (root.dash + 3px) + 2px; y: 0; width: root.dash; height: 1px; background: root.c; }
    for i in root.nx: Rectangle { x: i * (root.dash + 3px) + 2px; y: root.height - 1px; width: root.dash; height: 1px; background: root.c; }
    for i in root.ny: Rectangle { y: i * (root.dash + 3px) + 2px; x: 0; height: root.dash; width: 1px; background: root.c; }
    for i in root.ny: Rectangle { y: i * (root.dash + 3px) + 2px; x: root.width - 1px; height: root.dash; width: 1px; background: root.c; }
    @children
}

// Штриховка сжатых часов: косые штрихи.
export component Hatch inherits Rectangle {
    in property <color> c: #ffffff10;
    clip: true;
    for i in floor(self.width / 6px): Rectangle { x: i * 6px; y: 0; width: 2px; height: root.height; background: root.c; }
}

// Сегмент G: выбранное — светлая заливка с тёмным текстом.
export component CSeg inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback picked(int);
    height: 32px;
    width: 128px;
    border-radius: 6px;
    border-width: 1px;
    border-color: G.line;
    for it[i] in items: Rectangle {
        x: 3px + i * (root.width - 6px) / items.length;
        y: 3px;
        width: (root.width - 6px) / items.length;
        height: root.height - 6px;
        border-radius: 4px;
        background: i == current ? G.ink : (sa.has-hover ? G.node-hover : transparent);
        Text { text: it; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.2px; color: i == current ? #1C1D21 : G.dim; horizontal-alignment: center; vertical-alignment: center; }
        sa := TouchArea { clicked => { root.picked(i); } mouse-cursor: pointer; }
    }
}

