// Общие детали «Системы G»: нода с цветной шапкой, сокет, кнопка, моно-подпись.
import { G } from "theme.slint";

import { Icon } from "icons.slint";
export { Icon }

export component Mono inherits Text {
    font-family: G.mono;
    font-size: 11px;
    letter-spacing: 1.2px;
    color: G.muted;
}

// Гнездо и провод — единые правила docs/design-g-wires.md (п.25).
// Гнездо: квадрат 10×10, скругление 3. Полное (выход) — заливка цветом источника, обводка GROUND;
// пустое (ring, вход или необязательная связь) — заливка GROUND, обводка цветом источника.
export component Socket inherits Rectangle {
    in property <color> hue: G.line-strong;
    in property <bool> ring: true;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: ring ? #191A1E : hue;
    border-width: 1.5px;
    border-color: ring ? hue : #191A1E;
}

// Провод: безье M x1 y1 C x1+k y1, x2-k y2, x2 y2, толщина 1.5, цвет источника.
// Координаты — в единицах viewbox (обычно 1 = 1 px слоя, где рисуются провода).
export component Wire inherits Path {
    in property <float> x1;
    in property <float> y1;
    in property <float> x2;
    in property <float> y2;
    in property <float> k: 10;
    in property <color> hue: G.accent;
    stroke: hue;
    stroke-width: 1.5px;
    commands: "M " + x1 + " " + y1 + " C " + (x1 + k) + " " + y1 + " " + (x2 - k) + " " + y2 + " " + x2 + " " + y2;
}

// Нода: шапка «NN · НАЗВАНИЕ» на заливке, тело — содержимое. main — главная нода (крупнее, скобки по углам).
export component Node inherits Rectangle {
    in property <string> num;
    in property <string> title;
    in property <string> aside;
    in property <color> head: #3D3E45;
    in property <bool> main;
    background: G.node;
    border-radius: main ? G.r-main : G.r-node;
    border-width: 1px;
    border-color: main ? G.accent-line : G.line;
    clip: true;
    VerticalLayout {
        Rectangle {
            height: main ? 38px : 30px;
            background: head;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: num + " · " + title;
                    font-family: G.mono;
                    font-size: main ? 13px : 11px;
                    font-weight: 600;
                    letter-spacing: 1.4px;
                    color: #ffffff;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle { }
                Text {
                    text: aside;
                    font-family: G.mono;
                    font-size: 11px;
                    color: #FFFFFFE6;
                    vertical-alignment: center;
                    width: min(self.preferred-width, (parent.width - 40px) / 2);
                    overflow: elide;
                }
            }
        }
        @children
    }
}

// Уголки-скобки главной ноды.
export component Brackets inherits Rectangle {
    in property <color> c: G.accent;
    out property <length> k: 14px;
    Path { x: -5px; y: -5px; width: root.k; height: root.k; commands: "M 0.75 14 A 13.25 13.25 0 0 1 14 0.75"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
    Path { x: root.width - root.k + 5px; y: -5px; width: root.k; height: root.k; commands: "M 0 0.75 A 13.25 13.25 0 0 1 13.25 14"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
    Path { x: -5px; y: root.height - root.k + 5px; width: root.k; height: root.k; commands: "M 0.75 0 A 13.25 13.25 0 0 0 14 13.25"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
    Path { x: root.width - root.k + 5px; y: root.height - root.k + 5px; width: root.k; height: root.k; commands: "M 13.25 0 A 13.25 13.25 0 0 1 0 13.25"; stroke: c; stroke-width: 1.5px; viewbox-width: 14; viewbox-height: 14; }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 34px;
    preferred-height: 34px;
    min-width: label.preferred-width + 28px;
    border-radius: G.r-btn;
    background: primary ? (ta.has-hover ? G.accent-ink : G.accent) : (ta.has-hover ? G.node-hover : G.node);
    border-width: primary ? 0 : 1px;
    border-color: G.line;
    animate background { duration: G.fast; }
    label := Text {
        text: root.text;
        font-family: G.sans;
        font-size: 14px;
        font-weight: 500;
        color: primary ? G.on-accent : G.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Таблетка-переключатель (фильтры, части дня, варианты).
export component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <color> hue: G.accent;
    callback clicked;
    height: 26px;
    preferred-height: 26px;
    min-width: pt.preferred-width + 20px;
    border-radius: 13px;
    background: on ? hue.transparentize(0.78) : (pa.has-hover ? G.node-hover : transparent);
    border-width: 1px;
    border-color: on ? hue : G.line;
    animate background, border-color { duration: G.fast; }
    pt := Text { text: root.text; font-size: 12px; color: on ? G.ink : G.muted; horizontal-alignment: center; vertical-alignment: center; }
    pa := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Сегмент «Неделя | Месяц»: подписи через «|».
export component Seg inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback picked(int);
    height: 28px;
    preferred-height: 28px;
    border-radius: G.r-btn;
    border-width: 1px;
    border-color: G.line;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for it[i] in items: Rectangle {
            min-width: st.preferred-width + 20px;
            border-radius: 4px;
            background: i == current ? G.accent-wash : (sa.has-hover ? G.node-hover : transparent);
            st := Text { text: it; font-family: G.mono; font-size: 11px; letter-spacing: 1px; color: i == current ? G.accent-ink : G.muted; horizontal-alignment: center; vertical-alignment: center; }
            sa := TouchArea { clicked => { root.picked(i); } mouse-cursor: pointer; }
        }
    }
}

// Круглая отметка «сделано».
export component Check inherits Rectangle {
    in property <bool> done;
    in property <color> hue: G.accent;
    callback toggled;
    width: 18px;
    height: 18px;
    preferred-height: 18px;
    border-radius: 9px;
    border-width: 1.5px;
    border-color: done ? hue : (ca.has-hover ? G.ink : G.line-strong);
    background: done ? hue : transparent;
    animate background, border-color { duration: G.fast; }
    Icon { name: "check"; width: 11px; x: (parent.width - 11px) / 2; y: (parent.height - 11px) / 2; visible: done; c: G.on-accent; stroke-width: 2.2px; }
    ca := TouchArea { clicked => { root.toggled(); } mouse-cursor: pointer; }
}

// Маленькая кнопка-значок (иконка из icons.slint: "close", "prev", "next", "more"…).
// Подсказка при наведении: ставится внутрь кнопки, всплывает под ней через полсекунды.
export component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    property <bool> shown;
    Timer { interval: 450ms; running: root.on && root.text != "" && !root.shown; triggered => { pw.show(); root.shown = true; } }
    changed on => { if (!root.on && root.shown) { pw.close(); root.shown = false; } }
    pw := PopupWindow {
        close-policy: no-auto-close;
        x: (root.width - self.width) / 2; y: root.height + 6px; width: tl.preferred-width + 16px; height: 24px;
        Rectangle {
            border-radius: 6px; background: #111215; border-width: 1px; border-color: G.line-strong;
            tl := Text { text: root.text; font-size: 12px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> on;
    out property <bool> hover: ia.has-hover;
    callback clicked;
    width: 28px;
    height: 28px;
    preferred-height: 28px;
    border-radius: G.r-btn;
    background: on ? G.accent-wash : (ia.has-hover ? G.node-hover : transparent);
    Icon { name: root.icon; width: 14px; x: (parent.width - 14px) / 2; y: (parent.height - 14px) / 2; c: on ? G.accent-ink : (ia.has-hover ? G.ink : G.muted); }
    ia := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    Tip { text: root.tip; on: ia.has-hover; }
}

// Ссылка-текст.
export component Link inherits Text {
    callback clicked;
    color: la.has-hover ? G.accent-ink : G.accent;
    font-size: 13px;
    la := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Поле ввода в стиле G (без системной рамки).
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    in property <length> font-size: 14px;
    in property <bool> mono;
    in property <bool> bare;
    in property <color> ink: G.ink;
    callback accepted(string);
    callback edited(string);
    callback escape();
    callback shift-enter(string);
    // arrows: ↑/↓ не двигают курсор, а уходят наверх (выбор в списке под полем)
    in property <bool> arrows;
    callback up();
    callback down();
    out property <bool> focused: ti.has-focus;
    public function grab() { ti.focus(); }
    public function clear() { ti.text = ""; }
    height: 34px;
    preferred-height: 34px;
    border-radius: G.r-btn;
    background: bare ? transparent : G.bg;
    border-width: bare ? 0 : 1px;
    border-color: ti.has-focus ? G.accent-line : G.line;
    clip: true;
    Text {
        x: bare ? 0 : 10px;
        text: placeholder;
        visible: ti.text == "";
        color: G.dim;
        font-size: root.font-size;
        font-family: mono ? G.mono : G.sans;
        vertical-alignment: center;
        height: parent.height;
    }
    ti := TextInput {
        x: bare ? 0 : 10px;
        width: parent.width - (bare ? 0 : 20px);
        height: parent.height;
        color: root.ink;
        font-size: root.font-size;
        font-family: mono ? G.mono : G.sans;
        vertical-alignment: center;
        selection-background-color: G.accent-line;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.escape(); return accept; }
            if (e.text == Key.Return && e.modifiers.shift) { root.shift-enter(self.text); return accept; }
            if (root.arrows && e.text == Key.UpArrow) { root.up(); return accept; }
            if (root.arrows && e.text == Key.DownArrow) { root.down(); return accept; }
            reject
        }
    }
}

// Затемнение и окно поверх всего (диалоги, Настройки).
// Правило «клик мимо» — одно на все окна поверх: клик по пустому месту вокруг окна зовёт dismiss.
// Окно берёт то, что в нём набрано, и сохраняет, если это можно сохранить (у задачи есть название,
// время понятно…); нельзя — просто закрывается, ничего не создав. Esc и ✕ — close: закрыть без сохранения.
// Окну, где всё и так сохраняется сразу, dismiss задавать не нужно — он сам зовёт close.
// Выпадашки внутри окон делают так же: ловушка «клик мимо» — Catch.
// Окно поверх: фон темнеет 180 мс, окно проявляется и вырастает 0.96 → 1 за 220 мс (каталог G_Motion,
// «Окно «Создать», окно задачи»). «Минимум» — только проявление 120 мс, «выкл» — сразу.
// win-pop: false — у окна своя анимация (поиск, настройки).
export component Overlay inherits Rectangle {
    callback close;
    callback dismiss;
    in property <bool> win-pop: true;
    out property <bool> shown;
    dismiss => { root.close(); }
    background: root.shown || G.motion == 2 ? #0009 : #0000;
    animate background { duration: G.motion == 2 ? 0ms : 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Timer { interval: 1ms; running: !root.shown; triggered => { root.shown = true; } }
    TouchArea { clicked => { root.dismiss(); } }
    Rectangle {
        opacity: !root.win-pop || root.shown || G.motion == 2 ? 1 : 0;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: !root.win-pop || root.shown || G.motion != 0 ? 1 : 0.96;
        transform-scale-y: !root.win-pop || root.shown || G.motion != 0 ? 1 : 0.96;
        animate opacity { duration: G.motion == 2 ? 0ms : G.motion == 1 ? 120ms : 220ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate transform-scale-x, transform-scale-y { duration: G.motion == 0 ? 220ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        @children
    }
}

// Выпадающий список, меню, выбор месяца: раскрывается от кнопки (каталог G_Motion — «Меню, выпадающие
// списки»): проявление + рост 0.96 → 1 от края у кнопки, 160 мс. up — список над кнопкой (растёт вверх),
// from-right — привязан к правому краю. «Минимум» — только проявление 120 мс, «выкл» — сразу.
// Ставится вместо Rectangle у `if открыто: Pop { … }` — всё остальное как у Rectangle.
export component Pop inherits Rectangle {
    in property <bool> up;
    in property <bool> from-right;
    property <bool> shown;
    property <bool> moves: G.motion == 0;
    opacity: root.shown || G.motion == 2 ? 1 : 0;
    transform-origin: { x: root.from-right ? self.width : 0px, y: root.up ? self.height : 0px };
    transform-scale-x: root.shown || !root.moves ? 1 : 0.96;
    transform-scale-y: root.shown || !root.moves ? 1 : 0.9;
    animate opacity { duration: G.motion == 2 ? 0ms : G.motion == 1 ? 120ms : 160ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate transform-scale-x, transform-scale-y { duration: root.moves ? 180ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // первый кадр — свёрнутое, потом раскрывается
    Timer { interval: 1ms; running: !root.shown; triggered => { root.shown = true; } }
}

// Ловушка «клик мимо» для выпадашек и форм без затемнения: прозрачная, на весь экран вокруг родителя.
// Ставится перед самой выпадашкой; clicked — сохранить набранное (если можно) и закрыть.
export component Catch inherits TouchArea {
    x: -4000px; y: -4000px; width: 8000px; height: 8000px;
}

// Знак спутника вместо енота: ядро на орбите в круглой плашке; цвет — по состоянию.
export component Sat inherits Rectangle {
    in property <color> c: G.accent;
    width: 46px; height: 46px;
    border-radius: self.width / 2;
    background: #1C1D21;
    border-width: 1px; border-color: #3A3B42;
    property <float> k: self.width / 46px;
    property <angle> a: animation-tick() / 8s * 360deg;
    Rectangle { x: (parent.width - 28px * k) / 2; y: self.x; width: 28px * k; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #55575F; }
    Rectangle { x: (parent.width - 8px * k) / 2; y: self.x; width: 8px * k; height: self.width; border-radius: self.width / 2; background: G.ink; }
    Rectangle {
        width: 7px * k; height: self.width; border-radius: self.width / 2; background: root.c;
        x: parent.width / 2 + 14px * k * cos(root.a) - self.width / 2;
        y: parent.height / 2 + 14px * k * sin(root.a) - self.height / 2;
    }
}

// Пустое место со знаком спутника.
export component Empty inherits VerticalLayout {
    in property <string> text;
    in property <string> pose: "sleep";
    alignment: center;
    spacing: 10px;
    HorizontalLayout { alignment: center; Sat { width: 50px; height: 50px; c: pose == "cheer" ? G.green : pose == "oops" ? G.red : pose == "think" || pose == "flag" ? G.gold : pose == "sleep" ? #7C7E88 : G.accent; } }
    Text { text: root.text; color: G.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
}

// Пунктирная рамка (Slint не рисует пунктир сам): штрихи 4 px через 3 px.
export component DashBox inherits Rectangle {
    in property <color> c: G.line-strong;
    in property <length> dash: 4px;
    property <int> nx: floor(self.width / (root.dash + 3px));
    property <int> ny: floor(self.height / (root.dash + 3px));
    for i in root.nx: Rectangle { x: i * (root.dash + 3px) + 2px; y: 0; width: root.dash; height: 1px; background: root.c; }
    for i in root.nx: Rectangle { x: i * (root.dash + 3px) + 2px; y: root.height - 1px; width: root.dash; height: 1px; background: root.c; }
    for i in root.ny: Rectangle { y: i * (root.dash + 3px) + 2px; x: 0; height: root.dash; width: 1px; background: root.c; }
    for i in root.ny: Rectangle { y: i * (root.dash + 3px) + 2px; x: root.width - 1px; height: root.dash; width: 1px; background: root.c; }
    @children
}

// Штриховка сжатых часов: косые штрихи.
export component Hatch inherits Rectangle {
    in property <color> c: #ffffff10;
    clip: true;
    for i in floor(self.width / 6px): Rectangle { x: i * 6px; y: 0; width: 2px; height: root.height; background: root.c; }
}

// Сегмент G: выбранное — светлая заливка с тёмным текстом.
export component CSeg inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback picked(int);
    height: 32px;
    preferred-height: 32px;
    width: 128px;
    border-radius: 6px;
    border-width: 1px;
    border-color: G.line;
    // выбранное — одна светлая плашка, она переезжает к новому пункту (при «минимум» и «выкл» — сразу)
    Rectangle {
        x: 3px + root.current * (root.width - 6px) / max(1, root.items.length);
        y: 3px;
        width: (root.width - 6px) / max(1, root.items.length);
        height: root.height - 6px;
        border-radius: 4px;
        background: G.ink;
        visible: root.current >= 0 && root.current < root.items.length;
        animate x { duration: G.motion == 0 ? 180ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    for it[i] in items: Rectangle {
        x: 3px + i * (root.width - 6px) / items.length;
        y: 3px;
        width: (root.width - 6px) / items.length;
        height: root.height - 6px;
        border-radius: 4px;
        background: i != current && sa.has-hover ? G.node-hover : transparent;
        Text {
            text: it; font-family: G.mono; font-size: 10px; font-weight: 600; letter-spacing: 1.2px;
            color: i == current ? #1C1D21 : G.dim; horizontal-alignment: center; vertical-alignment: center;
            animate color { duration: G.motion == 2 ? 0ms : 120ms; }
        }
        sa := TouchArea { clicked => { root.picked(i); } mouse-cursor: pointer; }
    }
}


// Переключатель «Системы G» с пунктами разной ширины (КАНБАН | КОНВЕЙЕР | СТИКЕРЫ | СПИСОК и т.п.):
// выбранное — одна светлая плашка, она переезжает к новому пункту и меняет ширину, 200 мс.
// «Минимум» и «выкл» — сразу. Пункт сам сообщает плашке своё место (put), когда он выбран или сдвинулся.
export component GSeg inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <length> fs: 10.5px;
    in property <int> weight: 500;
    in property <length> pad: 3px;       // поля вокруг пунктов
    in property <length> ir: 5px;        // скругление плашки
    in property <length> min-item: 0px;
    callback picked(int);
    property <length> px;
    property <length> pw;
    property <bool> ready;
    height: 34px;
    width: gl.preferred-width;
    border-radius: 8px;
    border-width: 1px;
    border-color: G.line;
    // первое место плашки — без анимации
    Timer { interval: 60ms; running: !root.ready; triggered => { root.ready = true; } }
    Rectangle {
        x: root.px; y: root.pad; width: root.pw; height: root.height - 2 * root.pad;
        border-radius: root.ir;
        background: G.ink;
        visible: root.pw > 0 && root.current >= 0 && root.current < root.items.length;
        animate x, width { duration: root.ready && G.motion == 0 ? 200ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    gl := HorizontalLayout {
        padding: root.pad;
        padding-left: root.pad + 1px; padding-right: root.pad + 1px;
        spacing: 2px;
        for v[i] in root.items: Rectangle {
            property <bool> on: i == root.current;
            function put() { if (self.on) { root.px = self.x; root.pw = self.width; } }
            init => { self.put(); }
            changed on => { self.put(); }
            changed x => { self.put(); }
            changed width => { self.put(); }
            width: max(root.min-item, t.preferred-width + 20px);
            border-radius: root.ir;
            // пока плашка не нашла место — подсвечен сам пункт
            background: self.on ? (root.pw > 0 ? transparent : G.ink) : (a.has-hover ? G.node-hover : transparent);
            t := Text {
                text: v; font-family: G.mono; font-size: root.fs; font-weight: root.weight; letter-spacing: 1.2px;
                color: parent.on ? #1C1D21 : #A3A5AE; horizontal-alignment: center; vertical-alignment: center;
                animate color { duration: G.motion == 2 ? 0ms : 120ms; }
            }
            a := TouchArea { clicked => { root.picked(i); } mouse-cursor: pointer; }
        }
    }
}

// Стрелка выпадающего списка (символ ▾ есть не во всех шрифтах Windows).
export component Chev inherits Path {
    in property <color> c: #A3A5AE;
    in property <bool> up;
    width: 10px; height: 10px;
    viewbox-width: 10; viewbox-height: 10;
    fill: transparent; stroke: root.c; stroke-width: 1.5px; stroke-line-cap: round; stroke-line-join: round;
    // открыто — стрелка плавно поворачивается вверх
    commands: "M2 3.5 L5 6.5 L8 3.5";
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-rotation: root.up ? 180deg : 0deg;
    animate transform-rotation { duration: G.motion == 0 ? 180ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
}

// Многострочный ввод, который не растёт за рамку: текст прокручивается внутри (колесо и за курсором).
// Правило раскладки §1 (docs/layout.md): всё, что может переполниться, — прокрутка внутри своего места.
export component ScrollInput inherits Flickable {
    in-out property <string> text <=> ti.text;
    in property <length> font-size: 12.5px;
    in property <color> ink: G.ink;
    out property <bool> focused: ti.has-focus;
    callback edited(string);
    callback escape();
    in property <bool> enter-grab;   // Enter забирает подсказка (например, «[[» — выбрать ссылку)
    callback enter();
    public function grab() { ti.focus(); }
    public function to-end() { ti.set-selection-offsets(ti.text.character-count * 4, ti.text.character-count * 4); }
    viewport-height: max(self.height, ti.preferred-height + 4px);
    viewport-width: self.width;
    ti := TextInput {
        x: 0; y: 0; width: root.width; height: max(root.height, self.preferred-height + 4px);
        font-size: root.font-size; color: root.ink;
        single-line: false; wrap: word-wrap;
        selection-background-color: G.accent.with-alpha(0.4); selection-foreground-color: #FFFFFF;
        edited => { root.edited(self.text); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.escape(); return accept; }
            if (e.text == Key.Return && root.enter-grab) { root.enter(); return accept; }
            reject
        }
        // курсор всегда виден
        cursor-position-changed(p) => {
            if (p.y + root.viewport-y < 0) { root.viewport-y = -p.y; }
            if (p.y + root.font-size * 1.6 + root.viewport-y > root.height) { root.viewport-y = root.height - p.y - root.font-size * 1.6; }
        }
    }
}

// п.29: одна полоса прокрутки на всё приложение. Без стрелок, дорожка 6 px, ползунок от 32 px,
// видна, только когда содержимое не помещается. Заменяет ScrollView из std-widgets.
component Bar inherits Rectangle {
    in property <bool> vertical;
    in property <length> track;      // длина дорожки
    in property <length> view;       // видимая часть
    in property <length> full;       // всё содержимое
    in-out property <length> pos;    // сдвиг содержимого (<= 0)
    property <length> thumb: max(32px, track * view / max(1px, full));
    property <length> room: max(1px, full - view);
    property <length> at: (track - thumb) * min(1, max(0, -pos / room));
    border-radius: 3px;
    background: #ffffff0a;
    Rectangle {
        x: root.vertical ? 0 : root.at; y: root.vertical ? root.at : 0;
        width: root.vertical ? parent.width : root.thumb; height: root.vertical ? root.thumb : parent.height;
        border-radius: 3px;
        background: ta.has-hover || ta.pressed ? #8A8C96 : #6E7079;
        ta := TouchArea {
            property <length> start;
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.start = root.pos; } }
            moved => {
                if (self.pressed) {
                    let d = root.vertical ? self.mouse-y - self.pressed-y : self.mouse-x - self.pressed-x;
                    root.pos = max(-root.room, min(0, self.start - d * root.room / max(1px, root.track - root.thumb)));
                }
            }
        }
    }
}

export component ScrollView inherits Rectangle {
    in-out property <length> viewport-width <=> f.viewport-width;
    in-out property <length> viewport-height <=> f.viewport-height;
    in-out property <length> content-width <=> f.viewport-width;
    in-out property <length> content-height <=> f.viewport-height;
    in-out property <length> viewport-x <=> f.viewport-x;
    in-out property <length> viewport-y <=> f.viewport-y;
    out property <length> visible-width: f.width;
    out property <length> visible-height: f.height;
    in property <bool> mouse-drag-pan-enabled: false;
    f := Flickable {
        x: 0; y: 0; width: root.width; height: root.height;
        interactive: root.mouse-drag-pan-enabled;
        @children
    }
    if f.viewport-height > f.height + 1px: Bar {
        vertical: true;
        x: root.width - 10px; y: 4px; width: 6px; height: root.height - 8px;
        track: self.height; view: f.height; full: f.viewport-height;
        pos <=> f.viewport-y;
    }
    if f.viewport-width > f.width + 1px: Bar {
        x: 4px; y: root.height - 10px; height: 6px; width: root.width - 8px - (f.viewport-height > f.height + 1px ? 10px : 0);
        track: self.width; view: f.width; full: f.viewport-width;
        pos <=> f.viewport-x;
    }
}

// Строка выпадающего списка «название слева — подпись справа» (список и его сфера, привычка и счёт…).
// Подпись занимает свою ширину, но не больше 40% строки (если название короткое — сколько свободно);
// название обрезается многоточием и никогда не заходит под подпись. Длинная подпись тоже с многоточием.
export component LabelHint inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <color> label-color: G.ink;
    in property <color> hint-color: #7A7C86;
    in property <length> label-size: 12.5px;
    in property <length> hint-size: 11px;
    in property <int> label-weight: 400;
    in property <bool> mono;
    in property <length> hint-spacing: 0px;
    property <length> gap: root.hint == "" ? 0px : 10px;
    property <length> hw: root.hint == "" ? 0px : min(hn.preferred-width, max(root.width * 0.4, root.width - lb.preferred-width - root.gap));
    lb := Text {
        x: 0; y: 0; width: max(0px, root.width - root.hw - root.gap); height: root.height;
        text: root.label; color: root.label-color; font-size: root.label-size; font-weight: root.label-weight;
        vertical-alignment: center; overflow: elide;
    }
    hn := Text {
        x: root.width - root.hw; y: 0; width: root.hw; height: root.height;
        text: root.hint; color: root.hint-color; font-size: root.hint-size; letter-spacing: root.hint-spacing;
        font-family: root.mono ? G.mono : "";
        horizontal-alignment: right; vertical-alignment: center; overflow: elide;
    }
}

// Полоса скачивания обновления. frac 0…1 — заполнение плавно догоняет; frac < 0 (размер неизвестен
// или идёт установка) — бегущий отрезок. «Анимации: выкл» — отрезок стоит на месте.
export component UpdBar inherits Rectangle {
    in property <float> frac;
    in property <string> text;
    height: 30px;
    property <bool> run: root.frac < 0;
    property <float> t: G.motion == 2 ? 0.35 : mod(animation-tick() / 1400ms, 1.0);
    track := Rectangle {
        y: 0; height: 6px; border-radius: 3px; background: G.line; clip: true;
        if !root.run: Rectangle {
            x: 0; height: parent.height; border-radius: 3px; background: G.accent;
            width: parent.width * root.frac;
            animate width { duration: G.mid; easing: ease-out; }
        }
        if root.run: Rectangle {
            height: parent.height; border-radius: 3px; background: G.accent;
            width: parent.width * 0.3;
            x: (parent.width * 1.3) * root.t - self.width;
        }
    }
    Text { y: 12px; text: root.text; font-family: G.mono; font-size: 10.5px; letter-spacing: 0.6px; color: #A3A5AE; overflow: elide; width: parent.width; }
}

// Ошибка обновления: что случилось и что сделать, с красной чертой слева; появляется проявлением.
export component UpdFail inherits Rectangle {
    in property <string> what;
    in property <string> hint;
    property <bool> shown;
    height: fl.preferred-height;
    opacity: root.shown || G.motion == 2 ? 1 : 0;
    animate opacity { duration: G.mid; easing: ease-out; }
    Timer { interval: 1ms; running: !root.shown; triggered => { root.shown = true; } }
    Rectangle { x: 0; width: 2px; background: G.red; border-radius: 1px; }
    fl := VerticalLayout {
        x: 12px; width: parent.width - 12px;
        spacing: 3px;
        Text { text: root.what; color: G.ink; font-size: 13px; font-weight: 500; wrap: word-wrap; }
        Text { text: root.hint; color: #A3A5AE; font-size: 12px; wrap: word-wrap; }
    }
}
