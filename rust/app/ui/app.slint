// Главное окно Спутника: шапка с вкладками, разделы, плашка внизу и окна поверх.
// Вся логика — в Rust (src/view, src/state); окно только показывает модели из глобала S.
import { G } from "theme.slint";
import { Mono, Button, Node, Brackets, Empty, IconBtn, Icon, ScrollView, Tip, Pop, UpdBar, UpdFail } from "kit.slint";
import { S } from "store.slint";
import { TodayPage } from "today.slint";
import { BoardPage } from "board.slint";
import { CalendarPage } from "calendar.slint";
import { HabitsPage } from "habits.slint";
import { SettingsWin } from "settings.slint";
import { NotesPage } from "notes.slint";
import { CreateDialog, SearchDialog, Confirm } from "dialogs.slint";
import { HabitEditDialog } from "habitedit.slint";
import { DatePicker } from "datetime.slint";
import { ListSettings } from "listset.slint";
import { CtxMenu } from "menu.slint";
import { Templates } from "templates.slint";
import { TaskDialog } from "taskwin.slint";
export { S }
export { G }

component Tab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <int> count;
    // узкое окно: только значок (и число)
    in property <bool> short;
    callback clicked;
    width: hl.preferred-width;
    hl := HorizontalLayout {
        spacing: 7px;
        if icon != "": Rectangle { width: 13px; Icon { name: icon; width: 13px; height: 13px; y: (parent.height - 13px) / 2; c: active || ta.has-hover ? G.ink : #8A8C96; } }
        if !short || count > 0: Text {
            text: short ? count + "" : root.text + (count > 0 ? " · " + count : "");
            font-family: G.mono;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 1.5px;
            color: active || ta.has-hover ? G.ink : #8A8C96;
            vertical-alignment: center;
        }
    }
    // активная вкладка сообщает, где она: общая черта под вкладками плавно едет к ней (как плашка в «Создать»)
    if active: Rectangle {
        property <length> ax: root.absolute-position.x;
        property <length> ay: root.absolute-position.y + root.height / 2 + 10px;
        property <length> aw: root.width;
        init => { S.ul-x = ax; S.ul-y = ay; S.ul-w = aw; }
        changed ax => { S.ul-x = ax; }
        changed ay => { S.ul-y = ay; }
        changed aw => { S.ul-w = aw; }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

export component AppWindow inherits Window {
    title: @tr("Спутник");
    no-frame: true;
    preferred-width: 1360px;
    preferred-height: 860px;
    // при масштабе Windows 125–150 % экран ноутбука в логических точках — около 1090×580:
    // окно должно влезать, а разделы — прокручиваться (держать в лад с set_min_size в view/wire.rs)
    min-width: 960px;
    min-height: 540px;
    // шапка ужимается по ширине окна, чтобы кнопки окна справа никогда не обрезались:
    // < 1440 — «Найти» и обновление без подписей, время прячется; < 1240 — вкладки только значками
    // (через changed, а не привязку: иначе ширина шапки и ширина окна зависят друг от друга по кругу)
    property <bool> hd-compact: false;
    property <bool> hd-tight: false;
    changed width => {
        self.hd-compact = self.width < 1440px;
        self.hd-tight = self.width < 1240px;
    }

    background: G.ground;
    default-font-family: G.sans;
    icon: @image-url("../../assets/icon/sputnik.png");

    // имена и иконки разделов по id (0 Сегодня · 1 Календарь · 2 Доска · 3 Привычки · 4 Знания)
    // смена раздела (каталог G_Motion): новый раздел въезжает на 12 px со стороны направления и проявляется,
    // 220 мс. «Минимум» — только проявление 120 мс, «выкл» — сразу.
    property <int> pg-tab: S.tab;
    property <int> pg-seen: -1;
    property <bool> pg-snap;
    property <length> pg-off;
    property <float> pg-op: 1;
    animate pg-off, pg-op { duration: root.pg-snap ? 0ms : (G.motion == 2 ? 0ms : G.motion == 1 ? 120ms : 220ms); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    changed pg-tab => {
        if (G.motion != 2 && root.pg-seen >= 0 && root.pg-tab != root.pg-seen) {
            root.pg-snap = true;
            root.pg-op = 0;
            root.pg-off = G.motion == 0 ? (root.pg-tab > root.pg-seen ? 12px : -12px) : 0px;
            tpg.running = true;
        }
        root.pg-seen = root.pg-tab;
    }
    tpg := Timer { interval: 1ms; running: false; triggered => { self.running = false; root.pg-snap = false; root.pg-off = 0; root.pg-op = 1; } }
    property <[string]> tab-names: [@tr("СЕГОДНЯ"), @tr("КАЛЕНДАРЬ"), @tr("ДОСКА"), @tr("ПРИВЫЧКИ"), @tr("ЗНАНИЯ")];
    property <[string]> tab-icons: ["today", "calendar", "board", "habits", "notes"];

    // Холст: точки 1 px через 24 px.
    Image { width: 100%; height: 100%; source: @image-url("dot.svg"); horizontal-tiling: repeat; vertical-tiling: repeat; }

    // соседняя вкладка по порядку пользователя (Q/E), по кругу; из настроек — к краю
    function tab-near(d: int) -> int {
        let o = S.tab-order;
        let n = o.length;
        let i = o[0] == S.tab ? 0 : o[1] == S.tab ? 1 : o[2] == S.tab ? 2 : o[3] == S.tab ? 3 : o[4] == S.tab ? 4 : -1;
        if (n == 0) { return S.tab; }
        if (i < 0) { return d < 0 ? o[n - 1] : o[0]; }
        return o[Math.mod(i + d + n, n)];
    }
    keys := FocusScope {
        // Ctrl зажат или нет — для перехода по ссылкам Ctrl+кликом
        capture-key-pressed(e) => { if (e.text == Key.Control) { S.ctrl-held = true; } reject }
        capture-key-released(e) => { if (e.text == Key.Control) { S.ctrl-held = false; } reject }
        key-pressed(e) => {
            if (S.task-open || S.create-open || S.search-open || S.confirm != "" || S.ls-open || S.dp-open || S.menu-open || S.tp-open) {
                if (e.text == Key.Escape && S.dp-open) { S.dp-cancel(); return accept; }
                // меню сферы: Enter — править, Ctrl+E — в архив (п.40)
                if (S.menu-open && S.menu-head.alpha > 0 && e.text == Key.Return) { S.menu-pick("sph-edit"); return accept; }
                if (S.menu-open && S.menu-head.alpha > 0 && e.modifiers.control && (e.text == "e" || e.text == "у" || e.text == "\u{05}")) { S.menu-pick("sph-arch"); return accept; }
                if (e.text == Key.Escape) { S.t-close(); S.c-close(); S.search-open-set(false); S.confirm-no(); S.ls-close(); S.dp-cancel(); S.menu-close(); S.tp-close(); S.card-key("esc"); return accept; }
                return reject;
            }
            // Окно настроек: цифры 1–6 и ↑↓ — его разделы (вкладки шапки в это время цифрами не переключаются),
            // Esc и Ctrl+, — закрыть, Ctrl+K и / — «Найти настройку». Остальные клавиши разделов молчат.
            if (S.set-open) {
                if (e.text == Key.Escape) { S.set-close(); return accept; }
                if (e.modifiers.control) {
                    if (e.text == "," || e.text == "б") { S.set-close(); return accept; }
                    if (e.text == "k" || e.text == "л") { S.set-find-focus += 1; return accept; }
                    if (e.text == "w" || e.text == "ц") { S.win-close(); return accept; }
                    return reject;
                }
                if (e.text == "/" || e.text == ".") { S.set-find-focus += 1; return accept; }
                if (!e.modifiers.alt && !e.modifiers.shift && e.text >= "1" && e.text <= "6") { S.set-tab = e.text.to-float() - 1; return accept; }
                if (e.text == Key.DownArrow) { S.set-tab = Math.mod(S.set-tab + 1, 6); return accept; }
                if (e.text == Key.UpArrow) { S.set-tab = Math.mod(S.set-tab + 5, 6); return accept; }
                return reject;
            }
            if (e.modifiers.control) {
                // Ctrl+Shift+L — к поиску списка на доске
                if (e.modifiers.shift && (e.text == "l" || e.text == "L" || e.text == "д" || e.text == "Д" || e.text == "\u{0c}")) { if (S.tab != 2) { S.go(2); } S.list-find += 1; return accept; }
                // Ctrl+Z / Ctrl+Y в открытой заметке (холст ловит их сам, когда в фокусе)
                if (S.tab == 4 && (e.text == "z" || e.text == "Z" || e.text == "я" || e.text == "Я" || e.text == "\u{1a}")) { S.note-undo(e.modifiers.shift); return accept; }
                if (S.tab == 4 && (e.text == "y" || e.text == "Y" || e.text == "н" || e.text == "Н" || e.text == "\u{19}")) { S.note-undo(true); return accept; }
                if (e.text == "k" || e.text == "л") { S.search-open-set(true); return accept; }
                if (e.text == "n" || e.text == "т") { S.create(""); return accept; }
                if (e.text == "," || e.text == "б") { S.go(5); return accept; }
                if ((e.text == "." || e.text == "ю") && S.tab == 2) { S.ls-show(); return accept; }
                if (e.text == "w" || e.text == "ц") { S.win-close(); return accept; }
                if ((e.text == "e" || e.text == "у" || e.text == "\u{05}") && S.tab == 2 && S.sph-open && S.sph-edit != "") { S.sph-archive("sphere", S.sph-edit, true); return accept; }
                return reject;
            }
            if (e.text == Key.Escape && S.tab == 2 && S.sph-open) { if (S.sph-edit != "") { S.sph-show(""); } else { S.sph-close(); } return accept; }
            if (e.text == Key.F5 || e.text == "r" || e.text == "к") { S.refresh(); return accept; }
            if (e.text == "/" || e.text == ".") { S.search-open-set(true); return accept; }
            if (e.text == "n" || e.text == "т") { S.create(""); return accept; }
            if (e.text >= "1" && e.text <= "5" && !e.modifiers.shift) { S.go(S.tab-order[min(4, e.text.to-float() - 1)]); return accept; }
            if (e.text == "q" || e.text == "й") { S.go(root.tab-near(-1)); return accept; }
            if (e.text == "e" || e.text == "у") { S.go(root.tab-near(1)); return accept; }
            if (S.tab == 1) {
                if (e.text == Key.LeftArrow) { S.cal-shift(-1); return accept; }
                if (e.text == Key.RightArrow) { S.cal-shift(1); return accept; }
                if (e.text == "t" || e.text == "е") { S.cal-today(); return accept; }
                if (e.text == "w" || e.text == "ц") { S.cal-mode-set("week"); return accept; }
                if (e.text == "m" || e.text == "ь") { S.cal-mode-set("month"); return accept; }
            }
            if (S.tab == 2) {
                if (e.text == "[" || e.text == "х") { S.pick-list("<"); return accept; }
                if (e.text == "]" || e.text == "ъ") { S.pick-list(">"); return accept; }
                // канбан: ←/→ (A/D) — в соседнюю колонку, ↑/↓ — выбор соседней карточки, Enter — открыть
                if (e.text == Key.LeftArrow || e.text == "a" || e.text == "ф") { S.fly-dir = -1; S.fly-n += 1; S.card-key("left"); return accept; }
                if (e.text == Key.RightArrow || e.text == "d" || e.text == "в") { S.fly-dir = 1; S.fly-n += 1; S.card-key("right"); return accept; }
                if (e.text == Key.UpArrow) { S.card-key("up"); return accept; }
                if (e.text == Key.DownArrow) { S.card-key("down"); return accept; }
                if (e.text == Key.Return) { S.card-key("open"); return accept; }
            }
            // Shift+1…9 — привычки (символы над цифрами в обеих раскладках)
            if (e.modifiers.shift) {
                if (e.text == "!") { S.habit-tap("#1"); return accept; }
                if (e.text == "@" || e.text == "\"") { S.habit-tap("#2"); return accept; }
                if (e.text == "#" || e.text == "№") { S.habit-tap("#3"); return accept; }
                if (e.text == "$" || e.text == ";") { S.habit-tap("#4"); return accept; }
                if (e.text == "%") { S.habit-tap("#5"); return accept; }
            }
            reject
        }

        VerticalLayout {
            // Шапка (макет G_*: знак-орбита, разделы моно-шрифтом, дата, «Найти · CTRL K», светлая «＋ Создать»)
            Rectangle {
                height: 60px;
                background: G.bg;
                // своя рамка окна: тянуть за пустое место шапки, двойной клик — развернуть
                TouchArea {
                    pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { S.win-drag(); } }
                    double-clicked => { S.win-max(); }
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 14px;
                    // знак — буква «С» из орбиты со спутником (как в трекере, Brand.svelte)
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        Rectangle { width: 22px;
                        Rectangle {
                            width: 22px; height: 22px; y: (parent.height - 22px) / 2;
                            Path {
                                width: 22px; height: 22px;
                                viewbox-width: 512; viewbox-height: 512;
                                stroke: G.accent; stroke-width: 2.6px; stroke-line-cap: round;
                                commands: "M 370.9 159.6 A 150 150 0 1 0 370.9 352.4";
                            }
                            Rectangle { x: 11px - 2.7px; y: 11px - 2.7px; width: 5.4px; height: 5.4px; border-radius: 2.7px; background: G.ink; }
                            Rectangle { x: 15.9px - 2.8px; y: 6.9px - 2.8px; width: 5.6px; height: 5.6px; border-radius: 2.8px; background: G.ink; border-width: 1px; border-color: G.bg; }
                        }
                        }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 12px;
                        // порядок разделов настраивается: Настройки → Вид → «Порядок вкладок»
                        for t in S.tab-order: Tab { short: root.hd-tight; text: root.tab-names[t]; icon: root.tab-icons[t]; count: t == 0 ? S.today-count : 0; active: S.tab == t; clicked => { S.go(t); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if S.upd-version != "": Rectangle {
                        width: ut.preferred-width + 24px;
                        height: 32px;
                        y: 14px;
                        // поиск открыт — шапка слева от поля отъезжает и гаснет
                        opacity: S.search-open ? 0 : 1;
                        animate opacity { duration: G.motion == 2 ? 0ms : S.search-open ? 160ms : 120ms; }
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: G.accent-line;
                        background: ua.has-hover ? G.accent-wash : transparent;
                        ut := Text { text: (root.hd-compact ? "" : @tr("ВЕРСИЯ ")) + S.upd-version; font-family: G.mono; font-size: 11px; letter-spacing: 1.4px; color: G.accent-ink; horizontal-alignment: center; vertical-alignment: center; }
                        ua := TouchArea { clicked => { S.upd-toggle(); } mouse-cursor: pointer; }
                        Tip { text: @tr("Есть обновление — открыть"); on: ua.has-hover; }
                    }
                    if !root.hd-compact || S.busy || S.offline: Rectangle {
                        width: st.preferred-width + 16px;
                        opacity: S.search-open ? 0 : 1;
                        animate opacity { duration: G.motion == 2 ? 0ms : S.search-open ? 160ms : 120ms; }
                        st := Text {
                            x: S.search-open && G.motion == 0 ? -18px : 0px;
                            animate x { duration: G.motion == 0 ? 180ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                            text: S.busy ? @tr("СИНХРОНИЗАЦИЯ…") : S.now-label;
                            font-family: G.mono; font-size: 11px; letter-spacing: 1.4px;
                            color: S.offline ? G.red : S.error != "" ? G.gold : #8A8C96;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        sa := TouchArea { clicked => { S.refresh(); } mouse-cursor: pointer; }
                        Tip { text: @tr("Обновить сейчас"); on: sa.has-hover; }
                    }
                    sbox := Rectangle {
                        width: root.hd-compact ? 40px : 172px;
                        height: 32px;
                        y: 14px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: fa.has-hover ? G.line-strong : G.line;
                        Path { x: root.hd-compact ? 13px : 10px; y: 9px; width: 13px; height: 13px; viewbox-width: 24; viewbox-height: 24; stroke: #8A8C96; stroke-width: 1.6px; commands: "M 18 11 A 7 7 0 1 1 4 11 A 7 7 0 1 1 18 11 M 20 20 L 16 16"; }
                        if !root.hd-compact: Text { x: 31px; text: @tr("НАЙТИ"); font-family: G.mono; font-size: 11px; letter-spacing: 1.4px; color: #8A8C96; vertical-alignment: center; }
                        if !root.hd-compact: Text { x: parent.width - self.preferred-width - 10px; text: "CTRL K"; font-family: G.mono; font-size: 10px; letter-spacing: 1.4px; color: #62646E; vertical-alignment: center; }
                        fa := TouchArea { clicked => { S.search-open-set(true); } mouse-cursor: pointer; }
                        Tip { text: @tr("Поиск · Ctrl K"); on: fa.has-hover; }
                    }
                    // «Состояние»: три точки — связь, синхронизация, очередь; клик — Настройки
                    Rectangle {
                        width: 46px;
                        height: 32px;
                        y: 14px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: pa.has-hover ? G.line-strong : G.line;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 5px;
                            Rectangle { width: 6px; height: 6px; y: 13px; border-radius: 3px; background: S.offline ? G.red : G.green; }
                            Rectangle { width: 6px; height: 6px; y: 13px; border-radius: 3px; background: S.busy ? G.accent : S.error != "" ? G.gold : G.green; }
                            Rectangle { width: 6px; height: 6px; y: 13px; border-radius: 3px; background: S.status-ok ? G.green : G.gold; }
                        }
                        pa := TouchArea { clicked => { stat.visible = !stat.visible; } mouse-cursor: pointer; }
                        Tip { text: @tr("Состояние: связь, синхронизация, очередь"); on: pa.has-hover; }
                    }
                    // настройки — отдельной кнопкой
                    Rectangle {
                        width: 40px; height: 32px; y: 14px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: S.set-open ? G.accent-line : (ga.has-hover ? G.line-strong : G.line);
                        Icon { name: "settings"; width: 15px; height: 15px; x: (parent.width - 15px) / 2; y: (parent.height - 15px) / 2; c: S.set-open ? G.accent : G.ink; }
                        ga := TouchArea { clicked => { S.go(5); } mouse-cursor: pointer; }
                        Tip { text: @tr("Настройки"); on: ga.has-hover; }
                    }
                    Rectangle {
                        width: chl.preferred-width + 26px;
                        height: 32px;
                        y: 14px;
                        border-radius: 8px;
                        background: ca.has-hover ? #FFFFFF : G.ink;
                        chl := HorizontalLayout {
                            alignment: center; spacing: 7px;
                            Rectangle { width: 12px; Icon { name: "plus"; width: 12px; height: 12px; y: (parent.height - 12px) / 2; stroke-width: 2px; c: #1C1D21; } }
                            ct := Text { text: @tr("Создать"); font-size: 13px; font-weight: 600; color: #1C1D21; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        ca := TouchArea { clicked => { S.create(""); } mouse-cursor: pointer; }
                        Tip { text: @tr("Создать задачу, список или заметку"); on: ca.has-hover; }
                    }
                    // кнопки окна (G_Window): 34×32, скругление 8, у «Закрыть» — красный при наведении
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 4px;
                        Rectangle { width: 1px; height: 32px; y: 14px; background: G.line; }
                        Rectangle { width: 6px; }
                        for b[i] in ["min", S.win-maxed ? "restore" : "max", "close"]: Rectangle {
                            width: 34px; height: 32px; y: 14px;
                            border-radius: 8px;
                            background: wa.has-hover ? (i == 2 ? #E5484D : #2C2D33) : transparent;
                            Icon { name: b; width: 11px; height: 11px; x: (parent.width - 11px) / 2; y: (parent.height - 11px) / 2; stroke-width: 1.2px; c: wa.has-hover ? #fff : #A3A5AE; }
                            wa := TouchArea { clicked => { if (i == 0) { S.win-min(); } else if (i == 1) { S.win-max(); } else { S.win-close(); } } }
                            Tip { text: i == 0 ? @tr("Свернуть") : i == 1 ? (S.win-maxed ? @tr("Восстановить") : @tr("Развернуть")) : @tr("Закрыть"); on: wa.has-hover; }
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: G.line; }
            }
            if S.offline && S.signed-in: Rectangle {
                height: 26px;
                background: #3A2020;
                Text { text: @tr("Нет связи с Google — правки сохранены здесь и уйдут сами, когда связь вернётся"); color: G.red; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            }
            // Тело
            Rectangle {
                vertical-stretch: 1;
                // клик по пустому месту возвращает клавиши окну (1–5, N, R…)
                TouchArea { clicked => { keys.focus(); } }
                // первый запуск: на маленьком экране или при масштабе 125–150 % — прокрутка, а не обрезка
                if !S.signed-in: fr := ScrollView {
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, st1.y + st1.height + 140px);
                    Rectangle {
                    width: fr.content-width;
                    height: fr.content-height;
                    property <length> mx: 8px;
                    property <length> nw: (self.width - 2 * self.mx - 3 * 42px) / 4;
                    Text { x: parent.mx; y: 14px; text: @tr("Первый запуск"); font-size: 60px; font-weight: 200; color: G.ink; }
                    Text { x: parent.mx; y: 90px; text: @tr("ТРИ ШАГА · ОКОЛО МИНУТЫ · ВСЁ МОЖНО ПОМЕНЯТЬ В НАСТРОЙКАХ"); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #8A8C96; }
                    // 01 · вход и доступы
                    st1 := Rectangle {
                        x: parent.mx; y: 148px; width: parent.nw * 1.4; height: 30px + s1.preferred-height;
                        border-radius: 12px; background: G.node; border-width: 1px; border-color: G.accent-line; clip: true;
                        Rectangle { y: 0; height: 30px; background: G.head-main;
                            Text { x: 12px; text: @tr("01  ВХОД И ДОСТУПЫ"); font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - self.preferred-width - 12px; text: @tr("СЕЙЧАС"); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; } }
                        s1 := VerticalLayout {
                            y: 30px;
                            height: self.preferred-height;
                            padding: 14px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle { width: 44px; height: 44px; border-radius: 22px; border-width: 1px; border-color: #6E7079;
                                    Text { text: @tr("ПРИВЕТ"); font-family: G.mono; font-size: 7.5px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; } }
                                Text { text: @tr("Привет! Я Спутник. Работаю поверх твоих Google Задач и Календаря. Своего сервера нет: всё остаётся в твоём аккаунте."); wrap: word-wrap; color: G.ink; font-size: 13.5px; }
                            }
                            for a in [[@tr("Задачи"), @tr("читать и менять списки и задачи")], [@tr("Календарь"), @tr("показывать события и создавать новые")], [@tr("Контакты"), @tr("дни рождения, только чтение")], [@tr("Скрытая папка Drive"), @tr("слой Спутника для второго компьютера")]]: Rectangle {
                                height: 50px;
                                Rectangle { x: 0; y: 8px; width: 14px; height: 14px; border-radius: 3px; background: #3D3E45; border-width: 1px; border-color: #7C7E88;
                                    Icon { name: "check"; width: 10px; x: 2px; y: 2px; c: G.ink; stroke-width: 2.2px; } }
                                Text { x: 24px; y: 4px; text: a[0]; font-size: 13.5px; font-weight: 600; color: G.ink; }
                                Text { x: 24px; y: 24px; text: a[1]; font-size: 12px; color: #A3A5AE; }
                                Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                            }
                            Text { text: S.error; color: G.red; font-size: 13px; wrap: word-wrap; visible: S.error != ""; }
                            Rectangle {
                                height: 38px; border-radius: 6px;
                                background: S.logging-in ? G.node-hover : (la.has-hover ? G.accent-ink : G.accent);
                                Text { text: S.logging-in ? @tr("Жду ответа в браузере…") : @tr("Продолжить в Google"); font-size: 13.5px; font-weight: 600; color: S.logging-in ? G.ink : G.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                                la := TouchArea { clicked => { if (!S.logging-in) { S.login(); } } mouse-cursor: pointer; }
                            }
                            if S.logging-in: Rectangle {
                                height: 30px;
                                Text { text: @tr("Отмена"); font-size: 13px; color: G.muted; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { S.cancel-login(); } mouse-cursor: pointer; }
                            }
                            Text { text: @tr("GOOGLE ДАЁТ СНЯТЬ ГАЛОЧКИ · БЕЗ ВСЕХ ЧЕТЫРЁХ ВХОД НЕ ЗАСЧИТАЕТСЯ"); font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: #7A7C86; wrap: word-wrap; }
                        }
                    }
                    Brackets { x: st1.x; y: st1.y; width: st1.width; height: st1.height; }
                    // провода
                    Rectangle { x: st1.x + st1.width; y: st1.y + 15px; width: 42px; height: 1.5px; background: G.accent; }
                    Rectangle { x: st1.x + st1.width - 4px; y: st1.y + 11px; width: 9px; height: 9px; border-radius: 3px; background: G.accent; }
                    // 02 · что показывать
                    st2 := Rectangle {
                        x: st1.x + st1.width + 42px; y: 148px; width: parent.nw; height: 30px + s2.preferred-height;
                        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
                        Rectangle { y: 0; height: 30px; background: #3D3E45;
                            Text { x: 12px; text: @tr("02  ЧТО ПОКАЗЫВАТЬ"); font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - self.preferred-width - 12px; text: @tr("ДАЛЬШЕ"); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #FFFFFFE6; vertical-alignment: center; height: parent.height; } }
                        s2 := VerticalLayout {
                            y: 30px; height: self.preferred-height; padding: 14px; spacing: 0;
                            for c[i] in [@tr("Мои задачи"), @tr("Основной календарь"), @tr("Праздники России"), @tr("Дни рождения"), @tr("Рабочий календарь")]: Rectangle {
                                height: 36px;
                                Rectangle { x: 0; y: 11px; width: 14px; height: 14px; border-radius: 3px; border-width: 1px; border-color: #7C7E88; background: i < 3 ? #3D3E45 : transparent;
                                    Icon { name: "check"; width: 10px; x: 2px; y: 2px; visible: i < 3; c: G.ink; stroke-width: 2.2px; } }
                                Text { x: 24px; text: c; font-size: 13.5px; color: G.ink; vertical-alignment: center; height: parent.height; }
                            }
                        }
                    }
                    Rectangle { x: st2.x + st2.width; y: st2.y + 15px; width: 42px; height: 1px; background: #6E7079; }
                    // 03 · готово
                    Rectangle {
                        x: st2.x + st2.width + 42px; y: 148px; width: parent.nw; height: 30px + s3.preferred-height;
                        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line; clip: true;
                        Rectangle { y: 0; height: 30px; background: #3D3E45;
                            Text { x: 12px; text: @tr("03  ГОТОВО"); font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; }
                            Text { x: parent.width - self.preferred-width - 12px; text: @tr("ДАЛЬШЕ"); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #FFFFFFE6; vertical-alignment: center; height: parent.height; } }
                        s3 := VerticalLayout {
                            y: 30px; height: self.preferred-height; padding: 12px; spacing: 0;
                            for h[i] in [@tr("Ctrl N — создать из любого места"), @tr("«Запиши в Спутник» в чате с Claude"), @tr("Сводка дня в Telegram в 8:00")]: Rectangle {
                                height: 27px;
                                Text { x: 0; text: [@tr("А"), @tr("Б"), @tr("В")][i]; font-family: G.mono; font-size: 9px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
                                Text { x: 18px; text: h; font-size: 13px; color: G.ink; vertical-alignment: center; height: parent.height; overflow: elide; width: parent.width - 18px; }
                            }
                        }
                    }
                    // размерная линия
                    Rectangle {
                        x: parent.mx; y: parent.height - 120px; width: parent.width - 2 * parent.mx; height: 12px;
                        Rectangle { x: 0; width: 1px; background: #55575F; }
                        Rectangle { x: parent.width - 1px; width: 1px; background: #55575F; }
                        Rectangle { x: 12px; y: 6px; width: parent.width - 24px; height: 1px; background: #3A3B42; }
                        Rectangle { x: (parent.width - rt.preferred-width) / 2 - 10px; width: rt.preferred-width + 20px; background: G.ground; }
                        rt := Text { x: (parent.width - self.preferred-width) / 2; text: @tr("ВХОД И ДОСТУПЫ → ЧТО ПОКАЗЫВАТЬ → ГОТОВО"); font-family: G.mono; font-size: 9px; letter-spacing: 1.2px; color: #7A7C86; vertical-alignment: center; height: parent.height; }
                    }
                    if S.offline: Rectangle {
                        x: parent.mx; y: parent.height - 90px; width: 520px; height: 40px;
                        border-radius: 6px; border-width: 1px; border-color: #55575F;
                        Rectangle { x: 14px; y: 17px; width: 6px; height: 6px; border-radius: 3px; background: G.red; }
                        Text { x: 28px; text: @tr("НЕТ СВЯЗИ С GOOGLE · ПОВТОРЮ ЧЕРЕЗ МИНУТУ"); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.2px; color: G.red; vertical-alignment: center; height: parent.height; }
                    }
                    }
                }
                Rectangle {
                    x: root.pg-off; y: 0; width: parent.width; height: parent.height;
                    opacity: root.pg-op;
                    if S.signed-in && S.tab == 0: TodayPage { }
                    if S.signed-in && S.tab == 1: CalendarPage { }
                    if S.signed-in && S.tab == 2: BoardPage { }
                    if S.signed-in && S.tab == 3: HabitsPage { }
                    if S.signed-in && S.tab == 4: NotesPage { }
                }
            }
        }

        // Плашка
        // плашка въезжает снизу на 12 px и проявляется, 180 мс
        if S.toast != "": Rectangle {
            property <bool> in-place;
            Timer { interval: 1ms; running: !parent.in-place; triggered => { parent.in-place = true; } }
            opacity: self.in-place || G.motion == 2 ? 1 : 0;
            animate opacity { duration: G.motion == 2 ? 0ms : G.motion == 1 ? 120ms : 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            x: (parent.width - self.width) / 2;
            y: parent.height - 64px + (self.in-place || G.motion != 0 ? 0px : 12px);
            animate y { duration: G.motion == 0 ? 180ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            width: min(tr.preferred-width + 32px, parent.width - 32px);
            height: 40px;
            border-radius: G.r-node;
            background: G.node-hover;
            border-width: 1px;
            border-color: G.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0009;
            tr := HorizontalLayout {
                x: 16px;
                width: parent.width - 32px;
                spacing: 14px;
                Text { text: S.toast; color: G.ink; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                if S.toast-label != "": Text {
                    text: S.toast-label;
                    color: G.accent;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    TouchArea { clicked => { S.toast-act(); } mouse-cursor: pointer; }
                }
            }
        }

        if S.task-open: TaskDialog { }
        // черта под активной вкладкой — едет при переключении
        if S.ul-w > 0: Rectangle {
            x: S.ul-x - parent.absolute-position.x; y: S.ul-y - parent.absolute-position.y; width: S.ul-w; height: 1px;
            background: G.accent;
            animate x, width { duration: 220ms; easing: ease-out; }
        }
        if S.set-open: SettingsWin { }
        if S.create-open: CreateDialog { }
        if S.he-open: HabitEditDialog { }
        if S.search-open: SearchDialog { right: sbox.absolute-position.x + sbox.width; top: sbox.absolute-position.y; from-w: sbox.width; }
        if S.tp-open: Templates { }
        if S.ls-open: ListSettings { }
        if S.menu-open: CtxMenu { }
        if S.dp-open && S.dp-drop == "": Rectangle {
            TouchArea { clicked => { S.dp-dismiss(); } }   // клик мимо — сохранить выбранное
            // окно выбора даты раскрывается, как выпадающий список
            Pop {
                x: max(8px, S.create-open ? (parent.width - self.width) / 2 : parent.width - 464px - 16px - self.width - 8px);
                y: max(8px, S.create-open ? (parent.height - self.height) / 2 : 60px);
                width: dtp.width; height: dtp.height;
                from-right: !S.create-open;
                dtp := DatePicker { x: 0; y: 0; max-h: root.height - 16px; }
            }
        }
        // окно обновления (G_Status, слева): открывается само, когда вышла новая версия, и по чипу «Версия»;
        // внутри — «Что нового», потом полоса скачивания, при ошибке — причина и «Повторить»
        if S.upd-open: Pop {
            x: max(16px, parent.width - 1104px);
            y: 60px;
            width: 540px;
            height: 34px + ul.preferred-height;
            background: G.node;
            border-radius: 12px;
            border-width: 1px;
            border-color: S.upd-phase == 4 ? G.red : G.accent-line;
            animate border-color { duration: G.mid; }
            drop-shadow-blur: 24px;
            drop-shadow-color: #000b;
            clip: true;
            TouchArea { }
            Rectangle { y: 0; height: 34px; background: S.upd-phase == 4 ? #8A3A2E : G.head-main;
                animate background { duration: G.mid; }
                Text { x: 13px; text: S.upd-phase == 2 ? @tr("СКАЧИВАЮ ОБНОВЛЕНИЕ") : S.upd-phase == 3 ? @tr("СТАВЛЮ ОБНОВЛЕНИЕ") : S.upd-phase == 4 ? @tr("ОБНОВЛЕНИЕ НЕ ВСТАЛО") : @tr("ОБНОВЛЕНИЕ"); font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; }
                Text { x: parent.width - self.preferred-width - 13px; text: S.version + " → " + S.upd-version; font-family: G.mono; font-size: 10px; letter-spacing: 1.2px; color: #ffffffc0; vertical-alignment: center; height: parent.height; } }
            ul := VerticalLayout {
                y: 34px;
                height: self.preferred-height;
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle { width: 50px; height: 50px; border-radius: 25px; border-width: 1px; border-color: #6E7079;
                        Text { text: @tr("УРА"); font-family: G.mono; font-size: 8.5px; color: #8A8C96; horizontal-alignment: center; vertical-alignment: center; } }
                    VerticalLayout {
                        alignment: center;
                        Text { text: @tr("Вышла версия {}", S.upd-version); font-size: 19px; font-weight: 500; color: G.ink; }
                        Text { text: @tr("Сейчас стоит {}", S.version); font-size: 12.5px; color: #A3A5AE; }
                    }
                }
                Text { text: @tr("Что нового"); font-size: 13px; font-weight: 600; color: G.ink; }
                // длинный список «Что нового» не выталкивает кнопки за низ окна
                Text { text: S.upd-notes == "" ? @tr("Исправления и улучшения.") : S.upd-notes; color: G.ink; font-size: 13px; wrap: word-wrap; overflow: elide; height: min(self.preferred-height, max(60px, root.height - 400px)); }
                if S.upd-phase == 2 || S.upd-phase == 3: UpdBar { frac: S.upd-phase == 3 ? -1 : S.upd-frac; text: S.upd-progress; }
                if S.upd-phase == 4: UpdFail { what: S.upd-err; hint: S.upd-hint; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    if S.upd-phase != 2 && S.upd-phase != 3: Rectangle {
                        width: ui1.preferred-width + 24px; height: 32px; border-radius: 6px;
                        background: ub1.has-hover ? G.accent-ink : G.accent;
                        animate background { duration: G.fast; }
                        ui1 := Text { text: S.upd-phase == 4 ? @tr("Повторить") : @tr("Обновить сейчас"); font-size: 13px; font-weight: 600; color: G.on-accent; horizontal-alignment: center; vertical-alignment: center; }
                        ub1 := TouchArea { clicked => { S.upd-install(); } mouse-cursor: pointer; }
                    }
                    if S.upd-phase == 2: Rectangle {
                        width: ui3.preferred-width + 24px; height: 32px; border-radius: 6px; border-width: 1px; border-color: #8A8C96;
                        ui3 := Text { text: @tr("Остановить"); font-size: 13px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { S.upd-cancel(); } mouse-cursor: pointer; }
                    }
                    if S.upd-phase != 3: Rectangle {
                        width: ui2.preferred-width + 24px; height: 32px; border-radius: 6px; border-width: 1px; border-color: #8A8C96;
                        ui2 := Text { text: S.upd-phase == 2 ? @tr("Скрыть") : @tr("Позже"); font-size: 13px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { S.upd-later(); } mouse-cursor: pointer; }
                    }
                }
                Text { text: S.upd-phase == 2 ? @tr("Можно скрыть окно и работать дальше — после скачивания Спутник перезапустится сам.") : S.upd-phase == 3 ? @tr("Ещё пара секунд — Спутник перезапустится сам.") : @tr("Обновление займёт пару минут, задачи никуда не денутся. Окно можно открыть снова чипом «Версия» в шапке."); font-size: 12px; color: #A3A5AE; wrap: word-wrap; }
            }
        }
        // «Состояние» (G_Status, справа)
        stat := Rectangle {
            visible: false;
            x: parent.width - 436px;
            y: 60px;
            width: 380px;
            height: 34px + sl.preferred-height;
            background: G.node;
            border-radius: 8px;
            border-width: 1px;
            border-color: G.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000b;
            clip: true;
            TouchArea { }
            Rectangle { y: 0; height: 34px; background: S.status-ok && !S.offline ? #2E6B3E : #8A3A2E;
                Text { x: 13px; text: @tr("СОСТОЯНИЕ"); font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.4px; color: #fff; vertical-alignment: center; height: parent.height; }
                Text { x: parent.width - self.preferred-width - 13px; text: S.status-ok && !S.offline ? @tr("ВСЁ В ПОРЯДКЕ") : @tr("ЕСТЬ ВОПРОСЫ"); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: #ffffffd0; vertical-alignment: center; height: parent.height; } }
            sl := VerticalLayout {
                y: 34px;
                height: self.preferred-height;
                padding: 14px;
                spacing: 0;
                for r[i] in [
                    { t: @tr("Google Задачи и Календарь"), s: S.offline ? @tr("Нет связи — правки уйдут, когда вернётся") : S.status, ok: !S.offline && S.error == "" },
                    { t: @tr("Слой Спутника на Drive"), s: S.sync-info, ok: true },
                    { t: @tr("Знания на Drive"), s: S.notes-sync-info, ok: S.notes-sync-ok },
                    { t: @tr("Бот в Telegram"), s: S.bot-name == "" ? @tr("Не подключён — Настройки → Напоминания") : (S.bot-status == "" ? @tr("Работает") : S.bot-status), ok: S.bot-name != "" },
                    { t: @tr("Входящие от Claude"), s: S.inbox-count == 0 ? @tr("Пусто") : @tr("Ждут ответа: {}", S.inbox-count), ok: S.inbox-count == 0 },
                ]: Rectangle {
                    height: 55px;
                    Rectangle { x: 0; y: 13px; width: 7px; height: 7px; border-radius: 1.5px; background: r.ok ? G.green : G.gold; }
                    Text { x: 20px; y: 8px; text: r.t; font-size: 13.5px; color: G.ink; }
                    Text { x: 20px; y: 28px; text: r.s; font-size: 12px; color: #A3A5AE; overflow: elide; width: parent.width - 20px; }
                    if i < 4: Rectangle { y: parent.height - 1px; height: 1px; background: G.line-soft; }
                }
                Rectangle { height: 1px; background: G.line; }
                HorizontalLayout {
                    padding-top: 12px;
                    spacing: 20px;
                    alignment: start;
                    Rectangle {
                        width: sb.preferred-width + 24px; height: 32px; border-radius: 6px; border-width: 1px; border-color: #8A8C96;
                        sb := Text { text: @tr("Синхронизировать сейчас"); font-size: 13px; color: G.ink; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { stat.visible = false; S.refresh(); } mouse-cursor: pointer; }
                    }
                    Text { text: @tr("Настройки"); font-size: 13px; color: G.accent; vertical-alignment: center; TouchArea { clicked => { stat.visible = false; S.go(5); } mouse-cursor: pointer; } }
                }
            }
        }
        if S.confirm != "": Confirm { }
    }
    // без рамки Windows — тянуть за правый нижний угол и края, чтобы менять размер
    TouchArea { x: parent.width - 14px; y: parent.height - 14px; width: 14px; height: 14px; mouse-cursor: nwse-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(0); } } }
    TouchArea { x: parent.width - 5px; y: 60px; width: 5px; height: parent.height - 74px; mouse-cursor: ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(1); } } }
    TouchArea { x: 0; y: parent.height - 5px; width: parent.width - 14px; height: 5px; mouse-cursor: ns-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(2); } } }
    TouchArea { x: 0; y: 60px; width: 5px; height: parent.height - 65px; mouse-cursor: ew-resize; pointer-event(e) => { if (e.kind == PointerEventKind.down) { S.win-resize(3); } } }
    property <int> fk: S.focus-keys;
    changed fk => { keys.focus(); }
    init => {
        root.pg-seen = S.tab;
        keys.focus();
        self.hd-compact = self.width < 1440px;
        self.hd-tight = self.width < 1240px;
    }
}
