// Канвас «Знаний» по макету G_NotesCanvas: панель сверху, ноды-заметки с цветной шапкой, карточки, картинки,
// группы-рамки пунктиром, провода с подписями. Управление как в Obsidian: колесо — двигать (Shift — вбок),
// Ctrl + колесо — масштаб у курсора, тянуть по пустому — рамка выделения, средняя кнопка или Space + тянуть — двигать,
// двойной клик по пустому — карточка, по карточке — правка, по заметке — открыть. Камера живёт здесь, Rust получает
// только итоги в единицах холста (экран = мир × k + o).
import { G, Hues } from "theme.slint";
import { Mono, Icon, Brackets, Socket, DashBox, Field, Sat, ScrollInput } from "kit.slint";
import { S, CvNode, CvEdge, NoteRow } from "store.slint";
import { MdLine } from "linknote.slint";
import { ToolBtn, SelMenu, NotePick } from "canvasmenu.slint";

// Камера открытого канваса — общая, чтобы «Знания» могли положить заметку из списка в нужную точку.
export global CvCam {
    in-out property <float> k: 1;
    in-out property <length> ox;
    in-out property <length> oy;
}

export component CanvasView inherits Rectangle {
    // камера
    in-out property <float> k <=> CvCam.k;
    in-out property <length> ox <=> CvCam.ox;
    in-out property <length> oy <=> CvCam.oy;
    // перетаскивание: 0 — нет, 1 — двигать холст, 2 — рамка, 3 — ноды, 4 — провод, 5 — размер, 9 — нажато, ещё не тянули
    property <int> mode;
    property <int> what;           // что начнётся, когда потянут: 1 / 2 / 3
    property <length> px0;
    property <length> py0;
    property <length> mx;
    property <length> my;
    property <float> ddx;
    property <float> ddy;
    property <bool> alt;
    property <bool> ctl;           // Ctrl при последнем нажатии (двойной клик с Ctrl — открыть заметку)
    property <string> wire-from;
    property <int> wire-side;
    property <length> wx0;
    property <length> wy0;
    property <string> rs-id;
    property <float> rs-x;
    property <float> rs-y;
    property <float> rs-w;
    property <float> rs-h;
    property <bool> space;
    property <duration> last-down: -1s;
    property <bool> second;
    property <bool> picking;       // открыт поиск «＋ Заметка»
    property <bool> palette;       // в меню выделенного открыт выбор цвета
    property <string> sel-key: S.cv-sel + S.cv-sel-kind;
    changed sel-key => { root.palette = false; }
    // «Заметка…» из меню по правому клику
    property <int> pick-req: S.cv-pick;
    changed pick-req => { root.picking = true; }
    property <int> ver: S.cv-ver;
    // перетаскивание заметки из списка слева (NotesPage сообщает точку)
    in property <string> drag-path;
    clip: true;

    function wx(sx: length) -> float { return (sx - root.ox) / 1px / root.k; }
    function wy(sy: length) -> float { return (sy - root.oy) / 1px / root.k; }
    function sx(x: float) -> length { return x * root.k * 1px + root.ox; }
    function sy(y: float) -> length { return y * root.k * 1px + root.oy; }
    // приблизить к выделенному: вписать рамку x0, y0, x1, y1 в экран (как в Obsidian)
    function zoom-to(b: [float]) {
        if (b.length < 4) { return; }
        root.k = max(0.15, min(2, min((root.width / 1px - 160) / max(1, b[2] - b[0]), (root.height / 1px - 220) / max(1, b[3] - b[1]))));
        root.ox = root.width / 2 - (b[0] + b[2]) / 2 * root.k * 1px;
        root.oy = root.height / 2 + 26px - (b[1] + b[3]) / 2 * root.k * 1px;
    }
    public function fit() {
        if (S.cv-bounds.length < 4) { return; }
        root.k = max(0.15, min(1, min((root.width / 1px - 120) / max(1, S.cv-bounds[2] - S.cv-bounds[0]), (root.height / 1px - 160) / max(1, S.cv-bounds[3] - S.cv-bounds[1]))));
        root.ox = root.width / 2 - (S.cv-bounds[0] + S.cv-bounds[2]) / 2 * root.k * 1px;
        root.oy = root.height / 2 + 26px - (S.cv-bounds[1] + S.cv-bounds[3]) / 2 * root.k * 1px;
    }
    function zoom-at(f: float, at-x: length, at-y: length) {
        let nk = max(0.1, min(4, root.k * f));
        root.ox = at-x - (at-x - root.ox) * nk / root.k;
        root.oy = at-y - (at-y - root.oy) * nk / root.k;
        root.k = nk;
    }
    public function drop-at(path: string, ax: length, ay: length) {
        S.cv-add-file(path, root.wx(ax - root.absolute-position.x), root.wy(ay - root.absolute-position.y));
    }
    changed ver => { root.fit(); }
    init => { root.fit(); fs.focus(); }

    fs := FocusScope {
        key-pressed(e) => {
            if (S.cv-edit != "") { return reject; }
            if (e.text == " ") { root.space = true; return accept; }
            if (e.text == Key.Delete || e.text == Key.Backspace) { S.cv-key("delete", 0, 0); return accept; }
            if (e.text == Key.Escape) { root.picking = false; S.cv-key("esc", 0, 0); return accept; }
            if (e.text == "!") { root.fit(); return accept; }
            if (e.modifiers.control) {
                if (e.text == "z" || e.text == "Z" || e.text == "я" || e.text == "Я") { S.cv-key(e.modifiers.shift ? "redo" : "undo", 0, 0); return accept; }
                if (e.text == "y" || e.text == "Y" || e.text == "н" || e.text == "Н") { S.cv-key("redo", 0, 0); return accept; }
                if (e.text == "a" || e.text == "A" || e.text == "ф" || e.text == "Ф") { S.cv-key("all", 0, 0); return accept; }
                if (e.text == "c" || e.text == "C" || e.text == "с" || e.text == "С") { S.cv-key("copy", 0, 0); return accept; }
                if (e.text == "x" || e.text == "X" || e.text == "ч" || e.text == "Ч") { S.cv-key("cut", 0, 0); return accept; }
                if (e.text == "v" || e.text == "V" || e.text == "м" || e.text == "М") { S.cv-key("paste", root.wx(root.mx), root.wy(root.my)); return accept; }
                if (e.text == "d" || e.text == "D" || e.text == "в" || e.text == "В") { S.cv-key("dup", 0, 0); return accept; }
                if (e.text == "g" || e.text == "G" || e.text == "п" || e.text == "П") { S.cv-key("group", 0, 0); return accept; }
                if (e.text == "=" || e.text == "+") { root.zoom-at(1.2, root.width / 2, root.height / 2); return accept; }
                if (e.text == "-") { root.zoom-at(1 / 1.2, root.width / 2, root.height / 2); return accept; }
                if (e.text == "0") { root.zoom-at(1 / root.k, root.width / 2, root.height / 2); return accept; }
            }
            reject
        }
        key-released(e) => {
            if (e.text == " ") { root.space = false; return accept; }
            reject
        }
    }

    // фон в точку, как у графа; точки едут вместе с холстом
    Rectangle { background: G.ground; }
    Image {
        x: mod(root.ox / 1px, 24) * 1px - 48px; y: mod(root.oy / 1px, 24) * 1px - 48px;
        width: parent.width + 96px; height: parent.height + 96px;
        source: @image-url("dot.svg"); horizontal-tiling: repeat; vertical-tiling: repeat;
    }
    // фон: колесо, рамка, двигать, двойной клик — карточка, клик — снять выбор или выбрать провод
    bg := TouchArea {
        mouse-cursor: root.mode == 1 || root.space ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                S.menu-ctx("cv-bg", root.wx(self.mouse-x) + "," + root.wy(self.mouse-y), self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                return;
            }
            if (e.kind == PointerEventKind.down) {
                fs.focus();
                // второе нажатие двойного клика — не снимать выбор и не тянуть рамку
                root.second = animation-tick() - root.last-down < 450ms;
                root.last-down = animation-tick();
                root.px0 = self.mouse-x; root.py0 = self.mouse-y;
                root.mx = self.mouse-x; root.my = self.mouse-y;
                root.what = e.button == PointerEventButton.middle || root.space ? 1 : 2;
                root.mode = 9;
                root.alt = e.modifiers.shift || e.modifiers.control;
            }
            if (e.kind == PointerEventKind.up) {
                if (root.mode == 2) {
                    S.cv-box(root.wx(root.px0), root.wy(root.py0), root.wx(root.mx), root.wy(root.my), root.alt);
                } else if (root.mode == 9 && root.what == 2 && !root.second) {
                    if (!S.cv-edge-pick(root.wx(self.mouse-x), root.wy(self.mouse-y), 8 / root.k)) { S.cv-click("", root.alt); }
                }
                root.mode = 0;
            }
        }
        moved => {
            if (root.mode == 1) {
                root.ox += self.mouse-x - root.mx; root.oy += self.mouse-y - root.my;
            }
            root.mx = self.mouse-x; root.my = self.mouse-y;
            if (root.mode == 9 && (abs(root.mx - root.px0) > 3px || abs(root.my - root.py0) > 3px)) { root.mode = root.what; }
        }
        double-clicked => { S.cv-add("text", root.wx(self.mouse-x), root.wy(self.mouse-y)); }
        scroll-event(e) => {
            if (e.modifiers.control) {
                root.zoom-at(e.delta-y > 0 ? 1.12 : 1 / 1.12, self.mouse-x, self.mouse-y);
            } else if (e.modifiers.shift) {
                root.ox += e.delta-y;
            } else {
                root.ox += e.delta-x; root.oy += e.delta-y;
            }
            accept
        }
    }

    // группы и ноды (группы первыми — под остальными)
    for n in S.cv-nodes: nd := Rectangle {
        property <bool> moving: n.mv && root.mode == 3;
        property <float> nw: root.rs-id == n.id ? root.rs-w : n.w;
        // цвет ноды: выделение его не меняет — рамка и уголки того же цвета
        property <color> hue: n.kind == "text" ? (n.colored ? n.head : G.gold) : n.head.brighter(0.5);
        property <float> nh: root.rs-id == n.id ? root.rs-h : n.h;
        property <bool> far: root.k < 0.35;
        property <bool> editing: S.cv-edit == n.id;
        property <length> hh: 30px * min(1.4, max(0.6, root.k));
        property <length> pscroll;     // прокрутка снимка страницы
        x: root.sx((root.rs-id == n.id ? root.rs-x : n.x) + (moving ? root.ddx : 0));
        y: root.sy((root.rs-id == n.id ? root.rs-y : n.y) + (moving ? root.ddy : 0));
        width: nw * root.k * 1px;
        height: nh * root.k * 1px;
        // рамка-группа
        if n.kind == "group": DashBox {
            width: parent.width; height: parent.height;
            c: n.colored ? n.head.with-alpha(n.sel ? 1 : 0.8) : G.violet.with-alpha(n.sel ? 1 : 0.7);
            dash: 5px;
            background: (n.colored ? n.head : G.violet).with-alpha(0.05);
            border-radius: 10px;
        }
        if n.kind == "group" && !editing: Text {
            x: 14px; y: 12px; width: parent.width - 28px;
            text: n.text.to-uppercase();
            font-family: G.mono; font-size: max(9px, 10.5px * root.k); letter-spacing: 1.6px; font-weight: 600;
            color: n.colored ? n.head.brighter(0.6) : G.violet;
            overflow: elide;
        }
        // нода
        if n.kind != "group": Rectangle {
            // издалека рамку и углы рисует сама плашка — иначе две рамки с разным скруглением
            border-radius: far ? 6px : (n.main ? 12px : 8px) * max(0.75, min(1, root.k));
            background: far ? transparent : G.node;
            border-width: far ? 0 : 1px;
            border-color: n.sel ? nd.hue : (n.kind == "text" ? (n.colored ? n.head : G.gold.with-alpha(0.55)) : G.line);
            drop-shadow-blur: n.sel ? 18px : 0;
            drop-shadow-color: #0008;
            clip: true;
            // шапка (у карточки-текста — без заливки, подпись цветом)
            // мелкий масштаб: одна плашка цвета ноды с крупным названием в несколько строк
            // издалека (п. 46, «В · Заливка»): плашка цвета шапки, рамка цветом ноды 50 %, название 11 px, не больше 2 строк
            if far: Rectangle {
                background: n.fill; border-radius: 6px; clip: true;
                border-width: n.sel ? 1.5px : 1px; border-color: n.sel ? G.accent : nd.hue.with-alpha(0.5);
                // картинка — превью, а не имя файла
                if n.kind == "image" || (n.kind == "link" && n.page): Image {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    source: n.img; image-fit: cover; vertical-alignment: top;
                }
                // мелкая плашка (меньше 44×26 на экране) — только заливка
                if n.kind != "image" && !(n.kind == "link" && n.page) && parent.width >= 44px && parent.height >= 26px: Text {
                    x: 6px; width: parent.width - 12px;
                    height: min(parent.height - 6px, 11px * 1.3 * 2); y: (parent.height - self.height) / 2;
                    text: n.kind == "link" && n.title == n.path ? n.tag : n.title;
                    font-family: G.sans; font-weight: 600; font-size: 11px; color: #ffffff;
                    wrap: word-wrap; overflow: elide;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            if n.kind != "text" && !far: Rectangle {
                y: 0; height: nd.hh;
                background: n.head;
                Text {
                    x: 12px * min(1, root.k * 1.5); width: parent.width - 24px * min(1, root.k * 1.5) - tg.width;
                    // у снимка страницы в шапке — название страницы, сайт справа
                    text: (n.kind == "link" && !(n.page && n.title != n.path) ? n.tag : n.title).to-uppercase();
                    font-family: G.mono; font-size: max(8px, 10.5px * root.k); font-weight: 600; letter-spacing: 1.4px;
                    color: #fff; vertical-alignment: center; height: parent.height; overflow: elide;
                }
                tg := Text {
                    x: parent.width - self.width - 12px * min(1, root.k * 1.5);
                    width: self.preferred-width;
                    text: n.kind == "link" ? (n.page && n.title != n.path ? n.tag.to-uppercase() : "ССЫЛКА") : (n.missing ? "НЕТ ЗАМЕТКИ" : n.tag);
                    font-family: G.mono; font-size: max(8px, 10px * root.k); letter-spacing: 1.2px;
                    color: #ffffffb0; vertical-alignment: center; height: parent.height;
                }
            }
            // тело: строки заметки или карточки как markdown
            if (n.kind == "file" || n.kind == "text") && !far && !editing: Rectangle {
                x: 12px * min(1, root.k * 1.5);
                y: n.kind == "text" ? 10px * root.k : nd.hh + 8px * root.k;
                width: parent.width - 24px * min(1, root.k * 1.5);
                height: parent.height - self.y - 6px * root.k;
                clip: true;
                VerticalLayout {
                    alignment: start;
                    for l in n.rows: MdLine { line: l; fs: max(7px, 13px * root.k); }
                }
            }
            if n.kind == "image" && !far: Rectangle {
                x: 8px * root.k; y: nd.hh + 8px * root.k;
                width: parent.width - 16px * root.k; height: parent.height - self.y - 8px * root.k;
                border-radius: 6px; background: G.bg; border-width: 1px; border-color: G.line-soft; clip: true;
                Image { source: n.img; width: parent.width; height: parent.height; image-fit: contain; }
            }
            // ссылка: картинка страницы, название, описание, адрес (предпросмотр качается в фоне)
            // снимок страницы — как в браузере, колесо листает (у выделенной)
            if n.kind == "link" && n.page && !far: Rectangle {
                y: nd.hh; height: parent.height - nd.hh; clip: true; background: #fff;
                property <length> ph: self.width * n.img.height / max(1, n.img.width);
                Image { y: -nd.pscroll; source: n.img; width: parent.width; height: parent.ph; image-fit: fill; }
            }
            if n.kind == "link" && !n.page && !far: Rectangle {
                x: 10px * min(1, root.k * 1.5); y: nd.hh + 8px * root.k;
                width: parent.width - 20px * min(1, root.k * 1.5); height: parent.height - self.y - 8px * root.k;
                clip: true;
                property <length> ih: n.img.width > 0 ? min(self.height * 0.55, self.width * n.img.height / max(1, n.img.width)) : 0;
                if n.img.width > 0: Rectangle {
                    y: 0; height: parent.ih; border-radius: 6px; clip: true; background: G.bg;
                    Image { source: n.img; width: parent.width; height: parent.height; image-fit: cover; }
                }
                VerticalLayout {
                    y: parent.ih + (parent.ih > 0 ? 8px * root.k : 0); height: parent.height - self.y;
                    spacing: 4px * root.k; alignment: start;
                    if n.title != n.path: Text { text: n.title; color: G.ink; font-size: max(8px, 14px * root.k); font-weight: 600; wrap: word-wrap; overflow: elide; max-height: max(8px, 14px * root.k) * 3.2; }
                    for l in n.rows: MdLine { line: l; fs: max(7px, 12px * root.k); }
                    Text { text: n.missing ? "загружаю предпросмотр…" : n.path; color: n.missing ? G.dim : G.accent; font-size: max(7px, 11px * root.k); overflow: elide; }
                }
            }
        }
        // тянуть, выбрать, открыть
        na := TouchArea {
            height: n.kind == "group" ? 34px * max(0.6, root.k) : parent.height;
            mouse-cursor: root.mode == 3 ? MouseCursor.grabbing : MouseCursor.default;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    if (!fs.has-focus) { fs.focus(); }
                    if (!n.sel || e.modifiers.shift || e.modifiers.control) { S.cv-click(n.id, e.modifiers.shift || e.modifiers.control); }
                    root.px0 = self.absolute-position.x + self.mouse-x; root.py0 = self.absolute-position.y + self.mouse-y;
                    root.ddx = 0; root.ddy = 0; root.mode = 9; root.what = 3; root.alt = e.modifiers.alt; root.ctl = e.modifiers.control;
                }
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) { root.mode = 0; }
                // правый клик — меню карточки (выбранную оставляем, иначе выбираем эту)
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                    if (!n.sel) { S.cv-click(n.id, false); }
                    S.menu-ctx("cv-node", n.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    return;
                }
                if (e.kind == PointerEventKind.up) {
                    if (root.mode == 3) { S.cv-move(round(root.ddx / 10) * 10, round(root.ddy / 10) * 10, root.alt); }
                    else if (root.mode == 9 && n.sel && S.cv-sel > 1 && !e.modifiers.shift && !e.modifiers.control) { S.cv-click(n.id, false); }
                    root.mode = 0; root.ddx = 0; root.ddy = 0;
                }
            }
            moved => {
                if (self.pressed && (root.mode == 9 || root.mode == 3)) {
                    let cx = self.absolute-position.x + self.mouse-x;
                    let cy = self.absolute-position.y + self.mouse-y;
                    root.ddx = (cx - root.px0) / 1px / root.k;
                    root.ddy = (cy - root.py0) / 1px / root.k;
                    if (root.mode == 9 && (abs(cx - root.px0) > 3px || abs(cy - root.py0) > 3px)) { root.mode = 3; }
                    if (root.mode == 3) {
                        root.ddx = (cx - root.px0) / 1px / root.k;
                        root.ddy = (cy - root.py0) / 1px / root.k;
                    }
                }
            }
            double-clicked => {
                // заметку и карточку правим прямо на холсте; Ctrl + двойной клик — открыть заметку во вкладке
                if (n.kind == "text" || n.kind == "group" || (n.kind == "file" && !n.missing && !root.ctl)) { S.cv-edit-start(n.id); } else { S.cv-open(n.id); }
            }
            scroll-event(e) => {
                if (n.kind == "link" && n.page && n.sel && !e.modifiers.control) {
                    let ph = (nd.width) * n.img.height / max(1, n.img.width);
                    nd.pscroll = max(0, min(ph - (nd.height - nd.hh), nd.pscroll - e.delta-y));
                    return accept;
                }
                reject
            }
        }
        // правка на месте: текст карточки или подпись группы
        if editing: Rectangle {
            x: 10px; y: n.kind == "group" ? 6px : (n.kind == "file" ? nd.hh + 6px : 10px);
            width: parent.width - 20px; height: n.kind == "group" ? 26px : parent.height - self.y - 10px;
            background: G.bg; border-radius: 6px; border-width: 1px; border-color: G.accent-line;
            clip: true;
            if n.kind == "group": TextInput {
                x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
                text: n.text;
                single-line: true;
                font-size: max(11px, 13px * root.k);
                color: G.ink;
                selection-background-color: #F0A04B66;
                selection-foreground-color: #FFFFFF;
                init => { self.focus(); self.select-all(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape || e.text == Key.Return) { S.cv-text(n.id, self.text); fs.focus(); return accept; }
                    reject
                }
                changed has-focus => { if (!self.has-focus && S.cv-edit == n.id) { S.cv-text(n.id, self.text); } }
            }
            // карточка и заметка: markdown целиком, длинный текст листается внутри; Esc или клик мимо — готово
            if n.kind != "group": si := ScrollInput {
                x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
                text: n.text;
                font-size: max(11px, 13px * root.k);
                init => { self.grab(); }
                escape => { S.cv-text(n.id, self.text); fs.focus(); }
                changed focused => { if (!self.focused && S.cv-edit == n.id) { S.cv-text(n.id, self.text); } }
            }
        }
        // гнёзда по сторонам — тянуть провод
        if (n.sel || na.has-hover) && n.kind != "group" && !editing: Rectangle {
            for s in 4: Socket {
                property <length> cx: s == 1 ? parent.width : (s == 3 ? 0 : parent.width / 2);
                property <length> cy: s == 2 ? parent.height : (s == 0 ? 0 : parent.height / 2);
                x: cx - 5px; y: cy - 5px;
                hue: n.colored || n.kind == "file" ? n.head.brighter(0.8) : G.gold;
                ring: !sa.has-hover;
                sa := TouchArea {
                    mouse-cursor: MouseCursor.crosshair;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.wire-from = n.id; root.wire-side = s; root.mode = 4;
                            root.wx0 = self.absolute-position.x + 5px - root.absolute-position.x;
                            root.wy0 = self.absolute-position.y + 5px - root.absolute-position.y;
                            root.mx = root.wx0; root.my = root.wy0;
                        }
                        if (e.kind == PointerEventKind.up && root.mode == 4) {
                            S.cv-wire(n.id, s, root.wx(root.mx), root.wy(root.my));
                            root.mode = 0;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.mx = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                            root.my = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                        }
                    }
                }
            }
        }
        // размер: тянуть за любой край или угол (края — невидимые полосы, гнёзда посередине поверх них)
        if n.sel && S.cv-sel == 1 && !editing: Rectangle {
            for d in 8: Rectangle {
                property <int> hx: d == 0 || d == 6 || d == 7 ? -1 : (d == 1 || d == 5 ? 0 : 1);
                property <int> hy: d <= 2 ? -1 : (d == 3 || d == 7 ? 0 : 1);
                property <bool> corner: hx != 0 && hy != 0;
                x: hx < 0 ? -5px : (hx > 0 ? parent.width - 5px : 10px);
                y: hy < 0 ? -5px : (hy > 0 ? parent.height - 5px : 10px);
                width: hx == 0 ? parent.width - 20px : 10px;
                height: hy == 0 ? parent.height - 20px : 10px;
                if corner: Rectangle { x: 1px; y: 1px; width: 8px; height: 8px; border-radius: 2px; background: G.node; border-width: 1.5px; border-color: nd.hue; }
                TouchArea {
                    mouse-cursor: corner ? (hx == hy ? MouseCursor.nwse-resize : MouseCursor.nesw-resize) : (hx == 0 ? MouseCursor.ns-resize : MouseCursor.ew-resize);
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.rs-id = n.id; root.rs-x = n.x; root.rs-y = n.y; root.rs-w = n.w; root.rs-h = n.h;
                            root.px0 = self.absolute-position.x + self.mouse-x; root.py0 = self.absolute-position.y + self.mouse-y;
                        }
                        if (e.kind == PointerEventKind.up && root.rs-id == n.id) { S.cv-resize(n.id, root.rs-x, root.rs-y, root.rs-w, root.rs-h); root.rs-id = ""; }
                    }
                    moved => {
                        if (self.pressed) {
                            let dx = (self.absolute-position.x + self.mouse-x - root.px0) / 1px / root.k;
                            let dy = (self.absolute-position.y + self.mouse-y - root.py0) / 1px / root.k;
                            if (hx > 0) { root.rs-w = max(80, n.w + dx); }
                            if (hx < 0) { root.rs-w = max(80, n.w - dx); root.rs-x = n.x + n.w - root.rs-w; }
                            if (hy > 0) { root.rs-h = max(50, n.h + dy); }
                            if (hy < 0) { root.rs-h = max(50, n.h - dy); root.rs-y = n.y + n.h - root.rs-h; }
                        }
                    }
                }
            }
        }
        if n.sel && n.kind != "group": Brackets { width: parent.width; height: parent.height; c: nd.hue; }
    }

    // провода (поверх нод не мешают кликам: Path без TouchArea)
    // выделенный провод — как в Obsidian: толще, светлее, с широким полупрозрачным ореолом своего цвета
    for e in S.cv-edges: Rectangle {
        property <float> dax: e.amv && root.mode == 3 ? root.ddx : 0;
        property <float> day: e.amv && root.mode == 3 ? root.ddy : 0;
        property <float> dbx: e.bmv && root.mode == 3 ? root.ddx : 0;
        property <float> dby: e.bmv && root.mode == 3 ? root.ddy : 0;
        property <color> c: e.colored ? e.color : G.violet;
        if e.sel: Path {
            x: 0; y: 0; width: root.width; height: root.height;
            viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
            stroke: parent.c.with-alpha(0.16); stroke-width: max(10px, 16px * min(1, root.k)); stroke-line-cap: round;
            MoveTo { x: root.sx(e.ax + dax) / 1px; y: root.sy(e.ay + day) / 1px; }
            CubicTo {
                control-1-x: root.sx(e.c1x + dax) / 1px; control-1-y: root.sy(e.c1y + day) / 1px;
                control-2-x: root.sx(e.c2x + dbx) / 1px; control-2-y: root.sy(e.c2y + dby) / 1px;
                x: root.sx(e.bx + dbx) / 1px; y: root.sy(e.by + dby) / 1px;
            }
        }
        Path {
            x: 0; y: 0; width: root.width; height: root.height;
            viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
            stroke: e.sel ? parent.c.mix(#ffffff, 0.55) : parent.c;
            stroke-width: e.sel ? 3.5px : (root.k < 0.35 ? 1px : 1.5px); stroke-line-cap: round;
            MoveTo { x: root.sx(e.ax + dax) / 1px; y: root.sy(e.ay + day) / 1px; }
            CubicTo {
                control-1-x: root.sx(e.c1x + dax) / 1px; control-1-y: root.sy(e.c1y + day) / 1px;
                control-2-x: root.sx(e.c2x + dbx) / 1px; control-2-y: root.sy(e.c2y + dby) / 1px;
                x: root.sx(e.bx + dbx) / 1px; y: root.sy(e.by + dby) / 1px;
            }
        }
    }
    // стрелки и подписи проводов
    for e in S.cv-edges: Rectangle {
        property <float> dax: e.amv && root.mode == 3 ? root.ddx : 0;
        property <float> day: e.amv && root.mode == 3 ? root.ddy : 0;
        property <float> dbx: e.bmv && root.mode == 3 ? root.ddx : 0;
        property <float> dby: e.bmv && root.mode == 3 ? root.ddy : 0;
        // середина кривой (t = 0.5)
        property <float> mx: (e.ax + dax + 3 * (e.c1x + dax) + 3 * (e.c2x + dbx) + e.bx + dbx) / 8;
        property <float> my: (e.ay + day + 3 * (e.c1y + day) + 3 * (e.c2y + dby) + e.by + dby) / 8;
        property <float> ux: (e.bx - e.c2x) / max(0.001, sqrt((e.bx - e.c2x) * (e.bx - e.c2x) + (e.by - e.c2y) * (e.by - e.c2y)));
        property <float> uy: (e.by - e.c2y) / max(0.001, sqrt((e.bx - e.c2x) * (e.bx - e.c2x) + (e.by - e.c2y) * (e.by - e.c2y)));
        property <float> tx: root.sx(e.bx + dbx) / 1px;
        property <float> ty: root.sy(e.by + dby) / 1px;
        if e.arrow: Path {
            x: 0; y: 0; width: root.width; height: root.height;
            viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
            fill: e.sel ? (e.colored ? e.color : G.violet).mix(#ffffff, 0.55) : (e.colored ? e.color : G.violet);
            property <float> al: e.sel ? 12 : 9;
            MoveTo { x: tx; y: ty; }
            LineTo { x: tx - ux * al - uy * al / 2; y: ty - uy * al + ux * al / 2; }
            LineTo { x: tx - ux * al + uy * al / 2; y: ty - uy * al - ux * al / 2; }
            Close { }
        }
        if e.label != "" && S.cv-edit != e.id && root.k >= 0.2: Rectangle {
            x: root.sx(mx) - self.width / 2; y: root.sy(my) - self.height / 2;
            width: lt.preferred-width + 12px; height: 18px;
            background: #191A1E; border-radius: 4px;
            lt := Text { text: e.label.to-uppercase(); font-family: G.mono; font-size: 9.5px; letter-spacing: 1.4px; color: e.sel ? G.ink : G.muted; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { double-clicked => { S.cv-edit-start(e.id); } clicked => { S.cv-edge-pick(mx, my, 1); } }
        }
        if S.cv-edit == e.id: Rectangle {
            x: root.sx(mx) - 80px; y: root.sy(my) - 14px; width: 160px; height: 28px;
            background: G.bg; border-radius: 6px; border-width: 1px; border-color: G.accent-line;
            le := TextInput {
                x: 8px; width: parent.width - 16px; height: parent.height;
                text: e.label; font-size: 12px; color: G.ink; vertical-alignment: center;
                selection-background-color: #F0A04B66; selection-foreground-color: #FFFFFF;
                init => { self.focus(); self.select-all(); }
                accepted => { S.cv-text(e.id, self.text); fs.focus(); }
                key-pressed(k) => { if (k.text == Key.Escape) { S.cv-text(e.id, self.text); fs.focus(); return accept; } reject }
                changed has-focus => { if (!self.has-focus && S.cv-edit == e.id) { S.cv-text(e.id, self.text); } }
            }
        }
    }

    // провод, который тянут
    if root.mode == 4: Path {
        x: 0; y: 0; width: root.width; height: root.height;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: G.accent; stroke-width: 1.5px;
        MoveTo { x: root.wx0 / 1px; y: root.wy0 / 1px; }
        CubicTo {
            control-1-x: (root.wx0 + (root.wire-side == 1 ? 60px : root.wire-side == 3 ? -60px : 0)) / 1px;
            control-1-y: (root.wy0 + (root.wire-side == 2 ? 60px : root.wire-side == 0 ? -60px : 0)) / 1px;
            control-2-x: root.mx / 1px; control-2-y: root.my / 1px;
            x: root.mx / 1px; y: root.my / 1px;
        }
    }
    // рамка выделения
    if root.mode == 2: Rectangle {
        x: min(root.px0, root.mx); y: min(root.py0, root.my);
        width: abs(root.mx - root.px0); height: abs(root.my - root.py0);
        background: G.accent.with-alpha(0.06); border-width: 1px; border-color: G.accent-line;
    }

    // панель сверху (макет: «ХОЛСТ путь · ＋ Заметка · ＋ Текст · ＋ Картинка · Группа … Авто-раскладка»)
    bar := Rectangle {
        x: 16px; y: 12px; width: parent.width - 32px; height: 48px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.line;
        TouchArea { }
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px; spacing: 6px; alignment: start;
            Text { text: "ХОЛСТ"; font-family: G.mono; font-size: 10.5px; font-weight: 600; letter-spacing: 1.5px; color: G.ink; vertical-alignment: center; }
            Mono { text: S.cv-crumb; font-size: 9.5px; letter-spacing: 1.3px; color: #8A8C96; vertical-alignment: center; overflow: elide; max-width: 260px; }
            Rectangle { width: 1px; height: 22px; y: 13px; background: G.line; }
            Rectangle { width: 2px; }
            VerticalLayout { alignment: center; ToolBtn { text: "Заметка"; icon: "plus"; outlined: true; clicked => { root.picking = !root.picking; } } }
            VerticalLayout { alignment: center; ToolBtn { text: "Текст"; icon: "plus"; clicked => { S.cv-add("text", root.wx(root.width / 2), root.wy(root.height / 2)); } } }
            VerticalLayout { alignment: center; ToolBtn { text: "Картинка"; icon: "plus"; clicked => { S.cv-add-image(root.wx(root.width / 2), root.wy(root.height / 2)); } } }
            VerticalLayout { alignment: center; ToolBtn { text: "Группа"; clicked => { S.cv-add("group", root.wx(root.width / 2), root.wy(root.height / 2)); } } }
        }
        HorizontalLayout {
            x: parent.width - self.preferred-width - 12px; width: self.preferred-width;
            spacing: 14px; alignment: end;
            if parent.width > 900px: Mono { text: "ОТКРЫТЫЙ ФОРМАТ JSON CANVAS"; font-size: 9.5px; letter-spacing: 1.3px; color: #62646E; vertical-alignment: center; }
            VerticalLayout { alignment: center; ToolBtn { text: "Авто-раскладка"; accent: true; clicked => { S.cv-key("layout", 0, 0); } } }
        }
    }
    // поиск заметки для «＋ Заметка»
    if root.picking: NotePick {
        x: 200px; y: 64px;
        picked(p) => { S.cv-add-file(p, root.wx(root.width / 2), root.wy(root.height / 2)); root.picking = false; fs.focus(); }
        closed => { root.picking = false; fs.focus(); }
    }
    // меню у выделенного (как в Obsidian): над объектом, не мешает тянуть — пока тянут, спрятано
    if S.cv-sel > 0 && S.cv-edit == "" && S.cv-sel-box.length == 4 && root.mode != 3 && root.rs-id == "": SelMenu {
        property <length> top: root.sy(S.cv-sel-box[1]) - self.height - 12px;
        x: max(8px, min(parent.width - self.width - 8px, (root.sx(S.cv-sel-box[0]) + root.sx(S.cv-sel-box[2])) / 2 - self.width / 2));
        y: self.below ? min(parent.height - self.height - 60px, root.sy(S.cv-sel-box[3]) + 12px) : self.top;
        below: self.top < bar.y + bar.height + 8px;
        palette <=> root.palette;
        zoom => { root.zoom-to(S.cv-sel-box); }
    }
    // масштаб
    Rectangle {
        x: parent.width - 172px; y: parent.height - 48px; width: 156px; height: 32px;
        border-radius: 6px; background: G.node; border-width: 1px; border-color: G.line;
        TouchArea { }
        HorizontalLayout {
            padding-left: 4px; padding-right: 4px; spacing: 2px;
            ToolBtn { text: "−"; clicked => { root.zoom-at(1 / 1.2, root.width / 2, root.height / 2); } }
            Mono { text: round(root.k * 100) + "%"; vertical-alignment: center; horizontal-alignment: center; width: 44px; }
            ToolBtn { text: "+"; clicked => { root.zoom-at(1.2, root.width / 2, root.height / 2); } }
            VerticalLayout { alignment: center; Rectangle { width: 28px; height: 28px; border-radius: 6px; background: fa.has-hover ? G.node-hover : transparent;
                Icon { name: "expand"; width: 13px; x: 7.5px; y: 7.5px; c: G.muted; }
                fa := TouchArea { mouse-cursor: pointer; clicked => { root.fit(); } } } }
        }
    }
    // пустой канвас и подсказка (макет: карточка с пунктиром внизу справа)
    if S.cv-nodes.length < 3 && S.cv-err == "": Rectangle {
        x: parent.width - self.width - 16px; y: parent.height - 48px - 16px - self.height; width: 380px; height: 72px;
        border-radius: 8px; background: G.node.with-alpha(0.9);
        DashBox { width: parent.width; height: parent.height; c: G.gold.with-alpha(0.6); }
        Sat { x: 14px; y: 13px; width: 46px; height: 46px; }
        Text {
            x: 72px; width: parent.width - 86px; height: parent.height;
            text: "Перетащи заметку из списка — появится нода. Двойной клик — карточка, по заметке — правка (Ctrl — открыть). Провод — от гнезда к гнезду, двойной клик по подписи — правка.";
            font-size: 12.5px; color: #C9CBD3; wrap: word-wrap; vertical-alignment: center;
        }
    }
    if S.cv-err != "": Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 440px; height: 120px;
        border-radius: 8px; background: G.node; border-width: 1px; border-color: G.red;
        VerticalLayout {
            padding: 16px; spacing: 8px;
            Text { text: "Канвас не читается"; font-size: 15px; font-weight: 600; color: G.ink; }
            Text { text: S.cv-err + ". Файл не трогаем — поправь его в другой программе, и он откроется."; font-size: 12.5px; color: G.muted; wrap: word-wrap; }
        }
    }
}
